{
  "name": "Kalandra",
  "scopeName": "source.kalandra",
  "patterns": [
    { "name": "comment.line.number-sign.kalandra", "match": "#.*$" },
    {
      "name": "string.quoted.double.kalandra",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.kalandra",
          "match": "\\\\(?:u\\{[0-9a-fA-F]+\\}|.)"
        }
      ]
    },
    {
      "name": "keyword.declaration.kalandra",
      "match": "\\b(fn|type|enum|error|export|from|import|as)\\b"
    },
    {
      "name": "keyword.control.kalandra",
      "match": "\\b(if|else|match|fail|try|catch|spawn|await|parallel|on|with|and|or|not)\\b"
    },
    {
      "name": "storage.type.kalandra",
      "match": "\\b(int(?:8|16|32|64)?|uint(?:8|16|32|64)?|float(?:32|64)?|String|Bool|Tensor|Device|TaskError|FaultKind)\\b"
    },
    { "name": "constant.language.kalandra", "match": "\\b(true|false)\\b" },
    {
      "name": "constant.numeric.kalandra",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?\\b"
    },
    {
      "name": "keyword.operator.kalandra",
      "match": "->|=>|==|!=|<=|>=|[+*/%<>=!|:-]"
    },
    {
      "name": "entity.name.function.kalandra",
      "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*\\()"
    }
  ]
}

#version 450
#extension GL_ARB_gpu_shader_fp64 : require
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) readonly buffer Left { double a[]; };
layout(set=0,binding=1,std430) readonly buffer Right { double b[]; };
layout(set=0,binding=2,std430) writeonly buffer Output { double result[]; };
layout(set=0,binding=3,std430) buffer Parameters { uint p[2]; };
void main() {
  uint i=gl_GlobalInvocationID.x;
  if(i<p[0]) result[i]=a[i]/b[i];
}

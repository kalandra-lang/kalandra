#pragma once
#include <iostream>
#include <string_view>

namespace kalandra {
inline constexpr std::string_view version = "@KALANDRA_VERSION@";

// A standalone query must not load source, resolve resources or start LSP transport.
inline bool printVersion(int argc, char **argv, std::string_view tool) {
  if (argc != 2 || std::string_view(argv[1]) != "--version")
    return false;
  std::cout << tool << ' ' << version << '\n';
  return true;
}
} // namespace kalandra

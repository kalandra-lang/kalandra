if(NOT DEFINED KERNEL_PREFIX)
  set(KERNEL_PREFIX strict)
endif()
file(READ "${OUTPUT_DIR}/${KERNEL_PREFIX}.lowered.mlir" LOWERED)
file(READ "${OUTPUT_DIR}/${KERNEL_PREFIX}.spvasm" SPIRV)
file(READ "${OUTPUT_DIR}/${KERNEL_PREFIX}.metal" MSL)
file(READ "${OUTPUT_DIR}/strict-cpu.ll" LLVM)
if(LOWERED MATCHES "arith\\.(addf|subf|negf|mulf|divf)" OR SPIRV MATCHES "OpF(Add|Sub|Negate|Mul|Div)|Fma|FPFastMathMode" OR MSL MATCHES "fma[ \t]*\\(" OR LLVM MATCHES "(fadd|fsub|fneg|fmul|fdiv|llvm.fma)")
  message(FATAL_ERROR "Strict integer arithmetic retained or introduced a floating operation")
endif()
# These fixtures contain no source loops. Normalization must stay a bounded
# straight-line sequence rather than reintroducing per-bit shader loops.
if(LOWERED MATCHES "scf\\.(for|while)" OR SPIRV MATCHES "OpLoopMerge")
  message(FATAL_ERROR "Strict scalar normalization unexpectedly introduced a loop")
endif()
if(NOT SPIRV MATCHES "OpCapability Int64" OR NOT SPIRV MATCHES "OpIMul" OR NOT SPIRV MATCHES "OpIAdd")
  message(FATAL_ERROR "Expected 64-bit integer arithmetic missing")
endif()
file(READ "${OUTPUT_DIR}/${KERNEL_PREFIX}.reflection.json" REFLECTION)
string(JSON ENTRY GET "${REFLECTION}" entryPoints 0 name)
string(JSON WIDTH GET "${REFLECTION}" entryPoints 0 workgroup_size 0)
string(JSON BUFFERS LENGTH "${REFLECTION}" ssbos)
if(NOT ENTRY STREQUAL "strict_binary32" OR NOT WIDTH EQUAL 64 OR NOT BUFFERS EQUAL 4)
  message(FATAL_ERROR "Unexpected strict kernel interface")
endif()
foreach(INDEX RANGE 0 3)
  string(JSON BINDING GET "${REFLECTION}" ssbos ${INDEX} binding)
  string(JSON SIZE GET "${REFLECTION}" ssbos ${INDEX} block_size)
  if(INDEX EQUAL 3)
    set(EXPECTED_SIZE 8)
  elseif(KERNEL_PREFIX STREQUAL "runtime")
    set(EXPECTED_SIZE 0)
  else()
    set(EXPECTED_SIZE 16384)
  endif()
  if(NOT BINDING EQUAL INDEX OR NOT SIZE EQUAL EXPECTED_SIZE)
    message(FATAL_ERROR "Strict kernel buffer mapping changed")
  endif()
  string(JSON TYPE GET "${REFLECTION}" ssbos ${INDEX} type)
  string(JSON ELEMENT GET "${REFLECTION}" types "${TYPE}" members 0 type)
  string(JSON STRIDE GET "${REFLECTION}" types "${TYPE}" members 0 array_stride)
  string(JSON OFFSET GET "${REFLECTION}" types "${TYPE}" members 0 offset)
  if(INDEX EQUAL 3)
    set(EXPECTED_ELEMENT uint)
  else()
    set(EXPECTED_ELEMENT float)
  endif()
  if(NOT ELEMENT STREQUAL EXPECTED_ELEMENT OR NOT STRIDE EQUAL 4 OR NOT OFFSET EQUAL 0)
    message(FATAL_ERROR "Strict kernel element layout changed")
  endif()
endforeach()
message(STATUS "Strict CPU/GPU arithmetic contains only integer operations and the expected buffer interface")

file(READ "${OUTPUT_DIR}/strict64-cpu.lowered.mlir" LOWERED)
file(READ "${OUTPUT_DIR}/strict64-cpu.ll" LLVM)
if(LOWERED MATCHES "arith\\.(addf|subf|mulf|divf|negf)|scf\\.(for|while)" OR
   LLVM MATCHES "(fadd|fsub|fmul|fdiv|fneg|llvm.fma)")
  message(FATAL_ERROR "Strict CPU arithmetic retained floating arithmetic or normalization loops")
endif()
if(NOT LOWERED MATCHES "i128" OR NOT LLVM MATCHES "udiv i128" OR
   NOT LLVM MATCHES "define i64 @strict64_add" OR NOT LLVM MATCHES "define i32 @strict_add")
  message(FATAL_ERROR "Mixed-format CPU fixture lost wide intermediates or concrete result types")
endif()
foreach(KIND IN ITEMS remf vector half compare convert gpu spirv)
  set(TYPE f64)
  set(OP "arith.remf %x, %y : f64")
  set(RETURN "return %r : ${TYPE}")
  if(KIND STREQUAL "vector")
    set(TYPE "vector<2xf64>")
    set(OP "arith.addf %x, %y : ${TYPE}")
    set(RETURN "return %r : ${TYPE}")
  elseif(KIND STREQUAL "half")
    set(TYPE f16)
    set(OP "arith.mulf %x, %y : ${TYPE}")
    set(RETURN "return %r : ${TYPE}")
  elseif(KIND STREQUAL "compare")
    set(OP "arith.cmpf oeq, %x, %y : f64")
    set(RETURN "return %x : f64")
  elseif(KIND STREQUAL "convert")
    set(OP "arith.truncf %x : f64 to f32")
    set(RETURN "return %x : f64")
  endif()
  set(TEXT "module { func.func @bad(%x: ${TYPE}, %y: ${TYPE}) -> ${TYPE} { %r = ${OP} ${RETURN} } }\n")
  set(DIAGNOSTIC "supports only scalar float32/float64")
  if(KIND STREQUAL "gpu")
    set(TEXT "module { gpu.module @device {} }\n")
    set(DIAGNOSTIC "does not accept GPU")
  elseif(KIND STREQUAL "spirv")
    set(TEXT "module { spirv.module Logical GLSL450 {} }\n")
    set(DIAGNOSTIC "does not accept GPU")
  endif()
  file(WRITE "${OUTPUT_DIR}/strict64-rejected-${KIND}.mlir" "${TEXT}")
  file(WRITE "${OUTPUT_DIR}/strict64-rejected-output.mlir" "unchanged\n")
  execute_process(COMMAND "${LOWERER}" "${OUTPUT_DIR}/strict64-rejected-${KIND}.mlir" "${OUTPUT_DIR}/strict64-rejected-output.mlir"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/strict64-rejected-output.mlir" RESULT)
  if(NOT STATUS EQUAL 1 OR NOT ERROR MATCHES "${DIAGNOSTIC}" OR NOT RESULT STREQUAL "unchanged\n")
    message(FATAL_ERROR "Unsupported CPU arithmetic was not rejected transactionally: ${KIND} ${STATUS} ${ERROR}")
  endif()
endforeach()
# The established GPU/binary32 API must continue rejecting binary64.
file(WRITE "${OUTPUT_DIR}/strict64-gpu-rejected-output.mlir" "unchanged\n")
execute_process(COMMAND "${GPU_LOWERER}" "${FIXTURE}" "${OUTPUT_DIR}/strict64-gpu-rejected-output.mlir"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
file(READ "${OUTPUT_DIR}/strict64-gpu-rejected-output.mlir" RESULT)
if(NOT STATUS EQUAL 1 OR NOT ERROR MATCHES "supports only scalar float32 add/" OR NOT RESULT STREQUAL "unchanged\n")
  message(FATAL_ERROR "Binary64 was exposed to the GPU lowering: ${STATUS} ${ERROR}")
endif()
message(STATUS "Strict CPU binary64 integer artifacts and unsupported-format/device gates passed")

file(MAKE_DIRECTORY "${OUTPUT_DIR}/integer-minmax")
set(BASE "${OUTPUT_DIR}/integer-minmax/probe")
set(OPS "")
foreach(WIDTH IN ITEMS 32 64)
  string(APPEND OPS "    %a${WIDTH} = spirv.Constant -1 : i${WIDTH}\n    %b${WIDTH} = spirv.Constant 1 : i${WIDTH}\n")
  foreach(OP IN ITEMS SMax SMin UMax UMin)
    string(APPEND OPS "    %${OP}${WIDTH} = spirv.GL.${OP} %a${WIDTH}, %b${WIDTH} : i${WIDTH}\n")
  endforeach()
endforeach()
file(WRITE "${BASE}.mlir" "module {\n  spirv.module @probe Logical GLSL450 requires #spirv.vce<v1.0, [Shader, Int64], []> {\n    spirv.func @main() \"None\" {\n${OPS}    spirv.Return\n    }\n    spirv.EntryPoint \"GLCompute\" @main\n    spirv.ExecutionMode @main \"LocalSize\", 1, 1, 1\n  }\n}\n")
foreach(ROUNDING_MODE IN ITEMS decorated metal)
  set(OPTIONS)
  if(ROUNDING_MODE STREQUAL metal)
    set(OPTIONS --metal-compiler-rounding)
  endif()
  execute_process(COMMAND "${EXTRACTOR}" "${BASE}.mlir" "${BASE}-${ROUNDING_MODE}.mlir" ${OPTIONS}
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "Integer min/max extraction failed: ${ERROR}")
  endif()
  file(READ "${BASE}-${ROUNDING_MODE}.mlir" IR)
  foreach(OP IN ITEMS SMax SMin UMax UMin)
    if(NOT IR MATCHES "spirv.GL.${OP} [^\n]* : i32")
      message(FATAL_ERROR "Extraction changed supported 32-bit ${OP}")
    endif()
    if(ROUNDING_MODE STREQUAL metal AND IR MATCHES "spirv.GL.${OP} [^\n]* : i64")
      message(FATAL_ERROR "Metal extraction retained unsupported 64-bit ${OP}")
    elseif(ROUNDING_MODE STREQUAL decorated AND NOT IR MATCHES "spirv.GL.${OP} [^\n]* : i64")
      message(FATAL_ERROR "Decorated extraction unexpectedly changed 64-bit ${OP}")
    endif()
  endforeach()
  if(ROUNDING_MODE STREQUAL metal)
    foreach(OP IN ITEMS SGreaterThan SLessThan UGreaterThan ULessThan)
      if(NOT IR MATCHES "spirv.${OP}")
        message(FATAL_ERROR "Missing exact signed/unsigned comparison: ${OP}")
      endif()
    endforeach()
  endif()
  execute_process(COMMAND "${TRANSLATE}" --no-implicit-module --serialize-spirv
    "${BASE}-${ROUNDING_MODE}.mlir" -o "${BASE}-${ROUNDING_MODE}.spv" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "Normalized integer SPIR-V serialization failed: ${ERROR}")
  endif()
  execute_process(COMMAND "${VALIDATOR}" --target-env vulkan1.0 "${BASE}-${ROUNDING_MODE}.spv"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "Normalized integer SPIR-V validation failed: ${ERROR}")
  endif()
endforeach()

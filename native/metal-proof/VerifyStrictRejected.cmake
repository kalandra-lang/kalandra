foreach(KIND IN ITEMS remf add64 vector neg64 negvector)
  if(KIND STREQUAL "remf")
    set(TYPE f32)
    set(OP arith.remf)
  elseif(KIND STREQUAL "add64")
    set(TYPE f64)
    set(OP arith.addf)
  elseif(KIND STREQUAL "neg64")
    set(TYPE f64)
    set(OP arith.negf)
  elseif(KIND STREQUAL "negvector")
    set(TYPE "vector<2xf32>")
    set(OP arith.negf)
  else()
    set(TYPE "vector<2xf32>")
    set(OP arith.mulf)
  endif()
  set(OPERANDS "%x, %y")
  if(OP STREQUAL "arith.negf")
    set(OPERANDS "%x")
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-strict-${KIND}.mlir" "module { func.func @bad(%x: ${TYPE}, %y: ${TYPE}) -> ${TYPE} { %r = ${OP} ${OPERANDS} : ${TYPE} return %r : ${TYPE} } }\n")
  file(WRITE "${OUTPUT_DIR}/invalid-strict-output.mlir" "unchanged\n")
  execute_process(COMMAND "${LOWERER}" "${OUTPUT_DIR}/invalid-strict-${KIND}.mlir" "${OUTPUT_DIR}/invalid-strict-output.mlir"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/invalid-strict-output.mlir" RESULT)
  if(NOT STATUS EQUAL 1 OR NOT ERROR MATCHES "supports only scalar float32 add/subtract/multiply/divide/negate" OR NOT RESULT STREQUAL "unchanged\n")
    message(FATAL_ERROR "Unsupported arithmetic was not rejected transactionally: ${STATUS} ${ERROR}")
  endif()
endforeach()

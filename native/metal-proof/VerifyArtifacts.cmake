foreach(ROUNDING_POLICY IN ITEMS decorated compiler-rounding)
  file(READ "${OUTPUT_DIR}/${ROUNDING_POLICY}.reflection.json" REFLECTION)
  string(JSON ENTRY GET "${REFLECTION}" entryPoints 0 name)
  string(JSON WIDTH GET "${REFLECTION}" entryPoints 0 workgroup_size 0)
  string(JSON BUFFERS LENGTH "${REFLECTION}" ssbos)
  if(NOT ENTRY STREQUAL "multiply_add" OR NOT WIDTH EQUAL 64 OR NOT BUFFERS EQUAL 4)
    message(FATAL_ERROR "Unexpected reflected entry point or interface")
  endif()
  foreach(INDEX RANGE 0 3)
    string(JSON BINDING GET "${REFLECTION}" ssbos ${INDEX} binding)
    string(JSON SET GET "${REFLECTION}" ssbos ${INDEX} set)
    string(JSON SIZE GET "${REFLECTION}" ssbos ${INDEX} block_size)
    if(INDEX EQUAL 3)
      set(EXPECTED_SIZE 4)
    else()
      set(EXPECTED_SIZE 16384)
    endif()
    if(NOT BINDING EQUAL INDEX OR NOT SET EQUAL 0 OR NOT SIZE EQUAL EXPECTED_SIZE)
      message(FATAL_ERROR "Unexpected reflected buffer layout")
    endif()
  endforeach()
  file(READ "${OUTPUT_DIR}/${ROUNDING_POLICY}.spvasm" SPIRV)
  if(NOT SPIRV MATCHES "OpFMul" OR NOT SPIRV MATCHES "OpFAdd" OR SPIRV MATCHES "FPFastMathMode")
    message(FATAL_ERROR "Unexpected floating-point instructions/flags")
  endif()
  string(REGEX MATCHALL "NoContraction" DECORATIONS "${SPIRV}")
  list(LENGTH DECORATIONS COUNT)
  if(ROUNDING_POLICY STREQUAL "decorated" AND NOT COUNT EQUAL 2)
    message(FATAL_ERROR "Separate-rounding decorations lost")
  elseif(ROUNDING_POLICY STREQUAL "compiler-rounding" AND NOT COUNT EQUAL 0)
    message(FATAL_ERROR "Compiler-controlled diagnostic unexpectedly decorated")
  endif()
  file(READ "${OUTPUT_DIR}/${ROUNDING_POLICY}.metal" MSL)
  foreach(INDEX RANGE 0 3)
    string(FIND "${MSL}" "[[buffer(${INDEX})]]" POSITION)
    if(POSITION EQUAL -1)
      message(FATAL_ERROR "Metal buffer mapping changed")
    endif()
  endforeach()
endforeach()
message(STATUS "SPIR-V arithmetic, decorations, and reflected Metal buffer interface verified")

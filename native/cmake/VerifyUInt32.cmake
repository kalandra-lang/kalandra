include("${CMAKE_CURRENT_LIST_DIR}/UnsignedScalarType.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(EXTRA)
set(FLAGS -O0)
if(VARIANT STREQUAL "optimized")
  set(EXTRA -O2)
  set(FLAGS -O2)
elseif(VARIANT STREQUAL "sanitized")
  set(EXTRA --sanitize)
  set(FLAGS -O1 -fsanitize=address,undefined -fno-sanitize-recover=all)
elseif(VARIANT STREQUAL "thread-sanitized")
  set(EXTRA --thread-sanitize)
  set(FLAGS -O1 -fsanitize=thread)
endif()
function(RUN_OK)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "0" OR NOT ERR STREQUAL "")
    message(FATAL_ERROR "Failed: ${ARGN}: ${STATUS}: ${OUT}${ERR}")
  endif()
  message(STATUS "${OUT}")
  set(OUTPUT "${OUT}" PARENT_SCOPE)
endfunction()
foreach(OP IN ITEMS add sub mul div rem neg pos)
  if(OP STREQUAL "add")
    set(EXPR "a + b")
  elseif(OP STREQUAL "sub")
    set(EXPR "a - b")
  elseif(OP STREQUAL "mul")
    set(EXPR "a * b")
  elseif(OP STREQUAL "div")
    set(EXPR "a / b")
  elseif(OP STREQUAL "rem")
    set(EXPR "a % b")
  elseif(OP STREQUAL "neg")
    set(EXPR "-a")
  else()
    set(EXPR "+a")
  endif()
  set(SOURCE "${OUTPUT_DIR}/${OP}.k")
  set(IR "${OUTPUT_DIR}/${OP}.ll")
  set(RAW_${OP} "fn operation(a:uint32,b:uint32) -> uint32:\n  ${EXPR}\nfn forward(a:uint32,b:uint32) -> uint32:\n  operation(a,b)\nfn main() -> uint32:\n  4294967295\n")
  WRITE_SOURCE("${SOURCE}" "${RAW_${OP}}")
  RUN_OK("${COMPILER}" "${SOURCE}" -o "${OUTPUT_DIR}/${OP}" --test-entry forward
    --emit-llvm "${IR}" --emit-mlir "${OUTPUT_DIR}/${OP}.mlir" ${EXTRA})
  RUN_OK("${OUTPUT_DIR}/${OP}")
  SPECIALIZE("4294967295\n" EXPECTED)
  if(NOT OUTPUT STREQUAL "${EXPECTED}")
    message(FATAL_ERROR "Integer CLI result lost precision")
  endif()
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DINTEGER_BITS=${INTEGER_BITS}" "${HARNESS_SOURCE}" "${IR}" "${RUNTIME}" -o "${OUTPUT_DIR}/${OP}-harness")
  RUN_OK("${OUTPUT_DIR}/${OP}-harness" "${OP}")
  if(INTEGER_BITS EQUAL 64 AND (OP STREQUAL "div" OR OP STREQUAL "rem"))
    file(READ "${OUTPUT_DIR}/${OP}.mlir" MLIR)
    if(MLIR MATCHES "i128" OR NOT MLIR MATCHES "arith[.](divui|remui)")
      message(FATAL_ERROR "UInt64 division/remainder must use guarded native-width unsigned arithmetic")
    endif()
  endif()
endforeach()
function(COMPILE NAME SOURCE)
  WRITE_SOURCE("${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  RUN_OK("${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/${NAME}.mlir" ${EXTRA})
endfunction()
function(VERIFY NAME EXPECTED)
  SPECIALIZE("${EXPECTED}" EXPECTED)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" STREQUAL "0" OR NOT OUT STREQUAL "${EXPECTED}\n" OR NOT ERR STREQUAL "")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT}${ERR}; expected ${EXPECTED}")
    endif()
  endforeach()
endfunction()
foreach(OP IN ITEMS add sub mul div rem neg pos)
  if(OP STREQUAL "add")
    set(INPUT "2147483648,1")
    set(EXPECTED 2147483649)
  elseif(OP STREQUAL "sub")
    set(INPUT "4294967295,2147483648")
    set(EXPECTED 2147483647)
  elseif(OP STREQUAL "mul")
    set(INPUT "65535,65537")
    set(EXPECTED 4294967295)
  elseif(OP STREQUAL "div")
    set(INPUT "4294967295,2")
    set(EXPECTED 2147483647)
  elseif(OP STREQUAL "rem")
    set(INPUT "4294967295,2147483648")
    set(EXPECTED 2147483647)
  elseif(OP STREQUAL "neg")
    set(INPUT "0,0")
    set(EXPECTED 0)
  else()
    set(INPUT "4294967295,0")
    set(EXPECTED 4294967295)
  endif()
  set(SOURCE "${RAW_${OP}}")
  string(REPLACE "fn main() -> uint32:\n  4294967295\n"
    "fn main() -> uint32 ! TaskError:\n  try parallel:\n    try await spawn forward(${INPUT})\n" SOURCE "${SOURCE}")
  COMPILE("${OP}-task" "${SOURCE}")
  VERIFY("${OP}-task" "${EXPECTED}")
endforeach()
set(PREFIX "fn signed(value:int32) -> int32:\n  value\nfn real(value:float32) -> float32:\n  value\nfn combine(value:uint32,integer:int32,real:float32,values:Tensor[float32,?]) -> uint32:\n  reduceSum(values)\n  integer + 1\n  real + 1\n  value\nfn identity(value:uint32) -> uint32:\n  value\nfn nested(value:uint32) -> uint32 ! TaskError:\n  try parallel:\n    work = spawn identity(value)\n    first = try await work\n    again = try await work\n    first + (again - first)\n")
set(BODY "  values:Tensor[float32,3] = tensor([1,2,3])\n  try parallel:\n    integer = spawn signed(-1)\n    real = spawn real(1.5)\n    i = try await integer\n    f = try await real\n    work = spawn combine(4294967295,i,f,values)\n    first = try await work\n    again = try await work\n    child = spawn nested(first + (again - first))\n    answer = try await child\n")
COMPILE(mixed "${PREFIX}fn main() -> uint32 ! TaskError:\n${BODY}    answer\n")
VERIFY(mixed 4294967295)
COMPILE(mixed-signed "${PREFIX}fn main() -> int32 ! TaskError:\n${BODY}    i\n")
VERIFY(mixed-signed -1)
COMPILE(mixed-float "${PREFIX}fn main() -> float32 ! TaskError:\n${BODY}    f\n")
VERIFY(mixed-float 1.5)
file(READ "${OUTPUT_DIR}/mixed.ll" MIXED)
foreach(LAYOUT IN ITEMS "value.layout.scalar.${NUMERIC_TYPE}" "value.layout.scalar.int32" "value[.]layout[.]scalar =")
  if(NOT MIXED MATCHES "${LAYOUT}")
    message(FATAL_ERROR "Mixed unsigned/signed/float task result identity lost: ${LAYOUT}")
  endif()
endforeach()
foreach(OP IN ITEMS add sub mul div rem neg)
  if(OP STREQUAL "add")
    set(EXPR "a + b")
    set(INPUT "4294967295,1")
  elseif(OP STREQUAL "sub")
    set(EXPR "a - b")
    set(INPUT "0,1")
  elseif(OP STREQUAL "mul")
    set(EXPR "a * b")
    set(INPUT "4294967295,4294967295")
  elseif(OP STREQUAL "div")
    set(EXPR "a / b")
    set(INPUT "4294967295,0")
  elseif(OP STREQUAL "rem")
    set(EXPR "a % b")
    set(INPUT "4294967295,0")
  else()
    set(EXPR "-a")
    set(INPUT "1,0")
  endif()
  set(FUNCTIONS "fn operation(a:uint32,b:uint32) -> uint32:\n  ${EXPR}\nfn sibling(values:Tensor[float32,?]) -> Tensor[float32,?]:\n  values + 1\nfn batch(a:uint32,b:uint32,values:Tensor[float32,?]) -> uint32 ! TaskError:\n  try parallel:\n    other = spawn sibling(values)\n    work = spawn operation(a,b)\n    value = try await work\n    try await other\n    value\n")
  COMPILE("${OP}-recovered" "${FUNCTIONS}fn main() -> uint32 ! TaskError:\n  values:Tensor[float32,3] = tensor([1,2,3])\n  outcome = batch(${INPUT},values)\n  recovered = outcome catch fn(error):\n    match error:\n      TaskError.Fault {kind:cause,message:detail}:\n        match cause:\n          FaultKind.Arithmetic: 4294967295\n          _: 0\n      _: 0\n  try parallel:\n    other = spawn sibling(values)\n    try await other\n    recovered\n")
  VERIFY("${OP}-recovered" 4294967295)
  COMPILE("${OP}-fault" "${FUNCTIONS}fn main() -> uint32 ! TaskError:\n  values:Tensor[float32,3] = tensor([1,2,3])\n  try batch(${INPUT},values)\n")
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${OP}-fault"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" STREQUAL "88" OR NOT OUT STREQUAL "" OR
       NOT ERR MATCHES "TaskError.Fault at source 2:3" OR NOT ERR MATCHES "cleanup: live=0")
      message(FATAL_ERROR "Unsigned ${OP} task fault/source/cleanup: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()
COMPILE(sync-fault "fn divide(a:uint32,b:uint32) -> uint32:\n  a / b\nfn main() -> uint32:\n  divide(4294967295,0)\n")
execute_process(COMMAND "${OUTPUT_DIR}/sync-fault" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "86" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 2:3")
  message(FATAL_ERROR "Unsigned synchronous CLI fault: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(INVALID IN ITEMS 0 65 invalid)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${INVALID}"
    KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/mixed"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "88" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "TaskError.AdmissionRejected" OR NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Unsigned root admission/cleanup: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
foreach(WORKERS IN ITEMS 1 2 4)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
    KALANDRA_TEST_FAIL_ALLOC_AT=1 KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/mixed"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "86" OR NOT ERR MATCHES "AllocationFault" OR NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Unsigned root allocation/cleanup: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
# Static rejection must preserve existing output artifacts.
WRITE_SOURCE("${OUTPUT_DIR}/invalid.k" "fn main() -> uint32:\n  4294967295 * 4294967295\n")
file(WRITE "${OUTPUT_DIR}/preserved" "existing output")
file(WRITE "${OUTPUT_DIR}/preserved.ll" "existing IR")
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid.k" -o "${OUTPUT_DIR}/preserved"
  --emit-llvm "${OUTPUT_DIR}/preserved.ll" ${EXTRA} RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
file(READ "${OUTPUT_DIR}/preserved" OLD_EXE)
file(READ "${OUTPUT_DIR}/preserved.ll" OLD_IR)
if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "S052" OR NOT OLD_EXE STREQUAL "existing output" OR NOT OLD_IR STREQUAL "existing IR")
  message(FATAL_ERROR "Invalid unsigned constants published artifacts: ${STATUS}: ${ERR}")
endif()
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/mixed.k" --target metal
  -o "${OUTPUT_DIR}/unsupported-metal" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "${NUMERIC_TYPE}" OR EXISTS "${OUTPUT_DIR}/unsupported-metal")
  message(FATAL_ERROR "Metal unsigned arithmetic accidentally enabled: ${STATUS}: ${ERR}")
endif()
message(STATUS "Checked CPU ${NUMERIC_TYPE} scalars: unsigned runtime arithmetic, exact CLI values, mixed task layouts, nested/cached workers, Arithmetic recovery, admission/allocation cleanup and strict target gates passed")

if(INTEGER_BITS EQUAL 64)
  set(PREFIX "fn wideUnsigned(a:uint64,b:int64,c:uint32,d:int32,e:float32) -> uint64:\n  a\nfn wideSigned(a:uint64,b:int64,c:uint32,d:int32,e:float32) -> int64:\n  b\nfn narrowUnsigned(a:uint64,b:int64,c:uint32,d:int32,e:float32) -> uint32:\n  c\nfn narrowSigned(a:uint64,b:int64,c:uint32,d:int32,e:float32) -> int32:\n  d\nfn real(a:uint64,b:int64,c:uint32,d:int32,e:float32) -> float32:\n  e\n")
  foreach(ROOT IN ITEMS wideUnsigned wideSigned narrowUnsigned narrowSigned real)
    if(ROOT STREQUAL "wideUnsigned")
      set(TYPE uint64)
      set(EXPECTED 18446744073709551615)
      set(RETURN a)
    elseif(ROOT STREQUAL "wideSigned")
      set(TYPE int64)
      set(EXPECTED -9223372036854775808)
      set(RETURN b)
    elseif(ROOT STREQUAL "narrowUnsigned")
      set(TYPE uint32)
      set(EXPECTED 4294967295)
      set(RETURN c)
    elseif(ROOT STREQUAL "narrowSigned")
      set(TYPE int32)
      set(EXPECTED -2147483648)
      set(RETURN d)
    else()
      set(TYPE float32)
      set(EXPECTED 1.5)
      set(RETURN e)
    endif()
    set(SOURCE "${PREFIX}fn main() -> ${TYPE} ! TaskError:\n  try parallel:\n    wa = spawn wideUnsigned(18446744073709551615,-9223372036854775808,4294967295,-2147483648,1.5)\n    wb = spawn wideSigned(18446744073709551615,-9223372036854775808,4294967295,-2147483648,1.5)\n    wc = spawn narrowUnsigned(18446744073709551615,-9223372036854775808,4294967295,-2147483648,1.5)\n    wd = spawn narrowSigned(18446744073709551615,-9223372036854775808,4294967295,-2147483648,1.5)\n    we = spawn real(18446744073709551615,-9223372036854775808,4294967295,-2147483648,1.5)\n    a = try await wa\n    b = try await wb\n    c = try await wc\n    d = try await wd\n    e = try await we\n    ${RETURN}\n")
    # Preserve intentionally mixed widths; specialize neither the source nor expected value.
    file(WRITE "${OUTPUT_DIR}/families-${ROOT}.k" "${SOURCE}")
    RUN_OK("${COMPILER}" "${OUTPUT_DIR}/families-${ROOT}.k" -o "${OUTPUT_DIR}/families-${ROOT}"
      --emit-llvm "${OUTPUT_DIR}/families-${ROOT}.ll" --emit-mlir "${OUTPUT_DIR}/families-${ROOT}.mlir" ${EXTRA})
    foreach(WORKERS IN ITEMS 1 2 4)
      RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/families-${ROOT}")
      if(NOT OUTPUT STREQUAL "${EXPECTED}\n")
        message(FATAL_ERROR "Five scalar families ${ROOT}/${WORKERS}: ${OUTPUT}; expected ${EXPECTED}")
      endif()
    endforeach()
  endforeach()
  file(READ "${OUTPUT_DIR}/families-wideUnsigned.ll" IR)
  foreach(TYPE IN ITEMS uint64 int64 uint32 int32)
    if(NOT IR MATCHES "value.layout.scalar.${TYPE}" OR NOT IR MATCHES "result.scalar.${TYPE}")
      message(FATAL_ERROR "Five scalar families lost ${TYPE} layout identity")
    endif()
  endforeach()
  message(STATUS "UInt64/int64/uint32/int32/float32 mixed captures and all five root types passed")
endif()

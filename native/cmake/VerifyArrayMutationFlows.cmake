set(CASES readonly locked captured string record function tensor rhs-branch)
foreach(CASE IN LISTS CASES)
  if(CASE STREQUAL "readonly")
    set(SOURCE "fn put(a:[int])->int:\n  a[0]=9\n  0\nfn main()->int:\n  0\n")
    set(CODE S077)
  elseif(CASE STREQUAL "locked")
    set(SOURCE "fn read(a:[int])->int:\n  a[0]\nfn main()->int ! TaskError:\n  a=[1,2]\n  b=a\n  try parallel:\n    t=spawn read(a)\n    b[0]=9\n    try await t\n")
    set(CODE S077)
  elseif(CASE STREQUAL "captured")
    set(SOURCE "fn main()->int:\n  a=[1,2]\n  f=fn()->int:\n    a[0]=9\n    a[0]\n  f()\n")
    set(CODE S077)
  elseif(CASE STREQUAL "string")
    set(SOURCE "fn main()->int:\n  a=[\"a\",\"b\"]\n  a[0]=\"c\"\n  length(a)\n")
    set(CODE S078)
  elseif(CASE STREQUAL "record")
    set(SOURCE "type Box:\n  value:int\nfn main()->int:\n  a=[Box {value:1}]\n  a[0]=Box {value:2}\n  0\n")
    set(CODE S078)
  elseif(CASE STREQUAL "function")
    set(SOURCE "fn main()->int:\n  a=[fn(x:int):x]\n  a[0]=fn(x:int):x+1\n  0\n")
    set(CODE S078)
  elseif(CASE STREQUAL "tensor")
    set(SOURCE "fn main()->int:\n  a=tensor([1,2])\n  a[0]=9\n  0\n")
    set(CODE S078)
  else()
    set(SOURCE "fn read(a:[int])->int:\n  a[0]\nfn run(flag:Bool)->int ! TaskError:\n  a=[1,2]\n  try parallel:\n    t=spawn read(a)\n    a[0]=if flag:try await t\n    else:9\n    try await t\nfn main()->int:\n  0\n")
    set(CODE S077)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-store-${CASE}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/preserved-store" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-store-${CASE}.k" -o "${OUTPUT_DIR}/preserved-store"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved-store" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Store rejection/artifact preservation failed (${CASE}): ${STATUS}: ${ERR}")
  endif()
endforeach()

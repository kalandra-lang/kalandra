include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES "type Box:\n  cause:Mixed\ntype Both=A | B\ntype Mixed=Both | TaskError\nerror A:\n  Bad:\n    text:String\n    values:[int]\nerror B:\n  Missing\n")
set(FUNCTIONS "fn divide(value:int)->int:\n  8/value\nfn legacy(value:int)->int ! TaskError:\n  try parallel:\n    try await spawn divide(value)\nfn failed(mode:int)->Box ! Mixed:\n  if mode==0:fail A.Bad {text:\"é\"+\"🙂\",values:[20,22]}\n  if mode==1:fail B.Missing\n  value=try legacy(mode-2)\n  fail B.Missing\nfn make(mode:int)->Box:\n  failed(mode) catch fn(error):Box {cause:error}\nfn echo(box:Box)->Box:\n  box\nfn score(box:Box)->int:\n  match box.cause:\n    A.Bad {text,values}:length(text)+values[0]+values[1]\n    B.Missing:7\n    TaskError.Fault {kind,message}:\n      match kind:\n        FaultKind.Arithmetic:100+length(message)\n        _:900\n    _:800\n")
COMPILE(record "${TYPES}${FUNCTIONS}fn main()->[int]:\n  [score(echo(make(0))),score(echo(make(1))),score(echo(make(2)))]\n")
EXPECT(record "[44, 7, 124]")
COMPILE(cached "${TYPES}${FUNCTIONS}fn work(mode:int)->Box ! TaskError:\n  try parallel:\n    job=spawn echo(make(mode))\n    first=try await job\n    second=try await job\n    second\nfn main()->[int] ! TaskError:\n  [score(try work(0)),score(try work(1)),score(try work(2))]\n")
foreach(WORKERS IN ITEMS 1 2 4)
  RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/cached")
  if(NOT OUTPUT STREQUAL "[44, 7, 124]\n")
    message(FATAL_ERROR "Error payload fields changed across workers: ${OUTPUT}")
  endif()
endforeach()
COMPILE(enum "${TYPES}${FUNCTIONS}enum Envelope:\n  Empty\n  Wrapped:\n    cause:Mixed\nfn echoEnvelope(value:Envelope)->Envelope:\n  value\nfn scoreEnvelope(value:Envelope)->int:\n  match value:\n    Envelope.Empty:5\n    Envelope.Wrapped {cause}:score(Box {cause:cause})\nfn work(mode:int)->Envelope ! TaskError:\n  try parallel:\n    try await spawn echoEnvelope(Envelope.Wrapped {cause:make(mode).cause})\nfn main()->[int] ! TaskError:\n  [scoreEnvelope(Envelope.Empty),scoreEnvelope(try work(0)),scoreEnvelope(try work(2))]\n")
EXPECT(enum "[5, 44, 124]")
COMPILE(nested "${TYPES}${FUNCTIONS}type Outer:\n  rows:[Box]\nfn echoOuter(value:Outer)->Outer:\n  value\nfn work()->Outer ! TaskError:\n  try parallel:\n    try await spawn echoOuter(Outer {rows:[make(0),make(1),make(2)]})\nfn main()->[int] ! TaskError:\n  result=try work()\n  [score(result.rows[0]),score(result.rows[1]),score(result.rows[2])]\n")
EXPECT(nested "[44, 7, 124]")
COMPILE(direct-array "${TYPES}${FUNCTIONS}type Many:\n  causes:[Mixed]\nfn echoMany(value:Many)->Many:\n  value\nfn main()->[int] ! TaskError:\n  result=try parallel:\n    try await spawn echoMany(Many {causes:[make(0).cause,make(2).cause]})\n  [score(Box {cause:result.causes[0]}),score(Box {cause:result.causes[1]})]\n")
EXPECT(direct-array "[44, 124]")
COMPILE(single "type Box:\n  cause:Alias\ntype Alias=A\nerror A:\n  Bad:\n    value:int\nfn echo(value:Box)->Box:\n  value\nfn main()->int ! TaskError:\n  value=try parallel:\n    try await spawn echo(Box {cause:A.Bad {value:42}})\n  match value.cause:\n    A.Bad {value}:value\n")
EXPECT(single 42)
COMPILE(error-wrap "${TYPES}${FUNCTIONS}error WrapperError:\n  Wrapped:\n    cause:Mixed\nfn wrap(mode:int)->int ! WrapperError:\n  fail WrapperError.Wrapped {cause:make(mode).cause}\nfn work(mode:int)->int ! (WrapperError | TaskError):\n  try parallel:\n    try await spawn wrap(mode)\nfn recover(mode:int)->int:\n  work(mode) catch fn(error):\n    match error:\n      WrapperError.Wrapped {cause}:score(Box {cause:cause})\n      _:0\nfn main()->[int]:\n  [recover(0),recover(1),recover(2)]\n")
EXPECT(error-wrap "[44, 7, 124]")
COMPILE(update "${TYPES}${FUNCTIONS}fn work(value:Box)->Box:\n  value with {cause:make(2).cause}\nfn main()->[int] ! TaskError:\n  original=make(0)\n  changed=try parallel:\n    try await spawn work(original)\n  [score(original),score(changed)]\n")
EXPECT(update "[44, 124]")
set(TASK "type Box:\n  cause:Only\ntype Only=TaskError | TaskError\nfn divide(value:int)->int:\n  8/value\nfn seed()->int ! TaskError:\n  try parallel:\n    try await spawn divide(0)\nfn produce(error:Only)->Box ! TaskError:\n  ignored=try seed()\n  fail error\nfn make(error:Only)->Box:\n  produce(error) catch fn(cause):Box {cause:cause}\nfn echo(value:Box)->Box:\n  value\nfn score(value:Box)->int:\n  match value.cause:\n    TaskError.Fault {kind,message}:\n      match kind:\n        FaultKind.Arithmetic:100+length(message)\n        _:900\n    _:800\nfn run()->int ! TaskError:\n  seed() catch fn(error):\n    value=try parallel:\n      try await spawn echo(make(error))\n    score(value)\n")
COMPILE(task-only "${TASK}fn main()->int ! TaskError:\n  try run()\n")
EXPECT(task-only 124)
string(REPLACE "cause:Only" "cause:TaskError" DIRECT_TASK "${TASK}")
COMPILE(direct-task "${DIRECT_TASK}fn main()->int ! TaskError:\n  try run()\n")
EXPECT(direct-task 124)
# Enum inactive fields may contain the zero-initialized absent TaskError slot.
COMPILE(task-enum "${TASK}enum Envelope:\n  Empty\n  Wrapped:\n    cause:Only\nfn echoEnvelope(value:Envelope)->Envelope:\n  value\nfn main()->int ! TaskError:\n  value=try parallel:\n    try await spawn echoEnvelope(Envelope.Empty)\n  match value:\n    Envelope.Empty:42\n    Envelope.Wrapped {cause}:score(Box {cause:cause})\n")
EXPECT(task-enum 42)
COMPILE(task-enum-value "${TASK}enum Envelope:\n  Empty\n  Wrapped:\n    cause:Only\nfn echoEnvelope(value:Envelope)->Envelope:\n  value\nfn wrapped(error:Only)->int ! TaskError:\n  value=try parallel:\n    try await spawn echoEnvelope(Envelope.Wrapped {cause:error})\n  match value:\n    Envelope.Empty:0\n    Envelope.Wrapped {cause}:score(Box {cause:cause})\nfn main()->int ! TaskError:\n  seed() catch fn(error):try wrapped(error)\n")
EXPECT(task-enum-value 124)

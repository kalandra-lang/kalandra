# Cross-file re-exported aliases resolve before their users' field layouts.
file(MAKE_DIRECTORY "${OUTPUT_DIR}/modules")
file(WRITE "${OUTPUT_DIR}/modules/errors.k" "export error A:\n  Bad:\n    text:String\nexport error B:\n  Missing\nexport type Errors=A | B\n")
file(WRITE "${OUTPUT_DIR}/modules/public.k" "export from \"./errors.k\" import Errors as PublicError, A, B\n")
COMPILE(import "from \"./modules/public.k\" import PublicError, A, B\ntype Box:\n  cause:PublicError\nfn failer()->Box ! PublicError:\n  fail A.Bad {text:\"é\"+\"🙂\"}\nfn make()->Box:\n  failer() catch fn(error):Box {cause:error}\nfn main()->int:\n  match make().cause:\n    A.Bad {text}:length(text)\n    B.Missing:0\n")
EXPECT(import 2)
foreach(NAME IN ITEMS cached nested error-wrap)
  foreach(ATTEMPT RANGE 1 24)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Error payload cleanup failed: ${NAME} ${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()
set(RAW "type Box:\n  cause:Only\ntype Only=TaskError\nfn echo(value:Box)->Box:\n  value\nfn main()->int:\n  0\n")
foreach(MODE IN ITEMS task pure)
  if(MODE STREQUAL "task")
    set(EXTRA_SOURCE "fn identity(value:int)->int:\n  value\nfn marker()->int ! TaskError:\n  try parallel:\n    try await spawn identity(1)\n")
    set(DEFINITION)
  else()
    set(EXTRA_SOURCE)
    set(DEFINITION -DKALANDRA_ERROR_PAYLOAD_PURE)
  endif()
  COMPILE("raw-${MODE}" "${RAW}${EXTRA_SOURCE}" --test-entry echo)
  if(MODE STREQUAL "pure")
    # MLIR's literal-aggregate arguments use an internal LLVM calling convention.
    # A pointer-only test shim avoids pretending that it is a public C ABI.
    file(APPEND "${OUTPUT_DIR}/raw-pure.ll" "\ndefine void @kalandra_payload_probe(ptr %out, ptr %input, ptr %ctx) {\n  %value = load { { i32, i64, i64, i64 } }, ptr %input\n  call void @_mlir_ciface_kalandra_test_entry(ptr %out, { { i32, i64, i64, i64 } } %value, ptr %ctx)\n  ret void\n}\n")
  endif()
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} ${DEFINITION} "${SOURCE_DIR}/tests/ErrorPayloadFieldsRuntimeTests.cpp" "${OUTPUT_DIR}/raw-${MODE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/raw-${MODE}-harness")
  RUN_OK("${OUTPUT_DIR}/raw-${MODE}-harness")
endforeach()

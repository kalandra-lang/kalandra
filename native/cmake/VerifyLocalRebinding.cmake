include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
foreach(TYPE IN ITEMS i8 u8 i16 u16 i32 u32 i64 u64 f32 f64)
  COMPILE("scalar-${TYPE}" "fn step(value:${TYPE})->${TYPE}:\n  value=value+1\n  return value\nfn main()->${TYPE}:\n  a:${TYPE}=1\n  while a<4:\n    a=step(a)\n  return a\n")
  EXPECT("scalar-${TYPE}" 4)
endforeach()
COMPILE(branches "fn main()->i64:\n  i=0\n  total=0\n  while i<5:\n    if i<3:\n      total=total+i\n    else:\n      total=total+10\n    i=i+1\n  return total\n")
EXPECT(branches 23)
COMPILE(snapshot "fn main()->i64:\n  a=10\n  old=fn(x:i64):return a+x\n  a=20\n  return old(1)+a\n")
EXPECT(snapshot 31)
COMPILE(captured-local "fn main()->i64:\n  a=2\n  f=fn()->i64:\n    while a<4:\n      a=a+1\n    return a\n  a=10\n  return f()+f()+a\n")
EXPECT(captured-local 18)
COMPILE(nested "fn main()->i64:\n  i=0\n  total=0\n  while i<3:\n    j=0\n    while j<4:\n      total=total+i+j\n      j=j+1\n    i=i+1\n  return total\n")
EXPECT(nested 30)
COMPILE(tasks "fn identity(x:i64)->i64:\n  return x\nfn main()->i64 ! TaskError:\n  i=0\n  total=0\n  while i<2000:\n    try parallel:\n      old=spawn identity(i)\n      i=i+1\n      prior=try await old\n      total=total+prior\n      0\n  return total\n")
EXPECT(tasks 1999000)
COMPILE(closure-loop "fn main()->i64:\n  values=generate(8,fn(i):\n    total=0\n    while total<i: total=total+1\n    return total\n  )\n  return values[7]\n")
EXPECT(closure-loop 7)
COMPILE(cancellation "fn probe(n:i64,faultAt:i64)->i64:\n  i=0\n  total=0\n  while i<n:\n    if i==faultAt:\n      zero=0\n      total=total+1/zero\n    else:\n      total=(total+i)%1000003\n    i=i+1\n  return total\nfn main()->i64:\n  return 0\n" --test-entry probe)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/LocalRebindingRuntimeTests.cpp" "${OUTPUT_DIR}/cancellation.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/cancellation-harness")
RUN_OK("${OUTPUT_DIR}/cancellation-harness")
COMPILE(task-cancellation "type LoopResult:\n  value:i64\nfn identity(value:i64)->i64:\n  return value\nfn probe(n:i64)->LoopResult ! TaskError:\n  i=0\n  total=0\n  while i<n:\n    try parallel:\n      pending=spawn identity(i)\n      i=i+1\n      previous=try await pending\n      total=total+previous\n      0\n  return LoopResult {value:total}\nfn main()->i64:\n  return 0\n" --test-entry probe)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/LocalRebindingTaskTests.cpp" "${OUTPUT_DIR}/task-cancellation.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/task-cancellation-harness")
RUN_OK("${OUTPUT_DIR}/task-cancellation-harness")


file(MAKE_DIRECTORY "${OUTPUT_DIR}/src" "${OUTPUT_DIR}/examples")
set(MANIFEST "${OUTPUT_DIR}/kalandra.toml")
set(PUBLIC "${OUTPUT_DIR}/src/public.k")
file(WRITE "${MANIFEST}" "format=1\n[package]\nname='numerical'\nversion='0.1.0'\nentry='src/public.k'\n[project]\nentry='examples/main.k'\n")
file(WRITE "${PUBLIC}" "export fn libraryValue()->float32:\n  99\n")
file(WRITE "${OUTPUT_DIR}/examples/main.k" "fn shift(values:Tensor[float32,?])->Tensor[float32,?]:\n  values+1\nfn main()->float32 ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    values:Tensor[float32,3]=tensor([1,2,3])\n    resident=try await transfer(values,gpu)\n    changed=try await spawn shift(resident) on gpu\n    host=try await transfer(changed,devices.cpu())\n    reduceSum(host)\n")
execute_process(COMMAND "${COMPILER}" --project "${MANIFEST}" -o "${OUTPUT_DIR}/emitted"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT STATUS EQUAL 0 OR NOT EXISTS "${OUTPUT_DIR}/emitted/kernel0.mlir")
  message(FATAL_ERROR "Dual manifest Metal source emission failed: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(SOURCE IN ITEMS "${MANIFEST}" "${PUBLIC}")
  foreach(KIND IN ITEMS symlink hardlink)
    set(DESTINATION "${OUTPUT_DIR}/protected-${KIND}")
    file(MAKE_DIRECTORY "${DESTINATION}")
    file(REMOVE "${DESTINATION}/host.cpp")
    if(KIND STREQUAL "symlink")
      file(CREATE_LINK "${SOURCE}" "${DESTINATION}/host.cpp" SYMBOLIC)
    else()
      file(CREATE_LINK "${SOURCE}" "${DESTINATION}/host.cpp")
    endif()
    file(SHA256 "${SOURCE}" BEFORE)
    execute_process(COMMAND "${COMPILER}" --project "${MANIFEST}" -o "${DESTINATION}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    file(SHA256 "${SOURCE}" AFTER)
    if(STATUS EQUAL 0 OR NOT ERR MATCHES "source and output paths must be distinct" OR NOT BEFORE STREQUAL AFTER)
      message(FATAL_ERROR "Metal public/manifest source protection failed: ${KIND}: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(EXISTS "${DESTINATION}/placement.ir")
      message(FATAL_ERROR "Metal rejection published partial outputs")
    endif()
  endforeach()
endforeach()
message(STATUS "Dual manifest Metal source emission and public/manifest output protection passed; no GPU execution")

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
file(GLOB SOURCES "${SOURCE_DIR}/tests/fixtures/worker-named-functions/*.k")
foreach(PATH IN LISTS SOURCES)
  get_filename_component(NAME "${PATH}" NAME_WE)
  file(READ "${PATH}" TEXT)
  COMPILE("${NAME}" "${TEXT}")
  EXPECT("${NAME}" 42)
endforeach()
file(READ "${SOURCE_DIR}/../docs/design/fixtures/worker-named-functions.k" GUIDE)
COMPILE(guide "${GUIDE}")
EXPECT(guide 42)
foreach(TYPE IN ITEMS i8 u8 i16 u16 i32 u32 i64 u64 f32 f64)
  COMPILE("width-${TYPE}" "fn double(value:${TYPE})->${TYPE}:\n  return value*2\nfn apply(value:${TYPE},f:fn(${TYPE})->${TYPE})->${TYPE}:\n  return f(value)\nfn main()->${TYPE} ! TaskError:\n  return try parallel:\n    try await spawn apply(21,double)\n")
  EXPECT("width-${TYPE}" 42)
endforeach()
# Extend only the emitted private test artifact with aliases to trusted compiler
# entries/layouts. No product flag, public callback ABI or runtime registry API.
file(READ "${OUTPUT_DIR}/raw.ll" IR)
string(REGEX MATCH "define i64 @(kalandra_callable_[0-9]+)\\(" GOOD "${IR}")
set(GOOD_TARGET "${CMAKE_MATCH_1}")
string(REGEX MATCH "define double @(kalandra_callable_[0-9]+)\\(" WRONG "${IR}")
set(WRONG_TARGET "${CMAKE_MATCH_1}")
if(GOOD_TARGET STREQUAL "" OR WRONG_TARGET STREQUAL "")
  message(FATAL_ERROR "Private worker target fixture lost its typed entries")
endif()
file(APPEND "${OUTPUT_DIR}/raw.ll" "\n@kalandra_worker_test_entry = constant ptr @task.entry.2\n@kalandra_worker_test_layout = constant ptr @value.layout.function.reference.0\n@kalandra_worker_good_target = constant ptr @${GOOD_TARGET}\n@kalandra_worker_wrong_target = constant ptr @${WRONG_TARGET}\n")
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/WorkerNamedFunctionRuntimeTests.cpp" "${OUTPUT_DIR}/raw.ll" "${RUNTIME}"
  -o "${OUTPUT_DIR}/context-harness")
RUN_OK("${OUTPUT_DIR}/context-harness")
file(WRITE "${OUTPUT_DIR}/helper.k" "fn hidden(value:i64)->i64:\n  return value*2\nexport fn double(value:i64)->i64:\n  return hidden(value)\n")
COMPILE(imported "from \"./helper.k\" import double as twice\nfn apply(value:i64,transform:fn(i64)->i64)->i64:\n  return transform(value)\nfn main()->i64 ! TaskError:\n  return try parallel:\n    try await spawn apply(21,twice)\n")
EXPECT(imported 42)
foreach(WORKERS IN ITEMS 1 2 4)
  foreach(NAME IN ITEMS aliases same-target owned-error record array recursive coordinating-recipient factory-reference mixed-signatures zero-parameters)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}")
    if(NOT OUTPUT STREQUAL "42\n")
      message(FATAL_ERROR "Named function worker changed result: ${NAME}: ${OUTPUT}")
    endif()
  endforeach()
endforeach()
foreach(ATTEMPT RANGE 1 24)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
    KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/record"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
    message(FATAL_ERROR "Worker callable allocation probe failed: ${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
  endif()
  if("${STATUS}" STREQUAL "0")
    if(NOT OUT STREQUAL "42\n")
      message(FATAL_ERROR "Worker callable allocation probe changed success: ${OUT}${ERR}")
    endif()
  elseif(NOT OUT STREQUAL "")
    message(FATAL_ERROR "Failed worker callable published a result: ${OUT}${ERR}")
  endif()
  if(NOT "${STATUS}" STREQUAL "0")
    if(NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Worker callable allocation probe leaked storage: ${OUT}${ERR}")
    endif()
  endif()
endforeach()

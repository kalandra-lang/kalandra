include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES i32 u32 i64 u64 f32 f64)
set(IDENTITIES 2 6 3 7 8 9)
set(INDEX_TYPES i32 u32 i64 u64)
set(INDEX_IDS 2 6 3 7)
foreach(N RANGE 0 5)
  list(GET TYPES ${N} TYPE)
  list(GET IDENTITIES ${N} ID)
  foreach(I RANGE 0 3)
    list(GET INDEX_TYPES ${I} INDEX_TYPE)
    list(GET INDEX_IDS ${I} INDEX_ID)
    set(NAME "index-${TYPE}-${INDEX_TYPE}")
    COMPILE("${NAME}" "fn get(values:[${TYPE}],index:${INDEX_TYPE})->${TYPE}:\n  return values[index]\nfn main()->i64:\n  return 0\n" --test-entry get)
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "-DNUMERIC_TYPE=${ID}" "-DINDEX_TYPE=${INDEX_ID}" -isystem "${LLVM_ROOT}/include"
      "${SOURCE_DIR}/tests/ArrayIndexRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}"
      "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
    RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
  endforeach()
  set(SOURCE "fn get(values:[${TYPE}],index:i64)->${TYPE}:\n  return values[index]\nfn made()->[${TYPE}]:\n  return [${TYPE}(10),${TYPE}(20)]\nfn read(index:i64):\n  values=made()\n  mapped=map([${TYPE}(1),${TYPE}(2)],fn(x): return values[index]+x)\n  return mapped[1]\nfn inner(index:i64) ! TaskError:\n  return try parallel:\n    child=spawn read(index)\n    try await child\nfn probe() ! TaskError:\n  return try parallel:\n    a=spawn inner(1)\n    b=spawn made()\n    values=try await b\n    first=try await a\n    again=try await a\n    first+again-values[1]-${TYPE}(2)\nfn bad() ! TaskError:\n  return try parallel:\n    child=spawn get(made(),2)\n    try await child\nfn recover() ! TaskError:\n  attempt=bad()\n  return attempt catch fn(error):\n    return match error:\n      TaskError.Fault { kind: cause, message: detail }:\n        match cause:\n          FaultKind.Bounds: ${TYPE}(22)\n          FaultKind.Arithmetic: ${TYPE}(1)\n          FaultKind.Shape: ${TYPE}(2)\n          FaultKind.Allocation: ${TYPE}(3)\n          FaultKind.Native: ${TYPE}(4)\n      TaskError.Cancelled: ${TYPE}(5)\n      TaskError.DeadlineExceeded: ${TYPE}(6)\n      TaskError.AdmissionRejected { reason: why }: ${TYPE}(7)\nfn main()->${TYPE} ! TaskError:\n  return try probe()\n")
  if(TYPE STREQUAL "f32")
    set(EXPECTED 41b00000)
  elseif(TYPE STREQUAL "f64")
    set(EXPECTED 4036000000000000)
  else()
    set(EXPECTED 16)
  endif()
  foreach(KIND IN ITEMS probe bad recover)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "-DDESTINATION_TYPE=${ID}" -DEXPECTED_FAULT=5 "${SOURCE_DIR}/tests/ConversionTaskTests.cpp"
      "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  EXPECT("probe-${TYPE}" 22)
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" "${MODE}" 0)
    endforeach()
    RUN_OK("${OUTPUT_DIR}/bad-${TYPE}-harness" "${WORKERS}" 0 5 0)
    RUN_OK("${OUTPUT_DIR}/recover-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" 0 0)
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" 3 "${ATTEMPT}")
      if(WORKERS EQUAL 2)
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
          "${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" 3 0)
      endif()
    endforeach()
  endforeach()
  if(TYPE STREQUAL "i32")
    foreach(REPEAT RANGE 1 30)
      foreach(ATTEMPT IN ITEMS 3 4)
        RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" 4 "${EXPECTED}" 3 "${ATTEMPT}")
      endforeach()
    endforeach()
  endif()
endforeach()
COMPILE(precedence "fn make()->[i64]:\n  return [10,20,30]\nfn main():\n  return make()[1+1]*2+1\n")
EXPECT(precedence 61)
COMPILE(context "fn main()->f32:\n  return [1,2][1]\n")
EXPECT(context 2)
COMPILE(order "fn failing(value:i64)->i64:\n  return 1/value\nfn indexFault(value:i64)->i64:\n  return 2/value\nfn make(value:i64)->[i64]:\n  return [failing(value)]\nfn main():\n  return make(0)[indexFault(0)]\n")
execute_process(COMMAND "${OUTPUT_DIR}/order" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT ERR MATCHES "ArithmeticFault.*2:10")
  message(FATAL_ERROR "Index operand order lost first fault: ${STATUS}: ${ERR}")
endif()
COMPILE(bounds "fn get(values:[i64],index:i64):\n  return values[index]\nfn main():\n  return get([1,2],2)\n")
execute_process(COMMAND "${OUTPUT_DIR}/bounds" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT ERR MATCHES "BoundsFault.*2:3")
  message(FATAL_ERROR "Bounds CLI diagnostic lost: ${STATUS}: ${ERR}")
endif()
message(STATUS "Checked array indexing: 24 element/index pairs, exact reads and checked bounds, worker captures/nesting/recovery/cached awaits, cancellation, admission, allocation failure and immutable input passed")

COMPILE(index-order "fn failing(value:i64)->i64:\n  return 1/value\nfn indexFault(value:i64)->i64:\n  return 2/value\nfn make(value:i64)->[i64]:\n  return [failing(value)]\nfn main():\n  return make(1)[indexFault(0)]\n")
execute_process(COMMAND "${OUTPUT_DIR}/index-order" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT ERR MATCHES "ArithmeticFault.*4:10")
  message(FATAL_ERROR "Index expression fault was lost: ${STATUS}: ${ERR}")
endif()
foreach(KIND IN ITEMS bounds type mutation)
  if(KIND STREQUAL "bounds")
    set(INVALID "fn main():\n  return [1,2][2]\n")
    set(CODE S062)
  elseif(KIND STREQUAL "type")
    set(INVALID "fn main():\n  return [1,2][1.0]\n")
    set(CODE S061)
  else()
    set(INVALID "fn edit(values:[i64])->i64:\n  values[0]=3\n  return values[0]\nfn main()->i64:\n  return edit([1,2])\n")
    set(CODE S077)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${KIND}.k" "${INVALID}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${KIND}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Index diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()

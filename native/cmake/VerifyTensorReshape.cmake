include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
function(RAW TYPE ID INPUT_RANK OUTPUT_RANK KIND FIXED)
  set(INPUT "Tensor[${TYPE}")
  if(INPUT_RANK GREATER 0)
    math(EXPR LAST "${INPUT_RANK}-1")
    foreach(AXIS RANGE 0 ${LAST})
      string(APPEND INPUT ",?")
    endforeach()
  endif()
  string(APPEND INPUT "]")
  set(PARAMS)
  set(SHAPE)
  if(OUTPUT_RANK GREATER 0)
    math(EXPR LAST "${OUTPUT_RANK}-1")
    foreach(AXIS RANGE 0 ${LAST})
      if(KIND EQUAL 1)
        set(DIM uint64)
      elseif(KIND EQUAL 2)
        if(AXIS EQUAL 1)
          set(DIM uint32)
        else()
          set(DIM int32)
        endif()
      else()
        set(DIM int64)
      endif()
      string(APPEND PARAMS ",d${AXIS}:${DIM}")
      if(AXIS GREATER 0)
        string(APPEND SHAPE ",")
      endif()
      string(APPEND SHAPE "d${AXIS}")
    endforeach()
  endif()
  set(RESULT)
  set(DEFINES)
  if(FIXED)
    set(RESULT "->Tensor[${TYPE},2,2]")
    set(DEFINES -DFIXED_RESHAPE=1)
  endif()
  set(NAME "raw-${TYPE}-${INPUT_RANK}-${OUTPUT_RANK}-${KIND}-${FIXED}")
  COMPILE("${NAME}" "fn change(values:${INPUT}${PARAMS})${RESULT}:\n  reshape(values,[${SHAPE}])\nfn main()->int:\n  0\n" --test-entry change)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DNUMERIC_TYPE=${ID}" "-DINPUT_RANK=${INPUT_RANK}" "-DOUTPUT_RANK=${OUTPUT_RANK}" "-DDIMENSION_KIND=${KIND}" ${DEFINES}
    -isystem "${LLVM_ROOT}/include" "${SOURCE_DIR}/tests/TensorReshapeRuntimeTests.cpp"
    "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
  RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
endfunction()
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDS 2 6 3 7 8 9)
foreach(N RANGE 0 5)
  list(GET TYPES ${N} TYPE)
  list(GET IDS ${N} ID)
  RAW("${TYPE}" "${ID}" 2 2 0 FALSE)
  RAW("${TYPE}" "${ID}" 2 1 0 FALSE)
  if(TYPE STREQUAL "int64" OR TYPE STREQUAL "float32")
    foreach(INPUT_RANK IN ITEMS 0 1 3 8)
      RAW("${TYPE}" "${ID}" "${INPUT_RANK}" 2 0 FALSE)
    endforeach()
    foreach(OUTPUT_RANK IN ITEMS 0 3)
      RAW("${TYPE}" "${ID}" 2 "${OUTPUT_RANK}" 0 FALSE)
    endforeach()
    RAW("${TYPE}" "${ID}" 2 2 1 FALSE)
    RAW("${TYPE}" "${ID}" 2 2 2 FALSE)
    RAW("${TYPE}" "${ID}" 2 2 0 TRUE)
  endif()
  if(TYPE STREQUAL "float32")
    set(DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "float64")
    set(DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "int64")
    set(DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "uint64")
    set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "uint32")
    set(DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(DEFINES)
  endif()
  set(SOURCE "fn failing(value:int)->int:\n  1/value\nfn make()->Tensor[${TYPE},1,2,2]:\n  tensor([[[${TYPE}(1),${TYPE}(2)],[${TYPE}(3),${TYPE}(4)]]])\nfn changed(values:Tensor[${TYPE},?,?,?],rows:int,columns:int):\n  reshape(values,[rows,columns])\nfn mapped(values:Tensor[${TYPE},?,?,?],rows:int,columns:uint32):\n  tensor(map([${TYPE}(0)],fn(x):reduceSum(reshape(values,[rows,columns]))))\nfn inner(values:Tensor[${TYPE},?,?,?]) ! TaskError:\n  try parallel:\n    work=spawn reshape(values,[2,2])\n    first=try await work\n    again=try await work\n    again\nfn bad(values:Tensor[${TYPE},?,?,?],divisor:int):\n  reshape(values,[failing(divisor),2])\nfn faultProbe()->Tensor[${TYPE},?,?] ! TaskError:\n  try parallel:\n    work=spawn bad(make(),0)\n    try await work\nfn shapeProbe()->Tensor[${TYPE},?,?] ! TaskError:\n  try parallel:\n    work=spawn changed(make(),2,3)\n    try await work\nfn emptyProbe()->Tensor[${TYPE},?,?] ! TaskError:\n  values:Tensor[${TYPE},0,2,3]=tensor([],[0,2,3])\n  try parallel:\n    work=spawn reshape(values,[2,0])\n    try await work\nfn probe()->Tensor[${TYPE},?,?] ! TaskError:\n  original=make()\n  attempt=faultProbe()\n  recovered=attempt catch fn(error): reshape(original,[2,2])\n  try parallel:\n    nested=spawn inner(original)\n    direct=spawn reshape(original,[2,2])\n    measure=spawn mapped(original,2,2)\n    a=try await nested\n    b=try await direct\n    again=try await direct\n    measurement=try await measure\n    c=a+b+again+recovered\n    c/2+reduceSum(measurement)-10\nfn main()->${TYPE} ! TaskError:\n  result=try probe()\n  reduceSum(matmul(result,result))\n")
  foreach(KIND IN ITEMS probe emptyProbe faultProbe shapeProbe)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      -DTENSOR_RANK=2 -DCONVERSION_RESULT=1 ${DEFINES} "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp"
      "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  EXPECT("probe-${TYPE}" 216)
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    RUN_OK("${OUTPUT_DIR}/emptyProbe-${TYPE}-harness" "${WORKERS}" 4 0)
    RUN_OK("${OUTPUT_DIR}/faultProbe-${TYPE}-harness" "${WORKERS}" 7 0)
    RUN_OK("${OUTPUT_DIR}/shapeProbe-${TYPE}-harness" "${WORKERS}" 6 0)
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
      if(WORKERS EQUAL 2)
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
          "${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3)
      endif()
    endforeach()
  endforeach()
endforeach()
COMPILE(flatten "fn main():\n  values=reshape(tensor([[1,2],[3,4]]),[4])\n  values[2]\n")
EXPECT(flatten 3)
COMPILE(rank-zero "fn main():\n  reshape(tensor([[7]]),[])[]\n")
EXPECT(rank-zero 7)
COMPILE(after-group "fn main() ! TaskError:\n  values=try parallel:\n    work=spawn reshape(tensor([[1,2],[3,4]]),[4])\n    try await work\n  values[3]\n")
EXPECT(after-group 4)
COMPILE(callback "fn run(values:Tensor[int,?,?]):\n  map([1,2],fn(x):reduceSum(reshape(values,[x,4/x])))\nfn main():\n  values=run(tensor([[1,2],[3,4]]))\n  values[0]+values[1]\n")
EXPECT(callback 20)
COMPILE(awaited "fn rows()->int:\n  2\nfn main() ! TaskError:\n  try parallel:\n    work=spawn rows()\n    values=reshape(tensor([[1,2],[3,4]]),[try await work,2])\n    values[1,1]\n")
EXPECT(awaited 4)
set(HELPERS "fn first(value:int)->int:\n  1/value\nfn second(value:int)->int:\n  2/value\n")
foreach(KIND IN ITEMS first second before-validation)
  if(KIND STREQUAL "first")
    set(DIMS "first(0),second(0)")
    set(LINE 2)
  elseif(KIND STREQUAL "second")
    set(DIMS "first(1),second(0)")
    set(LINE 4)
  else()
    set(DIMS "rows,second(0)")
    set(LINE 4)
  endif()
  COMPILE("order-${KIND}" "${HELPERS}fn change(values:Tensor[int,?,?],rows:int):\n  reshape(values,[${DIMS}])\nfn main():\n  reduceSum(change(tensor([[1,2],[3,4]]),-1))\n")
  execute_process(COMMAND "${OUTPUT_DIR}/order-${KIND}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  if(STATUS EQUAL 0 OR NOT ERR MATCHES "ArithmeticFault.*${LINE}:3")
    message(FATAL_ERROR "Reshape dimension fault order changed: ${STATUS}: ${ERR}")
  endif()
endforeach()
foreach(KIND IN ITEMS count category identity)
  if(KIND STREQUAL "count")
    set(INVALID "fn main():\n  reshape(tensor([[1,2],[3,4]]),[3])\n")
    set(CODE S050)
  elseif(KIND STREQUAL "category")
    set(INVALID "fn main():\n  reshape([1,2],[2])\n")
    set(CODE S026)
  else()
    set(INVALID "fn change(values:Tensor[int,?])->Tensor[float32,?]:\n  reshape(values,[2])\nfn main()->int:\n  0\n")
    set(CODE S010)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${KIND}.k" "${INVALID}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${KIND}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Reshape diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
message(STATUS "Tensor reshape: exact six-type copies, rank changes, mixed dimensions, non-contiguous input, source independence, allocation/shape/stride checks, active cancellation and retained worker matrices passed")

file(WRITE "${OUTPUT_DIR}/text.k" "export fn append(values:[String])->[String]:\n  map(values,fn(text):text+\"!\")\n")
COMPILE(imports "from \"./text.k\" import append\nfn main()->[String] ! TaskError:\n  try parallel:\n    try await spawn append([\"سلام\"])\n")
EXPECT(imports "[\"سلام!\"]")
foreach(NAME IN ITEMS literal map worker-map capture records)
  RUN_OK("${OUTPUT_DIR}/${NAME}")
  set(EXPECTED "${OUTPUT}")
  foreach(FAIL_AT RANGE 1 24)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}"
      "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(STATUS EQUAL 0)
      if(NOT OUT STREQUAL EXPECTED OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
        message(FATAL_ERROR "String array allocation success missing result or settlement: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "String array allocation failure published or leaked: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "String array sanitizer failure: ${ERR}")
    endif()
  endforeach()
endforeach()
message(STATUS "String arrays: 23 compiled programs, bidirectional maps, captures, shared worker ownership, display and failure settlement passed")

RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror ${FLAGS} "-I${SOURCE_DIR}/include"
  "${SOURCE_DIR}/tests/StringArrayDisplayFailureTests.cpp" "${ENTRY}" "${RUNTIME}" -o "${OUTPUT_DIR}/bad-display")
foreach(LIMIT IN ITEMS 0 1 100)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/bad-display" --limit "${LIMIT}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "RuntimeFault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
    message(FATAL_ERROR "Hidden malformed String array tail published or leaked: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
foreach(NAME IN ITEMS mixed nested field)
  if(NAME STREQUAL "mixed")
    set(SOURCE "fn main():\n  [\"a\",1]\n")
  elseif(NAME STREQUAL "nested")
    set(SOURCE "fn main():\n  [[\"a\"]]\n")
  else()
    set(SOURCE "type Bad:\n  values:Tensor[String,2]\nfn main():\n  0\n")
  endif()
  file(WRITE "${OUTPUT_DIR}/reject-${NAME}.k" "${SOURCE}")
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(WRITE "${OUTPUT_DIR}/reject-${NAME}.${SUFFIX}" "preserve-${SUFFIX}")
  endforeach()
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/reject-${NAME}.k" -o "${OUTPUT_DIR}/reject-${NAME}.exe"
    --emit-llvm "${OUTPUT_DIR}/reject-${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/reject-${NAME}.mlir"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "error\\[S[0-9]+\\]")
    message(FATAL_ERROR "Invalid String array source admitted: ${STATUS}: ${OUT}${ERR}")
  endif()
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(READ "${OUTPUT_DIR}/reject-${NAME}.${SUFFIX}" CONTENT)
    if(NOT CONTENT STREQUAL "preserve-${SUFFIX}")
      message(FATAL_ERROR "Rejected String array replaced ${SUFFIX}")
    endif()
  endforeach()
endforeach()
message(STATUS "String array display validates hidden tails; rejected outputs preserved")


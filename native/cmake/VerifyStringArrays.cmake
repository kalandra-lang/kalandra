set(HELPERS "fn identity(values:[String])->[String]:\n  values\nfn child(values:[String])->[String] ! TaskError:\n  try parallel:\n    work=spawn identity(values)\n    first=try await work\n    again=try await work\n    again\nfn probe(values:[String])->[String] ! TaskError:\n  try parallel:\n    work=spawn child(values)\n    first=try await work\n    again=try await work\n    again\n")
COMPILE(worker "${HELPERS}fn main()->[String] ! TaskError:\n  try probe([\"é\",\"a\\0b\"])\n")
EXPECT(worker "[\"é\", \"a\\u0000b\"]")
COMPILE(worker-map "${HELPERS}fn transform(values:[String])->[String]:\n  map(values,fn(text):text+\"!\")\nfn main()->[String] ! TaskError:\n  try parallel:\n    work=spawn transform([\"é\",\"a\"])\n    a=try await work\n    b=try await work\n    map([0,1],fn(i):a[i]+b[i])\n")
EXPECT(worker-map "[\"é!é!\", \"a!a!\"]")
COMPILE(capture "fn main()->[String] ! TaskError:\n  names=[\"é\",\"a\"]\n  try parallel:\n    try await spawn map([0,1],fn(i):names[i])\n")

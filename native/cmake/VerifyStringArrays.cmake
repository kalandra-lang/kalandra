COMPILE(nested-capture "fn main()->[String] ! TaskError:\n  names=[\"é\",\"a\"]\n  try parallel:\n    try await spawn map([0,1],fn(i):map(names,fn(text):text+names[i])[i])\n")
EXPECT(nested-capture "[\"éé\", \"aa\"]")

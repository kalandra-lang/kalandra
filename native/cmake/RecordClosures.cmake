if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-record-closure-tests-${VARIANT} tests/RecordClosureTests.cpp)
    target_compile_options(kalandra-record-closure-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-record-closure-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-record-closure-tests-${VARIANT} PRIVATE KALANDRA_RECORD_FRONTEND_ONLY)
      target_compile_options(kalandra-record-closure-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-record-closure-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-record-closure-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-record-closures-frontend-${VARIANT} COMMAND kalandra-record-closure-tests-${VARIANT})
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(RC_RUNTIME "$<TARGET_FILE:kalandra-native-runtime-sanitized>")
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(RC_RUNTIME "$<TARGET_FILE:kalandra-native-runtime-thread-sanitized>")
    else()
      set(RC_RUNTIME "$<TARGET_FILE:kalandra-native-runtime>")
    endif()
    add_test(NAME native-record-closures-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DVARIANT=${VARIANT}"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=${RC_RUNTIME}" "-DLLVM_ROOT=${KALANDRA_LLVM_ROOT}"
        "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/record-closures-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyRecordClosures.cmake")
    set_tests_properties(native-record-closures-${VARIANT} PROPERTIES TIMEOUT 900)
  endforeach()
endif()

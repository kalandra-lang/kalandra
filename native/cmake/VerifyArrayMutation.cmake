COMPILE(bool "fn edit(mut a:[Bool])->[Bool]:\n  a[1]=true\n  a\nfn main()->int:\n  a=[true,false]\n  b=a\n  c=copy(a)\n  result=edit(a)\n  if result[1] and b[1] and not c[1]:42\n  else:0\n")
EXPECT(bool 42)
COMPILE(loop "fn main()->int:\n  a=generate(128,fn(i):0)\n  b=a\n  i=0\n  while i<128:\n    a[i]=i*3\n    i=i+1\n  b[127]\n")
EXPECT(loop 381)
COMPILE(await-rhs "fn read(a:[int])->int:\n  a[0]+10\nfn main()->int ! TaskError:\n  a=[1,2,3]\n  alias=a\n  try parallel:\n    pending=spawn read(a)\n    a[1]=try await pending\n    i=0\n    while i<3:\n      a[i]=a[i]+1\n      i=i+1\n    alias[0]*100+alias[1]*10+alias[2]\n")
EXPECT(await-rhs 324)
COMPILE(private-task "fn work()->[int]:\n  a=[1,2]\n  a[0]=40\n  a\nfn main()->int ! TaskError:\n  a=try parallel:\n    try await spawn work()\n  a[1]=a[1]+1\n  a[0]+a[1]\n")
EXPECT(private-task 43)
COMPILE(recursive "fn fill(mut a:[int],n:int)->int:\n  if n==0: a[0]\n  else:\n    a[0]=a[0]+1\n    fill(a,n-1)\nfn main()->int:\n  a=[0]\n  n=fill(a,2000)\n  n+a[0]\n")
EXPECT(recursive 4000)
COMPILE(bounds-order "fn failing(n:int)->int:\n  1/n\nfn edit(mut a:[int],index:int)->int:\n  a[index]=failing(0)\n  0\nfn main()->int:\n  a=[1]\n  edit(a,2)\n")
execute_process(COMMAND "${OUTPUT_DIR}/bounds-order" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "BoundsFault.*4:3")
  message(FATAL_ERROR "Assignment evaluated RHS before destination bounds: ${STATUS}: ${OUT}${ERR}")
endif()

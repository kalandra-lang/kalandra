include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int8 int16 int32 int64 uint8 uint16 uint32 uint64 float32 float64)
foreach(ID RANGE 0 9)
  list(GET TYPES ${ID} TYPE)
  COMPILE("alias-${TYPE}" "fn edit(mut values:[${TYPE}])->[${TYPE}]:\n  values[1]=${TYPE}(9)\n  values\nfn main()->int:\n  a=[${TYPE}(1),${TYPE}(2),${TYPE}(3)]\n  b=a\n  c=copy(a)\n  result=edit(a)\n  int(result[1])*100+int(b[1])*10+int(c[1])\n")
  EXPECT("alias-${TYPE}" 992)
  COMPILE("raw-${TYPE}" "fn replace(mut values:[${TYPE}],index:int,value:${TYPE})->int:\n  values[index]=value\n  length(values)\nfn main()->int:\n  0\n" --test-entry replace)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}" -DINDEX_TYPE=3
    "${SOURCE_DIR}/tests/ArrayMutationRuntimeTests.cpp" "${OUTPUT_DIR}/raw-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/raw-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/raw-${TYPE}-harness")
endforeach()

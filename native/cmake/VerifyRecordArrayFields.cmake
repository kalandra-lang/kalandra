include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
function(EXPECT_WORKERS NAME EXPECTED)
  foreach(WORKERS IN ITEMS 1 2 4)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}")
    if(NOT OUTPUT STREQUAL "${EXPECTED}\n")
      message(FATAL_ERROR "${NAME}/${WORKERS}: expected ${EXPECTED}, got ${OUTPUT}")
    endif()
  endforeach()
endfunction()
foreach(TYPE IN ITEMS i8 u8 i16 u16 i32 u32 i64 u64 f32 f64)
  set(DECL "type Row:\n  amount:${TYPE}\n  title:String\n  values:[${TYPE}]\ntype Table:\n  rows:[Row]\n  duplicate:[Row]\nenum Batch:\n  Empty\n  Values:\n    table:Table\n    duplicate:[Row]\nfn make()->Batch:\n  rows=[Row {amount:2,title:\"é\"+\"🙂\",values:[4,5]},Row {amount:3,title:\"bye\",values:[7,8]}]\n  return Batch.Values {table:Table {rows:rows,duplicate:rows},duplicate:rows}\nfn echo(x:Batch)->Batch:\n  return x\nfn child()->Batch ! TaskError:\n  return try parallel:\n    task=spawn echo(make())\n    first=try await task\n    again=try await task\n    again\nfn score(x:Batch)->i64:\n  return match x:\n    Batch.Empty:0\n    Batch.Values {table,duplicate}:i64(table.rows[0].amount+table.duplicate[1].values[0]+duplicate[0].values[1])+length(table.rows[0].title)+length(duplicate)\n")
  COMPILE("width-${TYPE}" "${DECL}fn main()->i64 ! TaskError:\n  result=try parallel:\n    empty=spawn echo(Batch.Empty)\n    work=spawn child()\n    missing=try await empty\n    try await work\n  return score(result)\n")
  EXPECT_WORKERS("width-${TYPE}" 18)
endforeach()
set(DECL "type Row:\n  name:String\n  values:[i64]\nenum Item:\n  Empty\n  Value:\n    rows:[Row]\ntype Box:\n  items:[Item]\n  rows:[Row]\nfn make()->Box:\n  rows=[Row {name:\"é\"+\"🙂\",values:[20,22]}]\n  return Box {items:[Item.Empty,Item.Value {rows:rows}],rows:rows}\nfn echo(x:Box)->Box:\n  return x\nfn child()->Box ! TaskError:\n  return try parallel:\n    task=spawn echo(make())\n    a=try await task\n    b=try await task\n    b\nfn text(item:Item)->String:\n  return match item:\n    Item.Empty:\"empty\"\n    Item.Value {rows}:rows[0].name\n")

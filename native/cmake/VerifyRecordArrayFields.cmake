foreach(NAME IN ITEMS width-int64 enum-arrays escape updates capture)
  foreach(WORKERS IN ITEMS 1 4)
    foreach(ATTEMPT RANGE 1 32)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
        KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
      if("${STATUS}" STREQUAL "0")
        if(NAME STREQUAL "width-int64")
          set(EXPECTED "18\n")
        elseif(NAME STREQUAL "enum-arrays")
          set(EXPECTED "emptyé🙂é🙂\n")
        elseif(NAME STREQUAL "updates")
          set(EXPECTED "é🙂é🙂!é🙂\n")
        else()
          set(EXPECTED "[20, 22]\n")
        endif()
        if(NOT OUT STREQUAL EXPECTED)
          message(FATAL_ERROR "Array-field allocation success changed output: ${OUT}${ERR}")
        endif()
      elseif(("${STATUS}" STREQUAL "86" AND ERR MATCHES "AllocationFault") OR ("${STATUS}" STREQUAL "88" AND ERR MATCHES "TaskError.Fault"))
        if(NOT OUT STREQUAL "" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
          message(FATAL_ERROR "Array-field allocation failure leaked or published output: ${STATUS}: ${OUT}${ERR}")
        endif()
      else()
        message(FATAL_ERROR "Unexpected array-field failure: ${STATUS}: ${OUT}${ERR}")
      endif()
      if(NOT ERR STREQUAL "" AND (NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2))
        message(FATAL_ERROR "Array-field cleanup counters differ: ${OUT}${ERR}")
      endif()
      if(ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
        message(FATAL_ERROR "Array-field sanitizer failure: ${ERR}")
      endif()
    endforeach()
  endforeach()
endforeach()
message(STATUS "Record/enum array fields: ten numeric widths, nested and empty payloads, updates, maps/slices/concat, escaping results, worker captures, raw transport rejection/cancellation and allocation cleanup passed")

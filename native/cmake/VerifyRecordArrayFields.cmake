EXPECT_WORKERS(empty 0)
COMPILE(capture "${DECL}fn main()->[i64] ! TaskError:\n  p=try parallel:\n    try await spawn child()\n  return try parallel:\n    try await spawn map([0,1],fn(i):return p.rows[0].values[i])\n")
EXPECT_WORKERS(capture "[20, 22]")
COMPILE(recovery "${DECL}fn bad(p:Box,index:i64)->Box:\n  return p with {rows:[p.rows[index]]}\nfn attempt()->Box ! TaskError:\n  return try parallel:\n    try await spawn bad(make(),9)\nfn main()->String:\n  p=attempt() catch fn(error):return make()\n  return p.rows[0].name\n")
EXPECT_WORKERS(recovery "é🙂")

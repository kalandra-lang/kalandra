EXPECT_WORKERS(enum-arrays "emptyé🙂é🙂")
COMPILE(escape "${DECL}fn extract(x:Box)->[Row]:\n  return match x.items[1]:\n    Item.Empty:[]\n    Item.Value {rows}:rows\nfn main()->[i64] ! TaskError:\n  rows=try parallel:\n    task=spawn child()\n    box=try await task\n    extract(box)\n  rows[0].values\n")
EXPECT_WORKERS(escape "[20, 22]")
COMPILE(updates "${DECL}fn rename(x:Box)->Box:\n  return x with {rows:map(x.rows,fn(r):return r with {name:r.name+\"!\"})}\nfn main()->String ! TaskError:\n  original=make()\n  changed=try parallel:\n    try await spawn rename(original)\n  return original.rows[0].name+changed.rows[0].name+text(changed.items[1])\n")
EXPECT_WORKERS(updates "é🙂é🙂!é🙂")
COMPILE(operations "${DECL}fn work(x:Box)->Box:\n  return x with {rows:concat(slice(x.rows,0,1),x.rows),items:concat(x.items,[Item.Empty])}\nfn main()->i64 ! TaskError:\n  result=try parallel:\n    try await spawn work(make())\n  return length(result.rows)+length(result.items)+result.rows[1].values[1]\n")
EXPECT_WORKERS(operations 27)

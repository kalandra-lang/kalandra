file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(EXTRA)
set(FLAGS -O0)
set(OPT_LINK)
if(VARIANT STREQUAL "optimized")
  set(EXTRA -O2)
  set(FLAGS -O2)
  set(OPT_LINK "${OPT_RUNTIME}")
elseif(VARIANT STREQUAL "sanitized")
  set(EXTRA --sanitize)
  set(FLAGS -O1 -fsanitize=address,undefined -fno-sanitize-recover=all)
elseif(VARIANT STREQUAL "thread-sanitized")
  set(EXTRA --thread-sanitize)
  set(FLAGS -O1 -fsanitize=thread)
endif()
function(RUN_OK)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "0" OR NOT ERR STREQUAL "")
    message(FATAL_ERROR "Failed: ${ARGN}: ${STATUS}: ${OUT}${ERR}")
  endif()
  message(STATUS "${OUT}")
endfunction()
function(QUALIFY NAME SOURCE ENTRY RANK FLOAT SCENARIO)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  RUN_OK("${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" --test-entry "${ENTRY}"
    --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/${NAME}.mlir" ${EXTRA})
  RUN_OK("${OUTPUT_DIR}/${NAME}")
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DTENSOR_RANK=${RANK}" "-DFLOAT_RESULT=${FLOAT}" "${HARNESS_SOURCE}" "${OUTPUT_DIR}/${NAME}.ll"
    ${OPT_LINK} "${RUNTIME}" -o "${OUTPUT_DIR}/${NAME}-harness")
  foreach(WORKERS IN ITEMS 1 2 4)
    RUN_OK("${OUTPUT_DIR}/${NAME}-harness" "${WORKERS}" "${SCENARIO}" 0)
  endforeach()
endfunction()
file(READ "${FIXTURES}/task-int32-tensor-mixed.k" SOURCE)
QUALIFY(mixed-integer "${SOURCE}" probe 1 0 1)
QUALIFY(mixed-float "${SOURCE}" floatingProbe 1 1 8)
file(READ "${OUTPUT_DIR}/mixed-integer.ll" IR)
if(NOT IR MATCHES "value.layout.tensor.int32.1" OR NOT IR MATCHES "value.layout.tensor1" OR
   NOT IR MATCHES "result.tensor.int32.1" OR NOT IR MATCHES "result.tensor1")
  message(FATAL_ERROR "Compiler conflated same-rank int32/float32 task tensor layouts")
endif()
file(READ "${FIXTURES}/task-int32-tensor-nested.k" SOURCE)
QUALIFY(nested "${SOURCE}" probe 2 0 2)
file(READ "${FIXTURES}/task-int32-tensor-recovery.k" SOURCE)
QUALIFY(recovery "${SOURCE}" probe 1 0 5)
QUALIFY(arithmetic-fault "${SOURCE}" failedProbe 1 0 7)
set(SOURCE "fn shift(values:Tensor[int32],amount:int32) -> Tensor[int32]:\n  values + amount\nfn combine(a:Tensor[int32],b:Tensor[int32]) -> Tensor[int32]:\n  a + b\nfn probe() -> Tensor[int32] ! TaskError:\n  values:Tensor[int32] = tensor(16777217)\n  try parallel:\n    work = spawn shift(values,1)\n    first = try await work\n    again = try await work\n    try await spawn combine(first,again)\nfn main() -> int32:\n  0\n")
QUALIFY(rankzero "${SOURCE}" probe 0 0 0)
set(SOURCE "fn twice(values:Tensor[int32,?,?,?]) -> Tensor[int32,?,?,?]:\n  values + values\nfn probe() -> Tensor[int32,?,?,?] ! TaskError:\n  values:Tensor[int32,2,1,2] = tensor([1,2,3,4],[2,1,2])\n  try parallel:\n    try await spawn twice(values)\nfn main() -> int32:\n  0\n")
QUALIFY(rankthree "${SOURCE}" probe 3 0 3)
set(SOURCE "fn divide(values:Tensor[int32,?,?]) -> Tensor[int32,?,?]:\n  values / 0\nfn probe() -> Tensor[int32,?,?] ! TaskError:\n  values:Tensor[int32,2,0] = tensor([],[2,0])\n  try parallel:\n    try await spawn divide(values)\nfn main() -> int32:\n  0\n")
QUALIFY(empty "${SOURCE}" probe 2 0 4)
set(SOURCE "fn identity(values:Tensor[int32,?]) -> Tensor[int32,?]:\n  values\nfn coordinate(values:Tensor[int32,?]) -> Tensor[int32,?] ! TaskError:\n  try parallel:\n    try await spawn identity(values)\nfn probe() -> Tensor[int32,2] ! TaskError:\n  values:Tensor[int32,1] = tensor([9])\n  fallback:Tensor[int32,2] = tensor([1,2])\n  result = coordinate(values)\n  recovered = result catch fn(error): fallback\n  checked:Tensor[int32,2] = recovered\n  checked\nfn main() -> int32:\n  0\n")
QUALIFY(shape-fault "${SOURCE}" probe 1 0 6)
foreach(WORKERS IN ITEMS 1 2 4)
  RUN_OK("${OUTPUT_DIR}/nested-harness" "${WORKERS}" 2 1)
  RUN_OK("${OUTPUT_DIR}/nested-harness" "${WORKERS}" 2 2)
  RUN_OK("${OUTPUT_DIR}/nested-harness" "${WORKERS}" 2 4)
  foreach(ATTEMPT RANGE 1 12)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
      "${OUTPUT_DIR}/recovery-harness" "${WORKERS}" 5 3)
  endforeach()
endforeach()
# Tensor tasks still reject GPU integer arithmetic.
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/nested.k" --target metal
  -o "${OUTPUT_DIR}/unsupported-metal" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "float32" OR EXISTS "${OUTPUT_DIR}/unsupported-metal")
  message(FATAL_ERROR "Tensor task support accidentally enabled Metal int32: ${STATUS}: ${ERR}")
endif()
message(STATUS "Int32 tensor task captures/results: exact cells, distinct layouts, nested/cached awaits, owner survival, arithmetic/shape recovery, allocation/admission faults and cancellation/deadline settlement passed with 1/2/4 workers")

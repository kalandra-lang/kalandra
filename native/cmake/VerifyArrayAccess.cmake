include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
foreach(TYPE IN ITEMS i8 i16 i32 i64 u8 u16 u32 u64 f32 f64 bool)
  if(TYPE STREQUAL "bool")
    set(VALUES "[true,false]")
  else()
    set(VALUES "[${TYPE}(1),${TYPE}(2)]")
  endif()
  COMPILE("contracts-${TYPE}" "fn inspect(mut values:[${TYPE}])->i64:\n  return length(values)\nfn forward(mut values:[${TYPE}])->i64:\n  f:fn(mut [${TYPE}])->i64=inspect\n  return f(values)\nfn main()->i64:\n  a=${VALUES}\n  callbacks:[fn(mut [${TYPE}])->i64]=[fn(mut values):return forward(values)]\n  n=callbacks[0](a)\n  counts=map([1],fn(i):return forward(copy(a)))\n  borrow=fn()->[${TYPE}]:return a\n  return n+counts[0]+forward(a)+forward(borrow())\n")
  EXPECT("contracts-${TYPE}" 8)
endforeach()
COMPILE(private-worker "fn inspect(mut values:[i64])->i64:\n  return length(values)\nfn work()->i64:\n  f:fn(mut [i64])->i64=inspect\n  a=[1,2]\n  return f(a)\nfn main()->i64 ! TaskError:\n  return try parallel:\n    a=spawn work()\n    b=spawn work()\n    (try await a)+(try await b)\n")
EXPECT(private-worker 4)
foreach(CASE IN ITEMS readonly reader)
  if(CASE STREQUAL "readonly")
    set(SOURCE "fn inspect(mut values:[i64])->i64:\n  return length(values)\nfn forward(values:[i64])->i64:\n  return inspect(values)\nfn main()->i64:\n  return 0\n")
  else()
    set(SOURCE "fn inspect(mut values:[i64])->i64:\n  return length(values)\nfn read(values:[i64])->i64:\n  return length(values)\nfn main()->i64 ! TaskError:\n  a=[1,2]\n  return try parallel:\n    t=spawn read(a)\n    n=inspect(a)\n    n+try await t\n")
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${CASE}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${CASE}.k" -o "${OUTPUT_DIR}/preserved"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "S077" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Array access diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
message(STATUS "Mut contracts: ten numeric types and bool, indirect/aggregate calls, readonly capture copies, private tasks and rejected writes passed")

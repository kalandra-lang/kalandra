include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
foreach(TYPE IN ITEMS int8 int16 int32 int64 uint8 uint16 uint32 uint64 float32 float64 Bool)
  if(TYPE STREQUAL "Bool")
    set(VALUES "[true,false]")
  else()
    set(VALUES "[${TYPE}(1),${TYPE}(2)]")
  endif()
  COMPILE("contracts-${TYPE}" "fn inspect(mut values:[${TYPE}])->int:\n  length(values)\nfn forward(mut values:[${TYPE}])->int:\n  f:fn(mut [${TYPE}])->int=inspect\n  f(values)\nfn main()->int:\n  a=${VALUES}\n  callbacks:[fn(mut [${TYPE}])->int]=[fn(mut values):forward(values)]\n  n=callbacks[0](a)\n  counts=map([1],fn(i):forward(copy(a)))\n  borrow=fn()->[${TYPE}]:a\n  n+counts[0]+forward(a)+forward(borrow())\n")
  EXPECT("contracts-${TYPE}" 8)
endforeach()
COMPILE(private-worker "fn inspect(mut values:[int])->int:\n  length(values)\nfn work()->int:\n  f:fn(mut [int])->int=inspect\n  a=[1,2]\n  f(a)\nfn main()->int ! TaskError:\n  try parallel:\n    a=spawn work()\n    b=spawn work()\n    (try await a)+(try await b)\n")
EXPECT(private-worker 4)
foreach(CASE IN ITEMS readonly reader)
  if(CASE STREQUAL "readonly")
    set(SOURCE "fn inspect(mut values:[int])->int:\n  length(values)\nfn forward(values:[int])->int:\n  inspect(values)\nfn main()->int:\n  0\n")
  else()
    set(SOURCE "fn inspect(mut values:[int])->int:\n  length(values)\nfn read(values:[int])->int:\n  length(values)\nfn main()->int ! TaskError:\n  a=[1,2]\n  try parallel:\n    t=spawn read(a)\n    n=inspect(a)\n    n+try await t\n")
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${CASE}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${CASE}.k" -o "${OUTPUT_DIR}/preserved"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "S077" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Array access diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
message(STATUS "Mut contracts: ten numeric types and Bool, indirect/aggregate calls, readonly capture copies, private tasks and rejected writes passed")

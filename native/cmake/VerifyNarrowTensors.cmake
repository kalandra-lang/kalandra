include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int8 uint8 int16 uint16)
set(IDS 0 4 1 5)
set(BITS 8 8 16 16)
set(LOWS -128 0 -32768 0)
set(HIGHS 127 255 32767 65535)
set(HALVES -128 128 -32768 32768)
set(OPS add sub mul div rem)
set(SIGNS + - * / %)
function(KERNEL NAME RANK OP MODE EXPR)
  set(TYPE_SHAPE "Tensor[${TYPE}")
  if(RANK GREATER 0)
    foreach(AXIS RANGE 1 ${RANK})
      string(APPEND TYPE_SHAPE ",?")
    endforeach()
  endif()
  string(APPEND TYPE_SHAPE "]")
  set(PREFIX)
  if(MODE EQUAL 5)
    set(PREFIX "fn fixed(x:Tensor[${TYPE},2,2])->Tensor[${TYPE},2,2]:\n  x+1\n")
  endif()
  set(NAME "${TYPE}-${NAME}")
  COMPILE("${NAME}" "${PREFIX}fn operation(a:${TYPE_SHAPE},b:${TYPE_SHAPE},scalar:${TYPE})->${TYPE_SHAPE}:\n  ${EXPR}\nfn main()->int:\n  0\n" --test-entry operation)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DTENSOR_RANK=${RANK}" "-DTENSOR_UNSIGNED=${UNSIGNED}" "-DTENSOR_BITS=${WIDTH}"
    "${SOURCE_DIR}/tests/Integer64TensorRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${NAME}-harness")
  RUN_OK("${OUTPUT_DIR}/${NAME}-harness" "${OP}" "${MODE}")
endfunction()
function(TASK NAME RANK SCENARIO SOURCE)
  set(NAME "${TYPE}-${NAME}")
  COMPILE("${NAME}" "${SOURCE}" --test-entry probe)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DTENSOR_RANK=${RANK}" "-DINTEGER_BITS=${WIDTH}" "-DUNSIGNED_RESULT=${UNSIGNED}" -DCONVERSION_RESULT=1
    "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${NAME}-harness")
  foreach(WORKERS IN ITEMS 1 4)
    RUN_OK("${OUTPUT_DIR}/${NAME}-harness" "${WORKERS}" "${SCENARIO}" 0)
    if(SCENARIO EQUAL 3)
      foreach(MODE IN ITEMS 1 2 4)
        RUN_OK("${OUTPUT_DIR}/${NAME}-harness" "${WORKERS}" "${SCENARIO}" "${MODE}")
      endforeach()
      foreach(FAIL_AT RANGE 1 12)
        RUN_OK("${OUTPUT_DIR}/${NAME}-harness" "${WORKERS}" "${SCENARIO}" 3 "${FAIL_AT}")
      endforeach()
    endif()
  endforeach()
endfunction()
function(REJECT NAME SOURCE)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  file(WRITE "${OUTPUT_DIR}/preserved.ll" "preserved llvm")
  file(WRITE "${OUTPUT_DIR}/preserved.mlir" "preserved mlir")
  set(IR_FLAGS --emit-llvm "${OUTPUT_DIR}/preserved.ll" --emit-mlir "${OUTPUT_DIR}/preserved.mlir")
  if(NAME MATCHES "-metal$")
    set(IR_FLAGS)
  endif()
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/preserved"
      ${IR_FLAGS} ${ARGN}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" OLD)
  file(READ "${OUTPUT_DIR}/preserved.ll" LLVM)
  file(READ "${OUTPUT_DIR}/preserved.mlir" MLIR)
  set(DISABLED_METAL FALSE)
  set(EXPECTED_STATUS 1)
  if(NAME MATCHES "-metal$" AND ERR MATCHES "Metal source support is disabled")
    set(DISABLED_METAL TRUE)
    set(EXPECTED_STATUS 2)
    message(STATUS "Metal toolchain unavailable: checking disabled-target artifact preservation")
  endif()
  if(NOT STATUS EQUAL EXPECTED_STATUS OR (NOT ERR MATCHES "S0|${TYPE}" AND NOT DISABLED_METAL) OR NOT OLD STREQUAL "preserved executable" OR
     NOT LLVM STREQUAL "preserved llvm" OR NOT MLIR STREQUAL "preserved mlir")
    message(FATAL_ERROR "Narrow tensor rejection overwrote artifacts: ${NAME}: ${OUT}${ERR}")
  endif()
endfunction()
foreach(N RANGE 0 3)
  list(GET TYPES ${N} TYPE)
  list(GET BITS ${N} WIDTH)
  list(GET LOWS ${N} LOW)
  list(GET HIGHS ${N} HIGH)
  list(GET HALVES ${N} HALF)
  math(EXPR UNSIGNED "${N} % 2")
  foreach(I RANGE 0 4)
    list(GET OPS ${I} OP)
    list(GET SIGNS ${I} SIGN)
    KERNEL("${OP}-pair" 2 "${OP}" 0 "a ${SIGN} b")
    KERNEL("${OP}-right" 2 "${OP}" 1 "a ${SIGN} scalar")
    KERNEL("${OP}-left" 2 "${OP}" 2 "scalar ${SIGN} b")
  endforeach()
  KERNEL(negate 2 neg 3 "-a")
  KERNEL(identity 2 pos 3 "+a")
  foreach(RANK IN ITEMS 0 1 3)
    KERNEL("rank-${RANK}" ${RANK} add 0 "a+b")
  endforeach()
  KERNEL(refinement 2 add 5 "fixed(a)")
  KERNEL(literal-0 0 literal 4 "tensor(scalar)")
  KERNEL(literal-1 1 literal 4 "tensor([scalar,${HIGH},${HALF},42])")
  KERNEL(literal-2 2 literal 4 "tensor([[scalar,${HIGH}],[${HALF},42]])")
  KERNEL(literal-3 3 literal 4 "tensor([scalar,${HIGH},${HALF},42],[2,2,1])")
  set(MAIN "fn main()->int:\n  0\n")
  set(TENSOR "Tensor[${TYPE},?,?]")
  set(STEPS "fn twice(a:${TENSOR})->${TENSOR}:\n  a*2\nfn child(a:${TENSOR})->${TENSOR} ! TaskError:\n  try parallel:\n    work=spawn twice(a)\n    first=try await work\n    again=try await work\n    again\n")
  TASK(worker 2 3 "${STEPS}fn probe()->${TENSOR} ! TaskError:\n  input:Tensor[${TYPE},2,2]=tensor([[1,2],[3,4]])\n  try parallel:\n    work=spawn child(input)\n    first=try await work\n    again=try await work\n    again\n${MAIN}")
  TASK(corners 1 1 "fn echo(a:Tensor[${TYPE},?])->Tensor[${TYPE},?]:\n  a\nfn probe()->Tensor[${TYPE},?] ! TaskError:\n  input:Tensor[${TYPE},4]=tensor([${LOW},${HIGH},42,0])\n  try parallel:\n    try await spawn echo(input)\n${MAIN}")
  TASK(rank0 0 0 "fn echo(a:Tensor[${TYPE}])->Tensor[${TYPE}]:\n  a\nfn probe()->Tensor[${TYPE}] ! TaskError:\n  input:Tensor[${TYPE}]=tensor(42)\n  try parallel:\n    try await spawn echo(input)\n${MAIN}")
  TASK(rank3 3 3 "fn twice(a:Tensor[${TYPE},?,?,?])->Tensor[${TYPE},?,?,?]:\n  a*2\nfn probe()->Tensor[${TYPE},?,?,?] ! TaskError:\n  input:Tensor[${TYPE},2,1,2]=tensor([1,2,3,4],[2,1,2])\n  try parallel:\n    try await spawn twice(input)\n${MAIN}")
  TASK(empty 2 4 "fn echo(a:${TENSOR})->${TENSOR}:\n  a\nfn probe()->${TENSOR} ! TaskError:\n  input:Tensor[${TYPE},2,0]=tensor([],[2,0])\n  try parallel:\n    try await spawn echo(input)\n${MAIN}")
  TASK(fault 1 7 "fn bad(a:Tensor[${TYPE},?])->Tensor[${TYPE},?]:\n  a+1\nfn probe()->Tensor[${TYPE},?] ! TaskError:\n  input:Tensor[${TYPE},2]=tensor([1,${HIGH}])\n  try parallel:\n    try await spawn bad(input)\n${MAIN}")
  COMPILE("${TYPE}-record" "type Box:\n  tag:uint16\n  values:${TENSOR}\nfn change(p:Box)->Box:\n  p with {values:p.values+1}\nfn main()->[${TYPE}] ! TaskError:\n  original=Box {tag:65535,values:tensor([[1,2],[3,4]])}\n  p=try parallel:\n    work=spawn change(original)\n    first=try await work\n    again=try await work\n    again\n  concat(array(original.values),array(p.values))\n")
  EXPECT("${TYPE}-record" "[1, 2, 3, 4, 2, 3, 4, 5]")
  COMPILE("${TYPE}-adapters" "fn main()->Tensor[${TYPE},?,?]:\n  input:[${TYPE}]=[1,2,3,4]\n  reshape(tensor(input),[2,2])+1\n")
  EXPECT("${TYPE}-adapters" "tensor([2, 3, 4, 5], [2, 2])")
  COMPILE("${TYPE}-index" "fn pick(a:${TENSOR},i:int8,j:uint16)->${TYPE}:\n  a[i,j]\nfn main()->[${TYPE}]:\n  values:Tensor[${TYPE},2,2]=tensor([[${LOW},${HIGH}],[3,4]])\n  [pick(values,0,0),pick(values,0,1)]\n")
  EXPECT("${TYPE}-index" "[${LOW}, ${HIGH}]")
  COMPILE("${TYPE}-queries" "fn query(a:${TENSOR})->[int]:\n  concat(shape(a),[length(array(a))])\nfn main()->[int] ! TaskError:\n  values:Tensor[${TYPE},2,2]=tensor([[1,2],[3,4]])\n  try parallel:\n    try await spawn query(values)\n")
  EXPECT("${TYPE}-queries" "[2, 2, 4]")
  COMPILE("${TYPE}-recover" "fn bad(a:Tensor[${TYPE},?])->Tensor[${TYPE},?]:\n  a+1\nfn attempt()->Tensor[${TYPE},?] ! TaskError:\n  input:Tensor[${TYPE},2]=tensor([1,${HIGH}])\n  try parallel:\n    try await spawn bad(input)\nfn main()->Tensor[${TYPE},?]:\n  attempt() catch fn(error):tensor([7,8])\n")
  EXPECT("${TYPE}-recover" "tensor([7, 8], [2])")
  COMPILE("${TYPE}-empty-cli" "fn main()->Tensor[${TYPE},2,0,3]:\n  tensor([],[2,0,3])\n")
  EXPECT("${TYPE}-empty-cli" "tensor([], [2, 0, 3])")
  foreach(FAIL_AT RANGE 1 20)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}"
      "${OUTPUT_DIR}/${TYPE}-record" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2 OR
      (STATUS EQUAL 0 AND NOT OUT STREQUAL "[1, 2, 3, 4, 2, 3, 4, 5]\n") OR
      (NOT STATUS EQUAL 0 AND (NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault")))
      message(FATAL_ERROR "Narrow tensor record allocation failure leaked or changed output: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
  REJECT("${TYPE}-matmul-rank" "fn f(a:Tensor[${TYPE},?])->${TENSOR}:\n  matmul(a,a)\n${MAIN}")
  REJECT("${TYPE}-metal" "fn f(a:${TENSOR})->${TENSOR}:\n  a+1\n${MAIN}" --target metal)
endforeach()
COMPILE(mixed "fn a(x:Tensor[int8,?])->Tensor[int8,?]:\n  x+1\nfn b(x:Tensor[uint8,?])->Tensor[uint8,?]:\n  x+1\nfn c(x:Tensor[int16,?])->Tensor[int16,?]:\n  x+1\nfn d(x:Tensor[uint16,?])->Tensor[uint16,?]:\n  x+1\nfn main()->[int] ! TaskError:\n  try parallel:\n    ia:Tensor[int8,1]=tensor([-2])\n    ib:Tensor[uint8,1]=tensor([254])\n    ic:Tensor[int16,1]=tensor([-32768])\n    id:Tensor[uint16,1]=tensor([65534])\n    wa=spawn a(ia)\n    wb=spawn b(ib)\n    wc=spawn c(ic)\n    wd=spawn d(id)\n    av=try await wa\n    bv=try await wb\n    cv=try await wc\n    dv=try await wd\n    [int(av[0]),int(bv[0]),int(cv[0]),int(dv[0])]\n")
EXPECT(mixed "[-1, 255, -32767, 65535]")
file(READ "${SOURCE_DIR}/../docs/design/narrow-tensors.md" GUIDE)
string(REGEX MATCH "```kalandra\n([^`]+)```" EXAMPLE "${GUIDE}")
COMPILE(documented "${CMAKE_MATCH_1}")
EXPECT(documented "tensor([2, 4, 6, 8], [2, 2])")
message(STATUS "Narrow tensors: four element types, shared checked elementwise kernels, owned worker/record results, adapters and operation gates passed")

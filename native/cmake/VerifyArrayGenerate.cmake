include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES i8 i16 i32 i64 u8 u16 u32 u64 f32 f64)
foreach(ID RANGE 0 9)
  list(GET TYPES ${ID} TYPE)
  COMPILE("generate-${TYPE}" "fn make(count:i64,bias:i64)->[${TYPE}]:\n  return generate(count,fn(i): return ${TYPE}(i%17+bias))\nfn main()->i64:\n  return length(make(37,3))\n" --test-entry make)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}"
    "${SOURCE_DIR}/tests/ArrayGenerateRuntimeTests.cpp" "${OUTPUT_DIR}/generate-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/generate-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/generate-${TYPE}-harness")
  EXPECT("generate-${TYPE}" 37)
endforeach()
# Empty callbacks must never execute. A nonempty one must preserve the existing
# checked arithmetic fault, including when imported into a worker kernel.
COMPILE(empty "fn main()->i64:\n  return length(generate(0,fn(i): return 1/i))\n")
EXPECT(empty 0)
COMPILE(worker "fn make(n:i64)->[i64]:\n  return generate(n,fn(i): return length(generate(i,fn(j): return i+j)))\nfn main()->i64 ! TaskError:\n  return try parallel:\n    pending=spawn make(8)\n    values=try await pending\n    values[7]\n")
EXPECT(worker 7)
COMPILE(direct-worker "fn main()->i64 ! TaskError:\n  bias=3\n  return try parallel:\n    pending=spawn generate(5,fn(i): return i+bias)\n    values=try await pending\n    values[4]\n")
EXPECT(direct-worker 7)
COMPILE(owned "type Item:\n  value:i64\nfn main()->i64:\n  values=generate(5,fn(i): return Item {value:i})\n  labels=generate(3,fn(i): return \"value\")\n  flags=generate(4,fn(i): return i<2)\n  callbacks=generate(4,fn(i): return fn(x:i64): return x+i)\n  return values[4].value+length(labels[2])+callbacks[3](2)\n")
EXPECT(owned 14)
COMPILE(fault "fn main()->i64:\n  return length(generate(3,fn(i): return 1/i))\n")
execute_process(COMMAND "${OUTPUT_DIR}/fault" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "86" OR NOT ERR MATCHES "ArithmeticFault")
  message(FATAL_ERROR "Nonempty generator lost arithmetic fault: ${STATUS}: ${OUT}${ERR}")
endif()

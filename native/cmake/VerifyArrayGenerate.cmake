include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int8 int16 int32 int64 uint8 uint16 uint32 uint64 float32 float64)
foreach(ID RANGE 0 9)
  list(GET TYPES ${ID} TYPE)
  COMPILE("generate-${TYPE}" "fn make(count:int,bias:int)->[${TYPE}]:\n  generate(count,fn(i): ${TYPE}(i%17+bias))\nfn main()->int:\n  length(make(37,3))\n" --test-entry make)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}"
    "${SOURCE_DIR}/tests/ArrayGenerateRuntimeTests.cpp" "${OUTPUT_DIR}/generate-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/generate-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/generate-${TYPE}-harness")
  EXPECT("generate-${TYPE}" 37)
endforeach()
# Empty callbacks must never execute. A nonempty one must preserve the existing
# checked arithmetic fault, including when imported into a worker kernel.
COMPILE(empty "fn main()->int:\n  length(generate(0,fn(i): 1/i))\n")
EXPECT(empty 0)
COMPILE(worker "fn make(n:int)->[int]:\n  generate(n,fn(i): length(generate(i,fn(j): i+j)))\nfn main()->int ! TaskError:\n  try parallel:\n    pending=spawn make(8)\n    values=try await pending\n    values[7]\n")
EXPECT(worker 7)
COMPILE(direct-worker "fn main()->int ! TaskError:\n  bias=3\n  try parallel:\n    pending=spawn generate(5,fn(i): i+bias)\n    values=try await pending\n    values[4]\n")
EXPECT(direct-worker 7)
COMPILE(owned "type Item:\n  value:int\nfn main()->int:\n  values=generate(5,fn(i): Item {value:i})\n  labels=generate(3,fn(i): \"value\")\n  flags=generate(4,fn(i): i<2)\n  callbacks=generate(4,fn(i): fn(x:int): x+i)\n  values[4].value+length(labels[2])+callbacks[3](2)\n")
EXPECT(owned 14)
COMPILE(fault "fn main()->int:\n  length(generate(3,fn(i): 1/i))\n")
execute_process(COMMAND "${OUTPUT_DIR}/fault" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "86" OR NOT ERR MATCHES "ArithmeticFault")
  message(FATAL_ERROR "Nonempty generator lost arithmetic fault: ${STATUS}: ${OUT}${ERR}")
endif()

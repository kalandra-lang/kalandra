include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
file(GLOB SOURCES "${SOURCE_DIR}/tests/fixtures/indirect-spawn/*.k")
foreach(PATH IN LISTS SOURCES)
  get_filename_component(NAME "${PATH}" NAME_WE)
  file(READ "${PATH}" TEXT)
  COMPILE("${NAME}" "${TEXT}")
  EXPECT("${NAME}" 42)
endforeach()
file(APPEND "${OUTPUT_DIR}/raw.ll" "\n@kalandra_indirect_factory = constant ptr @task.entry.0\n@kalandra_indirect_child = constant ptr @task.entry.3\n")
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/IndirectSpawnRuntimeTests.cpp" "${OUTPUT_DIR}/raw.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/context-harness")
RUN_OK("${OUTPUT_DIR}/context-harness")
foreach(TYPE IN ITEMS int8 uint8 int16 uint16 int32 uint32 int64 uint64 float32 float64)
  COMPILE("width-${TYPE}" "fn main()->${TYPE} ! TaskError:\n  values:[${TYPE}]=[40]\n  f=fn(value:${TYPE}):values[0]+value\n  try parallel:\n    try await spawn f(2)\n")
  EXPECT("width-${TYPE}" 42)
endforeach()
foreach(WORKERS IN ITEMS 1 2 4)
  foreach(NAME IN ITEMS alias captured selected nested returned expected-error fault)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}")
    if(NOT OUTPUT STREQUAL "42\n")
      message(FATAL_ERROR "Forwarded parameter changed ${NAME}: ${OUTPUT}")
    endif()
  endforeach()
endforeach()
foreach(NAME IN ITEMS captured nested returned aggregate)
  foreach(ATTEMPT RANGE 1 32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Parameter allocation probe failed: ${NAME}/${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
    endif()
    if("${STATUS}" STREQUAL "0")
      if(NOT OUT STREQUAL "42\n")
        message(FATAL_ERROR "Parameter allocation probe changed result: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Parameter allocation probe leaked/published output: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()
file(GLOB REJECTIONS "${SOURCE_DIR}/tests/fixtures/indirect-spawn/rejected/*.k")
foreach(PATH IN LISTS REJECTIONS)
  get_filename_component(NAME "${PATH}" NAME_WE)
  foreach(KIND IN ITEMS binary ll mlir)
    file(WRITE "${OUTPUT_DIR}/reject-${NAME}.${KIND}" "preserve-${KIND}")
  endforeach()
  execute_process(COMMAND "${COMPILER}" "${PATH}" -o "${OUTPUT_DIR}/reject-${NAME}.binary"
      --emit-llvm "${OUTPUT_DIR}/reject-${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/reject-${NAME}.mlir" ${EXTRA}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "S074")
    message(FATAL_ERROR "Unproven parameter sources accepted: ${NAME}: ${STATUS}: ${OUT}${ERR}")
  endif()
  foreach(KIND IN ITEMS binary ll mlir)
    file(READ "${OUTPUT_DIR}/reject-${NAME}.${KIND}" KEPT)
    if(NOT KEPT STREQUAL "preserve-${KIND}")
      message(FATAL_ERROR "Rejected parameter sources replaced ${KIND}")
    endif()
  endforeach()
endforeach()
COMPILE(callee-order "fn divide(value:int)->int:\n  1/value\nfn make(value:int)->fn(int)->int:\n  checked=1/value\n  divide\nfn main()->int ! TaskError:\n  try parallel:\n    try await spawn make(0)(divide(0))\n")
execute_process(COMMAND "${OUTPUT_DIR}/callee-order" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "86" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 4:11" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
  message(FATAL_ERROR "Indirect spawn reordered/deferred callee evaluation: ${STATUS}: ${OUT}${ERR}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/SignedScalarType.cmake")
function(WRITE_SOURCE PATH SOURCE)
  SPECIALIZE("${SOURCE}" SOURCE)
  file(WRITE "${PATH}" "${SOURCE}")
endfunction()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(EXTRA)
set(FLAGS -O0)
if(VARIANT STREQUAL "optimized")
  set(EXTRA -O2)
  set(FLAGS -O2)
elseif(VARIANT STREQUAL "sanitized")
  set(EXTRA --sanitize)
  set(FLAGS -O1 -fsanitize=address,undefined -fno-sanitize-recover=all)
elseif(VARIANT STREQUAL "thread-sanitized")
  set(EXTRA --thread-sanitize)
  set(FLAGS -O1 -fsanitize=thread)
endif()
function(RUN_OK)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "0" OR NOT ERR STREQUAL "")
    message(FATAL_ERROR "Failed: ${ARGN}: ${STATUS}: ${OUT}${ERR}")
  endif()
  message(STATUS "${OUT}")
  set(OUTPUT "${OUT}" PARENT_SCOPE)
endfunction()
foreach(OP IN ITEMS add sub mul div rem neg)
  if(OP STREQUAL "add")
    set(EXPR "a + b")
  elseif(OP STREQUAL "sub")
    set(EXPR "a - b")
  elseif(OP STREQUAL "mul")
    set(EXPR "a * b")
  elseif(OP STREQUAL "div")
    set(EXPR "a / b")
  elseif(OP STREQUAL "rem")
    set(EXPR "a % b")
  else()
    set(EXPR "-a")
  endif()
  set(SOURCE "${OUTPUT_DIR}/${OP}.k")
  set(IR "${OUTPUT_DIR}/${OP}.ll")
  WRITE_SOURCE("${SOURCE}" "fn operation(a:int32,b:int32) -> int32:\n  ${EXPR}\nfn forward(a:int32,b:int32) -> int32:\n  operation(a,b)\nfn main() -> int32:\n  16777217\n")
  RUN_OK("${COMPILER}" "${SOURCE}" -o "${OUTPUT_DIR}/${OP}" --test-entry forward
    --emit-llvm "${IR}" --emit-mlir "${OUTPUT_DIR}/${OP}.mlir" ${EXTRA})
  RUN_OK("${OUTPUT_DIR}/${OP}")
  SPECIALIZE("16777217\n" EXPECTED)
  if(NOT OUTPUT STREQUAL "${EXPECTED}")
    message(FATAL_ERROR "Integer CLI result lost precision")
  endif()
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DINTEGER_BITS=${INTEGER_BITS}" "${HARNESS_SOURCE}" "${IR}" "${RUNTIME}" -o "${OUTPUT_DIR}/${OP}-harness")
  RUN_OK("${OUTPUT_DIR}/${OP}-harness" "${OP}")
  if(INTEGER_BITS EQUAL 64 AND (OP STREQUAL "div" OR OP STREQUAL "rem"))
    file(READ "${OUTPUT_DIR}/${OP}.mlir" MLIR)
    if(MLIR MATCHES "i128" OR NOT MLIR MATCHES "arith[.](divsi|remsi)")
      message(FATAL_ERROR "Int64 division/remainder must use guarded native-width arithmetic")
    endif()
  endif()
endforeach()
# Dynamic failure must reach the CLI with its source location, not a signal/UB.
WRITE_SOURCE("${OUTPUT_DIR}/fault.k" "fn divide(a:int32,b:int32) -> int32:\n  a / b\nfn main() -> int32:\n  divide(-2147483648,-1)\n")
RUN_OK("${COMPILER}" "${OUTPUT_DIR}/fault.k" -o "${OUTPUT_DIR}/fault" ${EXTRA})
execute_process(COMMAND "${OUTPUT_DIR}/fault" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "86" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "^ArithmeticFault at source 2:[0-9]+\n$")
  message(FATAL_ERROR "Wrong CLI arithmetic fault: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(VALUE IN ITEMS -2147483648 2147483647)
  WRITE_SOURCE("${OUTPUT_DIR}/endpoint.k" "fn main() -> int32:\n  ${VALUE}\n")
  RUN_OK("${COMPILER}" "${OUTPUT_DIR}/endpoint.k" -o "${OUTPUT_DIR}/endpoint" ${EXTRA})
  RUN_OK("${OUTPUT_DIR}/endpoint")
  SPECIALIZE("${VALUE}\n" EXPECTED)
  if(NOT OUTPUT STREQUAL "${EXPECTED}")
    message(FATAL_ERROR "Wrong int32 endpoint output: ${OUTPUT}")
  endif()
endforeach()
WRITE_SOURCE("${OUTPUT_DIR}/invalid.k" "fn main() -> int32:\n  2147483647 + 1\n")
WRITE_SOURCE("${OUTPUT_DIR}/preserved" "existing output")
WRITE_SOURCE("${OUTPUT_DIR}/preserved.ll" "existing IR")
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid.k"
  -o "${OUTPUT_DIR}/preserved" --emit-llvm "${OUTPUT_DIR}/preserved.ll" ${EXTRA}
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
file(READ "${OUTPUT_DIR}/preserved" OLD_EXE)
file(READ "${OUTPUT_DIR}/preserved.ll" OLD_IR)
if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "S052" OR
   NOT OLD_EXE STREQUAL "existing output" OR NOT OLD_IR STREQUAL "existing IR")
  message(FATAL_ERROR "Invalid integer computation published artifacts: ${STATUS}: ${OUT}${ERR}")
endif()
# A Metal source module must not route its new scalar type through float frames.
WRITE_SOURCE("${OUTPUT_DIR}/unsupported-metal.k" "fn integerHelper(x:int32) -> int32:\n  x + 1\nfn main() -> float32 ! TaskError:\n  1\n")
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/unsupported-metal.k"
  --target metal -o "${OUTPUT_DIR}/unsupported-metal" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "float32" OR EXISTS "${OUTPUT_DIR}/unsupported-metal")
  message(FATAL_ERROR "Unsupported Metal int32 module accepted: ${STATUS}: ${OUT}${ERR}")
endif()

WRITE_SOURCE("${OUTPUT_DIR}/calls.k" "fn increment(x:int32) -> int32:\n  x + 1\nfn main() -> int32:\n  increment(16777217)\n")
RUN_OK("${COMPILER}" "${OUTPUT_DIR}/calls.k" -o "${OUTPUT_DIR}/calls" ${EXTRA})
RUN_OK("${OUTPUT_DIR}/calls")
SPECIALIZE("16777218\n" EXPECTED)
if(NOT OUTPUT STREQUAL "${EXPECTED}")
  message(FATAL_ERROR "Integer function/CLI result lost precision")
endif()

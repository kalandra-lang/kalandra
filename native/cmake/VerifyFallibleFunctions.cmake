file(STRINGS "${OUTPUT_DIR}/guide.ll" LLVM_LINES)
set(IN_CALLABLE FALSE)
set(CALLABLE_COUNT 0)
foreach(LINE IN LISTS LLVM_LINES)
  if(LINE MATCHES "^define .*@kalandra_callable_plan_")
    set(IN_CALLABLE TRUE)
    math(EXPR CALLABLE_COUNT "${CALLABLE_COUNT}+1")
  elseif(LINE STREQUAL "}")
    set(IN_CALLABLE FALSE)
  elseif(IN_CALLABLE AND LINE MATCHES "@kalandra_(task|group)_")
    message(FATAL_ERROR "Synchronous callable invoked a task/scheduler API: ${LINE}")
  endif()
endforeach()
if(CALLABLE_COUNT LESS 1)
  message(FATAL_ERROR "No synchronous callable entry was generated")
endif()
foreach(NAME IN ITEMS width-int64 owned worker-owned cached unions fallible-factory)
  foreach(ATTEMPT RANGE 1 32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Fallible callable allocation failed: ${NAME} ${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(NOT "${STATUS}" STREQUAL "0")
      if(NOT OUT STREQUAL "" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
        message(FATAL_ERROR "Fallible callable leaked storage or published partial data: ${OUT}${ERR}")
      endif()
    endif()
  endforeach()
endforeach()

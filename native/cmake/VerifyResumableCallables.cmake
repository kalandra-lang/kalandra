include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
file(GLOB SOURCES "${SOURCE_DIR}/tests/fixtures/resumable-callables/*.k")
foreach(PATH IN LISTS SOURCES)
  get_filename_component(NAME "${PATH}" NAME_WE)
  file(READ "${PATH}" TEXT)
  COMPILE("${NAME}" "${TEXT}")
  EXPECT("${NAME}" 42)
endforeach()
foreach(WORKERS IN ITEMS 1 2 4)
  foreach(NAME IN ITEMS alias arrays captured-data captured error-functions errors fault higher-order infallible-selected infallible nested-captures parallel-map records retained selected spawned unused-helper owned-result tensor-result string-result bool-result recursive task-error-capture)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}")
    if(NOT OUTPUT STREQUAL "42\n")
      message(FATAL_ERROR "Resumable callable changed ${NAME}: ${OUTPUT}")
    endif()
  endforeach()
endforeach()
foreach(NAME IN ITEMS captured captured-data nested-captures retained selected)
  foreach(ATTEMPT RANGE 1 32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Resumable callable allocation probe failed: ${NAME}/${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
    endif()
    if("${STATUS}" STREQUAL "0")
      if(NOT OUT STREQUAL "42\n")
        message(FATAL_ERROR "Resumable callable allocation probe changed result: ${NAME}/${ATTEMPT}: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Resumable callable allocation probe leaked/published output: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()

file(GLOB REJECTIONS "${SOURCE_DIR}/tests/fixtures/resumable-callables/rejected/*.k")
foreach(PATH IN LISTS REJECTIONS)
  get_filename_component(NAME "${PATH}" NAME_WE)
  foreach(KIND IN ITEMS binary ll mlir)
    file(WRITE "${OUTPUT_DIR}/reject-${NAME}.${KIND}" "preserve-${KIND}")
  endforeach()
  execute_process(COMMAND "${COMPILER}" "${PATH}" -o "${OUTPUT_DIR}/reject-${NAME}.binary"
      --emit-llvm "${OUTPUT_DIR}/reject-${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/reject-${NAME}.mlir" ${EXTRA}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "S0(36|54|59|60|74)")
    message(FATAL_ERROR "Unproven parameter sources accepted: ${NAME}: ${STATUS}: ${OUT}${ERR}")
  endif()
  foreach(KIND IN ITEMS binary ll mlir)
    file(READ "${OUTPUT_DIR}/reject-${NAME}.${KIND}" KEPT)
    if(NOT KEPT STREQUAL "preserve-${KIND}")
      message(FATAL_ERROR "Rejected parameter sources replaced ${KIND}")
    endif()
  endforeach()
endforeach()

foreach(TYPE IN ITEMS int8 uint8 int16 uint16 int32 uint32 int64 uint64 float32 float64)
  COMPILE("width-${TYPE}" "fn double(value:${TYPE})->${TYPE}:\n  value*2\nfn run(value:${TYPE})->${TYPE} ! TaskError:\n  try parallel:\n    try await spawn double(value)\nfn main()->${TYPE} ! TaskError:\n  callback=run\n  try callback(${TYPE}(21))\n")
  EXPECT("width-${TYPE}" 42)
endforeach()
file(READ "${SOURCE_DIR}/tests/fixtures/resumable-callable-probe.k" TEXT)
COMPILE(probe "${TEXT}")
file(READ "${OUTPUT_DIR}/probe.ll" LLVM)
string(REGEX REPLACE "(@task.entry.0 = [^\n]*)ptr @task.resume.0" "\\1ptr @kalandra_resumable_probe" LLVM "${LLVM}")
file(WRITE "${OUTPUT_DIR}/probe-instrumented.ll" "${LLVM}\ndeclare void @kalandra_resumable_probe(ptr)\n@kalandra_resumable_original = constant ptr @task.resume.0\n@kalandra_resumable_root = constant ptr @task.entry.2\n@kalandra_resumable_layout = constant ptr @value.layout.function.reference.0\n@kalandra_resumable_code = constant ptr @task.entry.3\n@kalandra_resumable_wrong = constant ptr @task.entry.0\n")
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/ResumableCallableRuntimeTests.cpp" "${OUTPUT_DIR}/probe-instrumented.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/probe-harness")
RUN_OK("${OUTPUT_DIR}/probe-harness")

COMPILE(evaluation-order "fn factory(value:int)->(fn(int)->int ! TaskError):\n  bad=1/value\n  run\nfn input(value:int)->int:\n  1/value\nfn double(value:int)->int:\n  value*2\nfn run(value:int)->int ! TaskError:\n  try parallel:\n    try await spawn double(value)\nfn main()->int ! TaskError:\n  try factory(0)(input(0))\n")
execute_process(COMMAND "${OUTPUT_DIR}/evaluation-order" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "86" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 2:7")
  message(FATAL_ERROR "resumable call changed callee/argument evaluation order: ${STATUS}: ${OUT}${ERR}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDS 2 6 3 7 8 9)
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDS ${INDEX} ID)
  set(DECL "type Envelope:\n  reading:Reading\n  generation:int32\ntype Reading:\n  enabled:Bool\n  position:Point\n  metadata:Metadata\ntype Point:\n  x:${TYPE}\n  valid:Bool\n  y:${TYPE}\ntype Metadata:\n  stamp:uint64\n  ready:Bool\n")
  set(HELPERS "fn identity(p:Envelope)->Envelope:\n  p\nfn toggle(p:Envelope)->Envelope:\n  p with {reading:p.reading with {enabled:not p.reading.enabled}}\nfn child(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    work=spawn identity(p)\n    first=try await work\n    again=try await work\n    again\nfn probe(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    work=spawn child(p)\n    first=try await work\n    again=try await work\n    toggled=try await spawn toggle(first)\n    try await spawn toggle(toggled)\n")
  set(VALUE "Envelope {generation:-17,reading:Reading {metadata:Metadata {stamp:18364758544493064720,ready:true},position:Point {x:2,valid:false,y:3},enabled:true}}")
  COMPILE("roundtrip-${TYPE}" "${DECL}${HELPERS}fn main()->Bool ! TaskError:\n  original=${VALUE}\n  result=try probe(original)\n  result.reading.position.x==original.reading.position.x and result.reading.position.y==original.reading.position.y and result.reading.enabled and result.generation==original.generation and result.reading.metadata.stamp==original.reading.metadata.stamp\n" --test-entry probe)
  EXPECT("roundtrip-${TYPE}" true)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}" -DNESTED_RECORD
    "${SOURCE_DIR}/tests/RecordWorkerRuntimeTests.cpp" "${OUTPUT_DIR}/roundtrip-${TYPE}.ll" "${RUNTIME}"
    -o "${OUTPUT_DIR}/roundtrip-${TYPE}-harness")
  foreach(WORKERS IN ITEMS 1 2 4)
    RUN_OK("${OUTPUT_DIR}/roundtrip-${TYPE}-harness" "${WORKERS}" 0 0)
    if(NOT WORKERS EQUAL 2)
      foreach(MODE IN ITEMS 1 2 4)
        RUN_OK("${OUTPUT_DIR}/roundtrip-${TYPE}-harness" "${WORKERS}" "${MODE}" 0)
      endforeach()
      if(TYPE STREQUAL "int64")
        foreach(FAIL_AT RANGE 1 16)
          RUN_OK("${OUTPUT_DIR}/roundtrip-${TYPE}-harness" "${WORKERS}" 3 "${FAIL_AT}")
        endforeach()
      endif()
    endif()
  endforeach()
  COMPILE("update-${TYPE}" "${DECL}fn shift(p:Envelope)->Envelope:\n  p with {reading:p.reading with {position:p.reading.position with {x:p.reading.position.x+10}}}\nfn main()->${TYPE} ! TaskError:\n  original=${VALUE}\n  moved=try parallel:\n    work=spawn shift(original)\n    first=try await work\n    again=try await work\n    again\n  moved.reading.position.x+original.reading.position.x\n")
  EXPECT("update-${TYPE}" 14)
endforeach()
COMPILE(bool-only "type Envelope:\n  flag:Flag\ntype Flag:\n  enabled:Bool\nfn flip(p:Envelope)->Envelope:\n  p with {flag:p.flag with {enabled:not p.flag.enabled}}\nfn main()->Bool ! TaskError:\n  p=try parallel:\n    try await spawn flip(Envelope {flag:Flag {enabled:false}})\n  p.flag.enabled\n")
EXPECT(bool-only true)
COMPILE(mixed "type Envelope:\n  first:Small\n  second:Wide\ntype Small:\n  i:int32\n  u:uint32\n  f:float32\ntype Wide:\n  i:int64\n  u:uint64\n  f:float64\nfn echo(p:Envelope)->Envelope:\n  p\nfn main()->Bool ! TaskError:\n  original=Envelope {first:Small {i:-2147483648,u:4294967295,f:-0.0},second:Wide {i:-9223372036854775808,u:18446744073709551615,f:0.1}}\n  p=try parallel:\n    try await spawn echo(original)\n  p.first.i==original.first.i and p.first.u==original.first.u and p.first.f==original.first.f and p.second.i==original.second.i and p.second.u==original.second.u and p.second.f==original.second.f\n")
EXPECT(mixed true)
set(DECL "type Scene:\n  position:Point\n  enabled:Bool\ntype Point:\n  x:int\n  y:int\n")
set(VALUE "Scene {position:Point {x:2,y:3},enabled:true}")
COMPILE(shared-child "${DECL}type Pair:\n  left:Point\n  right:Point\nfn change(p:Pair)->Pair:\n  p with {right:p.right with {x:12}}\nfn main()->int ! TaskError:\n  point=Point {x:2,y:3}\n  original=Pair {left:point,right:point}\n  p=try parallel:\n    try await spawn change(original)\n  p.left.x+p.right.x+original.right.x\n")
EXPECT(shared-child 16)
set(FAILERS "fn bad(p:Scene,divisor:int)->Scene:\n  p with {position:p.position with {x:p.position.x/divisor}}\nfn attempt()->Scene ! TaskError:\n  try parallel:\n    try await spawn bad(${VALUE},0)\n")
set(FALLBACK "Scene {position:Point {x:7,y:8},enabled:false}")
COMPILE(recovery "${DECL}${FAILERS}fn main():\n  p=attempt() catch fn(error): ${FALLBACK}\n  p.position.x+p.position.y\n")
EXPECT(recovery 15)
COMPILE(rethrow "${DECL}${FAILERS}fn relay()->Scene ! TaskError:\n  attempt() catch fn(error): fail error\nfn main():\n  p=relay() catch fn(error): ${FALLBACK}\n  p.position.x+p.position.y\n")
EXPECT(rethrow 15)
COMPILE(match "${DECL}${FAILERS}fn main():\n  p=attempt() catch fn(error):\n    match error:\n      TaskError.Fault {kind}:\n        match kind:\n          FaultKind.Arithmetic: ${FALLBACK}\n          _: ${VALUE}\n      _: ${VALUE}\n  p.position.x+p.position.y\n")
EXPECT(match 15)
COMPILE(conditional "${DECL}fn choose(flag:Bool,p:Scene)->Scene ! TaskError:\n  if flag:\n    try parallel:\n      try await spawn identity(p)\n  else: p with {position:p.position with {x:7}}\nfn identity(p:Scene)->Scene:\n  p\nfn main()->int ! TaskError:\n  p=try choose(true,${VALUE})\n  q=try choose(false,p)\n  p.position.x+q.position.x\n")
EXPECT(conditional 9)
COMPILE(map "${DECL}fn item(x:int):\n  Scene {position:Point {x:x,y:1},enabled:true}.position.x\nfn work(p:Scene,values:[int])->[int]:\n  offset=p.position.x\n  map(values,fn(x):item(x)+offset)\nfn main()->[int] ! TaskError:\n  try parallel:\n    try await spawn work(${VALUE},[1,2,3])\n")
EXPECT(map "[3, 4, 5]")
COMPILE(tensor "${DECL}fn size(values:Tensor[int,?,?])->Scene:\n  dimensions=shape(values)\n  Scene {position:Point {x:dimensions[0],y:dimensions[1]},enabled:true}\nfn main()->int ! TaskError:\n  p=try parallel:\n    try await spawn size(tensor([[1,2,3],[4,5,6]]))\n  p.position.x*p.position.y\n")
EXPECT(tensor 6)
file(WRITE "${OUTPUT_DIR}/scenes.k" "${DECL}export fn make(x:int):\n  Scene {position:Point {x:x,y:3},enabled:true}\nexport fn shifted(p:Scene):\n  p with {position:p.position with {x:p.position.x+10}}\n")
file(WRITE "${OUTPUT_DIR}/service.k" "from \"./scenes.k\" import make,shifted\nexport fn run(value:int) ! TaskError:\n  try parallel:\n    try await spawn shifted(make(value))\n")
COMPILE(modules "from \"./scenes.k\" import make,shifted\nfrom \"./service.k\" import run\nfn main()->int ! TaskError:\n  original=make(2)\n  moved=try parallel:\n    try await spawn shifted(original)\n  other=try run(2)\n  adjusted=moved with {position:moved.position with {y:4}}\n  adjusted.position.x+original.position.x+other.position.x\n")
EXPECT(modules 26)
set(ORDER "fn index(i:int):\n  [1][i]\nfn divide(i:int):\n  1/i\nfn base(p:Scene)->Scene:\n  p with {position:p.position with {x:index(5)}}\n")
foreach(MODE IN ITEMS fields base)
  if(MODE STREQUAL "fields")
    set(EXPR "Scene {enabled:index(5)==0,position:Point {x:divide(0),y:0}}")
  else()
    set(EXPR "base(p) with {position:Point {x:divide(0),y:0}}")
  endif()
  COMPILE("order-${MODE}" "${DECL}${ORDER}fn ordered(p:Scene)->Scene:\n  ${EXPR}\nfn attempt()->Scene ! TaskError:\n  try parallel:\n    try await spawn ordered(${VALUE})\nfn main():\n  p=attempt() catch fn(error):\n    match error:\n      TaskError.Fault {kind}:\n        match kind:\n          FaultKind.Bounds: ${FALLBACK}\n          _: ${VALUE}\n      _: ${VALUE}\n  p.position.x\n")
  EXPECT("order-${MODE}" 7)
endforeach()
COMPILE(failure "${DECL}${FAILERS}fn main()->int ! TaskError:\n  p=try attempt()\n  p.position.x\n")
execute_process(COMMAND "${OUTPUT_DIR}/failure" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "TaskError[.]Fault")
  message(FATAL_ERROR "Failed nested record exposed partial output: ${STATUS}: ${OUT}${ERR}")
endif()
# Reject inline storage cycles before replacing any requested output.
file(WRITE "${OUTPUT_DIR}/reject.k" "type A:\n  child:B\ntype B:\n  child:A\nfn main():\n  0\n")
foreach(SUFFIX IN ITEMS exe ll mlir)
  file(WRITE "${OUTPUT_DIR}/reject.${SUFFIX}" "preserve-${SUFFIX}")
endforeach()
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/reject.k" -o "${OUTPUT_DIR}/reject.exe" --emit-llvm "${OUTPUT_DIR}/reject.ll" --emit-mlir "${OUTPUT_DIR}/reject.mlir" ${EXTRA} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "error\\[S068\\]" OR NOT ERR MATCHES "recursive type cycle has no finite construction")
  message(FATAL_ERROR "Record storage cycle reached lowering: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(SUFFIX IN ITEMS exe ll mlir)
  file(READ "${OUTPUT_DIR}/reject.${SUFFIX}" CONTENT)
  if(NOT CONTENT STREQUAL "preserve-${SUFFIX}")
    message(FATAL_ERROR "Invalid nested layout replaced ${SUFFIX}")
  endif()
endforeach()
message(STATUS "Nested records: typed aggregates, exact nested worker snapshots, immutable updates, helpers/modules/maps, error/order semantics, cancellation and cycle artifact preservation passed")

# Shared checked 8/16/32/64-bit integer reduction qualification.
if(NOT DEFINED NUMERIC_TYPE)
  set(NUMERIC_TYPE int32)
endif()
set(UNSIGNED_INPUT 0)
set(INTEGER_BITS 32)
set(MAXIMUM 2147483647)
set(NESTED_EXPECTED 16777227)
if(NUMERIC_TYPE MATCHES "^uint")
  set(UNSIGNED_INPUT 1)
  set(MAXIMUM 4294967295)
endif()
if(NUMERIC_TYPE MATCHES "64$")
  set(INTEGER_BITS 64)
  set(NESTED_EXPECTED 9007199254741003)
  if(UNSIGNED_INPUT)
    set(MAXIMUM 18446744073709551615)
  else()
    set(MAXIMUM 9223372036854775807)
  endif()
endif()
if(NUMERIC_TYPE MATCHES "(8|16)$")
  set(INTEGER_BITS ${CMAKE_MATCH_1})
  set(NESTED_EXPECTED 52)
  if(INTEGER_BITS EQUAL 8)
    if(UNSIGNED_INPUT)
      set(MAXIMUM 255)
    else()
      set(MAXIMUM 127)
    endif()
  elseif(UNSIGNED_INPUT)
    set(MAXIMUM 65535)
  else()
    set(MAXIMUM 32767)
  endif()
endif()
if(NOT NUMERIC_TYPE MATCHES "^(int|uint)(8|16|32|64)$")
  message(FATAL_ERROR "Unsupported reduction qualification type: ${NUMERIC_TYPE}")
endif()
function(SPECIALIZE INPUT OUTPUT)
  string(REPLACE "int32" "${NUMERIC_TYPE}" SOURCE "${INPUT}")
  if(UNSIGNED_INPUT)
    string(REPLACE "2147483647,1,-1" "4294967295,1,0" SOURCE "${SOURCE}")
  endif()
  if(INTEGER_BITS EQUAL 64)
    string(REPLACE "4294967295" "18446744073709551615" SOURCE "${SOURCE}")
    string(REPLACE "2147483648" "9223372036854775808" SOURCE "${SOURCE}")
    string(REPLACE "2147483647" "9223372036854775807" SOURCE "${SOURCE}")
    string(REPLACE "16777217" "9007199254740993" SOURCE "${SOURCE}")
  endif()
  if(INTEGER_BITS LESS 32)
    string(REPLACE "4294967295" "${MAXIMUM}" SOURCE "${SOURCE}")
    string(REPLACE "2147483648,2147483647,0" "${MAXIMUM},0,0" SOURCE "${SOURCE}")
    string(REPLACE "2147483647" "${MAXIMUM}" SOURCE "${SOURCE}")
    string(REPLACE "16777217" "42" SOURCE "${SOURCE}")
  endif()
  set(${OUTPUT} "${SOURCE}" PARENT_SCOPE)
endfunction()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(EXTRA)
set(FLAGS -O0)
if(VARIANT STREQUAL "optimized")
  set(EXTRA -O2)
  set(FLAGS -O2)
elseif(VARIANT STREQUAL "sanitized")
  set(EXTRA --sanitize)
  set(FLAGS -O1 -fsanitize=address,undefined -fno-sanitize-recover=all)
elseif(VARIANT STREQUAL "thread-sanitized")
  set(EXTRA --thread-sanitize)
  set(FLAGS -O1 -fsanitize=thread)
endif()
function(RUN_OK)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "0" OR NOT ERR STREQUAL "")
    message(FATAL_ERROR "Failed: ${ARGN}: ${STATUS}: ${OUT}${ERR}")
  endif()
  message(STATUS "${OUT}")
endfunction()
foreach(RANK IN ITEMS 0 1 2 3)
  set(TYPE "Tensor[int32")
  if(RANK GREATER 0)
    foreach(I RANGE 1 ${RANK})
      string(APPEND TYPE ",?")
    endforeach()
  endif()
  string(APPEND TYPE "]")
  SPECIALIZE("fn operation(values:${TYPE}) -> int32:\n  reduceSum(values)\nfn main() -> int32:\n  0\n" SOURCE)
  file(WRITE "${OUTPUT_DIR}/rank-${RANK}.k" "${SOURCE}")
  RUN_OK("${COMPILER}" "${OUTPUT_DIR}/rank-${RANK}.k" -o "${OUTPUT_DIR}/rank-${RANK}"
    --test-entry operation --emit-llvm "${OUTPUT_DIR}/rank-${RANK}.ll"
    --emit-mlir "${OUTPUT_DIR}/rank-${RANK}.mlir" ${EXTRA})
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DTENSOR_RANK=${RANK}" "-DINTEGER_BITS=${INTEGER_BITS}" "-DUNSIGNED_INPUT=${UNSIGNED_INPUT}" "${HARNESS_SOURCE}" "${OUTPUT_DIR}/rank-${RANK}.ll"
    "${RUNTIME}" -o "${OUTPUT_DIR}/rank-${RANK}-harness")
  RUN_OK("${OUTPUT_DIR}/rank-${RANK}-harness")
  if(UNSIGNED_INPUT)
    file(READ "${OUTPUT_DIR}/rank-${RANK}.mlir" IR)
    if(NOT IR MATCHES "arith.extui" OR NOT IR MATCHES "${MAXIMUM}" OR NOT IR MATCHES "ule")
      message(FATAL_ERROR "Unsigned reduction lost zero extension or unsigned bounds checks")
    endif()
  endif()
endforeach()
function(COMPILE NAME SOURCE)
  SPECIALIZE("${SOURCE}" SOURCE)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  RUN_OK("${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/${NAME}.mlir" ${EXTRA})
endfunction()
function(VERIFY NAME EXPECTED)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" STREQUAL "0" OR NOT OUT STREQUAL "${EXPECTED}\n" OR NOT ERR STREQUAL "")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT}${ERR}; expected ${EXPECTED}")
    endif()
  endforeach()
endfunction()
set(PREFIX "fn sum(values:Tensor[int32,?]) -> int32:\n  reduceSum(values)\nfn identity(values:Tensor[int32,?]) -> Tensor[int32,?]:\n  values\nfn nested(values:Tensor[int32,?]) -> int32 ! TaskError:\n  try parallel:\n    work = spawn sum(values)\n    first = try await work\n    again = try await work\n    first + (again - first)\n")
COMPILE(nested "${PREFIX}fn main() -> int32 ! TaskError:\n  values:Tensor[int32,5] = tensor([16777217,1,2,3,4])\n  try parallel:\n    work = spawn nested(values)\n    sibling = spawn identity(values)\n    first = try await work\n    completed = try await sibling\n    first + (reduceSum(completed) - first)\n")
VERIFY(nested ${NESTED_EXPECTED})
COMPILE(empty "${PREFIX}fn main() -> int32 ! TaskError:\n  values:Tensor[int32,0] = tensor([])\n  try parallel:\n    try await spawn sum(values)\n")
VERIFY(empty 0)
if(UNSIGNED_INPUT)
  COMPILE(maximum "${PREFIX}fn main() -> int32 ! TaskError:\n  values:Tensor[int32,3] = tensor([2147483648,2147483647,0])\n  try parallel:\n    try await spawn sum(values)\n")
  VERIFY(maximum ${MAXIMUM})
endif()
set(FAULT "fn batch(values:Tensor[int32,?]) -> int32 ! TaskError:\n  try parallel:\n    work = spawn nested(values)\n    sibling = spawn identity(values)\n    total = try await work\n    try await sibling\n    total\n")
COMPILE(recovery "${PREFIX}${FAULT}fn main() -> int32 ! TaskError:\n  original:Tensor[int32,3] = tensor([2147483647,1,-1])\n  result = batch(original)\n  recovered = result catch fn(error):\n    match error:\n      TaskError.Fault {kind:cause,message:detail}:\n        match cause:\n          FaultKind.Arithmetic: 7\n          _: 0\n      _: 0\n  try parallel:\n    work = spawn identity(original)\n    values = try await work\n    recovered + reduceSum(values - values)\n")
VERIFY(recovery 7)
COMPILE(fault "${PREFIX}${FAULT}fn main() -> int32 ! TaskError:\n  original:Tensor[int32,3] = tensor([2147483647,1,-1])\n  try batch(original)\n")
foreach(WORKERS IN ITEMS 1 2 4)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
    KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/fault"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "88" OR NOT OUT STREQUAL "" OR
     NOT ERR MATCHES "TaskError.Fault at source 2:3" OR NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Reduction task fault/source/cleanup: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
COMPILE(sync-fault "fn sum(values:Tensor[int32,?]) -> int32:\n  reduceSum(values)\nfn main() -> int32:\n  values:Tensor[int32,3] = tensor([2147483647,1,-1])\n  sum(values)\n")
execute_process(COMMAND "${OUTPUT_DIR}/sync-fault" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "86" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 2:3")
  message(FATAL_ERROR "Synchronous reduction overflow: ${STATUS}: ${OUT}${ERR}")
endif()
block()
  if(UNSIGNED_INPUT)
    set(ENDPOINT ${MAXIMUM})
    set(VALUES "${MAXIMUM},0,0")
  else()
    math(EXPR ENDPOINT "-${MAXIMUM} - 1")
    set(VALUES "${ENDPOINT},0,0")
  endif()
  COMPILE(endpoint "${PREFIX}fn main() -> int32 ! TaskError:\n  values:Tensor[int32,3] = tensor([${VALUES}])\n  try parallel:\n    try await spawn nested(values)\n")
  VERIFY(endpoint ${ENDPOINT})
  if(NOT UNSIGNED_INPUT)
    COMPILE(tree-order "${PREFIX}fn main() -> int32 ! TaskError:\n  values:Tensor[int32,3] = tensor([${MAXIMUM},-1,1])\n  try parallel:\n    try await spawn sum(values)\n")
    VERIFY(tree-order ${MAXIMUM})
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(ATTEMPT RANGE 1 24)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
        "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/nested"
        RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
      if("${STATUS}" STREQUAL "0")
        if(NOT OUT STREQUAL "${NESTED_EXPECTED}\n" OR NOT ERR STREQUAL "")
          message(FATAL_ERROR "Allocation sweep returned wrong value: ${OUT}${ERR}")
        endif()
      elseif("${STATUS}" STREQUAL "86" AND ERR MATCHES "AllocationFault" AND OUT STREQUAL "")
        # The private root-task bridge can fail before a source task is admitted.
      elseif(NOT "${STATUS}" STREQUAL "88" OR NOT ERR MATCHES "TaskError.Fault" OR NOT OUT STREQUAL "")
        message(FATAL_ERROR "Allocation sweep invalid outcome: ${STATUS}: ${OUT}${ERR}")
      endif()
      if(NOT "${STATUS}" STREQUAL "0" AND NOT ERR MATCHES "cleanup: live=0")
        message(FATAL_ERROR "Allocation sweep leaked: ${STATUS}: ${OUT}${ERR}")
      endif()
    endforeach()
  endforeach()
  message(STATUS "${NUMERIC_TYPE} allocation sweep positions 1..24 settled with 1/2/4 workers")
endblock()
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/nested.k" --target metal
  -o "${OUTPUT_DIR}/unsupported-metal" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "${NUMERIC_TYPE}" OR EXISTS "${OUTPUT_DIR}/unsupported-metal")
  message(FATAL_ERROR "Metal integer reduction accidentally enabled: ${STATUS}: ${ERR}")
endif()
message(STATUS "Checked CPU ${NUMERIC_TYPE} reduceSum: ranked runtime inputs, tree overflow, empty identity, nested/cached worker results and recovery passed with 1/2/4 workers")

foreach(NAME IN ITEMS sync worker record-array capture record-map)
  foreach(FAIL_AT RANGE 1 24)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}"
      "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NAME STREQUAL "record-array")
      set(EXPECTED "👩!kept\n")
    elseif(NAME STREQUAL "capture")
      set(EXPECTED "[5, 6, 7]\n")
    elseif(NAME STREQUAL "record-map")
      set(EXPECTED "é!👩\n")
    else()
      set(EXPECTED "[\"é\", \"é!\", \"👩\"]\n")
    endif()
    if(STATUS EQUAL 0)
      if(NOT OUT STREQUAL EXPECTED)
        message(FATAL_ERROR "String-array record allocation sweep changed result: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "String-array record allocation failure published or leaked: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(NOT ERR STREQUAL "" AND (NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2))
      message(FATAL_ERROR "String-array record cleanup counters differ: ${ERR}")
    endif()
    if(ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "String-array record sanitizer failure: ${ERR}")
    endif()
  endforeach()
endforeach()

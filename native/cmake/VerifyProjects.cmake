    set(STATUS_CODE 1)
    set(ERROR_CODE M005)
  elseif(CASE STREQUAL "duplicate")
    set(SOURCE "fn main():\n  0\n")
    set(PACKAGES --package "same=${OUTPUT_DIR}/types.k" --package "same=${OUTPUT_DIR}/public.k")
    set(STATUS_CODE 1)
    set(ERROR_CODE M005)
  elseif(CASE STREQUAL "missing")
    set(SOURCE "from \"missing\" import value\nfn main():\n  0\n")
    set(PACKAGES --package "missing=${OUTPUT_DIR}/absent.k")
    set(STATUS_CODE 1)
    set(ERROR_CODE M002)
  else()
    set(SOURCE "fn main():\n  0\n")
    set(PACKAGES --package "bad=${OUTPUT_DIR}/old.kalandra")
    set(STATUS_CODE 2)
    set(ERROR_CODE "package mappings require")
  endif()
  file(WRITE "${OUTPUT_DIR}/reject-package-${CASE}.k" "${SOURCE}")

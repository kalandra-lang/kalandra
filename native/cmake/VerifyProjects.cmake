# All package source files retain the existing protection from output replacement.
foreach(KIND IN ITEMS direct symlink hardlink)
  set(DESTINATION "${OUTPUT_DIR}/core-types.k")
  if(NOT KIND STREQUAL "direct")
    set(DESTINATION "${OUTPUT_DIR}/protected-${KIND}.k")
    file(REMOVE "${DESTINATION}")
    if(KIND STREQUAL "symlink")
      file(CREATE_LINK "${OUTPUT_DIR}/core-types.k" "${DESTINATION}" SYMBOLIC)
    else()
      file(CREATE_LINK "${OUTPUT_DIR}/core-types.k" "${DESTINATION}")
    endif()
  endif()
  file(SHA256 "${OUTPUT_DIR}/core-types.k" BEFORE)
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/worker.k" --package "public=${OUTPUT_DIR}/public.k" --package "types=${OUTPUT_DIR}/types.k" -o "${DESTINATION}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  file(SHA256 "${OUTPUT_DIR}/core-types.k" AFTER)
  if(NOT STATUS EQUAL 2 OR NOT ERR MATCHES "module source and output paths must be distinct" OR NOT BEFORE STREQUAL AFTER)
    message(FATAL_ERROR "Package source output protection failed: ${KIND}: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()

# Manifest diagnostics/configuration failures preserve executable and IR outputs.
foreach(CASE IN ITEMS syntax version unknown entry absolute package duplicate missing-entry missing-package extra-source extra-project empty-project)
  set(CONTENT "format=1\n[project]\nentry='worker.k'\n[packages]\npublic='public.k'\ntypes='types.k'\n")
  set(OPTIONS)
  set(STATUS_CODE 1)
  if(CASE STREQUAL "syntax")
    set(CONTENT "format=1\n[project\nentry='worker.k'\n")
  elseif(CASE STREQUAL "version")
    set(CONTENT "format=2\n[project]\nentry='worker.k'\n")
  elseif(CASE STREQUAL "unknown")
    set(CONTENT "format=1\n[project]\nentry='worker.k'\nunknown=1\n")
  elseif(CASE STREQUAL "entry")
    set(CONTENT "format=1\n[project]\nentry='worker.kalandra'\n")
  elseif(CASE STREQUAL "absolute")
    set(CONTENT "format=1\n[project]\nentry='/tmp/worker.k'\n")
  elseif(CASE STREQUAL "package")
    set(CONTENT "format=1\n[project]\nentry='worker.k'\n[packages]\nlib=42\n")
  elseif(CASE STREQUAL "duplicate")
    set(OPTIONS --package "public=${OUTPUT_DIR}/public.k")
  elseif(CASE STREQUAL "missing-entry")
    set(CONTENT "format=1\n[project]\nentry='absent.k'\n")
  elseif(CASE STREQUAL "missing-package")
    set(CONTENT "format=1\n[project]\nentry='worker.k'\n[packages]\npublic='absent.k'\n")
  elseif(CASE STREQUAL "extra-source")
    set(OPTIONS "${OUTPUT_DIR}/worker.k")
    set(STATUS_CODE 2)
  elseif(CASE STREQUAL "extra-project")
    set(OPTIONS --project "${OUTPUT_DIR}/worker.toml")
    set(STATUS_CODE 2)
  else()
    set(OPTIONS --project "")
    set(STATUS_CODE 2)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${CASE}.toml" "${CONTENT}")
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(WRITE "${OUTPUT_DIR}/invalid-${CASE}.${SUFFIX}" "preserve-${SUFFIX}")
  endforeach()
  execute_process(COMMAND "${COMPILER}" --project "${OUTPUT_DIR}/invalid-${CASE}.toml" ${OPTIONS}
    -o "${OUTPUT_DIR}/invalid-${CASE}.exe" --emit-llvm "${OUTPUT_DIR}/invalid-${CASE}.ll" --emit-mlir "${OUTPUT_DIR}/invalid-${CASE}.mlir"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL STATUS_CODE OR NOT OUT STREQUAL "" OR ERR STREQUAL "")
    message(FATAL_ERROR "Invalid project accepted: ${CASE}: ${STATUS}: ${OUT}${ERR}")
  endif()
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(READ "${OUTPUT_DIR}/invalid-${CASE}.${SUFFIX}" RESULT)
    if(NOT RESULT STREQUAL "preserve-${SUFFIX}")
      message(FATAL_ERROR "Invalid project changed ${SUFFIX}")
    endif()
  endforeach()
endforeach()
# The manifest itself is a protected compiler input for all output kinds.
foreach(KIND IN ITEMS direct symlink hardlink)
  set(DESTINATION "${OUTPUT_DIR}/worker.toml")
  if(NOT KIND STREQUAL "direct")
    set(DESTINATION "${OUTPUT_DIR}/protected-${KIND}.toml")
    file(REMOVE "${DESTINATION}")
    if(KIND STREQUAL "symlink")
      file(CREATE_LINK "${OUTPUT_DIR}/worker.toml" "${DESTINATION}" SYMBOLIC)
    else()
      file(CREATE_LINK "${OUTPUT_DIR}/worker.toml" "${DESTINATION}")
    endif()
  endif()
  foreach(OUTPUT_KIND IN ITEMS executable llvm mlir)
    if(OUTPUT_KIND STREQUAL "executable")
      set(OUTPUT_OPTIONS -o "${DESTINATION}")
    elseif(OUTPUT_KIND STREQUAL "llvm")
      set(OUTPUT_OPTIONS -o "${OUTPUT_DIR}/unused-output" --emit-llvm "${DESTINATION}")
    else()
      set(OUTPUT_OPTIONS -o "${OUTPUT_DIR}/unused-output" --emit-mlir "${DESTINATION}")
    endif()
    file(SHA256 "${OUTPUT_DIR}/worker.toml" BEFORE)
    execute_process(COMMAND "${COMPILER}" --project "${OUTPUT_DIR}/worker.toml" ${OUTPUT_OPTIONS}
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    file(SHA256 "${OUTPUT_DIR}/worker.toml" AFTER)
    if(NOT STATUS EQUAL 2 OR NOT ERR MATCHES "source and output paths must be distinct" OR NOT BEFORE STREQUAL AFTER)
      message(FATAL_ERROR "Manifest output protection failed: ${KIND}/${OUTPUT_KIND}: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()

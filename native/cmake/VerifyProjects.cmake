function(COMPILE NAME SOURCE)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/${NAME}.toml" "format=1\n[project]\nentry=\"${NAME}.k\"\n[packages]\npublic=\"public.k\"\ntypes=\"types.k\"\n")
  RUN_OK("${COMPILER}" --project "${OUTPUT_DIR}/${NAME}.toml" -o "${OUTPUT_DIR}/${NAME}"
    --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/${NAME}.mlir" ${EXTRA} ${ARGN})
endfunction()

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
foreach(ID IN ITEMS 8 9)
  if(ID EQUAL 8)
    set(TYPE float32)
  else()
    set(TYPE float64)
  endif()
  foreach(COPY IN ITEMS 0 1)
    set(NAME "hardware-${TYPE}-${COPY}")
    set(DEFINES "-DNUMERIC_TYPE=${ID}")
    if(COPY)
      set(SOURCE "fn ordered(a:[${TYPE}])->[${TYPE}]:\n  sorted(a)\nfn main()->int:\n  0\n")
      list(APPEND DEFINES -DSORT_COPY)
    else()
      set(SOURCE "fn ordered(mut a:[${TYPE}])->int:\n  length(sort(a))\nfn main()->int:\n  0\n")
    endif()
    file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
    RUN_OK("${COMPILER}" --arithmetic hardware "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
      --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" --test-entry ordered ${EXTRA})
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} ${DEFINES}
      "${SOURCE_DIR}/tests/ArraySortRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${NAME}-harness")
    RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
  endforeach()
endforeach()
message(STATUS "Hardware float32/float64 sorting: bits/NaNs/zeros, strides, FP environment, ownership/allocation/fault/cancel checks passed")

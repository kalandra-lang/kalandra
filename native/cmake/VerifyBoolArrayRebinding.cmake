include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
foreach(KIND IN ITEMS direct callable finite-callable)
  file(READ "${SOURCE_DIR}/tests/fixtures/bool-array-rebinding/lifetime.k" SOURCE)
  if(NOT KIND STREQUAL "direct")
    string(REPLACE "    values=choose(index)" "    values=select(index)" SOURCE "${SOURCE}")
    if(KIND STREQUAL "callable")
      set(BINDING "  select=choose\n")
    else()
      set(BINDING "  select=if count%2==0:choose\n  else:alternate\n")
    endif()
    string(REPLACE "fn run(count:i64)->i64:\n" "fn run(count:i64)->i64:\n${BINDING}" SOURCE "${SOURCE}")
  endif()
  COMPILE("lifetime-${KIND}" "${SOURCE}" --test-entry run)
  EXPECT("lifetime-${KIND}" 20012)
  file(READ "${OUTPUT_DIR}/lifetime-${KIND}.ll" LLVM)
  if(LLVM MATCHES "kalandra_task_test_entry|kalandra_task_runner")
    message(FATAL_ERROR "Pure Boolean replacement unexpectedly uses task machinery")
  endif()
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "${SOURCE_DIR}/tests/ArrayRebindingRuntimeTests.cpp" "${OUTPUT_DIR}/lifetime-${KIND}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/lifetime-${KIND}-harness")
  RUN_OK("${OUTPUT_DIR}/lifetime-${KIND}-harness")
endforeach()
set(EXPECTED_aliases 8)
set(EXPECTED_captures "[false, true, true, false]")
set(EXPECTED_rhs true)
set(EXPECTED_parallel-map 886)
foreach(NAME IN ITEMS aliases captures rhs parallel-map)
  file(READ "${SOURCE_DIR}/tests/fixtures/bool-array-rebinding/${NAME}.k" SOURCE)
  COMPILE("${NAME}" "${SOURCE}")
  EXPECT("${NAME}" "${EXPECTED_${NAME}}")
endforeach()
file(READ "${SOURCE_DIR}/tests/fixtures/bool-array-rebinding/task-lifetime.k" SOURCE)
COMPILE(task-lifetime "${SOURCE}" --test-entry probe)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/ArrayRebindingTaskTests.cpp" "${OUTPUT_DIR}/task-lifetime.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/task-lifetime-harness")
RUN_OK("${OUTPUT_DIR}/task-lifetime-harness")
foreach(NAME IN ITEMS alias reader captured)
  if(NAME STREQUAL "alias")
    # A plain local alias is writable; replacement must preserve its old backing.
    COMPILE(plain-alias "fn main()->bool:\n  a=[true]\n  alias=a\n  a=[false]\n  alias[0]=false\n  return not a[0] and not alias[0]\n")
    EXPECT(plain-alias true)
    continue()
  elseif(NAME STREQUAL "reader")
    set(SOURCE "fn read(a:[bool])->bool:\n  return a[0]\nfn main()->i64 ! TaskError:\n  a=[true]\n  try parallel:\n    task=spawn read(a)\n    a[0]=false\n    try await task\n  return 0\n")
  else()
    set(SOURCE "fn main()->i64:\n  a=[true]\n  f=fn()->bool:\n    a[0]=false\n    return a[0]\n  return 0\n")
  endif()
  file(WRITE "${OUTPUT_DIR}/reject-${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/reject-${NAME}.k" -o "${OUTPUT_DIR}/reject-${NAME}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(STATUS EQUAL 0 OR NOT ERR MATCHES "read.only|read.lock|read lock|reader|captur")
    message(FATAL_ERROR "Unsafe Boolean mutation admitted or wrong diagnostic: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
message(STATUS "Boolean array replacements: byte-normalized SSA, aliases, closures, bounded ownership and task cancellation/faults passed")

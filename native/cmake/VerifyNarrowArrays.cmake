include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int8 uint8 int16 uint16)
set(IDS 0 4 1 5)
set(LOWS -128 0 -32768 0)
set(HIGHS 127 255 32767 65535)
foreach(N RANGE 0 3)
  list(GET TYPES ${N} TYPE)
  list(GET IDS ${N} ID)
  list(GET LOWS ${N} LOW)
  list(GET HIGHS ${N} HIGH)
  COMPILE("concat-${TYPE}" "fn join(a:[${TYPE}],b:[${TYPE}])->[${TYPE}]:\n  concat(a,b)\nfn main()->int:\n  0\n" --test-entry join)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DNUMERIC_TYPE=${ID}" "${SOURCE_DIR}/tests/ArrayConcatRuntimeTests.cpp"
    "${OUTPUT_DIR}/concat-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/concat-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/concat-${TYPE}-harness")
  foreach(BOUND IN ITEMS "${TYPE}" int64 uint64)
    if(BOUND STREQUAL "${TYPE}")
      set(BOUND_ID "${ID}")
    elseif(BOUND STREQUAL "int64")
      set(BOUND_ID 3)
    else()
      set(BOUND_ID 7)
    endif()
    set(NAME "slice-${TYPE}-${BOUND}")
    COMPILE("${NAME}" "fn part(values:[${TYPE}],a:${BOUND},b:${BOUND})->[${TYPE}]:\n  slice(values,a,b)\nfn main()->int:\n  0\n" --test-entry part)
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "-DNUMERIC_TYPE=${ID}" "-DBOUND_TYPE=${BOUND_ID}" "${SOURCE_DIR}/tests/ArraySliceRuntimeTests.cpp"
      "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${NAME}-harness")
    RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
  endforeach()
  set(SCALAR "type Reading:\n  x:${TYPE}\n  y:${TYPE}\n  enabled:Bool\nfn identity(p:Reading)->Reading:\n  p\nfn nested(p:Reading)->Reading ! TaskError:\n  try parallel:\n    child=spawn identity(p)\n    first=try await child\n    again=try await child\n    again\nfn probe(p:Reading)->Reading ! TaskError:\n  try parallel:\n    work=spawn nested(p)\n    first=try await work\n    again=try await work\n    again\nfn main()->int:\n  0\n")
  COMPILE("scalar-record-${TYPE}" "${SCALAR}" --test-entry probe)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DNUMERIC_TYPE=${ID}" "${SOURCE_DIR}/tests/RecordWorkerRuntimeTests.cpp"
    "${OUTPUT_DIR}/scalar-record-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/scalar-record-${TYPE}-harness")
  set(RAW "type Envelope:\n  data:Data\n  duplicate:[${TYPE}]\ntype Data:\n  values:[${TYPE}]\n  enabled:Bool\nfn identity(p:Envelope)->Envelope:\n  p\nfn probe(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    child=spawn identity(p)\n    first=try await child\n    again=try await child\n    again\nfn main()->int:\n  0\n")
  COMPILE("record-array-${TYPE}" "${RAW}" --test-entry probe)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DNUMERIC_TYPE=${ID}" "${SOURCE_DIR}/tests/RecordCollectionWorkerTests.cpp"
    "${OUTPUT_DIR}/record-array-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/record-array-${TYPE}-harness")
  foreach(WORKERS IN ITEMS 1 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/scalar-record-${TYPE}-harness" "${WORKERS}" "${MODE}" 0)
      RUN_OK("${OUTPUT_DIR}/record-array-${TYPE}-harness" "${WORKERS}" "${MODE}" 0)
    endforeach()
    RUN_OK("${OUTPUT_DIR}/record-array-${TYPE}-harness" "${WORKERS}" 5 0)
    foreach(FAIL_AT RANGE 1 20)
      RUN_OK("${OUTPUT_DIR}/scalar-record-${TYPE}-harness" "${WORKERS}" 3 "${FAIL_AT}")
      RUN_OK("${OUTPUT_DIR}/record-array-${TYPE}-harness" "${WORKERS}" 3 "${FAIL_AT}")
    endforeach()
  endforeach()
  COMPILE("limits-${TYPE}" "fn main()->[${TYPE}]:\n  [${LOW},0,${HIGH}]\n")
  EXPECT("limits-${TYPE}" "[${LOW}, 0, ${HIGH}]")
  RUN_OK("${OUTPUT_DIR}/limits-${TYPE}" --limit 1)
  if(NOT OUTPUT STREQUAL "[${LOW}, ...] (3 elements)\n")
    message(FATAL_ERROR "Narrow array display limit changed: ${OUTPUT}")
  endif()
  set(DECL "type Row:\n  active:Bool\n  value:${TYPE}\n  text:String\n  values:[${TYPE}]\ntype Box:\n  row:Row\n  id:uint64\n")
  set(HELPERS "fn change(p:Box)->Box:\n  offset=p.row.value\n  p with {row:p.row with {value:offset+1,values:map(p.row.values,fn(x):x+offset)}}\nfn child(p:Box)->Box ! TaskError:\n  try parallel:\n    work=spawn change(p)\n    first=try await work\n    again=try await work\n    again\n")
  COMPILE("owned-${TYPE}" "${DECL}${HELPERS}fn main()->[${TYPE}] ! TaskError:\n  original=Box {id:18446744073709551615,row:Row {active:true,value:2,text:\"é👩\",values:[1,2,3]}}\n  changed=try child(original)\n  rows=[original,changed]\n  mapped=map(rows,fn(p):p with {row:p.row with {values:slice(p.row.values,0,2)}})\n  concat(mapped[0].row.values,mapped[1].row.values)\n")
  EXPECT("owned-${TYPE}" "[1, 2, 3, 4]")
  COMPILE("empty-${TYPE}" "${DECL}fn echo(p:Row)->Row:\n  p\nfn main()->[${TYPE}] ! TaskError:\n  p=try parallel:\n    try await spawn echo(Row {active:true,value:${HIGH},text:\"\",values:[]})\n  p.values\n")
  EXPECT("empty-${TYPE}" "[]")
  COMPILE("conditional-${TYPE}" "fn choose(flag:Bool)->[${TYPE}]:\n  if flag:[1,2]\n  else:[3]\nfn main()->[${TYPE}]:\n  choose(false)\n")
  EXPECT("conditional-${TYPE}" "[3]")
  COMPILE("maps-${TYPE}" "fn main()->[int]:\n  original:[${TYPE}]=[1,2,3]\n  offset:${TYPE}=2\n  small=map(original,fn(x):x+offset)\n  widened=map(small,fn(x):int(x))\n  narrowed=map(widened,fn(x):${TYPE}(x))\n  map(narrowed,fn(x):int(x))\n")
  EXPECT("maps-${TYPE}" "[3, 4, 5]")
  COMPILE("array-worker-${TYPE}" "fn echo(values:[${TYPE}])->[${TYPE}]:\n  values\nfn main()->[${TYPE}] ! TaskError:\n  original:[${TYPE}]=[${LOW},${HIGH}]\n  try parallel:\n    work=spawn echo(original)\n    first=try await work\n    again=try await work\n    concat(first,again)\n")
  EXPECT("array-worker-${TYPE}" "[${LOW}, ${HIGH}, ${LOW}, ${HIGH}]")
  COMPILE("recover-${TYPE}" "fn bad(values:[${TYPE}],divisor:${TYPE})->[${TYPE}]:\n  map(values,fn(x):x/divisor)\nfn attempt()->[${TYPE}] ! TaskError:\n  try parallel:\n    try await spawn bad([1,2,3],0)\nfn main()->[${TYPE}]:\n  attempt() catch fn(error):[7,8]\n")
  EXPECT("recover-${TYPE}" "[7, 8]")
  COMPILE("overflow-${TYPE}" "fn add(values:[${TYPE}])->[${TYPE}]:\n  map(values,fn(x):x+1)\nfn main()->[${TYPE}] ! TaskError:\n  try parallel:\n    try await spawn add([1,${HIGH}])\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/overflow-${TYPE}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "TaskError.Fault" OR
      NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
    message(FATAL_ERROR "Narrow array overflow published output or leaked owners: ${OUT}${ERR}")
  endif()
  foreach(FAIL_AT RANGE 1 32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}"
      "${OUTPUT_DIR}/owned-${TYPE}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2 OR
       (STATUS EQUAL 0 AND NOT OUT STREQUAL "[1, 2, 3, 4]\n") OR
       (NOT STATUS EQUAL 0 AND (NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault")))
      message(FATAL_ERROR "Narrow array source allocation failure leaked or changed output: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()
COMPILE(mixed "type Mixed:\n  flag:Bool\n  a:int8\n  b:uint8\n  c:int16\n  d:uint16\n  text:String\n  values:[int16]\nfn echo(p:Mixed)->Mixed:\n  p\nfn main()->Bool ! TaskError:\n  original=Mixed {flag:true,a:-128,b:255,c:-32768,d:65535,text:\"é\",values:[-32768,32767]}\n  p=try parallel:\n    work=spawn echo(original)\n    first=try await work\n    again=try await work\n    again\n  p.flag and p.a==original.a and p.b==original.b and p.c==original.c and p.d==original.d and p.text==original.text and p.values[0]==original.values[0]\n")
EXPECT(mixed true)
file(WRITE "${OUTPUT_DIR}/library.k" "type Box:\n  value:uint16\n  values:[int8]\nexport fn make()->Box:\n  Box {value:65535,values:[-128,127]}\nexport fn echo(p:Box)->Box:\n  p\n")
COMPILE(modules "from \"narrow\" import make,echo\nfn main()->[int8] ! TaskError:\n  p=try parallel:\n    try await spawn echo(make())\n  p.values\n" --package "narrow=${OUTPUT_DIR}/library.k")
file(WRITE "${OUTPUT_DIR}/kalandra.toml" "format=1\n[project]\nentry='modules.k'\n[packages]\nnarrow='library.k'\n")
RUN_OK("${CHECKER}" --project "${OUTPUT_DIR}/kalandra.toml")
RUN_OK("${COMPILER}" --project "${OUTPUT_DIR}/kalandra.toml" -o "${OUTPUT_DIR}/modules" ${EXTRA})
EXPECT(modules "[-128, 127]")
file(READ "${SOURCE_DIR}/../docs/design/narrow-arrays.md" GUIDE)
string(REGEX MATCH "```kalandra\n([^`]+)```" EXAMPLE "${GUIDE}")
COMPILE(documented "${CMAKE_MATCH_1}")
EXPECT(documented "[3, 4]")
message(STATUS "Narrow arrays and record fields: four numeric widths, raw strides/bounds, nested/cached workers, maps/updates, CLI display and allocation cleanup passed")

COMPILE(mixed-arrays "fn a(x:[int8])->[int8]:\n  x\nfn b(x:[uint8])->[uint8]:\n  x\nfn c(x:[int16])->[int16]:\n  x\nfn d(x:[uint16])->[uint16]:\n  x\nfn main()->[int] ! TaskError:\n  try parallel:\n    wa=spawn a([-128,127])\n    wb=spawn b([0,255])\n    wc=spawn c([-32768,32767])\n    wd=spawn d([0,65535])\n    av=try await wa\n    bv=try await wb\n    cv=try await wc\n    dv=try await wd\n    [int(av[0]),int(bv[1]),int(cv[0]),int(dv[1])]\n")
EXPECT(mixed-arrays "[-128, 255, -32768, 65535]")

# Shared unsigned scalar qualification, specialized by source width.
if(NOT DEFINED NUMERIC_TYPE)
  set(NUMERIC_TYPE uint32)
endif()
set(INTEGER_BITS 32)
if(NUMERIC_TYPE STREQUAL "uint64")
  set(INTEGER_BITS 64)
elseif(NOT NUMERIC_TYPE STREQUAL "uint32")
  message(FATAL_ERROR "Unsupported unsigned scalar type: ${NUMERIC_TYPE}")
endif()
function(SPECIALIZE INPUT OUTPUT)
  set(SOURCE "${INPUT}")
  if(INTEGER_BITS EQUAL 64)
    string(REPLACE "uint32" "uint64" SOURCE "${SOURCE}")
    string(REPLACE "4294967295" "18446744073709551615" SOURCE "${SOURCE}")
    string(REPLACE "2147483648" "9223372036854775808" SOURCE "${SOURCE}")
    string(REPLACE "2147483647" "9223372036854775807" SOURCE "${SOURCE}")
    string(REPLACE "2147483649" "9223372036854775809" SOURCE "${SOURCE}")
    string(REPLACE "65535" "4294967295" SOURCE "${SOURCE}")
    string(REPLACE "65537" "4294967297" SOURCE "${SOURCE}")
  endif()
  set(${OUTPUT} "${SOURCE}" PARENT_SCOPE)
endfunction()
function(WRITE_SOURCE PATH SOURCE)
  SPECIALIZE("${SOURCE}" SOURCE)
  file(WRITE "${PATH}" "${SOURCE}")
endfunction()

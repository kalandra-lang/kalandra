include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src" "${OUTPUT_DIR}/examples")
set(LIBRARY "format=1\n[package]\nname='geometry'\nversion='0.2.0-rc.1+build.001'\nentry='src/public.k'\n")
set(MANIFEST "${OUTPUT_DIR}/kalandra.toml")
file(WRITE "${MANIFEST}" "${LIBRARY}[project]\nentry='examples/main.k'\n")
# The library source is deliberately unused: the declared public entry still
# must not be replaced by compilation of the example application.
file(WRITE "${OUTPUT_DIR}/src/public.k" "export fn libraryValue()->int64:\n  99\n")
file(WRITE "${OUTPUT_DIR}/examples/main.k" "fn answer()->int64:\n  42\nfn main()->int64 ! TaskError:\n  try parallel:\n    try await spawn answer()\n")
RUN_OK("${CHECKER}" --project "${MANIFEST}")
RUN_OK("${COMPILER}" --project "${MANIFEST}" -o "${OUTPUT_DIR}/program" ${EXTRA})
RUN_OK("${OUTPUT_DIR}/program")
if(NOT OUTPUT STREQUAL "42\n")
  message(FATAL_ERROR "Dual manifest selected the wrong entry: ${OUTPUT}")
endif()
foreach(SOURCE IN ITEMS "${MANIFEST}" "${OUTPUT_DIR}/src/public.k")
  foreach(KIND IN ITEMS direct symlink hardlink)
    set(DESTINATION "${SOURCE}")
    if(NOT KIND STREQUAL "direct")
      set(DESTINATION "${OUTPUT_DIR}/alias-${KIND}")
      file(REMOVE "${DESTINATION}")
      if(KIND STREQUAL "symlink")
        file(CREATE_LINK "${SOURCE}" "${DESTINATION}" SYMBOLIC)
      else()
        file(CREATE_LINK "${SOURCE}" "${DESTINATION}")
      endif()
    endif()
    foreach(FLAG IN ITEMS -o --emit-llvm --emit-mlir)
      file(SHA256 "${SOURCE}" BEFORE)
      set(OPTIONS -o "${OUTPUT_DIR}/rejected" "${FLAG}" "${DESTINATION}")
      if(FLAG STREQUAL "-o")
        set(OPTIONS -o "${DESTINATION}")
      endif()
      execute_process(COMMAND "${COMPILER}" --project "${MANIFEST}" ${OPTIONS}
        RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
      file(SHA256 "${SOURCE}" AFTER)
      if(NOT STATUS EQUAL 2 OR NOT ERR MATCHES "source and output paths must be distinct" OR NOT BEFORE STREQUAL AFTER)
        message(FATAL_ERROR "Dual manifest source protection failed: ${KIND}/${FLAG}: ${STATUS}: ${OUT}${ERR}")
      endif()
    endforeach()
  endforeach()
endforeach()
# A library-only manifest cannot accidentally become an executable.
file(WRITE "${MANIFEST}" "${LIBRARY}")
file(WRITE "${OUTPUT_DIR}/preserved" "keep")
foreach(TOOL IN ITEMS COMPILER CHECKER)
  set(OPTIONS)
  if(TOOL STREQUAL "COMPILER")
    set(OPTIONS -o "${OUTPUT_DIR}/preserved")
  endif()
  execute_process(COMMAND "${${TOOL}}" --project "${MANIFEST}" ${OPTIONS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "requires a \\[project\\] entry")
    message(FATAL_ERROR "Library-only executable selection accepted: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
file(READ "${OUTPUT_DIR}/preserved" CONTENT)
if(NOT CONTENT STREQUAL "keep")
  message(FATAL_ERROR "Library-only rejection replaced an output")
endif()
# A valid application does not hide malformed library metadata in the same file.
string(REPLACE "0.2.0-rc.1+build.001" "invalid" INVALID "${LIBRARY}")
file(WRITE "${MANIFEST}" "${INVALID}[project]\nentry='examples/main.k'\n")
execute_process(COMMAND "${COMPILER}" --project "${MANIFEST}" -o "${OUTPUT_DIR}/preserved"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
file(READ "${OUTPUT_DIR}/preserved" CONTENT)
if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "package.version" OR NOT CONTENT STREQUAL "keep")
  message(FATAL_ERROR "Malformed dual manifest was ignored: ${STATUS}: ${OUT}${ERR}")
endif()
message(STATUS "Library/application entry selection, worker execution and manifest/public source protection passed")

if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-scoped-package-tests-${VARIANT} tests/ScopedPackageTests.cpp)
    target_compile_options(kalandra-scoped-package-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-scoped-package-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized kalandra-project-sanitized)
      target_compile_definitions(kalandra-scoped-package-tests-${VARIANT} PRIVATE KALANDRA_SCOPED_FRONTEND_ONLY)
      target_compile_options(kalandra-scoped-package-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-scoped-package-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-scoped-package-tests-${VARIANT} PRIVATE kalandra-backend kalandra-project)
      target_include_directories(kalandra-scoped-package-tests-${VARIANT} SYSTEM PRIVATE ${LLVM_INCLUDE_DIRS})
    endif()
    add_test(NAME native-scoped-packages-frontend-${VARIANT} COMMAND kalandra-scoped-package-tests-${VARIANT} "${CMAKE_CURRENT_BINARY_DIR}/scoped-packages-frontend-${VARIANT}")
    set_tests_properties(native-scoped-packages-frontend-${VARIANT} PROPERTIES TIMEOUT 90)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(SCOPED_RUNTIME kalandra-native-runtime-sanitized)
      set(SCOPED_ENTRY kalandra-collection-entry-sanitized)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(SCOPED_RUNTIME kalandra-native-runtime-thread-sanitized)
      set(SCOPED_ENTRY kalandra-collection-entry-thread-sanitized)
    else()
      set(SCOPED_RUNTIME kalandra-native-runtime)
      set(SCOPED_ENTRY kalandra-collection-entry-debug)
    endif()
    add_test(NAME native-scoped-packages-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DGENERATOR=$<TARGET_FILE:kalandra-scoped-package-tests-debug>" "-DVARIANT=${VARIANT}"
        "-DENTRY=$<TARGET_FILE:${SCOPED_ENTRY}>" "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=$<TARGET_FILE:${SCOPED_RUNTIME}>"
        "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/scoped-packages-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyScopedPackages.cmake")
    set_tests_properties(native-scoped-packages-${VARIANT} PROPERTIES TIMEOUT 90)
  endforeach()
endif()

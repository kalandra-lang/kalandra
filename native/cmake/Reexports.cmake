if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-reexport-tests-${VARIANT} tests/ReexportTests.cpp)
    target_compile_options(kalandra-reexport-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-reexport-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-reexport-tests-${VARIANT} PRIVATE KALANDRA_REEXPORT_FRONTEND_ONLY)
      target_compile_options(kalandra-reexport-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-reexport-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-reexport-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-reexports-frontend-${VARIANT} COMMAND kalandra-reexport-tests-${VARIANT} "${CMAKE_CURRENT_BINARY_DIR}/reexports-frontend-${VARIANT}")
    set_tests_properties(native-reexports-frontend-${VARIANT} PROPERTIES TIMEOUT 90)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(REEXPORT_RUNTIME kalandra-native-runtime-sanitized)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(REEXPORT_RUNTIME kalandra-native-runtime-thread-sanitized)
    else()
      set(REEXPORT_RUNTIME kalandra-native-runtime)
    endif()
    add_test(NAME native-reexports-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DVARIANT=${VARIANT}"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=$<TARGET_FILE:${REEXPORT_RUNTIME}>"
        "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/reexports-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyReexports.cmake")
    set_tests_properties(native-reexports-${VARIANT} PROPERTIES TIMEOUT 300)
  endforeach()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
file(GLOB SOURCES "${SOURCE_DIR}/tests/fixtures/worker-nested-closures/*.k")
foreach(PATH IN LISTS SOURCES)
  get_filename_component(NAME "${PATH}" NAME_WE)
  file(READ "${PATH}" TEXT)
  COMPILE("${NAME}" "${TEXT}")
  EXPECT("${NAME}" 42)
endforeach()
file(READ "${SOURCE_DIR}/../docs/design/fixtures/worker-nested-closures.k" GUIDE)
COMPILE(guide "${GUIDE}")
EXPECT(guide 42)
foreach(TYPE IN ITEMS int8 uint8 int16 uint16 int32 uint32 int64 uint64 float32 float64)
  COMPILE("width-${TYPE}" "fn apply(value:${TYPE},f:fn(${TYPE})->${TYPE})->${TYPE}:\n  f(value)\nfn main()->${TYPE} ! TaskError:\n  values:[${TYPE}]=[40]\n  base=fn(value:${TYPE}):values[0]+value\n  outer=fn(value:${TYPE}):base(value)\n  try parallel:\n    try await spawn apply(2,outer)\n")
  EXPECT("width-${TYPE}" 42)
endforeach()
file(READ "${OUTPUT_DIR}/raw.ll" IR)
string(REGEX MATCH "@kalandra_environment_alloc_v1\\([^\n]*i64 40, ptr( nonnull)? @(kalandra_callable_[0-9]+)" BASE "${IR}")
set(BASE_CODE "${CMAKE_MATCH_2}")
string(REGEX MATCH "@kalandra_environment_alloc_v1\\([^\n]*i64 16, ptr( nonnull)? @(kalandra_callable_[0-9]+)" OUTER "${IR}")
set(OUTER_CODE "${CMAKE_MATCH_2}")
if(BASE_CODE STREQUAL "" OR OUTER_CODE STREQUAL "" OR BASE_CODE STREQUAL OUTER_CODE)
  message(FATAL_ERROR "Private nested entries changed")
endif()
file(APPEND "${OUTPUT_DIR}/raw.ll" "\n@kalandra_nested_test_entry = constant ptr @task.entry.0\n@kalandra_nested_test_layout = constant ptr @value.layout.function.reference.0\n@kalandra_nested_test_base = constant ptr @${BASE_CODE}\n@kalandra_nested_test_outer = constant ptr @${OUTER_CODE}\n")
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/WorkerNestedClosureRuntimeTests.cpp" "${OUTPUT_DIR}/raw.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/context-harness")
RUN_OK("${OUTPUT_DIR}/context-harness")
foreach(WORKERS IN ITEMS 1 2 4)
  foreach(NAME IN ITEMS deep factory conditional coordinator fallible shared)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}")
    if(NOT OUTPUT STREQUAL "42\n")
      message(FATAL_ERROR "Nested closure changed ${NAME}: ${OUTPUT}")
    endif()
  endforeach()
endforeach()
foreach(NAME IN ITEMS factory deep shared)
  foreach(ATTEMPT RANGE 1 32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Nested allocation probe failed: ${NAME}/${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
    endif()
    if("${STATUS}" STREQUAL "0")
      if(NOT OUT STREQUAL "42\n")
        message(FATAL_ERROR "Nested allocation probe changed result: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Nested allocation probe leaked/published output: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()

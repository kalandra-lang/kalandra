foreach(NAME IN ITEMS width-int64 rethrow replacement nested absent-success)
  foreach(ATTEMPT RANGE 1 24)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1
      "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if("${STATUS}" STREQUAL "0")
      if(NAME STREQUAL "width-int64")
        set(EXPECTED "13\n")
      elseif(NAME STREQUAL "rethrow")
        set(EXPECTED "8\n")
      elseif(NAME STREQUAL "replacement")
        set(EXPECTED "53\n")
      elseif(NAME STREQUAL "nested")
        set(EXPECTED "[22, 27]\n")
      else()
        set(EXPECTED "tensor([1, 2, 3, 4], [2, 2])\n")
      endif()
      if(NOT OUT STREQUAL EXPECTED)
        message(FATAL_ERROR "Application-error allocation success changed output: ${OUT}${ERR}")
      endif()
    elseif(NOT "${STATUS}" STREQUAL "86" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault")
      message(FATAL_ERROR "Unexpected application-error allocation result: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(NOT ERR STREQUAL "" AND (NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2))
      message(FATAL_ERROR "Application-error cleanup counters differ: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Application-error sanitizer failure: ${ERR}")
    endif()
  endforeach()
endforeach()
# An unsupported source build must not overwrite an existing artifact.
file(WRITE "${OUTPUT_DIR}/unsupported.k" "error ReadError:\n  Bad\nfn bad()->int ! ReadError:\n  fail ReadError.Bad\nfn main()->int ! TaskError:\n  try parallel:\n    try await spawn bad()\n")
file(WRITE "${OUTPUT_DIR}/preserved" "existing executable")
file(WRITE "${OUTPUT_DIR}/preserved.ll" "existing IR")
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/unsupported.k" -o "${OUTPUT_DIR}/preserved" --emit-llvm "${OUTPUT_DIR}/preserved.ll"
  RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
file(READ "${OUTPUT_DIR}/preserved" OUT)
file(READ "${OUTPUT_DIR}/preserved.ll" IR)
if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "S072" OR NOT OUT STREQUAL "existing executable" OR NOT IR STREQUAL "existing IR")
  message(FATAL_ERROR "Unsupported error channel overwrote build artifacts: ${STATUS}: ${ERR}")
endif()

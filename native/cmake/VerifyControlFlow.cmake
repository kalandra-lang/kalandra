include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDENTITIES 2 6 3 7 8 9)
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDENTITIES ${INDEX} ID)
  COMPILE("select-${TYPE}" "fn choose(flag:Bool,a:${TYPE},b:${TYPE})->${TYPE}:\n  if flag:\n    a\n  else:\n    b\nfn main()->${TYPE}:\n  choose(true,7,9)\n" --test-entry choose)
  EXPECT("select-${TYPE}" 7)
  file(READ "${OUTPUT_DIR}/select-${TYPE}.ll" IR)
  if(IR MATCHES "task.entry.")
    message(FATAL_ERROR "Ordinary conditional introduced scheduler entries")
  endif()
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DNUMERIC_TYPE=${ID}" -isystem "${LLVM_ROOT}/include"
    "${SOURCE_DIR}/tests/ControlFlowRuntimeTests.cpp" "${OUTPUT_DIR}/select-${TYPE}.ll" "${RUNTIME}"
    "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/select-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/select-${TYPE}-harness")
endforeach()
COMPILE(tensor "fn choose(flag:Bool)->Tensor[float64,?]:\n  if flag:\n    tensor([-0.0,1.0000000000000002])\n  else:\n    tensor([4.9406564584124654e-324,1.7976931348623157e308,0.0])\nfn main()->int64:\n  0\n" --test-entry choose)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -isystem "${LLVM_ROOT}/include"
  "${SOURCE_DIR}/tests/ControlTensorRuntimeTests.cpp" "${OUTPUT_DIR}/tensor.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/tensor-harness")
RUN_OK("${OUTPUT_DIR}/tensor-harness")
COMPILE(allocation "fn choose(flag:Bool)->float64:\n  if flag:\n    7.0\n  else:\n    values:Tensor[float64,4]=tensor([1,2,3,4])\n    reduceSum(values)\nfn main()->int64:\n  0\n" --test-entry choose)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/ControlAllocationRuntimeTests.cpp" "${OUTPUT_DIR}/allocation.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/allocation-harness")
RUN_OK("${OUTPUT_DIR}/allocation-harness")
set(UNSAFE "fn unsafe(value:int64)->Bool:\n  1/value>0\n")
foreach(CASE RANGE 0 7)
  if(CASE EQUAL 0)
    set(EXPRESSION "false and unsafe(0)")
    set(WANT false)
  elseif(CASE EQUAL 1)
    set(EXPRESSION "true or unsafe(0)")
    set(WANT true)
  elseif(CASE EQUAL 2)
    set(EXPRESSION "not false and true or false")
    set(WANT true)
  elseif(CASE EQUAL 3)
    set(EXPRESSION "false and true or true")
    set(WANT true)
  elseif(CASE EQUAL 4)
    set(EXPRESSION "true or false and unsafe(0)")
    set(WANT true)
  elseif(CASE EQUAL 5)
    set(EXPRESSION "not 1>2")
    set(WANT true)
  elseif(CASE EQUAL 6)
    set(EXPRESSION "not (true and false)")
    set(WANT true)
  else()
    set(EXPRESSION "false or true and false")
    set(WANT false)
  endif()
  COMPILE("logic-${CASE}" "${UNSAFE}fn main()->Bool:\n  ${EXPRESSION}\n")
  EXPECT("logic-${CASE}" "${WANT}")
endforeach()
set(LOGICAL_EXPRESSIONS "a and b" "a or b" "not a" "not a==b" "not a and b or a")
foreach(OP RANGE 0 4)
  list(GET LOGICAL_EXPRESSIONS ${OP} BODY)
  COMPILE("dynamic-logic-${OP}" "fn operation(a:Bool,b:Bool)->Bool:\n  ${BODY}\nfn main()->Bool:\n  true\n" --test-entry operation)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DOPERATION=${OP}"
    "${SOURCE_DIR}/tests/ControlLogicRuntimeTests.cpp" "${OUTPUT_DIR}/dynamic-logic-${OP}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/dynamic-logic-${OP}-harness")
  RUN_OK("${OUTPUT_DIR}/dynamic-logic-${OP}-harness")
endforeach()
foreach(OP RANGE 0 2)
  if(OP EQUAL 0)
    set(BODY "flag and unsafe(0)")
  elseif(OP EQUAL 1)
    set(BODY "flag or unsafe(0)")
  else()
    set(BODY "if flag: unsafe(0)\n  else: false")
  endif()
  COMPILE("dynamic-skip-${OP}" "${UNSAFE}fn operation(flag:Bool)->Bool:\n  ${BODY}\nfn main()->Bool:\n  true\n" --test-entry operation)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DOPERATION=${OP}"
    "${SOURCE_DIR}/tests/ControlSkipRuntimeTests.cpp" "${OUTPUT_DIR}/dynamic-skip-${OP}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/dynamic-skip-${OP}-harness")
  RUN_OK("${OUTPUT_DIR}/dynamic-skip-${OP}-harness")
endforeach()
COMPILE(scope "fn unsafe(value:int64)->int64:\n  1/value\nfn main()->int64:\n  x=5\n  result=if true:\n    x=2\n    x\n  else:\n    unsafe(0)\n  x+result\n")
EXPECT(scope 7)
COMPILE(nested "fn main()->int64:\n  if false:\n    1\n  else:\n    if true: 7\n    else: 9\n")
EXPECT(nested 7)
COMPILE(recursion "fn total(n:int64)->int64:\n  if n==0:\n    0\n  else:\n    n+total(n-1)\nfn main()->int64:\n  total(10)\n")
EXPECT(recursion 55)
set(SOURCE "fn failing(value:int64)->Bool:\n  1/value>0\nfn truth(flag:Bool)->Bool:\n  flag\nfn nested(flag:Bool)->Bool ! TaskError:\n  if flag:\n    try parallel:\n      work=spawn truth(true)\n      try await work\n  else:\n    try parallel:\n      work=spawn truth(false)\n      not (try await work)\nfn rhs(value:int64)->Bool ! TaskError:\n  try parallel:\n    try await spawn failing(value)\nfn skipped()->Bool ! TaskError:\n  false and (try rhs(0))\nfn propagated(flag:Bool)->Bool ! TaskError:\n  if flag:\n    try rhs(0)\n  else:\n    try nested(false)\nfn probe()->Bool ! TaskError:\n  original:Tensor[int64,2]=tensor([1,2])\n  attempted=propagated(true)\n  recovered=attempted catch fn(error): reduceSum(original)==3\n  try parallel:\n    work=spawn nested(false)\n    yes=spawn nested(true)\n    first=try await work\n    again=try await work\n    second=try await yes\n    skippedWork=spawn skipped()\n    skippedResult=try await skippedWork\n    recovered and first and again and second and not skippedResult\nfn falseProbe()->Bool ! TaskError:\n  true and not (try nested(false))\nfn rethrow(flag:Bool)->Bool ! TaskError:\n  result=propagated(flag)\n  result catch fn(error):\n    if flag:\n      fail error\n    else:\n      false\nfn faultProbe()->Bool ! TaskError:\n  try rethrow(true)\nfn main()->Bool ! TaskError:\n  try probe()\n")
foreach(KIND IN ITEMS probe falseProbe faultProbe)
  COMPILE("worker-${KIND}" "${SOURCE}" --test-entry "${KIND}")
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "${SOURCE_DIR}/tests/BooleanTaskTests.cpp" "${OUTPUT_DIR}/worker-${KIND}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/worker-${KIND}-harness")
endforeach()
EXPECT(worker-probe true)
foreach(WORKERS IN ITEMS 1 2 4)
  RUN_OK("${OUTPUT_DIR}/worker-probe-harness" "${WORKERS}" 1 0 0)
  RUN_OK("${OUTPUT_DIR}/worker-falseProbe-harness" "${WORKERS}" 0 0 0)
  RUN_OK("${OUTPUT_DIR}/worker-faultProbe-harness" "${WORKERS}" 0 5 0)
  foreach(MODE IN ITEMS 1 2 4)
    RUN_OK("${OUTPUT_DIR}/worker-probe-harness" "${WORKERS}" 1 "${MODE}" 0)
  endforeach()
  foreach(ATTEMPT RANGE 1 24)
    RUN_OK("${OUTPUT_DIR}/worker-probe-harness" "${WORKERS}" 1 3 "${ATTEMPT}")
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" "${OUTPUT_DIR}/worker-probe-harness" "${WORKERS}" 1 3 0)
  endforeach()
endforeach()
foreach(KIND IN ITEMS and or if condition)
  if(KIND STREQUAL "and")
    set(BODY "true and unsafe(0)")
  elseif(KIND STREQUAL "or")
    set(BODY "false or unsafe(0)")
  elseif(KIND STREQUAL "condition")
    set(BODY "if unsafe(0): true\n  else: false")
  else()
    set(BODY "if true: unsafe(0)\n  else: false")
  endif()
  COMPILE("fault-${KIND}" "${UNSAFE}fn main()->Bool:\n  ${BODY}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/fault-${KIND}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 2:3" OR NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Selected control path failed fault/cleanup: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
message(STATUS "CPU conditional and logical control flow: exact selected scalars, skipped faults, branch scopes, nested workers and settled owners passed")
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  if(TYPE STREQUAL "float32")
    set(DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "float64")
    set(DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "int64")
    set(DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "uint64")
    set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "uint32")
    set(DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(DEFINES)
  endif()
  COMPILE("tensor-worker-${TYPE}" "fn choose(flag:Bool,value:Tensor[${TYPE},?,?])->Tensor[${TYPE},?,?]:\n  if flag:\n    value*2\n  else:\n    value+value\nfn inner(flag:Bool,value:Tensor[${TYPE},?,?])->Tensor[${TYPE},?,?] ! TaskError:\n  if flag:\n    try parallel:\n      try await spawn choose(true,value)\n  else:\n    try parallel:\n      try await spawn choose(false,value)\nfn probe()->Tensor[${TYPE},?,?] ! TaskError:\n  value:Tensor[${TYPE},2,2]=tensor([[1,2],[3,4]])\n  try parallel:\n    left=spawn inner(true,value)\n    right=spawn inner(false,value)\n    a=try await left\n    b=try await right\n    again=try await right\n    (a+b+again)/3\nfn main()->${TYPE} ! TaskError:\n  value=try probe()\n  reduceSum(value)\n" --test-entry probe)
  EXPECT("tensor-worker-${TYPE}" 20)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -DTENSOR_RANK=2 -DCONVERSION_RESULT=1 ${DEFINES}
    "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/tensor-worker-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/tensor-worker-${TYPE}-harness")
  foreach(WORKERS IN ITEMS 1 2 4)
    RUN_OK("${OUTPUT_DIR}/tensor-worker-${TYPE}-harness" "${WORKERS}" 3 0)
    foreach(MODE IN ITEMS 1 2 4)
      RUN_OK("${OUTPUT_DIR}/tensor-worker-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
  endforeach()
endforeach()
foreach(NAME IN ITEMS condition missing wrong)
  if(NAME STREQUAL "condition")
    set(INVALID "fn main()->int64:\n  if 1: 2\n  else: 3\n")
  elseif(NAME STREQUAL "missing")
    set(INVALID "fn main()->int64:\n  if true: 2\n")
  else()
    set(INVALID "fn main()->Bool:\n  true and 1\n")
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${NAME}.k" "${INVALID}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${NAME}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "(P035|S057|S013)" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Control-flow diagnostics/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()

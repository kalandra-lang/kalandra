COMPILE(rethrow "${TYPES}${HELPERS}fn repeat(mode:int)->int ! Reordered:\n  load(mode) catch fn(error):fail error\nfn recovered(mode:int)->int:\n  repeat(mode) ${HANDLER}fn main()->[int]:\n  [recovered(0),recovered(1),recovered(2)]\n")

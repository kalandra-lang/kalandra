COMPILE(guard-union "${TYPES}fn checked(mode:int)->int ! LoadError:\n  if mode==0:\n    fail ReadError.Missing\n  if mode==1:\n    fail ParseError.Bad {position:5}\n  42\nfn recovered(mode:int)->int:\n  checked(mode) ${HANDLER}fn main()->[int]:\n  [recovered(0),recovered(1),recovered(2)]\n")

foreach(MODE IN ITEMS read parse)
  if(MODE STREQUAL "read")
    set(CALL "read(0)")
    set(ERROR "ReadError.Bad")
  else()
    set(CALL "parse(1)")
    set(ERROR "ParseError.Bad")
  endif()
  COMPILE("unhandled-${MODE}" "${TYPES}${HELPERS}fn main()->int ! All:\n  ${CALL}\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/unhandled-${MODE}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "89" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "^${ERROR}\ncleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
    message(FATAL_ERROR "Union CLI lost original identity or cleanup: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
set(RAW "error ReadError:\n  Missing\n  Bad:\n    reason:String\n    numbers:[int]\nerror OtherError:\n  Bad:\n    reason:String\n    numbers:[int]\ntype Both=ReadError | OtherError\n")
foreach(TAG IN ITEMS 2 3)
  if(TAG EQUAL 2)
    set(FAMILY ReadError)
  else()
    set(FAMILY OtherError)
  endif()
  COMPILE("raw-${TAG}" "${RAW}fn probe()->int ! Both:\n  fail ${FAMILY}.Bad {reason:\"é\"+\"🙂\",numbers:[20,22]}\nfn main()->int:\n  0\n" --test-entry probe)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DKALANDRA_ERROR_UNION_TAG=${TAG}" "${SOURCE_DIR}/tests/ApplicationErrorRuntimeTests.cpp" "${OUTPUT_DIR}/raw-${TAG}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/raw-${TAG}-harness")
  foreach(WORKERS IN ITEMS 1 4)
    RUN_OK("${OUTPUT_DIR}/raw-${TAG}-harness" "${WORKERS}")
  endforeach()
endforeach()
foreach(NAME IN ITEMS propagate return-widen handler-union rethrow shape-refinement)
  foreach(ATTEMPT RANGE 1 32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NAME STREQUAL "return-widen")
      set(EXPECTED "[20, 5, 45]\n")
    elseif(NAME STREQUAL "handler-union")
      set(EXPECTED "[99, 5, 45]\n")
    elseif(NAME STREQUAL "shape-refinement")
      set(EXPECTED "tensor([7, 10], [1, 2])\n")
    else()
      set(EXPECTED "[44, 5, 45]\n")
    endif()
    if("${STATUS}" STREQUAL "0" AND NOT OUT STREQUAL EXPECTED)
      message(FATAL_ERROR "Union allocation success changed output: ${OUT}${ERR}")
    endif()
    if(NOT "${STATUS}" STREQUAL "0" AND (NOT "${STATUS}" STREQUAL "86" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault"))
      message(FATAL_ERROR "Union allocation result changed: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer" OR (NOT ERR STREQUAL "" AND (NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)))
      message(FATAL_ERROR "Union allocation cleanup failed: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()

execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/unsupported.k" -o "${OUTPUT_DIR}/preserved" --emit-llvm "${OUTPUT_DIR}/preserved.ll" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
file(READ "${OUTPUT_DIR}/preserved" OUT)
file(READ "${OUTPUT_DIR}/preserved.ll" IR)
if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "S072" OR NOT OUT STREQUAL "existing executable" OR NOT IR STREQUAL "existing IR")

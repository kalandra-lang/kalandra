EXPECT(narrow-handler "[10, 6, 45]")
COMPILE(match-union "${TYPES}${HELPERS}enum Choice:\n  First\n  Second\nfn choose(value:Choice)->int ! LoadError:\n  match value:\n    Choice.First:read(0)\n    Choice.Second:parse(1)\nfn recovered(value:Choice)->int:\n  choose(value) ${HANDLER}fn main()->[int]:\n  [recovered(Choice.First),recovered(Choice.Second)]\n")

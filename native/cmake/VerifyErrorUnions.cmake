set(TYPES "error ReadError:\n  Missing\n  Bad:\n    reason:String\n    values:[int]\nerror ParseError:\n  Bad:\n    position:int\nerror PublicError:\n  Unavailable\ntype LoadError=ReadError | ParseError | ReadError\ntype Reordered=ParseError | ReadError\ntype All=PublicError | LoadError\n")
set(HELPERS "fn read(mode:int)->int ! ReadError:\n  if mode==0:\n    fail ReadError.Bad {reason:\"é\"+\"🙂\",values:[20,22]}\n  42\nfn parse(mode:int)->int ! ParseError:\n  if mode==1:\n    fail ParseError.Bad {position:5}\n  3\nfn load(mode:int)->int ! LoadError:\n  a=try read(mode)\n  b=try parse(mode)\n  a+b\n")
set(HANDLER "catch fn(error):\n    match error:\n      ReadError.Missing:0\n      ReadError.Bad {reason,values}:length(reason)+values[0]+values[1]\n      ParseError.Bad {position}:position\n")
COMPILE(propagate "${TYPES}${HELPERS}fn recovered(mode:int)->int:\n  load(mode) ${HANDLER}fn main()->[int]:\n  [recovered(0),recovered(1),recovered(2)]\n")
EXPECT(propagate "[44, 5, 45]")
COMPILE(return-widen "${TYPES}${HELPERS}fn wider(mode:int)->int ! All:\n  load(mode)\nfn recovered(mode:int)->int:\n  wider(mode) catch fn(error):\n    match error:\n      ReadError.Missing:0\n      ReadError.Bad {values}:values[0]\n      ParseError.Bad {position}:position\n      PublicError.Unavailable:99\nfn main()->[int]:\n  [recovered(0),recovered(1),recovered(2)]\n")
EXPECT(return-widen "[20, 5, 45]")
COMPILE(conditional "${TYPES}${HELPERS}fn choose(mode:int)->int ! (ParseError | ReadError):\n  if mode==0:read(mode)\n  else:parse(mode)\nfn recovered(mode:int)->int:\n  choose(mode) ${HANDLER}fn main()->[int]:\n  [recovered(0),recovered(1),recovered(2)]\n")

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
foreach(NAME IN ITEMS strings callables records empty repeated errors)
  file(READ "${SOURCE_DIR}/tests/fixtures/scoped-owned-maps/${NAME}.k" SOURCE)
  COMPILE("${NAME}" "${SOURCE}")
endforeach()
EXPECT(strings 25)
EXPECT(callables 155)
EXPECT(records 291)
EXPECT(empty 2)
EXPECT(repeated 8595)
EXPECT(errors 20)
file(READ "${SOURCE_DIR}/tests/fixtures/scoped-owned-maps/probe.k" SOURCE)
COMPILE(probe "${SOURCE}" --test-entry probe)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  -DEXPECTED_PER_PAIR=167 -DTASK_IN_FLIGHT=16 "${SOURCE_DIR}/tests/ArrayRebindingTaskTests.cpp"
  "${OUTPUT_DIR}/probe.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/probe-harness")
RUN_OK("${OUTPUT_DIR}/probe-harness")
set(EXPECTED_strings 25)
set(EXPECTED_callables 155)
set(EXPECTED_records 291)
set(EXPECTED_empty 2)
set(EXPECTED_repeated 8595)
set(EXPECTED_errors 20)
foreach(WORKERS IN ITEMS 1 4)
  foreach(NAME IN ITEMS strings callables records empty repeated errors)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}")
    if(NOT OUTPUT STREQUAL "${EXPECTED_${NAME}}\n")
      message(FATAL_ERROR "Owned prefix changed ${NAME}/${WORKERS}: ${OUTPUT}")
    endif()
  endforeach()
endforeach()

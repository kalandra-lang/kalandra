# Shared signed scalar qualification, specialized by source width.
if(NOT DEFINED NUMERIC_TYPE)
  set(NUMERIC_TYPE int32)
endif()
set(INTEGER_BITS 32)
if(NUMERIC_TYPE STREQUAL "int64")
  set(INTEGER_BITS 64)
elseif(NOT NUMERIC_TYPE STREQUAL "int32")
  message(FATAL_ERROR "Unsupported signed scalar type: ${NUMERIC_TYPE}")
endif()
function(SPECIALIZE INPUT OUTPUT)
  set(SOURCE "${INPUT}")
  if(INTEGER_BITS EQUAL 64)
    string(REPLACE "int32" "int64" SOURCE "${SOURCE}")
    string(REPLACE "2147483648" "9223372036854775808" SOURCE "${SOURCE}")
    string(REPLACE "2147483647" "9223372036854775807" SOURCE "${SOURCE}")
    string(REPLACE "2147483646" "9223372036854775806" SOURCE "${SOURCE}")
    string(REPLACE "1073741824" "4611686018427387904" SOURCE "${SOURCE}")
    string(REPLACE "16777218" "9007199254740994" SOURCE "${SOURCE}")
    string(REPLACE "16777217" "9007199254740993" SOURCE "${SOURCE}")
  endif()
  set(${OUTPUT} "${SOURCE}" PARENT_SCOPE)
endfunction()

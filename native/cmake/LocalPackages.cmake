if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-local-package-tests-${VARIANT} tests/LocalPackageTests.cpp)
    target_compile_options(kalandra-local-package-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-local-package-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-local-package-tests-${VARIANT} PRIVATE KALANDRA_LOCAL_PACKAGE_FRONTEND_ONLY)
      target_compile_options(kalandra-local-package-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-local-package-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-local-package-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-local-packages-frontend-${VARIANT} COMMAND kalandra-local-package-tests-${VARIANT} "${CMAKE_CURRENT_BINARY_DIR}/local-packages-frontend-${VARIANT}")
    set_tests_properties(native-local-packages-frontend-${VARIANT} PROPERTIES TIMEOUT 90)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(LOCAL_PACKAGE_RUNTIME kalandra-native-runtime-sanitized)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(LOCAL_PACKAGE_RUNTIME kalandra-native-runtime-thread-sanitized)
    else()
      set(LOCAL_PACKAGE_RUNTIME kalandra-native-runtime)
    endif()
    add_test(NAME native-local-packages-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DCHECKER=$<TARGET_FILE:kalandra-check>" "-DVARIANT=${VARIANT}"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=$<TARGET_FILE:${LOCAL_PACKAGE_RUNTIME}>"
        "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/local-packages-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyLocalPackages.cmake")
    set_tests_properties(native-local-packages-${VARIANT} PROPERTIES TIMEOUT 300)
  endforeach()
endif()

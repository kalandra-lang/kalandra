include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
function(RAW TYPE ID RANK KIND)
  set(TENSOR "Tensor[${TYPE}")
  set(PARAMETERS)
  set(INDICES)
  if(RANK GREATER 0)
    math(EXPR LAST "${RANK}-1")
    foreach(AXIS RANGE 0 ${LAST})
      string(APPEND TENSOR ",?")
      if(KIND EQUAL 1)
        set(INDEX_TYPE uint64)
      elseif(KIND EQUAL 2)
        if(AXIS EQUAL 1)
          set(INDEX_TYPE uint32)
        else()
          set(INDEX_TYPE int32)
        endif()
      elseif(KIND EQUAL 3)
        if(AXIS EQUAL 1)
          set(INDEX_TYPE int32)
        else()
          set(INDEX_TYPE uint32)
        endif()
      else()
        set(INDEX_TYPE int64)
      endif()
      string(APPEND PARAMETERS ",i${AXIS}:${INDEX_TYPE}")
      if(AXIS GREATER 0)
        string(APPEND INDICES ",")
      endif()
      string(APPEND INDICES "i${AXIS}")
    endforeach()
  endif()
  string(APPEND TENSOR "]")
  set(NAME "read-${TYPE}-${RANK}-${KIND}")
  COMPILE("${NAME}" "fn read(values:${TENSOR}${PARAMETERS})->${TYPE}:\n  values[${INDICES}]\nfn main()->int:\n  0\n" --test-entry read)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DNUMERIC_TYPE=${ID}" "-DTENSOR_RANK=${RANK}" "-DINDEX_KIND=${KIND}" -isystem "${LLVM_ROOT}/include"
    "${SOURCE_DIR}/tests/TensorIndexRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}"
    "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
  RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
endfunction()
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDS 2 6 3 7 8 9)
foreach(N RANGE 0 5)
  list(GET TYPES ${N} TYPE)
  list(GET IDS ${N} ID)
  foreach(KIND RANGE 0 3)
    RAW("${TYPE}" "${ID}" 2 "${KIND}")
  endforeach()
  if(TYPE STREQUAL "int64" OR TYPE STREQUAL "float32")
    foreach(RANK IN ITEMS 0 1 3 8)
      RAW("${TYPE}" "${ID}" "${RANK}" 0)
    endforeach()
  endif()
  set(SOURCE "fn get(values:Tensor[${TYPE},?,?],row:int,column:uint)->${TYPE}:\n  values[row,column]\nfn made()->Tensor[${TYPE},2,2]:\n  tensor([[${TYPE}(10),${TYPE}(20)],[${TYPE}(30),${TYPE}(40)]])\nfn read(values:Tensor[${TYPE},?,?],row:int,column:uint32):\n  mapped=map([${TYPE}(1),${TYPE}(2)],fn(x): values[row,column]+x)\n  mapped[1]\nfn inner(values:Tensor[${TYPE},?,?],row:int,column:uint32) ! TaskError:\n  try parallel:\n    child=spawn read(values,row,column)\n    try await child\nfn probe() ! TaskError:\n  original=made()\n  try parallel:\n    a=spawn inner(original,1,0)\n    b=spawn made()\n    values=try await b\n    first=try await a\n    again=try await a\n    first+again-values[1,0]-${TYPE}(2)\nfn bad() ! TaskError:\n  try parallel:\n    child=spawn get(made(),2,0)\n    try await child\nfn badColumn() ! TaskError:\n  try parallel:\n    child=spawn get(made(),0,2)\n    try await child\nfn recover() ! TaskError:\n  attempt=bad()\n  attempt catch fn(error):\n    match error:\n      TaskError.Fault { kind: cause, message: detail }:\n        match cause:\n          FaultKind.Bounds: ${TYPE}(32)\n          FaultKind.Arithmetic: ${TYPE}(1)\n          FaultKind.Shape: ${TYPE}(2)\n          FaultKind.Allocation: ${TYPE}(3)\n          FaultKind.Native: ${TYPE}(4)\n      TaskError.Cancelled: ${TYPE}(5)\n      TaskError.DeadlineExceeded: ${TYPE}(6)\n      TaskError.AdmissionRejected { reason: why }: ${TYPE}(7)\nfn main()->${TYPE} ! TaskError:\n  try probe()\n")
  if(TYPE STREQUAL "float32")
    set(EXPECTED 42000000)
  elseif(TYPE STREQUAL "float64")
    set(EXPECTED 4040000000000000)
  else()
    set(EXPECTED 20)
  endif()
  foreach(KIND IN ITEMS probe bad badColumn recover)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "-DDESTINATION_TYPE=${ID}" -DEXPECTED_FAULT=5 "${SOURCE_DIR}/tests/ConversionTaskTests.cpp"
      "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  EXPECT("probe-${TYPE}" 32)
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" "${MODE}" 0)
    endforeach()
    RUN_OK("${OUTPUT_DIR}/bad-${TYPE}-harness" "${WORKERS}" 0 5 0)
    RUN_OK("${OUTPUT_DIR}/badColumn-${TYPE}-harness" "${WORKERS}" 0 5 0)
    RUN_OK("${OUTPUT_DIR}/recover-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" 0 0)
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" 3 "${ATTEMPT}")
      if(WORKERS EQUAL 2)
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
          "${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" 3 0)
      endif()
    endforeach()
  endforeach()
endforeach()
COMPILE(precedence "fn main():\n  tensor([[1,2],[3,4]])[1,0]*2+1\n")
EXPECT(precedence 7)
COMPILE(rank-zero "fn main():\n  tensor(7)[]\n")
EXPECT(rank-zero 7)
COMPILE(post-group "fn made()->Tensor[int,2,2]:\n  tensor([[1,2],[3,4]])\nfn main() ! TaskError:\n  values=try parallel:\n    work=spawn made()\n    try await work\n  values[1,1]\n")
EXPECT(post-group 4)
COMPILE(rank-zero-worker "fn read(values:Tensor[int]):\n  values[]\nfn main() ! TaskError:\n  values=tensor(7)\n  try parallel:\n    work=spawn read(values)\n    try await work\n")
EXPECT(rank-zero-worker 7)
COMPILE(rank-three-worker "fn read(values:Tensor[int,?,?,?],a:int,b:int,c:int):\n  values[a,b,c]\nfn main() ! TaskError:\n  values=tensor([[[1,2],[3,4]],[[5,6],[7,8]]])\n  try parallel:\n    work=spawn read(values,1,0,1)\n    try await work\n")
EXPECT(rank-three-worker 6)
COMPILE(awaited-indices "fn row()->int:\n  1\nfn column()->uint32:\n  0\nfn main() ! TaskError:\n  values=tensor([[1,2],[3,4]])\n  try parallel:\n    a=spawn row()\n    b=spawn column()\n    values[try await a,try await b]\n")
EXPECT(awaited-indices 3)
# All operands execute before dimension validation. Faulting axis helpers keep their locations.
set(HELPERS "fn first(value:int)->int:\n  1/value\nfn second(value:int)->int:\n  2/value\n")
foreach(KIND IN ITEMS first second bounds-before-operand)
  if(KIND STREQUAL "first")
    set(BODY "values[first(0),second(0)]")
    set(LINE 2)
  elseif(KIND STREQUAL "second")
    set(BODY "values[first(1),second(0)]")
    set(LINE 4)
  else()
    set(BODY "values[row,second(0)]")
    set(LINE 4)
  endif()
  COMPILE("order-${KIND}" "${HELPERS}fn read(values:Tensor[int,?,?],row:int):\n  ${BODY}\nfn main():\n  read(tensor([[1,2],[3,4]]),-1)\n")
  execute_process(COMMAND "${OUTPUT_DIR}/order-${KIND}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  if(STATUS EQUAL 0 OR NOT ERR MATCHES "ArithmeticFault.*${LINE}:3")
    message(FATAL_ERROR "Tensor index evaluation order changed: ${STATUS}: ${ERR}")
  endif()
endforeach()
foreach(KIND IN ITEMS rank bounds type)
  if(KIND STREQUAL "rank")
    set(INVALID "fn main():\n  tensor([[1,2],[3,4]])[0]\n")
    set(CODE S063)
  elseif(KIND STREQUAL "bounds")
    set(INVALID "fn main():\n  tensor([[1,2],[3,4]])[0,2]\n")
    set(CODE S062)
  else()
    set(INVALID "fn main():\n  tensor([[1,2],[3,4]])[0,true]\n")
    set(CODE S061)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${KIND}.k" "${INVALID}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${KIND}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Tensor index diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
message(STATUS "Tensor indexing: six numeric types, mixed integer indices, ranks zero/one/two/three/eight, exact strided reads, per-axis bounds, worker captures/nesting/recovery/cached awaits, cancellation, admission and allocation failure passed")


include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDENTITIES 2 6 3 7 8 9)
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDENTITIES ${INDEX} ID)
  COMPILE("identity-${TYPE}" "fn identity(value:${TYPE})->${TYPE}:\n  value\nfn mapped(input:[${TYPE}]):\n  input -> map(identity)\nfn main()->int64:\n  0\n" --test-entry mapped)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}" -isystem "${LLVM_ROOT}/include"
    "${SOURCE_DIR}/tests/ArrayMapRuntimeTests.cpp" "${OUTPUT_DIR}/identity-${TYPE}.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/identity-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/identity-${TYPE}-harness")
  if(TYPE STREQUAL "float32")
    set(DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "float64")
    set(DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "int64")
    set(DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "uint64")
    set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "uint32")
    set(DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(DEFINES)
  endif()
  if(TYPE STREQUAL "int64")
    set(TWICE "data:Tensor[int64,2]=tensor([value,value])\n  reduceSum(data)")
  else()
    set(TWICE "value*2")
  endif()
  set(SOURCE "fn failing(value:int64)->int64:\n  1/value\nfn twice(value:${TYPE})->${TYPE}:\n  ${TWICE}\nfn transform(value:${TYPE})->${TYPE}:\n  if value==0:\n    value\n  else:\n    twice(value)\nfn identity(value:${TYPE})->${TYPE}:\n  value\nfn guard(value:${TYPE})->${TYPE}:\n  unused=failing(int64(value)-int64(value))\n  value\nfn run(values:[${TYPE}]):\n  values -> map(transform)\nfn faultProbe()->[${TYPE}] ! TaskError:\n  try parallel:\n    work=spawn map([${TYPE}(1)],guard)\n    try await work\nfn emptyProbe()->[${TYPE}] ! TaskError:\n  try parallel:\n    work=spawn map([],guard)\n    try await work\nfn probe() ! TaskError:\n  original=map([${TYPE}(1),${TYPE}(2),${TYPE}(3),${TYPE}(4)],identity)\n  attempted=faultProbe()\n  recovered=attempted catch fn(error): original\n  try parallel:\n    left=spawn run(recovered)\n    right=spawn map(original,transform)\n    a=try await left\n    b=try await right\n    again=try await right\n    again\nfn main()->int64 ! TaskError:\n  result=try probe()\n  7\n")
  foreach(KIND IN ITEMS probe emptyProbe faultProbe)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -DTENSOR_RANK=1 -DARRAY_RESULT=1 -DCONVERSION_RESULT=1 ${DEFINES}
      "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  EXPECT("probe-${TYPE}" 7)
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    RUN_OK("${OUTPUT_DIR}/emptyProbe-${TYPE}-harness" "${WORKERS}" 4 0)
    RUN_OK("${OUTPUT_DIR}/faultProbe-${TYPE}-harness" "${WORKERS}" 7 0)
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
      if(WORKERS EQUAL 2)
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
          "${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3)
      endif()
    endforeach()
  endforeach()
endforeach()
foreach(PAIR IN ITEMS "float64-float32" "float64-uint64" "int64-float64" "float32-float64")
  string(REPLACE "-" ";" PARTS "${PAIR}")
  list(GET PARTS 0 SOURCE_TYPE)
  list(GET PARTS 1 DESTINATION_TYPE)
  list(FIND TYPES ${SOURCE_TYPE} SOURCE_INDEX)
  list(FIND TYPES ${DESTINATION_TYPE} DESTINATION_INDEX)
  list(GET IDENTITIES ${SOURCE_INDEX} SOURCE_ID)
  list(GET IDENTITIES ${DESTINATION_INDEX} DESTINATION_ID)
  COMPILE("convert-${PAIR}" "fn convert(value:${SOURCE_TYPE})->${DESTINATION_TYPE}:\n  ${DESTINATION_TYPE}(value)\nfn mapped(input:[${SOURCE_TYPE}]):\n  map(input,convert)\nfn main()->int64:\n  0\n" --test-entry mapped)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -DTENSOR_RANK=1 "-DSOURCE_TYPE=${SOURCE_ID}" "-DDESTINATION_TYPE=${DESTINATION_ID}" -isystem "${LLVM_ROOT}/include"
    "${SOURCE_DIR}/tests/TensorConversionRuntimeTests.cpp" "${OUTPUT_DIR}/convert-${PAIR}.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/convert-${PAIR}-harness")
  RUN_OK("${OUTPUT_DIR}/convert-${PAIR}-harness")
endforeach()
foreach(ORDER IN ITEMS first second)
  if(ORDER STREQUAL "first")
    set(DATA "0,1")
    set(LINE 3)
  else()
    set(DATA "1,0")
    set(LINE 5)
  endif()
  COMPILE("order-${ORDER}" "fn failure(value:int)->int:\n  if value==0:\n    1/value\n  else:\n    1/(value-1)\nfn main()->int:\n  result=map([${DATA}],failure)\n  7\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/order-${ORDER}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source ${LINE}:5" OR NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Map first-fault order/source/cleanup failed: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
COMPILE(nested "fn twice(value:int)->int:\n  value*2\nfn nested(value:int)->int:\n  ignored=map([value],twice)\n  twice(value)\nfn wrapper(values:[int]):\n  map(values,nested)\nfn main()->int ! TaskError:\n  try parallel:\n    work=spawn wrapper([1,2,3])\n    result=try await work\n    7\n")
EXPECT(nested 7)
foreach(NAME IN ITEMS arity unknown effect)
  if(NAME STREQUAL "arity")
    set(SOURCE "fn bad(a:int,b:int)->int:\n  a+b\nfn main():\n  map([1,2],bad)\n")
    set(CODE S059)
  elseif(NAME STREQUAL "unknown")
    set(SOURCE "fn main():\n  map([1,2],unknown)\n")
    set(CODE S059)
  else()
    set(SOURCE "fn identity(value:int)->int:\n  value\nfn work(value:int)->int ! TaskError:\n  try parallel:\n    try await spawn identity(value)\nfn callback(value:int)->int:\n  attempted=work(value)\n  attempted catch fn(error): value\nfn main():\n  map([1,2],callback)\n")
    set(CODE S054)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${NAME}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${NAME}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Map diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
message(STATUS "Sequential map: six exact identities, mapped conversions, named helper graphs, direct/nested workers, empty arrays, first-fault ordering and retained ownership passed")

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(OP 0)
foreach(EXPR IN ITEMS "a+b" "a*b" "a*b+a" "a-b" "-a" "a/b")
  set(NAME "op-${OP}")
  COMPILE("${NAME}" "fn operation(a:float,b:float) -> float:\n  ${EXPR}\nfn forward(a:float,b:float) -> float:\n  operation(a,b)\nfn main() -> float:\n  1.0000000000000002\n" --test-entry forward)
  EXPECT("${NAME}" 1.0000000000000002)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module -ffp-contract=off ${FLAGS}
    -isystem "${LLVM_ROOT}/include" "${SOURCE_DIR}/tests/Float64RuntimeTests.cpp"
    "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
  RUN_OK("${OUTPUT_DIR}/${NAME}-harness" "${OP}")
  file(READ "${OUTPUT_DIR}/${NAME}.ll" LLVM)
  # LLVM may spell an exact sign-bit flip as fneg; rounded arithmetic must remain integer-only.
  if(LLVM MATCHES "(fadd|fsub|fmul|fdiv) double|fpext|fptrunc" OR NOT LLVM MATCHES "define double @_mlir_ciface_kalandra_test_entry")
    message(FATAL_ERROR "Source binary64 bypassed strict lowering or lost entry precision")
  endif()
  math(EXPR OP "${OP}+1")
endforeach()
set(CASE 0)
foreach(TEST IN ITEMS "-0.0|-0" "4.9406564584124654e-324|4.9406564584124654e-324" "1.7976931348623157e308|1.7976931348623157e+308" "1e-4000|0" "1 + 1.5|2.5" "(9007199254740992.0 + 1) - 9007199254740992.0|0" "1.0/0|inf" "-1.0/0|-inf")
  string(REPLACE "|" ";" FIELDS "${TEST}")
  list(GET FIELDS 0 EXPR)
  list(GET FIELDS 1 EXPECTED)
  COMPILE("literal-${CASE}" "fn main():\n  ${EXPR}\n")
  EXPECT("literal-${CASE}" "${EXPECTED}")
  math(EXPR CASE "${CASE}+1")
endforeach()
# Preserve previously existing output files on finite-literal overflow.
file(WRITE "${OUTPUT_DIR}/overflow.k" "fn main() -> float:\n  1.8e308\n")
file(WRITE "${OUTPUT_DIR}/preserved" "existing executable")
file(WRITE "${OUTPUT_DIR}/preserved.ll" "existing LLVM")
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/overflow.k" -o "${OUTPUT_DIR}/preserved"
  --emit-llvm "${OUTPUT_DIR}/preserved.ll" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
file(READ "${OUTPUT_DIR}/preserved" EXE)
file(READ "${OUTPUT_DIR}/preserved.ll" IR)
if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "S015" OR NOT EXE STREQUAL "existing executable" OR NOT IR STREQUAL "existing LLVM")
  message(FATAL_ERROR "Overflow literal published output: ${STATUS}: ${ERR}")
endif()
file(WRITE "${OUTPUT_DIR}/gpu.k" "fn helper(x:float64) -> float64:\n  x+1\nfn main() -> float32 ! TaskError:\n  1\n")
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/gpu.k" --target metal -o "${OUTPUT_DIR}/gpu"
  RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "float32" OR EXISTS "${OUTPUT_DIR}/gpu")
  message(FATAL_ERROR "Unsupported Metal float64 module admitted: ${STATUS}: ${ERR}")
endif()

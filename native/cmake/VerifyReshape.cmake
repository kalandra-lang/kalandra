include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDENTITIES 2 6 3 7 8 9)
function(RAW TYPE ID RANK KIND FIXED)
  set(PARAMS)
  set(SHAPE)
  if(KIND EQUAL 1)
    set(D0 uint64)
    set(D1 uint64)
  elseif(KIND EQUAL 2)
    set(D0 int32)
    set(D1 uint32)
  else()
    set(D0 int64)
    set(D1 int64)
  endif()
  if(RANK GREATER 0)
    set(PARAMS ",a:${D0}")
    set(SHAPE a)
  endif()
  if(RANK GREATER 1)
    string(APPEND PARAMS ",b:${D1}")
    string(APPEND SHAPE ",b")
  endif()
  if(RANK GREATER 2)
    string(APPEND PARAMS ",c:${D0}")
    string(APPEND SHAPE ",c")
  endif()
  set(RESULT)
  set(DEFINES)
  if(FIXED)
    set(RESULT "->Tensor[${TYPE},2,2]")
    set(DEFINES -DFIXED_RESHAPE=1)
  endif()
  set(NAME "raw-${TYPE}-${RANK}-${KIND}-${FIXED}")
  COMPILE("${NAME}" "fn reshape(input:[${TYPE}]${PARAMS})${RESULT}:\n  tensor(input,[${SHAPE}])\nfn main()->int:\n  0\n" --test-entry reshape)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}" "-DRESHAPE_RANK=${RANK}" "-DDIMENSION_KIND=${KIND}" ${DEFINES} -isystem "${LLVM_ROOT}/include"
    "${SOURCE_DIR}/tests/ReshapeRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
  RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
endfunction()
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDENTITIES ${INDEX} ID)
  RAW(${TYPE} ${ID} 2 0 0)
  if(TYPE STREQUAL "int64" OR TYPE STREQUAL "float32")
    foreach(RANK IN ITEMS 0 1 3)
      RAW(${TYPE} ${ID} ${RANK} 0 0)
    endforeach()
  endif()
  if(TYPE STREQUAL "int64")
    RAW(${TYPE} ${ID} 2 1 0)
    RAW(${TYPE} ${ID} 2 2 0)
    RAW(${TYPE} ${ID} 2 0 1)
  endif()
  if(TYPE STREQUAL "float32")
    set(DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "float64")
    set(DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "int64")
    set(DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "uint64")
    set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "uint32")
    set(DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(DEFINES)
  endif()
  set(SOURCE "fn failing(value:int)->int:\n  1/value\nfn uncertain(flag:Bool)->[${TYPE}]:\n  if flag: [${TYPE}(1)]\n  else: [${TYPE}(1),${TYPE}(2),${TYPE}(3),${TYPE}(4)]\nfn reshape(values:[${TYPE}],rows:int,columns:int):\n  tensor(values,[rows,columns])\nfn run(values:[${TYPE}],rows:int32,columns:uint64,one:int):\n  mapped=map(values,fn(x): reduceSum(tensor(map([x],fn(y): y+y),[one,one])))\n  tensor(mapped,[rows,columns])\nfn inner(values:[${TYPE}],rows:int,columns:int) ! TaskError:\n  try parallel:\n    work=spawn tensor(values,[rows,columns])\n    first=try await work\n    again=try await work\n    again\nfn bad(values:[${TYPE}],divisor:int):\n  tensor(values,[failing(divisor),1])\nfn faultProbe()->Tensor[${TYPE},?,?] ! TaskError:\n  values=[${TYPE}(1)]\n  try parallel:\n    work=spawn bad(values,0)\n    try await work\nfn shapeProbe()->Tensor[${TYPE},?,?] ! TaskError:\n  values=uncertain(true)\n  try parallel:\n    work=spawn reshape(values,2,2)\n    try await work\nfn emptyProbe()->Tensor[${TYPE},?,?] ! TaskError:\n  empty:[${TYPE}]=[]\n  try parallel:\n    work=spawn tensor(empty,[2,0])\n    try await work\nfn probe() ! TaskError:\n  original=[${TYPE}(1),${TYPE}(2),${TYPE}(3),${TYPE}(4)]\n  mapped=map(original,fn(x): x+x)\n  arithmeticAttempt=faultProbe()\n  arithmeticRecovered=arithmeticAttempt catch fn(error): tensor(mapped,[2,2])\n  shapeAttempt=shapeProbe()\n  shapeRecovered=shapeAttempt catch fn(error): tensor(mapped,[2,2])\n  rows=2\n  columns=2\n  try parallel:\n    nested=spawn inner(mapped,rows,columns)\n    left=spawn run(original,2,2,1)\n    right=spawn tensor(mapped,[rows,columns])\n    n=try await nested\n    a=try await left\n    b=try await right\n    again=try await right\n    (n+a+b+again+shapeRecovered+arithmeticRecovered)/6\nfn main()->${TYPE} ! TaskError:\n  result=try probe()\n  reduceSum(matmul(result,result))\n")
  foreach(KIND IN ITEMS probe emptyProbe faultProbe shapeProbe)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -DTENSOR_RANK=2 -DCONVERSION_RESULT=1 ${DEFINES}
      "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  EXPECT("probe-${TYPE}" 216)
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    RUN_OK("${OUTPUT_DIR}/emptyProbe-${TYPE}-harness" "${WORKERS}" 4 0)
    RUN_OK("${OUTPUT_DIR}/faultProbe-${TYPE}-harness" "${WORKERS}" 7 0)
    RUN_OK("${OUTPUT_DIR}/shapeProbe-${TYPE}-harness" "${WORKERS}" 6 0)
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
      if(WORKERS EQUAL 2)
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
          "${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3)
      endif()
    endforeach()
  endforeach()
endforeach()
COMPILE(literal-runtime "fn matrix(rows:int,columns:int):\n  tensor([1,2,3,4],[rows,columns])\nfn main()->int:\n  value=matrix(2,2)\n  reduceSum(matmul(value,value))\n")
EXPECT(literal-runtime 54)
COMPILE(rank-zero-worker "fn main()->int ! TaskError:\n  values=[7]\n  try parallel:\n    work=spawn tensor(values,[])\n    result=try await work\n    reduceSum(result)\n")
EXPECT(rank-zero-worker 7)
COMPILE(rank-three-worker "fn main()->int ! TaskError:\n  values=[1,2,3,4,5,6,7,8]\n  try parallel:\n    work=spawn tensor(values,[2,2,2])\n    result=try await work\n    reduceSum(result)\n")
EXPECT(rank-three-worker 36)
COMPILE(argument-order "fn first(value:int)->int:\n  1/value\nfn build(values:[int],negative:int):\n  tensor(values,[negative,first(0)])\nfn main()->int:\n  reduceSum(build([1],-1))\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/argument-order"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 2:3" OR NOT ERR MATCHES "cleanup: live=0")
  message(FATAL_ERROR "Dimension arguments were validated before evaluation completed: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(ORDER IN ITEMS first second)
  if(ORDER STREQUAL "first")
    set(DIMENSIONS "first(0),second(0)")
    set(LINE 2)
  else()
    set(DIMENSIONS "second(0),first(0)")
    set(LINE 4)
  endif()
  COMPILE("order-${ORDER}" "fn first(value:int)->int:\n  1/value\nfn second(value:int)->int:\n  2/value\nfn main():\n  values=[1,2,3,4]\n  reduceSum(tensor(values,[${DIMENSIONS}]))\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/order-${ORDER}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source ${LINE}:3" OR NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Reshape dimension order/source/cleanup failed: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
foreach(NAME IN ITEMS count dimension rank)
  if(NAME STREQUAL "count")
    set(SOURCE "fn main():\n  values=[1,2,3]\n  reduceSum(tensor(values,[2,2]))\n")
    set(CODE S050)
  elseif(NAME STREQUAL "dimension")
    set(SOURCE "fn reshape(values:[int],n:float):\n  tensor(values,[n,2])\nfn main()->int:\n  0\n")
    set(CODE S050)
  else()
    set(SOURCE "fn reshape(values:[int],shape:[int]):\n  tensor(values,shape)\nfn main()->int:\n  0\n")
    set(CODE S050)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${NAME}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${NAME}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Reshape diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
message(STATUS "Reshape: exact rank 0/1/2/3 copies, six numeric types, signed/unsigned dimensions, shape/count/byte/stride validation, active cancellation, ordered dimensions, matrix arithmetic and retained worker results passed")

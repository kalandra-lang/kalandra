include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES i32 u32 i64 u64 f32 f64)
set(IDENTITIES 2 6 3 7 8 9)
function(RAW TYPE ID RANK KIND FIXED)
  set(PARAMS)
  set(SHAPE)
  if(KIND EQUAL 1)
    set(D0 u64)
    set(D1 u64)
  elseif(KIND EQUAL 2)
    set(D0 i32)
    set(D1 u32)
  else()
    set(D0 i64)
    set(D1 i64)
  endif()
  if(RANK GREATER 0)
    set(PARAMS ",a:${D0}")
    set(SHAPE a)
  endif()
  if(RANK GREATER 1)
    string(APPEND PARAMS ",b:${D1}")
    string(APPEND SHAPE ",b")
  endif()
  if(RANK GREATER 2)
    string(APPEND PARAMS ",c:${D0}")
    string(APPEND SHAPE ",c")
  endif()
  set(RESULT)
  set(DEFINES)
  if(FIXED)
    set(RESULT "->Tensor[${TYPE},2,2]")
    set(DEFINES -DFIXED_RESHAPE=1)
  endif()
  set(NAME "raw-${TYPE}-${RANK}-${KIND}-${FIXED}")
  COMPILE("${NAME}" "fn reshape(input:[${TYPE}]${PARAMS})${RESULT}:\n  tensor(input,[${SHAPE}])\nfn main()->i64:\n  0\n" --test-entry reshape)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}" "-DRESHAPE_RANK=${RANK}" "-DDIMENSION_KIND=${KIND}" ${DEFINES} -isystem "${LLVM_ROOT}/include"
    "${SOURCE_DIR}/tests/ReshapeRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
  RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
endfunction()
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDENTITIES ${INDEX} ID)
  RAW(${TYPE} ${ID} 2 0 0)
  if(TYPE STREQUAL "i64" OR TYPE STREQUAL "f32")
    foreach(RANK IN ITEMS 0 1 3)
      RAW(${TYPE} ${ID} ${RANK} 0 0)
    endforeach()
  endif()
  if(TYPE STREQUAL "i64")
    RAW(${TYPE} ${ID} 2 1 0)
    RAW(${TYPE} ${ID} 2 2 0)
    RAW(${TYPE} ${ID} 2 0 1)
  endif()
  if(TYPE STREQUAL "f32")
    set(DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "f64")
    set(DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "i64")
    set(DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "u64")
    set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "u32")
    set(DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(DEFINES)
  endif()
  set(SOURCE "fn failing(value:i64)->i64:\n  return 1/value\nfn uncertain(flag:bool)->[${TYPE}]:\n  return if flag: [${TYPE}(1)]\n  else: [${TYPE}(1),${TYPE}(2),${TYPE}(3),${TYPE}(4)]\nfn reshape(values:[${TYPE}],rows:i64,columns:i64):\n  return tensor(values,[rows,columns])\nfn run(values:[${TYPE}],rows:i32,columns:u64,one:i64):\n  mapped=map(values,fn(x): return reduceSum(tensor(map([x],fn(y): return y+y),[one,one])))\n  return tensor(mapped,[rows,columns])\nfn inner(values:[${TYPE}],rows:i64,columns:i64) ! TaskError:\n  return try parallel:\n    work=spawn tensor(values,[rows,columns])\n    first=try await work\n    again=try await work\n    again\nfn bad(values:[${TYPE}],divisor:i64):\n  return tensor(values,[failing(divisor),1])\nfn faultProbe()->Tensor[${TYPE},?,?] ! TaskError:\n  values=[${TYPE}(1)]\n  return try parallel:\n    work=spawn bad(values,0)\n    try await work\nfn shapeProbe()->Tensor[${TYPE},?,?] ! TaskError:\n  values=uncertain(true)\n  return try parallel:\n    work=spawn reshape(values,2,2)\n    try await work\nfn emptyProbe()->Tensor[${TYPE},?,?] ! TaskError:\n  empty:[${TYPE}]=[]\n  return try parallel:\n    work=spawn tensor(empty,[2,0])\n    try await work\nfn probe() ! TaskError:\n  original=[${TYPE}(1),${TYPE}(2),${TYPE}(3),${TYPE}(4)]\n  mapped=map(original,fn(x): return x+x)\n  arithmeticAttempt=faultProbe()\n  arithmeticRecovered=arithmeticAttempt catch fn(error): return tensor(mapped,[2,2])\n  shapeAttempt=shapeProbe()\n  shapeRecovered=shapeAttempt catch fn(error): return tensor(mapped,[2,2])\n  rows=2\n  columns=2\n  return try parallel:\n    nested=spawn inner(mapped,rows,columns)\n    left=spawn run(original,2,2,1)\n    right=spawn tensor(mapped,[rows,columns])\n    n=try await nested\n    a=try await left\n    b=try await right\n    again=try await right\n    (n+a+b+again+shapeRecovered+arithmeticRecovered)/6\nfn main()->${TYPE} ! TaskError:\n  result=try probe()\n  return reduceSum(matmul(result,result))\n")
  foreach(KIND IN ITEMS probe emptyProbe faultProbe shapeProbe)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -DTENSOR_RANK=2 -DCONVERSION_RESULT=1 ${DEFINES}
      "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  EXPECT("probe-${TYPE}" 216)
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    RUN_OK("${OUTPUT_DIR}/emptyProbe-${TYPE}-harness" "${WORKERS}" 4 0)
    RUN_OK("${OUTPUT_DIR}/faultProbe-${TYPE}-harness" "${WORKERS}" 7 0)
    RUN_OK("${OUTPUT_DIR}/shapeProbe-${TYPE}-harness" "${WORKERS}" 6 0)
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
      if(WORKERS EQUAL 2)
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
          "${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3)
      endif()
    endforeach()
  endforeach()
endforeach()
COMPILE(literal-runtime "fn matrix(rows:i64,columns:i64):\n  return tensor([1,2,3,4],[rows,columns])\nfn main()->i64:\n  value=matrix(2,2)\n  return reduceSum(matmul(value,value))\n")
EXPECT(literal-runtime 54)
COMPILE(rank-zero-worker "fn main()->i64 ! TaskError:\n  values=[7]\n  return try parallel:\n    work=spawn tensor(values,[])\n    result=try await work\n    reduceSum(result)\n")
EXPECT(rank-zero-worker 7)
COMPILE(rank-three-worker "fn main()->i64 ! TaskError:\n  values=[1,2,3,4,5,6,7,8]\n  return try parallel:\n    work=spawn tensor(values,[2,2,2])\n    result=try await work\n    reduceSum(result)\n")
EXPECT(rank-three-worker 36)
COMPILE(argument-order "fn first(value:i64)->i64:\n  return 1/value\nfn build(values:[i64],negative:i64):\n  return tensor(values,[negative,first(0)])\nfn main()->i64:\n  return reduceSum(build([1],-1))\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/argument-order"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 2:10" OR NOT ERR MATCHES "cleanup: live=0")
  message(FATAL_ERROR "Dimension arguments were validated before evaluation completed: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(ORDER IN ITEMS first second)
  if(ORDER STREQUAL "first")
    set(DIMENSIONS "first(0),second(0)")
    set(LINE 2)
  else()
    set(DIMENSIONS "second(0),first(0)")
    set(LINE 4)
  endif()
  COMPILE("order-${ORDER}" "fn first(value:i64)->i64:\n  return 1/value\nfn second(value:i64)->i64:\n  return 2/value\nfn main():\n  values=[1,2,3,4]\n  return reduceSum(tensor(values,[${DIMENSIONS}]))\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/order-${ORDER}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source ${LINE}:10" OR NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Reshape dimension order/source/cleanup failed: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
foreach(NAME IN ITEMS count dimension rank)
  if(NAME STREQUAL "count")
    set(SOURCE "fn main():\n  values=[1,2,3]\n  return reduceSum(tensor(values,[2,2]))\n")
    set(CODE S050)
  elseif(NAME STREQUAL "dimension")
    set(SOURCE "fn reshape(values:[i64],n:f64):\n  return tensor(values,[n,2])\nfn main()->i64:\n  return 0\n")
    set(CODE S050)
  else()
    set(SOURCE "fn reshape(values:[i64],shape:[i64]):\n  return tensor(values,shape)\nfn main()->i64:\n  return 0\n")
    set(CODE S050)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${NAME}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${NAME}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Reshape diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
message(STATUS "Reshape: exact rank 0/1/2/3 copies, six numeric types, signed/unsigned dimensions, shape/count/byte/stride validation, active cancellation, ordered dimensions, matrix arithmetic and retained worker results passed")

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES i32 u32 i64 u64 f32 f64)
set(IDS 2 6 3 7 8 9)
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDS ${INDEX} ID)
  set(DECL "type Reading:\n  x:${TYPE}\n  y:${TYPE}\n  enabled:bool\n")
  set(HELPERS "fn identity(p:Reading)->Reading:\n  return p\nfn toggle(p:Reading)->Reading:\n  return p with {enabled:not p.enabled}\nfn child(p:Reading)->Reading ! TaskError:\n  return try parallel:\n    work=spawn identity(p)\n    first=try await work\n    again=try await work\n    again with {enabled:first.enabled}\nfn probe(p:Reading)->Reading ! TaskError:\n  return try parallel:\n    work=spawn child(p)\n    first=try await work\n    again=try await work\n    toggled=try await spawn toggle(first)\n    try await spawn toggle(toggled)\n")
  # A sibling with exactly the same physical layout remains a different nominal type.
  set(SIBLING "type Other:\n  x:${TYPE}\n  y:${TYPE}\n  enabled:bool\nfn sibling(p:Other)->Other:\n  return p\n")
  COMPILE("roundtrip-${TYPE}" "${DECL}${SIBLING}${HELPERS}fn main()->bool ! TaskError:\n  original=Reading {enabled:true,y:3,x:2}\n  result=try probe(original)\n  other=try parallel:\n    try await spawn sibling(Other {x:2,y:3,enabled:true})\n  result.x==original.x and result.y==other.y and result.enabled==other.enabled\n" --test-entry probe)
  EXPECT("roundtrip-${TYPE}" true)
  file(READ "${OUTPUT_DIR}/roundtrip-${TYPE}.ll" IR)
  if(NOT IR MATCHES "value.layout.record.0" OR NOT IR MATCHES "value.layout.record.1")
    message(FATAL_ERROR "Nominal record worker layouts were merged")
  endif()
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}"
    "${SOURCE_DIR}/tests/RecordWorkerRuntimeTests.cpp" "${OUTPUT_DIR}/roundtrip-${TYPE}.ll" "${RUNTIME}"
    -o "${OUTPUT_DIR}/roundtrip-${TYPE}-harness")
  foreach(WORKERS IN ITEMS 1 2 4)
    RUN_OK("${OUTPUT_DIR}/roundtrip-${TYPE}-harness" "${WORKERS}" 0 0)
    if(NOT WORKERS EQUAL 2)
      foreach(MODE IN ITEMS 1 2 4)
        RUN_OK("${OUTPUT_DIR}/roundtrip-${TYPE}-harness" "${WORKERS}" "${MODE}" 0)
      endforeach()
      if(TYPE STREQUAL "i64")
        foreach(FAIL_AT RANGE 1 16)
          RUN_OK("${OUTPUT_DIR}/roundtrip-${TYPE}-harness" "${WORKERS}" 3 "${FAIL_AT}")
        endforeach()
      endif()
    endif()
  endforeach()
  COMPILE("update-${TYPE}" "${DECL}fn shift(p:Reading,delta:${TYPE})->Reading:\n  return p with {x:p.x+delta}\nfn nested(p:Reading)->Reading ! TaskError:\n  return try parallel:\n    work=spawn shift(p,10)\n    first=try await work\n    again=try await work\n    first with {y:again.x}\nfn main()->${TYPE} ! TaskError:\n  original=Reading {x:2,y:3,enabled:true}\n  moved=try parallel:\n    work=spawn nested(original)\n    try await work\n  return moved.x+moved.y+original.x\n")
  EXPECT("update-${TYPE}" 26)
endforeach()
COMPILE(bool-only "type Flag:\n  enabled:bool\nfn flip(flag:Flag)->Flag:\n  return flag with {enabled:not flag.enabled}\nfn main()->bool ! TaskError:\n  flag=try parallel:\n    try await spawn flip(Flag {enabled:false})\n  return flag.enabled\n")
EXPECT(bool-only true)
COMPILE(mixed "type Mixed:\n  i:i32\n  u:u32\n  wide:i64\n  uwide:u64\n  f:f32\n  d:f64\n  flag:bool\nfn echo(p:Mixed)->Mixed:\n  return p\nfn main()->bool ! TaskError:\n  original=Mixed {flag:true,d:0.1,f:-0.0,uwide:18446744073709551615,wide:-9223372036854775808,u:4294967295,i:-2147483648}\n  p=try parallel:\n    try await spawn echo(original)\n  return p.flag and p.i==original.i and p.u==original.u and p.wide==original.wide and p.uwide==original.uwide and p.d==original.d and p.f==original.f\n")
EXPECT(mixed true)
set(DECL "type Point:\n  x:i64\n  y:i64\n")
set(FAILERS "fn bad(p:Point,divisor:i64)->Point:\n  return p with {x:p.x/divisor}\nfn attempt()->Point ! TaskError:\n  return try parallel:\n    try await spawn bad(Point {x:1,y:2},0)\n")
COMPILE(recovery "${DECL}${FAILERS}fn main():\n  p=attempt() catch fn(error): Point {x:7,y:8}\n  p.x+p.y\n")
EXPECT(recovery 15)
COMPILE(rethrow "${DECL}${FAILERS}fn relay()->Point ! TaskError:\n  attempt() catch fn(error): fail error\nfn main():\n  p=relay() catch fn(error): Point {x:7,y:8}\n  p.x+p.y\n")
EXPECT(rethrow 15)
COMPILE(match "${DECL}${FAILERS}fn main():\n  p=attempt() catch fn(error):\n    match error:\n      TaskError.Fault {kind}:\n        match kind:\n          FaultKind.Arithmetic: Point {x:7,y:8}\n          _: Point {x:9,y:10}\n      _: Point {x:11,y:12}\n  p.x+p.y\n")
EXPECT(match 15)
COMPILE(handler-task "${DECL}${FAILERS}fn fallback(p:Point)->Point:\n  p with {x:p.x+1}\nfn recovered()->Point ! TaskError:\n  attempt() catch fn(error):\n    try parallel:\n      try await spawn fallback(Point {x:7,y:8})\nfn main()->i64 ! TaskError:\n  p=try recovered()\n  p.x+p.y\n")
EXPECT(handler-task 16)
COMPILE(conditional "${DECL}fn choose(p:Point,flag:bool)->Point ! TaskError:\n  return if flag:\n    try parallel:\n      try await spawn identity(p)\n  else: p with {x:7}\nfn identity(p:Point)->Point:\n  return p\nfn main()->i64 ! TaskError:\n  p=try choose(Point {x:1,y:2},true)\n  q=try choose(p,false)\n  return p.x+q.x\n")
EXPECT(conditional 8)
COMPILE(map "${DECL}fn read(x:i64):\n  return Point {x:x,y:1}.x\nfn work(p:Point,values:[i64])->[i64]:\n  offset=p.x\n  return map(values,fn(x):return read(x)+offset)\nfn main()->[i64] ! TaskError:\n  return try parallel:\n    try await spawn work(Point {x:3,y:4},[1,2,3])\n")
EXPECT(map "[4, 5, 6]")
COMPILE(tensor "${DECL}fn size(values:Tensor[i64,?,?])->Point:\n  dimensions=shape(values)\n  return Point {x:dimensions[0],y:dimensions[1]}\nfn main()->i64 ! TaskError:\n  p=try parallel:\n    try await spawn size(tensor([[1,2,3],[4,5,6]]))\n  return p.x*p.y\n")
EXPECT(tensor 6)
file(WRITE "${OUTPUT_DIR}/points.k" "${DECL}export fn make(x:i64):\n  return Point {x:x,y:2}\nexport fn shifted(p:Point):\n  return p with {x:p.x+10}\n")
file(WRITE "${OUTPUT_DIR}/service.k" "from \"./points.k\" import shifted,make\nexport fn run(value:i64) ! TaskError:\n  return try parallel:\n    try await spawn shifted(make(value))\n")
COMPILE(modules "from \"./points.k\" import make,shifted\nfrom \"./service.k\" import run\nfn main()->i64 ! TaskError:\n  original=make(2)\n  moved=try parallel:\n    work=spawn shifted(original)\n    p=try await work\n    p\n  other=try run(2)\n  return moved.x+original.x+other.x\n")
EXPECT(modules 26)
# More fields and mixed packet sizes use the same generic aggregate machinery.
set(WIDE "type Wide:\n")
set(FIELDS "")
foreach(N RANGE 1 20)
  string(APPEND WIDE "  f${N}:int\n")
  if(N GREATER 1)
    string(APPEND FIELDS ",")
  endif()
  string(APPEND FIELDS "f${N}:${N}")
endforeach()
COMPILE(wide "${WIDE}fn echo(p:Wide)->Wide:\n  p with {f20:p.f20+1}\nfn main()->i64 ! TaskError:\n  p=try parallel:\n    try await spawn echo(Wide {${FIELDS}})\n  p.f1+p.f20\n")
EXPECT(wide 22)
COMPILE(failure "${DECL}${FAILERS}fn main()->i64 ! TaskError:\n  p=try attempt()\n  p.x\n")
execute_process(COMMAND "${OUTPUT_DIR}/failure" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "TaskError[.]Fault")
  message(FATAL_ERROR "Failed record worker exposed partial output: ${STATUS}: ${OUT}${ERR}")
endif()
message(STATUS "Record workers: exact copied fields, nominal layouts, nested/cached results, recovery, cancellation/deadline/admission/allocation settlement and collections/modules passed")

if(BUILD_TESTING)
  add_custom_target(native-workgroup-qualification)
  if(TARGET kalandra-workgroup-emitter-tests)
    add_dependencies(native-workgroup-qualification kalandra-workgroup-emitter-tests)
  endif()
  foreach(suite IN ITEMS safety geometry)
    if(suite STREQUAL "safety")
      set(source WorkgroupSafety)
    else()
      set(source WorkgroupGeometry)
    endif()
    foreach(variant IN ITEMS debug optimized sanitized)
      set(target kalandra-workgroup-${suite}-${variant})
      add_executable(${target} tests/${source}Tests.cpp lib/${source}.cpp)
      add_dependencies(native-workgroup-qualification ${target})
      target_include_directories(${target} PRIVATE include)
      target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
      if(variant STREQUAL "optimized")
        target_compile_options(${target} PRIVATE -O2)
      elseif(variant STREQUAL "sanitized")
        target_compile_options(${target} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
        target_link_options(${target} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
      else()
        target_compile_options(${target} PRIVATE -O0)
      endif()
      add_test(NAME frontend-workgroup-${suite}-${variant} COMMAND ${target})
      set_tests_properties(frontend-workgroup-${suite}-${variant} PROPERTIES TIMEOUT 30)
    endforeach()

  endforeach()
  add_dependencies(native-workgroup-qualification kalandra-check kalandra-check-sanitized)
  foreach(variant IN ITEMS debug sanitized)
    set(checker kalandra-check)
    if(variant STREQUAL "sanitized")
      set(checker kalandra-check-sanitized)
    endif()
    add_test(NAME frontend-workgroup-source-${variant}
      COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/WorkgroupSourceTests.py"
        --checker "$<TARGET_FILE:${checker}>"
        --output "${CMAKE_CURRENT_BINARY_DIR}/workgroup-source-${variant}")
    set_tests_properties(frontend-workgroup-source-${variant} PROPERTIES TIMEOUT 180)
  endforeach()
endif()

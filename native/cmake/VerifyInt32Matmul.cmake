# Shared checked 8/16/32/64-bit integer matmul qualification.
if(NOT DEFINED NUMERIC_TYPE)
  set(NUMERIC_TYPE int32)
endif()
set(UNSIGNED_INPUT 0)
set(INTEGER_BITS 32)
set(MAXIMUM 2147483647)
set(NEAR_MAXIMUM 4294836225)
if(NUMERIC_TYPE MATCHES "^uint")
  set(UNSIGNED_INPUT 1)
  set(MAXIMUM 4294967295)
endif()
if(NUMERIC_TYPE MATCHES "64$")
  set(INTEGER_BITS 64)
  set(NEAR_MAXIMUM 18446744065119617025)
  if(UNSIGNED_INPUT)
    set(MAXIMUM 18446744073709551615)
  else()
    set(MAXIMUM 9223372036854775807)
  endif()
endif()
if(NUMERIC_TYPE MATCHES "(8|16)$")
  set(INTEGER_BITS ${CMAKE_MATCH_1})
  if(INTEGER_BITS EQUAL 8)
    set(SQUARE_LIMIT 15)
    set(NEAR_MAXIMUM 225)
    if(UNSIGNED_INPUT)
      set(MAXIMUM 255)
      set(UPPER_HALF 128)
    else()
      set(MAXIMUM 127)
      set(UPPER_HALF 64)
    endif()
  else()
    set(SQUARE_LIMIT 255)
    set(NEAR_MAXIMUM 65025)
    if(UNSIGNED_INPUT)
      set(MAXIMUM 65535)
      set(UPPER_HALF 32768)
    else()
      set(MAXIMUM 32767)
      set(UPPER_HALF 16384)
    endif()
  endif()
endif()
if(NOT NUMERIC_TYPE MATCHES "^(int|uint)(8|16|32|64)$")
  message(FATAL_ERROR "Unsupported matmul qualification type: ${NUMERIC_TYPE}")
endif()
function(SPECIALIZE INPUT OUTPUT)
  string(REPLACE "int32" "${NUMERIC_TYPE}" SOURCE "${INPUT}")
  if(UNSIGNED_INPUT)
    if(INTEGER_BITS EQUAL 64)
      string(REPLACE "16777217,-10" "9007199254740993,10" SOURCE "${SOURCE}")
    else()
      string(REPLACE "16777217,-10" "2147483648,10" SOURCE "${SOURCE}")
    endif()
    string(REPLACE "1073741824,-1073741824" "2147483648,2147483648" SOURCE "${SOURCE}")
    string(REPLACE "2147483647,1,-1" "4294967295,1,0" SOURCE "${SOURCE}")
    string(REPLACE "2147483647,0,1,0" "4294967295,0,1,0" SOURCE "${SOURCE}")
  endif()
  if(INTEGER_BITS EQUAL 64)
    string(REPLACE "4294967295" "18446744073709551615" SOURCE "${SOURCE}")
    string(REPLACE "2147483648" "9223372036854775808" SOURCE "${SOURCE}")
    string(REPLACE "2147483647" "9223372036854775807" SOURCE "${SOURCE}")
    string(REPLACE "1073741824" "4611686018427387904" SOURCE "${SOURCE}")
    string(REPLACE "16777217" "9007199254740993" SOURCE "${SOURCE}")
    string(REPLACE "65535" "4294967295" SOURCE "${SOURCE}")
  endif()
  if(INTEGER_BITS LESS 32)
    string(REPLACE "16777217,-10" "42,-10" SOURCE "${SOURCE}")
    string(REPLACE "2147483648,10" "42,10" SOURCE "${SOURCE}")
    string(REPLACE "100,200" "10,20" SOURCE "${SOURCE}")
    string(REPLACE "65535,0" "${SQUARE_LIMIT},0" SOURCE "${SOURCE}")
    math(EXPR LOWER_HALF "${UPPER_HALF} - 1")
    string(REPLACE "2147483648,2147483647" "${UPPER_HALF},${LOWER_HALF}" SOURCE "${SOURCE}")
    string(REPLACE "4294967295" "${MAXIMUM}" SOURCE "${SOURCE}")
    string(REPLACE "2147483648" "${UPPER_HALF}" SOURCE "${SOURCE}")
    string(REPLACE "2147483647" "${MAXIMUM}" SOURCE "${SOURCE}")
    string(REPLACE "1073741824" "${UPPER_HALF}" SOURCE "${SOURCE}")
    string(REPLACE "[[7,8],[9,10],[11,12]]" "[[1,2],[1,2],[1,2]]" SOURCE "${SOURCE}")
  endif()
  set(${OUTPUT} "${SOURCE}" PARENT_SCOPE)
endfunction()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(EXTRA)
set(FLAGS -O0)
if(VARIANT STREQUAL "optimized")
  set(EXTRA -O2)
  set(FLAGS -O2)
elseif(VARIANT STREQUAL "sanitized")
  set(EXTRA --sanitize)
  set(FLAGS -O1 -fsanitize=address,undefined -fno-sanitize-recover=all)
elseif(VARIANT STREQUAL "thread-sanitized")
  set(EXTRA --thread-sanitize)
  set(FLAGS -O1 -fsanitize=thread)
endif()
function(RUN_OK)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "0" OR NOT ERR STREQUAL "")
    message(FATAL_ERROR "Failed: ${ARGN}: ${STATUS}: ${OUT}${ERR}")
  endif()
  message(STATUS "${OUT}")
endfunction()
SPECIALIZE("fn operation(a:Tensor[int32,?,?],b:Tensor[int32,?,?]) -> Tensor[int32,?,?]:\n  matmul(a,b)\nfn main() -> int32:\n  0\n" SOURCE)
file(WRITE "${OUTPUT_DIR}/dynamic.k" "${SOURCE}")
RUN_OK("${COMPILER}" "${OUTPUT_DIR}/dynamic.k" -o "${OUTPUT_DIR}/dynamic"
  --test-entry operation --emit-llvm "${OUTPUT_DIR}/dynamic.ll" --emit-mlir "${OUTPUT_DIR}/dynamic.mlir" ${EXTRA})
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "-DUNSIGNED_INPUT=${UNSIGNED_INPUT}" "-DINTEGER_BITS=${INTEGER_BITS}" "${HARNESS_SOURCE}" "${OUTPUT_DIR}/dynamic.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/dynamic-harness")
RUN_OK("${OUTPUT_DIR}/dynamic-harness")
function(COMPILE NAME SOURCE)
  SPECIALIZE("${SOURCE}" SOURCE)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  RUN_OK("${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/${NAME}.mlir" ${EXTRA})
endfunction()
function(VERIFY NAME EXPECTED)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" STREQUAL "0" OR NOT OUT STREQUAL "${EXPECTED}\n" OR NOT ERR STREQUAL "")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT}${ERR}; expected ${EXPECTED}")
    endif()
  endforeach()
endfunction()
COMPILE(fixed "fn operation(a:Tensor[int32,2,3],b:Tensor[int32,3,2]) -> Tensor[int32,2,2]:\n  matmul(a,b)\nfn main() -> int32:\n  a:Tensor[int32,2,3] = tensor([[1,2,3],[4,5,6]])\n  b:Tensor[int32,3,2] = tensor([[7,8],[9,10],[11,12]])\n  reduceSum(operation(a,b))\n")
if(INTEGER_BITS LESS 32)
  VERIFY(fixed 63)
else()
  VERIFY(fixed 415)
endif()
if(UNSIGNED_INPUT)
  file(READ "${OUTPUT_DIR}/dynamic.mlir" IR)
  if(NOT IR MATCHES "arith.extui" OR NOT IR MATCHES "${MAXIMUM}" OR NOT IR MATCHES "ule")
    message(FATAL_ERROR "Unsigned matmul lost zero extension or unsigned bounds checks")
  endif()
  foreach(KIND IN ITEMS maximum near-maximum)
    if(KIND STREQUAL "maximum")
      set(A "2147483648,2147483647")
      set(B "1,1")
      set(EXPECTED ${MAXIMUM})
    else()
      set(A "65535,0")
      set(B "65535,0")
      set(EXPECTED ${NEAR_MAXIMUM})
    endif()
    COMPILE("${KIND}" "fn main() -> int32:\n  a:Tensor[int32,1,2] = tensor([${A}],[1,2])\n  b:Tensor[int32,2,1] = tensor([${B}],[2,1])\n  reduceSum(matmul(a,b))\n")
    VERIFY("${KIND}" "${EXPECTED}")
  endforeach()
endif()
set(PREFIX "fn product(a:Tensor[int32,?,?],b:Tensor[int32,?,?]) -> Tensor[int32,?,?]:\n  matmul(a,b)\nfn nested(values:Tensor[int32,?,?]) -> Tensor[int32,?,?] ! TaskError:\n  identity:Tensor[int32,2,2] = tensor([[1,0],[0,1]])\n  adjusted = values + 1\n  try parallel:\n    work = spawn product(adjusted,identity)\n    first = try await work\n    again = try await work\n    first + (again - first) + 1\n")
COMPILE(nested "${PREFIX}fn probe() -> Tensor[int32,?,?] ! TaskError:\n  values:Tensor[int32,2,2] = tensor([[16777217,-10],[100,200]])\n  try parallel:\n    try await spawn nested(values)\nfn main() -> int32:\n  0\n")
RUN_OK("${COMPILER}" "${OUTPUT_DIR}/nested.k" -o "${OUTPUT_DIR}/nested"
  --test-entry probe --emit-llvm "${OUTPUT_DIR}/nested.ll" --emit-mlir "${OUTPUT_DIR}/nested.mlir" ${EXTRA})
set(OPT_LINK)
if(VARIANT STREQUAL "optimized")
  set(OPT_LINK "${OPT_RUNTIME}")
endif()
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  -DTENSOR_RANK=2 -DFLOAT_RESULT=0 "-DINTEGER_BITS=${INTEGER_BITS}" "-DUNSIGNED_RESULT=${UNSIGNED_INPUT}" "${TASK_HARNESS_SOURCE}" "${OUTPUT_DIR}/nested.ll"
  ${OPT_LINK} "${RUNTIME}" -o "${OUTPUT_DIR}/nested-harness")
foreach(WORKERS IN ITEMS 1 2 4)
  foreach(MODE IN ITEMS 0 1 2 4)
    RUN_OK("${OUTPUT_DIR}/nested-harness" "${WORKERS}" 2 "${MODE}")
  endforeach()
  set(ALLOCATION_ATTEMPTS 12)
  if(NOT INTEGER_BITS EQUAL 32)
    set(ALLOCATION_ATTEMPTS 24)
  endif()
  foreach(ATTEMPT RANGE 1 ${ALLOCATION_ATTEMPTS})
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
      "${OUTPUT_DIR}/nested-harness" "${WORKERS}" 2 3)
  endforeach()
endforeach()
set(BATCH "fn batch(a:Tensor[int32,?,?],b:Tensor[int32,?,?]) -> Tensor[int32,?,?] ! TaskError:\n  try parallel:\n    try await spawn product(a,b)\n")
foreach(KIND IN ITEMS product pair later)
  if(KIND STREQUAL "product")
    set(A "tensor([[1073741824,-1073741824]])")
    set(B "tensor([[2],[2]])")
    set(INNER 2)
  elseif(KIND STREQUAL "pair")
    set(A "tensor([[2147483647,1,-1]])")
    set(B "tensor([[1],[1],[1]])")
    set(INNER 3)
  else()
    set(A "tensor([[2147483647,0,1,0]])")
    set(B "tensor([[1],[1],[1],[1]])")
    set(INNER 4)
  endif()
  set(INPUT "  a:Tensor[int32,1,${INNER}] = ${A}\n  b:Tensor[int32,${INNER},1] = ${B}\n")
  COMPILE("${KIND}-recovery" "${PREFIX}${BATCH}fn main() -> int32 ! TaskError:\n${INPUT}  result = batch(a,b)\n  recovered = result catch fn(error):\n    match error:\n      TaskError.Fault {kind:cause,message:detail}:\n        match cause:\n          FaultKind.Arithmetic: a\n          _: a - a\n      _: a - a\n  try parallel:\n    work = spawn product(recovered - a,b)\n    completed = try await work\n    reduceSum(completed)\n")
  VERIFY("${KIND}-recovery" 0)
  COMPILE("${KIND}-fault" "${PREFIX}${BATCH}fn main() -> int32 ! TaskError:\n${INPUT}  try batch(a,b)\n  0\n")
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${KIND}-fault"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" STREQUAL "88" OR NOT OUT STREQUAL "" OR
       NOT ERR MATCHES "TaskError.Fault at source 2:3" OR NOT ERR MATCHES "cleanup: live=0")
      message(FATAL_ERROR "Matmul ${KIND} task fault/source/cleanup: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()
COMPILE(empty-task "${PREFIX}fn main() -> int32 ! TaskError:\n  a:Tensor[int32,2,0] = tensor([],[2,0])\n  b:Tensor[int32,0,3] = tensor([],[0,3])\n  try parallel:\n    work = spawn product(a,b)\n    value = try await work\n    reduceSum(value)\n")
VERIFY(empty-task 0)
COMPILE(sync-fault "fn product(a:Tensor[int32,?,?],b:Tensor[int32,?,?]) -> Tensor[int32,?,?]:\n  matmul(a,b)\nfn main() -> int32:\n  a:Tensor[int32,1,2] = tensor([[1073741824,-1073741824]])\n  b:Tensor[int32,2,1] = tensor([[2],[2]])\n  reduceSum(product(a,b))\n")
execute_process(COMMAND "${OUTPUT_DIR}/sync-fault" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "86" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 2:3")
  message(FATAL_ERROR "Synchronous matmul overflow: ${STATUS}: ${OUT}${ERR}")
endif()
block()
  if(UNSIGNED_INPUT)
    set(ENDPOINT ${MAXIMUM})
  else()
    math(EXPR ENDPOINT "-${MAXIMUM} - 1")
  endif()
  COMPILE(endpoint "fn product(a:Tensor[int32,1,1],b:Tensor[int32,1,1]) -> Tensor[int32,1,1]:\n  matmul(a,b)\nfn main() -> int32 ! TaskError:\n  a:Tensor[int32,1,1] = tensor([[${ENDPOINT}]])\n  b:Tensor[int32,1,1] = tensor([[1]])\n  try parallel:\n    result = try await spawn product(a,b)\n    reduceSum(result)\n")
  VERIFY(endpoint ${ENDPOINT})
  message(STATUS "${NUMERIC_TYPE} exact endpoint and allocation probes passed with 1/2/4 workers")
endblock()
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/nested.k" --target metal
  -o "${OUTPUT_DIR}/unsupported-metal" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "${NUMERIC_TYPE}" OR EXISTS "${OUTPUT_DIR}/unsupported-metal")
  message(FATAL_ERROR "Metal integer matmul accidentally enabled: ${STATUS}: ${ERR}")
endif()
message(STATUS "Checked CPU ${NUMERIC_TYPE} matmul: exact products/adjacent tree, ranked shape faults, empty contractions, nested retained tensor results, Arithmetic recovery and 1/2/4 worker cleanup passed")

# Static errors must preserve an existing executable and IR.
foreach(KIND IN ITEMS shape mixed rank)
  if(KIND STREQUAL "shape")
    set(SOURCE "fn product(a:Tensor[${NUMERIC_TYPE},2,3],b:Tensor[${NUMERIC_TYPE},4,2]) -> Tensor[${NUMERIC_TYPE},2,2]:\n  matmul(a,b)\n")
    set(DIAGNOSTIC S029)
  elseif(KIND STREQUAL "mixed")
    set(SOURCE "fn product(a:Tensor[${NUMERIC_TYPE},?,?],b:Tensor[float32,?,?]) -> Tensor[${NUMERIC_TYPE},?,?]:\n  matmul(a,b)\n")
    set(DIAGNOSTIC S017)
  else()
    set(SOURCE "fn product(a:Tensor[${NUMERIC_TYPE},?]) -> Tensor[${NUMERIC_TYPE},?,?]:\n  matmul(a,a)\n")
    set(DIAGNOSTIC S028)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${KIND}.k" "${SOURCE}fn main() -> ${NUMERIC_TYPE}:\n  0\n")
  file(WRITE "${OUTPUT_DIR}/preserved" "existing output")
  file(WRITE "${OUTPUT_DIR}/preserved.ll" "existing IR")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${KIND}.k" -o "${OUTPUT_DIR}/preserved"
    --emit-llvm "${OUTPUT_DIR}/preserved.ll" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" EXE)
  file(READ "${OUTPUT_DIR}/preserved.ll" IR)
  if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "${DIAGNOSTIC}" OR
     NOT EXE STREQUAL "existing output" OR NOT IR STREQUAL "existing IR")
    message(FATAL_ERROR "${NUMERIC_TYPE} matmul ${KIND} static gate/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()

foreach(NAME IN ITEMS selected residual worker callback capture)
  foreach(ATTEMPT RANGE 1 24)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Narrowing cleanup failed: ${NAME} ${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()
foreach(MODE IN ITEMS selected task-only)
  file(READ "${OUTPUT_DIR}/${MODE}.k" PROGRAM)
  string(FIND "${PROGRAM}" "fn main()" MAIN_OFFSET)
  string(SUBSTRING "${PROGRAM}" 0 ${MAIN_OFFSET} PREFIX)
  if(MODE STREQUAL "selected")
    set(CHANNEL A)
    set(ARGUMENT 0)
    set(EXIT 89)
    set(NAME "A.Bad")
  else()
    set(CHANNEL TaskError)
    set(ARGUMENT 4)
    set(EXIT 88)
    set(NAME "TaskError.Fault at source")
  endif()
  COMPILE("unhandled-${MODE}" "${PREFIX}fn main()->int ! ${CHANNEL}:\n  try only(${ARGUMENT})\n")
  execute_process(COMMAND "${OUTPUT_DIR}/unhandled-${MODE}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "${EXIT}" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "${NAME}")
    message(FATAL_ERROR "Narrowing changed CLI error identity: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES "error A:\n  Bad:\n    text:String\n    values:[int]\n  Missing\nerror B:\n  Other:\n    value:int\nerror C:\n  Last\ntype Apps=A | B | C\ntype Mixed=Apps | TaskError\ntype Rest=B | C | TaskError\n")
set(WORK "fn divide(value:int)->int:\n  8/value\nfn work(mode:int)->int ! Mixed:\n  if mode==0:fail A.Bad {text:\"é\"+\"🙂\",values:[20,22]}\n  if mode==1:fail A.Missing\n  if mode==2:fail B.Other {value:7}\n  if mode==3:fail C.Last\n  try parallel:\n    try await spawn divide(mode-4)\n")
set(HANDLER "catch fn(error):\n    match error:\n      A.Bad {text,values}:length(text)+values[0]+values[1]\n      A.Missing:5\n      B.Other {value}:value\n      C.Last:9\n      TaskError.Fault {kind,message}:\n        match kind:\n          FaultKind.Arithmetic:100+length(message)\n          _:900\n      _:800\n")
COMPILE(selected "${TYPES}${WORK}fn only(mode:int)->int ! A:\n  work(mode) catch fn(error):\n    match error:\n      A.Bad:fail error\n      A.Missing:fail error\n      _:0\nfn recover(mode:int)->int:\n  only(mode) catch fn(error):\n    match error:\n      A.Bad {text,values}:length(text)+values[0]+values[1]\n      A.Missing:5\nfn main()->[int]:\n  [recover(0),recover(1),recover(2),recover(4),recover(6)]\n")
EXPECT(selected "[44, 5, 0, 0, 4]")
COMPILE(residual "${TYPES}${WORK}fn only(mode:int)->int ! Rest:\n  work(mode) catch fn(error):\n    match error:\n      A.Bad:0\n      A.Missing:1\n      _:fail error\nfn recover(mode:int)->int:\n  only(mode) catch fn(error):\n    match error:\n      B.Other {value}:value\n      C.Last:9\n      TaskError.Fault {kind,message}:\n        match kind:\n          FaultKind.Arithmetic:100+length(message)\n          _:900\n      _:800\nfn main()->[int]:\n  [recover(0),recover(1),recover(2),recover(3),recover(4),recover(6)]\n")
EXPECT(residual "[0, 1, 7, 9, 124, 4]")
COMPILE(task-only "${TYPES}${WORK}fn only(mode:int)->int ! TaskError:\n  work(mode) catch fn(error):\n    match error:\n      A.Bad:0\n      A.Missing:1\n      B.Other:2\n      C.Last:3\n      _:fail error\nfn recover(mode:int)->int:\n  only(mode) catch fn(error):\n    match error:\n      TaskError.Fault {kind,message}:\n        match kind:\n          FaultKind.Arithmetic:100+length(message)\n          _:900\n      _:800\nfn main()->[int]:\n  [recover(0),recover(2),recover(4),recover(6)]\n")
EXPECT(task-only "[0, 2, 124, 4]")
COMPILE(nested "${TYPES}${WORK}fn only(mode:int)->int ! B:\n  work(mode) catch fn(error):\n    match error:\n      A.Bad:0\n      A.Missing:1\n      _:\n        match error:\n          B.Other:fail error\n          _:2\nfn recover(mode:int)->int:\n  only(mode) catch fn(error):\n    match error:\n      B.Other {value}:value\nfn main()->[int]:\n  [recover(0),recover(1),recover(2),recover(3),recover(4)]\n")
EXPECT(nested "[0, 1, 7, 2, 2]")
COMPILE(worker "${TYPES}${WORK}fn only(mode:int)->int ! A:\n  work(mode) catch fn(error):\n    match error:\n      A.Bad:fail error\n      A.Missing:fail error\n      _:0\nfn run(mode:int)->int ! (A | TaskError):\n  try parallel:\n    try await spawn only(mode)\nfn recover(mode:int)->int:\n  run(mode) catch fn(error):\n    match error:\n      A.Bad {text,values}:length(text)+values[0]+values[1]\n      A.Missing:5\n      _:99\nfn main()->[int]:\n  [recover(0),recover(1),recover(2),recover(4)]\n")

EXPECT(capture "[45, 46]")
COMPILE(record "${TYPES}${DATA}type Box:\n  cause:A\nfn keep(value:Apps)->Box:\n  match value:\n    A.Bad:Box {cause:value}\n    _:Box {cause:A.Missing}\nfn main()->int ! TaskError:\n  value=try parallel:\n    try await spawn keep(data(0))\n  consumeA(value.cause)\n")
EXPECT(record 44)
COMPILE(snapshot "${TYPES}${DATA}fn inspect(value:Apps)->int:\n  original=value\n  match value:\n    A.Bad:consumeA(value)+score(original)\n    _:0\nfn main()->[int]:\n  [inspect(data(0)),inspect(data(2))]\n")
EXPECT(snapshot "[88, 0]")

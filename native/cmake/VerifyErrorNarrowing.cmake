    message(FATAL_ERROR "Narrowed worker changed: ${OUTPUT}")
  endif()
endforeach()
set(DATA "fn failData(mode:int)->Apps ! Apps:\n  if mode==0:fail A.Bad {text:\"é\"+\"🙂\",values:[20,22]}\n  if mode==1:fail A.Missing\n  if mode==2:fail B.Other {value:7}\n  fail C.Last\nfn data(mode:int)->Apps:\n  failData(mode) catch fn(error):error\nfn consumeA(value:A)->int:\n  match value:\n    A.Bad {text,values}:length(text)+values[0]+values[1]\n    A.Missing:5\nfn consumeB(value:B)->int:\n  match value:\n    B.Other {value}:value\nfn consumeC(value:C)->int:\n  match value:\n    C.Last:9\nfn score(value:Apps)->int:\n  match value:\n    A.Bad:consumeA(value)\n    A.Missing:consumeA(value)\n    B.Other:consumeB(value)\n    _:consumeC(value)\n")
COMPILE(callback "${TYPES}${DATA}fn main()->[int]:\n  map([data(0),data(1),data(2),data(3)],score)\n")
EXPECT(callback "[44, 5, 7, 9]")

set(EXTRA)
if(VARIANT STREQUAL "optimized")
  set(EXTRA -O2)
elseif(VARIANT STREQUAL "sanitized")
  set(EXTRA --sanitize)
elseif(VARIANT STREQUAL "thread-sanitized")
  set(EXTRA --thread-sanitize)
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(COMPILE NAME SOURCE)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" ${EXTRA}
    --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/${NAME}.mlir"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "0" OR NOT ERR STREQUAL "")
    message(FATAL_ERROR "Enum compile ${NAME}: ${STATUS}: ${OUT}${ERR}")
  endif()
endfunction()
function(EXPECT NAME EXPECTED)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" STREQUAL "0" OR NOT OUT STREQUAL "${EXPECTED}\n" OR NOT ERR STREQUAL "")
      message(FATAL_ERROR "Enum ${NAME}/${WORKERS}: ${STATUS}: ${OUT}${ERR}; expected ${EXPECTED}")
    endif()
  endforeach()
endfunction()
foreach(TYPE IN ITEMS int8 uint8 int16 uint16 int32 uint32 int64 uint64 float32 float64)
  set(DECL "enum Payload:\n  Empty\n  Values:\n    array:[${TYPE}]\n    fixed:Tensor[${TYPE},1,2]\n    dynamic:Tensor[${TYPE},?,?]\n    scalar:Tensor[${TYPE}]\n    zero:Tensor[${TYPE},2,0,3]\nfn make()->Payload:\n  Payload.Values {array:[1,2],fixed:tensor([[3,4]]),dynamic:tensor([[5,6]]),scalar:tensor(7),zero:tensor([],[2,0,3])}\nfn echo(x:Payload)->Payload:\n  x\nfn child()->Payload ! TaskError:\n  try parallel:\n    value=spawn echo(make())\n    first=try await value\n    again=try await value\n    again\nfn score(p:Payload)->${TYPE}:\n  match p:\n    Payload.Empty:0\n    Payload.Values {array,fixed,dynamic,scalar,zero}:array[1]+fixed[0,1]+dynamic[0,1]+reduceSum(scalar)+reduceSum(zero)\n")
  COMPILE("collections-${TYPE}" "${DECL}fn main()->int ! TaskError:\n  value=try parallel:\n    empty=spawn echo(Payload.Empty)\n    result=spawn child()\n    unused=try await empty\n    try await result\n  int(score(value))\n")
  EXPECT("collections-${TYPE}" 19)
endforeach()
set(DECL "type Data:\n  text:String\n  names:[String]\n  flags:[Bool]\n  values:[int]\nenum Inner:\n  None\n  Some:\n    data:Data\nenum Outer:\n  Empty\n  Nested:\n    inner:Inner\n  Text:\n    names:[String]\n    flags:[Bool]\nfn make()->Outer:\n  Outer.Nested {inner:Inner.Some {data:Data {text:\"é\"+\"🙂\",names:[\"one\"+\"!\",\"two\"],flags:[true,false],values:[20,22]}}}\nfn echo(x:Outer)->Outer:\n  x\nfn child()->Outer ! TaskError:\n  try parallel:\n    work=spawn echo(make())\n    one=try await work\n    again=try await work\n    again\nfn score(x:Outer)->int:\n  match x:\n    Outer.Empty:0\n    Outer.Nested {inner}:\n      match inner:\n        Inner.None:1\n        Inner.Some {data}:\n          if data.flags[0]:data.values[0]+data.values[1]+length(data.text)+length(data.names[0])\n          else:0\n    Outer.Text {names,flags}:\n      if flags[0]:length(names[0])\n      else:0\n")
COMPILE(nested "${DECL}fn main()->int ! TaskError:\n  try parallel:\n    empty=spawn echo(Outer.Empty)\n    inner=spawn echo(Outer.Nested {inner:Inner.None})\n    text=spawn echo(Outer.Text {names:[\"hi\"+\"!\"],flags:[true]})\n    work=spawn child()\n    a=try await empty\n    b=try await inner\n    c=try await text\n    d=try await work\n    score(a)+score(b)+score(c)+score(d)\n")
EXPECT(nested 52)
COMPILE(enum-array "${DECL}fn create()->[Outer]:\n  [Outer.Empty,make(),Outer.Nested {inner:Inner.None},Outer.Text {names:[\"hi\"+\"!\"],flags:[true]}]\nfn copy(xs:[Outer])->[Outer]:\n  xs\nfn main()->int ! TaskError:\n  result=try parallel:\n    task=spawn copy(create())\n    try await task\n  reduceSum(tensor(map(result,score)))\n")
EXPECT(enum-array 52)
# Active collections may escape the match and outlive the child result.
COMPILE(escape "${DECL}fn values(x:Outer)->[int]:\n  match x:\n    Outer.Nested {inner}:\n      match inner:\n        Inner.Some {data}:data.values\n        Inner.None:[]\n    _:[]\nfn main()->[int] ! TaskError:\n  result=try parallel:\n    task=spawn child()\n    try await task\n  values(result)\n")
EXPECT(escape "[20, 22]")
COMPILE(inactive "${DECL}fn main()->int:\n  score(Outer.Empty)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_FAIL_ALLOC_AT=1 "${OUTPUT_DIR}/inactive"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "0" OR NOT OUT STREQUAL "0\n" OR NOT ERR STREQUAL "")
  message(FATAL_ERROR "Inactive payload allocated or was accessed: ${STATUS}: ${OUT}${ERR}")
endif()
COMPILE(shape-fault "enum Matrix:\n  Empty\n  Value:\n    data:Tensor[int,2,2]\nfn wrap(x:Tensor[int,?,?])->Matrix:\n  Matrix.Value {data:x}\nfn dynamic(rows:int,columns:int)->int:\n  match wrap(tensor([1,2,3],[rows,columns])):\n    Matrix.Empty:0\n    Matrix.Value {data}:reduceSum(data)\nfn main()->int:\n  dynamic(1,3)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/shape-fault"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "87" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ShapeFault" OR NOT ERR MATCHES "cleanup: live=0")
  message(FATAL_ERROR "Active enum tensor shape was not checked: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(WORKERS IN ITEMS 1 2 4)
  foreach(ATTEMPT RANGE 1 48)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
      KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/nested" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if("${STATUS}" STREQUAL "0")
      if(NOT OUT STREQUAL "52\n" OR NOT ERR STREQUAL "")
        message(FATAL_ERROR "Payload allocation success changed output: ${OUT}${ERR}")
      endif()
    elseif(("${STATUS}" STREQUAL "86" AND ERR MATCHES "AllocationFault") OR ("${STATUS}" STREQUAL "88" AND ERR MATCHES "TaskError.Fault"))
      if(NOT OUT STREQUAL "" OR NOT ERR MATCHES "cleanup: live=0")
        message(FATAL_ERROR "Payload allocation failure leaked: ${STATUS}: ${OUT}${ERR}")
      endif()
    else()
      message(FATAL_ERROR "Unexpected payload allocation outcome: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()
message(STATUS "Enum payloads: ten numeric collection widths, fixed/dynamic/rank-zero/empty tensors, Bool/String arrays, nested records/enums, escaping collections, worker ownership and 144 allocation sweeps passed")

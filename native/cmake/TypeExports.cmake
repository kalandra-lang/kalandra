if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-type-export-tests-${VARIANT} tests/TypeExportTests.cpp)
    target_compile_options(kalandra-type-export-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-type-export-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-type-export-tests-${VARIANT} PRIVATE KALANDRA_TYPE_EXPORT_FRONTEND_ONLY)
      target_compile_options(kalandra-type-export-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-type-export-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-type-export-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-type-exports-frontend-${VARIANT} COMMAND kalandra-type-export-tests-${VARIANT} "${CMAKE_CURRENT_BINARY_DIR}/type-exports-frontend-${VARIANT}")
    set_tests_properties(native-type-exports-frontend-${VARIANT} PROPERTIES TIMEOUT 90)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(TYPE_EXPORT_RUNTIME kalandra-native-runtime-sanitized)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(TYPE_EXPORT_RUNTIME kalandra-native-runtime-thread-sanitized)
    else()
      set(TYPE_EXPORT_RUNTIME kalandra-native-runtime)
    endif()
    add_test(NAME native-type-exports-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DVARIANT=${VARIANT}"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=$<TARGET_FILE:${TYPE_EXPORT_RUNTIME}>"
        "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/type-exports-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyTypeExports.cmake")
    set_tests_properties(native-type-exports-${VARIANT} PROPERTIES TIMEOUT 300)
  endforeach()
endif()

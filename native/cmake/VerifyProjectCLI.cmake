include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/caller" "${OUTPUT_DIR}/project/src" "${OUTPUT_DIR}/library")
file(WRITE "${OUTPUT_DIR}/library/base.k" "export fn value()->int:\n  20\n")
file(WRITE "${OUTPUT_DIR}/caller/extra.k" "export fn value()->int:\n  22\n")
file(WRITE "${OUTPUT_DIR}/project/src/main.k" "from \"base\" import value as first\nfrom \"extra\" import value as second\nfn main()->int ! TaskError:\n  try parallel:\n    work=spawn first()\n    value=try await work\n    value+second()\n")
file(WRITE "${OUTPUT_DIR}/project/kalandra.toml" "format=1\n[project]\nentry='src/main.k'\n[packages]\nbase='../library/base.k'\n")
RUN_OK("${CMAKE_COMMAND}" -E chdir "${OUTPUT_DIR}/caller" "${CHECKER}" --package extra=extra.k --project ../project/kalandra.toml)
RUN_OK("${CMAKE_COMMAND}" -E chdir "${OUTPUT_DIR}/caller" "${CHECKER}" --project ../project/kalandra.toml --package extra=extra.k)
RUN_OK("${CMAKE_COMMAND}" -E chdir "${OUTPUT_DIR}/caller" "${COMPILER}" --package extra=extra.k
  --project ../project/kalandra.toml -o "${OUTPUT_DIR}/program" --emit-llvm "${OUTPUT_DIR}/program.ll" --emit-mlir "${OUTPUT_DIR}/program.mlir" ${EXTRA})
RUN_OK("${OUTPUT_DIR}/program")
if(NOT OUTPUT STREQUAL "42\n")
  message(FATAL_ERROR "Manifest and CLI relative bases were mixed: ${OUTPUT}")
endif()
file(WRITE "${OUTPUT_DIR}/preserved" "keep")
foreach(TOOL IN ITEMS COMPILER CHECKER)
  if(TOOL STREQUAL "COMPILER")
    set(OPTIONS -o "${OUTPUT_DIR}/preserved")
  else()
    set(OPTIONS)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E chdir "${OUTPUT_DIR}/caller" "${${TOOL}}"
    --project ../project/kalandra.toml --package base=extra.k ${OPTIONS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "M005" OR NOT OUT STREQUAL "")
    message(FATAL_ERROR "${TOOL} silently overrode a manifest mapping: ${STATUS}: ${OUT}${ERR}")
  endif()
  file(READ "${OUTPUT_DIR}/preserved" CONTENT)
  if(NOT CONTENT STREQUAL "keep")
    message(FATAL_ERROR "Rejected duplicate mapping changed output")
  endif()
endforeach()
message(STATUS "Project CLI: manifest-relative and working-directory mappings compose through worker calls; duplicate mappings rejected by compiler/checker")

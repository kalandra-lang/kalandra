include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDS 2 6 3 7 8 9)
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDS ${INDEX} ID)
  set(DECL "type Config:\n  inner:Inner\n  offset:${TYPE}\ntype Inner:\n  enabled:Bool\n  extra:[${TYPE}]\n  bias:Tensor[${TYPE},2]\n")
  set(VALUE "Config {offset:${TYPE}(10),inner:Inner {enabled:true,extra:[${TYPE}(1),${TYPE}(2)],bias:tensor([${TYPE}(3),${TYPE}(4)])}}")
  set(HELPER "fn keep(ignored:[${TYPE}],value:${TYPE})->${TYPE}:\n  value\nfn choose(value:${TYPE},config:Config)->${TYPE}:\n  if config.inner.enabled: value+config.offset+config.inner.extra[0]+config.inner.bias[1]\n  else: value\nfn run(values:[${TYPE}],config:Config)->[${TYPE}]:\n  values -> map(fn(x):keep(map(config.inner.extra,fn(y):x+y+config.offset),choose(x,config)+x-${TYPE}(15)))\nfn identity(config:Config)->Config:\n  config\n")
  COMPILE("sync-${TYPE}" "${DECL}${HELPER}fn main()->[${TYPE}]:\n  original=${VALUE}\n  updated=original with {offset:${TYPE}(20)}\n  result=run([1,2,3,4],original)\n  result\n")
  EXPECT("sync-${TYPE}" "[2, 4, 6, 8]")
  # Non-numeric capture identity still matters when physical layouts are equal.
  set(SOURCE "fn failing(value:int)->int:\n  1/value\n${DECL}${HELPER}fn faultProbe()->[${TYPE}] ! TaskError:\n  config=${VALUE}\n  divisor=0\n  try parallel:\n    try await spawn map([${TYPE}(1)],fn(x):keep([${TYPE}(failing(divisor))],choose(x,config)))\nfn emptyProbe()->[${TYPE}] ! TaskError:\n  config=${VALUE}\n  divisor=0\n  try parallel:\n    try await spawn map([],fn(x:${TYPE}):keep([${TYPE}(failing(divisor))],choose(x,config)))\nfn probe()->[${TYPE}] ! TaskError:\n  original=${VALUE}\n  received=try parallel:\n    try await spawn identity(original)\n  recovered=faultProbe() catch fn(error): [${TYPE}(1),${TYPE}(2),${TYPE}(3),${TYPE}(4)]\n  try parallel:\n    left=spawn run(recovered,received)\n    right=spawn map([${TYPE}(1),${TYPE}(2),${TYPE}(3),${TYPE}(4)],fn(x):choose(x,received)+x-${TYPE}(15))\n    first=try await left\n    second=try await right\n    again=try await right\n    again\nfn main()->int ! TaskError:\n  result=try probe()\n  7\n")
  if(TYPE STREQUAL "float32")
    set(DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "float64")
    set(DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "int64")
    set(DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "uint64")
    set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "uint32")
    set(DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(DEFINES)
  endif()
  foreach(KIND IN ITEMS probe emptyProbe faultProbe)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -DTENSOR_RANK=1 -DARRAY_RESULT=1 -DCONVERSION_RESULT=1 ${DEFINES}
      "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  EXPECT("probe-${TYPE}" 7)
  foreach(WORKERS IN ITEMS 1 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    RUN_OK("${OUTPUT_DIR}/emptyProbe-${TYPE}-harness" "${WORKERS}" 4 0)
    RUN_OK("${OUTPUT_DIR}/faultProbe-${TYPE}-harness" "${WORKERS}" 7 0)
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
      RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" "${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3)
    endforeach()
  endforeach()
  COMPILE("raw-${TYPE}" "type Config:\n  inner:Inner\ntype Inner:\n  flag:Bool\n  original:[${TYPE}]\nfn choose(value:${TYPE},config:Config)->${TYPE}:\n  if config.inner.flag: value\n  else: value\nfn mapped(values:[${TYPE}]):\n  config=Config {inner:Inner {flag:true,original:values}}\n  map(values,fn(x):choose(x,config))\nfn main()->int:\n  0\n" --test-entry mapped)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}" -isystem "${LLVM_ROOT}/include"
    "${SOURCE_DIR}/tests/ArrayMapRuntimeTests.cpp" "${OUTPUT_DIR}/raw-${TYPE}.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/raw-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/raw-${TYPE}-harness")
endforeach()
COMPILE(immutable "type Config:\n  offset:int\n  values:[int]\nfn main():\n  config=Config {offset:10,values:[2,3]}\n  values=map([1,2],fn(x):(config with {offset:config.offset+x,values:[x]}).offset)\n  [values[0],values[1],config.offset,config.values[0]]\n")
EXPECT(immutable "[11, 12, 10, 2]")
file(WRITE "${OUTPUT_DIR}/helpers.k" "type Config:\n  offsets:[int]\nexport fn make():\n  Config {offsets:[10,20]}\nexport fn apply(value:int,config:Config):\n  value+config.offsets[0]\n")
COMPILE(modules "from \"./helpers.k\" import make,apply as adjust\nfn main()->[int] ! TaskError:\n  config=make()\n  try parallel:\n    try await spawn map([1,2,3],fn(x):adjust(x,config))\n")
EXPECT(modules "[11, 12, 13]")
message(STATUS "Whole-record callbacks: six numeric types, nested collection captures, worker snapshots/cached results, nested closures, exact identity lanes, immutable updates, imported nominal types, errors and cleanup passed")

file(READ "${SOURCE_DIR}/../docs/design/record-closures.md" DOC)
string(REGEX MATCH "```kalandra\n([^`]+)```" EXAMPLE "${DOC}")
COMPILE(documentation "${CMAKE_MATCH_1}")
EXPECT(documentation "[13, 14, 15]")

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
function(CLEAN NAME EXPECTED)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 ${ARGN} "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "${EXPECTED}\n" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)")
    message(FATAL_ERROR "Collection display/cleanup failed: ${NAME}: ${STATUS}: ${OUT}${ERR}")
  endif()
  if(NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
    message(FATAL_ERROR "Collection display leaked context owners: ${ERR}")
  endif()
endfunction()
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDS 2 6 3 7 8 9)
foreach(N RANGE 0 5)
  list(GET TYPES ${N} TYPE)
  list(GET IDS ${N} ID)
  COMPILE("array-${TYPE}" "fn main()->[${TYPE}]:\n  [1,2,3,4] -> map(fn(x:${TYPE}):x*2)\n")
  CLEAN("array-${TYPE}" "[2, 4, 6, 8]")
  COMPILE("tensor-${TYPE}" "fn main()->Tensor[${TYPE},2,2]:\n  tensor([[1,2],[3,4]])*2\n")
  CLEAN("tensor-${TYPE}" "tensor([2, 4, 6, 8], [2, 2])")
  COMPILE("scalar-tensor-${TYPE}" "fn main()->Tensor[${TYPE}]:\n  tensor(7)\n")
  CLEAN("scalar-tensor-${TYPE}" "tensor([7], [])")
  COMPILE("empty-array-${TYPE}" "fn main()->[${TYPE}]:\n  []\n")
  CLEAN("empty-array-${TYPE}" "[]")
  COMPILE("empty-tensor-${TYPE}" "fn main()->Tensor[${TYPE},2,0,3]:\n  tensor([],[2,0,3])\n")
  CLEAN("empty-tensor-${TYPE}" "tensor([], [2, 0, 3])")
  file(WRITE "${OUTPUT_DIR}/math-${TYPE}.k" "export fn double(values:Tensor[${TYPE},?,?]):\n  values*2\nexport fn mapped(values:[${TYPE}]):\n  map(values,fn(x):x*2)\n")
  foreach(ARRAY IN ITEMS 0 1)
    if(ARRAY)
      set(EXPR "mapped([${TYPE}(1),${TYPE}(2),${TYPE}(3),${TYPE}(4)])")
      set(EXPECTED "[2, 4, 6, 8]")
    else()
      set(EXPR "double(tensor([[${TYPE}(1),${TYPE}(2)],[${TYPE}(3),${TYPE}(4)]]))")
      set(EXPECTED "tensor([2, 4, 6, 8], [2, 2])")
    endif()
    set(NAME "worker-${TYPE}-${ARRAY}")
    COMPILE("${NAME}" "from \"./math-${TYPE}.k\" import double, mapped\nfn main() ! TaskError:\n  result=try parallel:\n    work=spawn ${EXPR}\n    first=try await work\n    again=try await work\n    again\n  result\n")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}" "-DMAIN_ARRAY=${ARRAY}" -I "${SOURCE_DIR}/include"
      "${SOURCE_DIR}/tests/CollectionEntryTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${NAME}-harness")
    foreach(WORKERS IN ITEMS 1 2 4)
      CLEAN("${NAME}" "${EXPECTED}" "KALANDRA_WORKERS=${WORKERS}")
      RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}-harness")
    endforeach()
    RUN_OK("${CMAKE_COMMAND}" -E env KALANDRA_WORKERS=0 "${OUTPUT_DIR}/${NAME}-harness" admission)
    foreach(FAIL_AT RANGE 1 8)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}" "${OUTPUT_DIR}/${NAME}"
        RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
      if(NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)")
        message(FATAL_ERROR "Failed collection entry omitted cleanup: ${STATUS}: ${OUT}${ERR}")
      endif()
      if(NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
        message(FATAL_ERROR "Failed collection entry leaked owners: ${ERR}")
      endif()
      if(STATUS EQUAL 0)
        if(NOT OUT STREQUAL "${EXPECTED}\n")
          message(FATAL_ERROR "Successful allocation sweep changed result: ${OUT}")
        endif()
      elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault")
        message(FATAL_ERROR "Failed collection entry published partial output: ${STATUS}: ${OUT}${ERR}")
      endif()
    endforeach()
  endforeach()
endforeach()

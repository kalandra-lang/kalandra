foreach(KIND IN ITEMS arithmetic shape bounds task)
  if(KIND STREQUAL "arithmetic")
    set(SOURCE "fn failHere(value:int):\n  1/value\nfn main():\n  [failHere(0),2]\n")
    set(ERROR "ArithmeticFault.*2:3")
  elseif(KIND STREQUAL "shape")
    set(SOURCE "fn resize(values:Tensor[int,?],count:int):\n  reshape(values,[count])\nfn main():\n  resize(tensor([1,2]),3)\n")
    set(ERROR "ShapeFault.*2:3")
  elseif(KIND STREQUAL "bounds")
    set(SOURCE "fn select(values:[int],index:int):\n  [values[index]]\nfn main():\n  select([1],2)\n")
    set(ERROR "BoundsFault.*2:4")
  else()
    set(SOURCE "fn failHere(value:int):\n  [1/value]\nfn main() ! TaskError:\n  try parallel:\n    work=spawn failHere(0)\n    try await work\n")
    set(ERROR "ArithmeticFault|TaskError.Fault")
  endif()
  COMPILE("fault-${KIND}" "${SOURCE}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/fault-${KIND}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "${ERROR}" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)")
    message(FATAL_ERROR "Collection failure display changed: ${KIND}: ${STATUS}: ${OUT}${ERR}")
  endif()
  if(NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
    message(FATAL_ERROR "Collection fault leaked owners: ${ERR}")
  endif()
endforeach()
# Argument errors are rejected before executing the program.
foreach(ARGUMENTS IN ITEMS "--limit;-1" "--limit;1.5" "--limit;18446744073709551616" "--limit" "--unknown" "--all;extra")
  execute_process(COMMAND "${OUTPUT_DIR}/fault-arithmetic" ${ARGUMENTS} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 2 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "usage:" OR ERR MATCHES "ArithmeticFault")
    message(FATAL_ERROR "Invalid collection display option executed source: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()

if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-narrow-array-tests-${VARIANT} tests/NarrowArrayTests.cpp)
    target_compile_options(kalandra-narrow-array-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-narrow-array-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-narrow-array-tests-${VARIANT} PRIVATE KALANDRA_NARROW_ARRAY_FRONTEND_ONLY)
      target_compile_options(kalandra-narrow-array-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-narrow-array-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-narrow-array-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-narrow-arrays-frontend-${VARIANT} COMMAND kalandra-narrow-array-tests-${VARIANT})
    set_tests_properties(native-narrow-arrays-frontend-${VARIANT} PROPERTIES TIMEOUT 90)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(NARROW_RUNTIME kalandra-native-runtime-sanitized)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(NARROW_RUNTIME kalandra-native-runtime-thread-sanitized)
    else()
      set(NARROW_RUNTIME kalandra-native-runtime)
    endif()
    add_test(NAME native-narrow-arrays-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DCHECKER=$<TARGET_FILE:kalandra-check>" "-DVARIANT=${VARIANT}"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=$<TARGET_FILE:${NARROW_RUNTIME}>"
        "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/narrow-arrays-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyNarrowArrays.cmake")
    set_tests_properties(native-narrow-arrays-${VARIANT} PROPERTIES TIMEOUT 600)
  endforeach()
endif()

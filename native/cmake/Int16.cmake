if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-int16-tests-${VARIANT} tests/Int16Tests.cpp)
    target_compile_options(kalandra-int16-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-int16-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-int16-tests-${VARIANT} PRIVATE KALANDRA_INT16_FRONTEND_ONLY)
      target_compile_options(kalandra-int16-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-int16-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-int16-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-int16-frontend-${VARIANT} COMMAND kalandra-int16-tests-${VARIANT})
    set_tests_properties(native-int16-frontend-${VARIANT} PROPERTIES TIMEOUT 90)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(INT16_RUNTIME kalandra-native-runtime-sanitized)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(INT16_RUNTIME kalandra-native-runtime-thread-sanitized)
    else()
      set(INT16_RUNTIME kalandra-native-runtime)
    endif()
    add_test(NAME native-int16-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DCHECKER=$<TARGET_FILE:kalandra-check>" "-DVARIANT=${VARIANT}"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DLLVM_ROOT=${KALANDRA_LLVM_ROOT}" "-DRUNTIME=$<TARGET_FILE:${INT16_RUNTIME}>"
        "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/int16-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyInt16.cmake")
    set_tests_properties(native-int16-${VARIANT} PROPERTIES TIMEOUT 600)
  endforeach()
endif()

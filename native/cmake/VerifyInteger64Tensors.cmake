if(NUMERIC_TYPE STREQUAL "uint64")
  set(UNSIGNED 1)
  set(MAXIMUM 18446744073709551615)
  set(HIGH 9223372036854775808)
else()
  set(UNSIGNED 0)
  set(MAXIMUM 9223372036854775807)
  set(HIGH -9223372036854775808)
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(EXTRA)
set(FLAGS -O0)
if(VARIANT STREQUAL "optimized")
  set(EXTRA -O2)
  set(FLAGS -O2)
elseif(VARIANT STREQUAL "sanitized")
  set(EXTRA --sanitize)
  set(FLAGS -O1 -fsanitize=address,undefined -fno-sanitize-recover=all)
elseif(VARIANT STREQUAL "thread-sanitized")
  set(EXTRA --thread-sanitize)
  set(FLAGS -O1 -fsanitize=thread)
endif()
function(RUN_OK)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "0" OR NOT ERR STREQUAL "")
    message(FATAL_ERROR "Failed: ${ARGN}: ${STATUS}: ${OUT}${ERR}")
  endif()
  message(STATUS "${OUT}")
endfunction()
function(QUALIFY NAME RANK OP MODE EXPR)
  set(TYPE "Tensor[${NUMERIC_TYPE}")
  foreach(I RANGE 1 ${RANK})
    if(RANK GREATER 0)
      string(APPEND TYPE ",?")
    endif()
  endforeach()
  string(APPEND TYPE "]")
  set(PREFIX "")
  if(MODE EQUAL 5)
    set(PREFIX "fn fixed(x:Tensor[${NUMERIC_TYPE},2,2]) -> Tensor[${NUMERIC_TYPE},2,2]:\n  x + 1\n")
  endif()
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${PREFIX}fn operation(a:${TYPE},b:${TYPE},scalar:${NUMERIC_TYPE}) -> ${TYPE}:\n  ${EXPR}\nfn main() -> ${NUMERIC_TYPE}:\n  0\n")
  RUN_OK("${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" --test-entry operation
    --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/${NAME}.mlir" ${EXTRA})
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DTENSOR_RANK=${RANK}" "-DTENSOR_UNSIGNED=${UNSIGNED}" "${HARNESS_SOURCE}" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${NAME}-harness")
  RUN_OK("${OUTPUT_DIR}/${NAME}-harness" "${OP}" "${MODE}")
endfunction()
foreach(OP IN ITEMS add sub mul div rem)
  if(OP STREQUAL "add")
    set(SYMBOL "+")
  elseif(OP STREQUAL "sub")
    set(SYMBOL "-")
  elseif(OP STREQUAL "mul")
    set(SYMBOL "*")
  elseif(OP STREQUAL "div")
    set(SYMBOL "/")
  else()
    set(SYMBOL "%")
  endif()
  QUALIFY("${OP}-pair" 2 "${OP}" 0 "a ${SYMBOL} b")
  QUALIFY("${OP}-right" 2 "${OP}" 1 "a ${SYMBOL} scalar")
  QUALIFY("${OP}-left" 2 "${OP}" 2 "scalar ${SYMBOL} b")
endforeach()
QUALIFY(negate 2 neg 3 "-a")
QUALIFY(identity 2 pos 3 "+a")
foreach(RANK IN ITEMS 0 1 3)
  QUALIFY("rank-${RANK}" ${RANK} add 0 "a + b")
endforeach()
QUALIFY(refinement 2 add 5 "fixed(a)")
QUALIFY(literal-0 0 literal 4 "tensor(scalar)")
QUALIFY(literal-1 1 literal 4 "tensor([scalar,${MAXIMUM},${HIGH},9007199254740993])")
QUALIFY(literal-2 2 literal 4 "tensor([[scalar,${MAXIMUM}],[${HIGH},9007199254740993]])")
QUALIFY(literal-3 3 literal 4 "tensor([scalar,${MAXIMUM},${HIGH},9007199254740993],[2,2,1])")
message(STATUS "Shared 64-bit CPU tensor literals, ranked checked integer arithmetic, scalar lifting, exact cells, shape/overflow faults and ownership passed")

# Unsupported paths must diagnose without overwriting prior artifacts.
function(REJECT NAME SOURCE MATCH)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  file(WRITE "${OUTPUT_DIR}/preserved.ll" "preserved llvm")
  set(IR_FLAGS --emit-llvm "${OUTPUT_DIR}/preserved.ll")
  if(NAME STREQUAL "metal")
    set(IR_FLAGS)
  endif()
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/${NAME}.k"
    -o "${OUTPUT_DIR}/preserved" ${IR_FLAGS} ${ARGN}
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" OLD)
  file(READ "${OUTPUT_DIR}/preserved.ll" IR)
  if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "${MATCH}" OR
     NOT OLD STREQUAL "preserved executable" OR NOT IR STREQUAL "preserved llvm")
    message(FATAL_ERROR "${NAME} gate failed: ${STATUS}: ${ERR}")
  endif()
endfunction()
# Worker handoff is now qualified through the shared 64-bit task suites.
file(WRITE "${OUTPUT_DIR}/task.k" "fn identity(x:Tensor[${NUMERIC_TYPE},?]) -> Tensor[${NUMERIC_TYPE},?]:\n  x\nfn main() -> ${NUMERIC_TYPE} ! TaskError:\n  try parallel:\n    x:Tensor[${NUMERIC_TYPE},2] = tensor([1,2])\n    try await spawn identity(x)\n    0\n")
RUN_OK("${COMPILER}" "${OUTPUT_DIR}/task.k" -o "${OUTPUT_DIR}/task-identity" ${EXTRA})
RUN_OK("${OUTPUT_DIR}/task-identity")
file(WRITE "${OUTPUT_DIR}/reduction.k" "fn f(x:Tensor[${NUMERIC_TYPE},?]) -> ${NUMERIC_TYPE}:\n  reduceSum(x)\nfn main() -> ${NUMERIC_TYPE}:\n  0\n")
RUN_OK("${COMPILER}" "${OUTPUT_DIR}/reduction.k" -o "${OUTPUT_DIR}/supported-reduction" ${EXTRA})
RUN_OK("${OUTPUT_DIR}/supported-reduction")
file(WRITE "${OUTPUT_DIR}/matmul.k" "fn f(x:Tensor[${NUMERIC_TYPE},?,?]) -> Tensor[${NUMERIC_TYPE},?,?]:\n  matmul(x,x)\nfn main() -> ${NUMERIC_TYPE}:\n  0\n")
RUN_OK("${COMPILER}" "${OUTPUT_DIR}/matmul.k" -o "${OUTPUT_DIR}/supported-matmul" ${EXTRA})
RUN_OK("${OUTPUT_DIR}/supported-matmul")
REJECT(metal "fn f(x:Tensor[${NUMERIC_TYPE},?]) -> Tensor[${NUMERIC_TYPE},?]:\n  x + 1\nfn main() -> ${NUMERIC_TYPE}:\n  0\n" "${NUMERIC_TYPE}" --target metal)
REJECT(size "fn f(x:Tensor[${NUMERIC_TYPE},1152921504606846976]) -> ${NUMERIC_TYPE}:\n  0\n" "S002")
REJECT(mixed "fn f(x:Tensor[${NUMERIC_TYPE},?], y:Tensor[float32,?]) -> Tensor[${NUMERIC_TYPE},?]:\n  x + y\n" "S0")
message(STATUS "Shared 64-bit tensor task/reduction/matmul admission and Metal gates and eight-byte size checks passed")

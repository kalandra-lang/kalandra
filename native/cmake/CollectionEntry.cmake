foreach(VARIANT IN ITEMS debug sanitized thread-sanitized)
  add_library(kalandra-collection-entry-${VARIANT} STATIC runtime/CollectionEntry.cpp)
  target_include_directories(kalandra-collection-entry-${VARIANT} PRIVATE include)
  target_compile_options(kalandra-collection-entry-${VARIANT} PRIVATE -Wall -Wextra -Werror)
  if(VARIANT STREQUAL "sanitized")
    target_compile_options(kalandra-collection-entry-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
  elseif(VARIANT STREQUAL "thread-sanitized")
    target_compile_options(kalandra-collection-entry-${VARIANT} PRIVATE -O1 -g -fsanitize=thread -fno-omit-frame-pointer)
  endif()
endforeach()
target_compile_definitions(kalandra PRIVATE
  KALANDRA_COLLECTION_ENTRY="$<TARGET_FILE:kalandra-collection-entry-debug>"
  KALANDRA_COLLECTION_SANITIZED_ENTRY="$<TARGET_FILE:kalandra-collection-entry-sanitized>"
  KALANDRA_COLLECTION_THREAD_SANITIZED_ENTRY="$<TARGET_FILE:kalandra-collection-entry-thread-sanitized>")
kalandra_compiler_runtimes(kalandra-collection-entry-debug kalandra-collection-entry-sanitized kalandra-collection-entry-thread-sanitized)
if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    add_executable(kalandra-collection-display-${VARIANT} tests/CollectionDisplayTests.cpp)
    target_include_directories(kalandra-collection-display-${VARIANT} PRIVATE include)
    target_compile_options(kalandra-collection-display-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      set(DISPLAY_RUNTIME kalandra-native-runtime-sanitized)
      target_compile_options(kalandra-collection-display-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-collection-display-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(DISPLAY_RUNTIME kalandra-native-runtime-thread-sanitized)
      target_compile_options(kalandra-collection-display-${VARIANT} PRIVATE -O1 -g -fsanitize=thread -fno-omit-frame-pointer)
      target_link_options(kalandra-collection-display-${VARIANT} PRIVATE -fsanitize=thread)
    else()
      set(DISPLAY_RUNTIME kalandra-native-runtime)
      if(VARIANT STREQUAL "optimized")
        target_compile_options(kalandra-collection-display-${VARIANT} PRIVATE -O2)
      endif()
    endif()
    target_link_libraries(kalandra-collection-display-${VARIANT} PRIVATE ${DISPLAY_RUNTIME})
    add_test(NAME native-collection-display-${VARIANT} COMMAND kalandra-collection-display-${VARIANT})
    add_test(NAME native-collection-entry-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DCLANGXX=${CMAKE_CXX_COMPILER}"
        "-DRUNTIME=$<TARGET_FILE:${DISPLAY_RUNTIME}>" "-DVARIANT=${VARIANT}"
        "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/collection-entry-${VARIANT}" "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyCollectionEntry.cmake")
    set_tests_properties(native-collection-entry-${VARIANT} PROPERTIES TIMEOUT 900)
    set_tests_properties(native-collection-display-${VARIANT} PROPERTIES TIMEOUT 60)
  endforeach()
endif()

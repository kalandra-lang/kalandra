file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(EXTRA)
if(VARIANT STREQUAL "optimized")
  list(APPEND EXTRA -O2)
elseif(VARIANT STREQUAL "sanitized")
  list(APPEND EXTRA --sanitize)
elseif(VARIANT STREQUAL "thread-sanitized")
  list(APPEND EXTRA --thread-sanitize)
endif()
function(RUN_OK)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE STATUS OUTPUT_VARIABLE STDOUT ERROR_VARIABLE STDERR)
  if(NOT "${STATUS}" STREQUAL "0" OR NOT STDERR STREQUAL "")
    message(FATAL_ERROR "Command failed: ${ARGN}: ${STATUS}: ${STDOUT}${STDERR}")
  endif()
  set(OUTPUT "${STDOUT}" PARENT_SCOPE)
endfunction()
foreach(CASE IN ITEMS "task-scalars|16" "task-tensors|163" "task-nested|40" "task-aliases|20" "task-lexical|10")
  string(REPLACE "|" ";" FIELDS "${CASE}")
  list(GET FIELDS 0 NAME)
  list(GET FIELDS 1 EXPECTED)
  RUN_OK("${COMPILER}" "${FIXTURES}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" ${EXTRA})
  RUN_OK("${CMAKE_COMMAND}" -E env PATH=/usr/bin:/bin "${OUTPUT_DIR}/${NAME}")
  if(NOT OUTPUT STREQUAL "${EXPECTED}\n")
    message(FATAL_ERROR "Task source result differs: ${NAME}: ${OUTPUT}")
  endif()
  file(READ "${OUTPUT_DIR}/${NAME}.ll" IR)
  if(NOT IR MATCHES "switch i32" OR NOT IR MATCHES "@kalandra_task_await_v1" OR
     NOT IR MATCHES "@kalandra_task_spawn_v1" OR
     IR MATCHES "[ \t](fast|reassoc|contract|afn|nnan|ninf|nsz|arcp)[ \t]")
    message(FATAL_ERROR "Continuation/native numerical contract missing: ${NAME}")
  endif()
endforeach()
# Failure 1 occurs in main; failure 3 occurs in a child after its two argument retains.
foreach(CASE IN ITEMS "1|86|AllocationFault" "3|88|TaskError.Fault")
  string(REPLACE "|" ";" FIELDS "${CASE}")
  list(GET FIELDS 0 FAIL_AT)
  list(GET FIELDS 1 EXPECTED_EXIT)
  list(GET FIELDS 2 EXPECTED_ERROR)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1
    "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}" "${OUTPUT_DIR}/task-tensors"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE STDOUT ERROR_VARIABLE STDERR)
  if(NOT "${STATUS}" STREQUAL "${EXPECTED_EXIT}" OR NOT STDOUT STREQUAL "" OR
     NOT STDERR MATCHES "${EXPECTED_ERROR}" OR NOT STDERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Task source fault classification failed: ${STATUS}: ${STDOUT}${STDERR}")
  endif()
endforeach()
message(STATUS "Source continuations, typed task errors, nested groups, cached awaits, and tensor handoff pass")

execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_FAIL_ALLOC_AT=2
  "${OUTPUT_DIR}/task-nested" RESULT_VARIABLE STATUS OUTPUT_VARIABLE STDOUT ERROR_VARIABLE STDERR)
if(NOT "${STATUS}" STREQUAL "88" OR NOT STDOUT STREQUAL "" OR NOT STDERR MATCHES "TaskError.Fault")
  message(FATAL_ERROR "Nested fallible task did not preserve TaskError: ${STATUS}: ${STDOUT}${STDERR}")
endif()
set(QUOTA_SOURCE "fn identity(x: float32) -> float32:\n  x\nfn main() -> float32 ! TaskError:\n  try parallel:\n")
foreach(INDEX RANGE 0 128)
  string(APPEND QUOTA_SOURCE "    job${INDEX} = spawn identity(1)\n")
endforeach()
foreach(INDEX RANGE 0 128)
  string(APPEND QUOTA_SOURCE "    try await job${INDEX}\n")
endforeach()
string(APPEND QUOTA_SOURCE "    0\n")
file(WRITE "${OUTPUT_DIR}/quota.k" "${QUOTA_SOURCE}")
RUN_OK("${COMPILER}" "${OUTPUT_DIR}/quota.k" -o "${OUTPUT_DIR}/quota" ${EXTRA})
execute_process(COMMAND "${OUTPUT_DIR}/quota" RESULT_VARIABLE STATUS OUTPUT_VARIABLE STDOUT ERROR_VARIABLE STDERR)
if(NOT "${STATUS}" STREQUAL "88" OR NOT STDOUT STREQUAL "" OR NOT STDERR MATCHES "TaskError.AdmissionRejected")
  message(FATAL_ERROR "Source admission rejection lost its type: ${STATUS}: ${STDOUT}${STDERR}")
endif()

foreach(WORKERS IN ITEMS 1 2 4)
  RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/task-nested")
  if(NOT OUTPUT STREQUAL "40\n")
    message(FATAL_ERROR "Configured worker count changed results: ${WORKERS}: ${OUTPUT}")
  endif()
endforeach()
foreach(WORKERS IN ITEMS 0 65 invalid)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" KALANDRA_TEST_REPORT_CLEANUP=1
    "${OUTPUT_DIR}/task-nested" RESULT_VARIABLE STATUS OUTPUT_VARIABLE STDOUT ERROR_VARIABLE STDERR)
  if(NOT "${STATUS}" STREQUAL "88" OR NOT STDOUT STREQUAL "" OR NOT STDERR MATCHES "TaskError.AdmissionRejected" OR
      NOT STDERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Invalid worker configuration was not rejected: ${WORKERS}: ${STATUS}: ${STDOUT}${STDERR}")
  endif()
endforeach()

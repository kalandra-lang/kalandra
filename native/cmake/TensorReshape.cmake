if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-tensor-reshape-tests-${VARIANT} tests/TensorReshapeTests.cpp)
    target_compile_options(kalandra-tensor-reshape-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-tensor-reshape-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-tensor-reshape-tests-${VARIANT} PRIVATE KALANDRA_TENSOR_RESHAPE_FRONTEND_ONLY)
      target_compile_options(kalandra-tensor-reshape-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-tensor-reshape-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-tensor-reshape-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-tensor-reshape-frontend-${VARIANT} COMMAND kalandra-tensor-reshape-tests-${VARIANT})
    set_tests_properties(native-tensor-reshape-frontend-${VARIANT} PROPERTIES TIMEOUT 120)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(TENSOR_RESHAPE_RUNTIME "$<TARGET_FILE:kalandra-native-runtime-sanitized>")
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(TENSOR_RESHAPE_RUNTIME "$<TARGET_FILE:kalandra-native-runtime-thread-sanitized>")
    else()
      set(TENSOR_RESHAPE_RUNTIME "$<TARGET_FILE:kalandra-native-runtime>")
    endif()
    add_test(NAME native-tensor-reshape-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DCLANGXX=${CMAKE_CXX_COMPILER}"
        "-DLLVM_ROOT=${KALANDRA_LLVM_ROOT}" "-DRUNTIME=${TENSOR_RESHAPE_RUNTIME}" "-DVARIANT=${VARIANT}"
        "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/tensor-reshape-${VARIANT}" "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyTensorReshape.cmake")
    set_tests_properties(native-tensor-reshape-${VARIANT} PROPERTIES TIMEOUT 900)
  endforeach()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDS 2 6 3 7 8 9)
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDS ${INDEX} ID)
  COMPILE("plain-${TYPE}" "type Point:\n  amount:${TYPE}\n  valid:Bool\nfn make()->[Point]:\n  [Point {amount:2,valid:true},Point {amount:3,valid:false}]\nfn main()->${TYPE} ! TaskError:\n  rows=try parallel:\n    try await spawn make()\n  if rows[0].valid and not rows[1].valid: rows[0].amount+rows[1].amount\n  else: 0\n")
  EXPECT("plain-${TYPE}" 5)
  set(DECL "type Envelope:\n  data:Data\n  enabled:Bool\ntype Data:\n  amount:${TYPE}\n  values:[${TYPE}]\n  matrix:Tensor[${TYPE},2,2]\n")
  set(MAKE "fn make()->[Envelope]:\n  [Envelope {enabled:true,data:Data {amount:2,values:[4,5],matrix:tensor([[1,2],[3,4]])}},Envelope {enabled:false,data:Data {amount:3,values:[6,7],matrix:tensor([[5,6],[7,8]])}}]\n")
  set(HELPERS "fn echo(rows:[Envelope])->[Envelope]:\n  rows\nfn choose(flag:Bool,rows:[Envelope])->[Envelope]:\n  if flag: rows\n  else: []\nfn update(rows:[Envelope],i:int)->Envelope:\n  item=rows[i]\n  item with {data:item.data with {amount:item.data.amount+10}}\n")
  set(CALCULATE "  changed=update(rows,0)\n  changed.data.amount+original[0].data.amount+rows[1].data.values[1]+rows[0].data.matrix[1,1]+${TYPE}(length(rows))\n")
  COMPILE("sync-${TYPE}" "${DECL}${MAKE}${HELPERS}fn main()->${TYPE}:\n  original=make()\n  rows=echo(original)\n${CALCULATE}")
  EXPECT("sync-${TYPE}" 27)
  COMPILE("worker-${TYPE}" "${DECL}${MAKE}${HELPERS}fn main()->${TYPE} ! TaskError:\n  original=make()\n  rows=try parallel:\n    work=spawn echo(original)\n    first=try await work\n    again=try await work\n    again\n${CALCULATE}")
  EXPECT("worker-${TYPE}" 27)
  COMPILE("empty-${TYPE}" "${DECL}${MAKE}${HELPERS}fn main()->int ! TaskError:\n  rows=try parallel:\n    try await spawn choose(false,make())\n  length(rows)\n")
  EXPECT("empty-${TYPE}" 0)
  COMPILE("field-${TYPE}" "${DECL}${MAKE}${HELPERS}fn main()->[${TYPE}] ! TaskError:\n  rows=try parallel:\n    try await spawn echo(make())\n  rows[0].data.values\n")
  EXPECT("field-${TYPE}" "[4, 5]")
  COMPILE("capture-${TYPE}" "${DECL}${MAKE}${HELPERS}fn main()->[${TYPE}] ! TaskError:\n  rows=try parallel:\n    try await spawn echo(make())\n  try parallel:\n    try await spawn map([0,1],fn(i):rows[i].data.values[0])\n")
  EXPECT("capture-${TYPE}" "[4, 6]")
  set(RAW "type Reading:\n  amount:${TYPE}\n  enabled:Bool\n  values:[${TYPE}]\n  matrix:Tensor[${TYPE},1,2]\nfn echo(rows:[Reading])->[Reading]:\n  rows\nfn child(rows:[Reading])->[Reading] ! TaskError:\n  try parallel:\n    work=spawn echo(rows)\n    first=try await work\n    again=try await work\n    again\nfn probe(rows:[Reading])->[Reading] ! TaskError:\n  try parallel:\n    work=spawn child(rows)\n    first=try await work\n    again=try await work\n    again\nfn main()->int:\n  0\n")
  COMPILE("raw-${TYPE}" "${RAW}" --test-entry probe)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}"
    "${SOURCE_DIR}/tests/RecordArrayWorkerTests.cpp" "${OUTPUT_DIR}/raw-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/raw-${TYPE}-harness")
  foreach(WORKERS IN ITEMS 1 4)
    foreach(MODE IN ITEMS 0 1 2 4 5 6 7)
      RUN_OK("${OUTPUT_DIR}/raw-${TYPE}-harness" "${WORKERS}" "${MODE}" 0)
    endforeach()
    if(TYPE STREQUAL "int64")
      foreach(FAIL_AT RANGE 1 16)
        RUN_OK("${OUTPUT_DIR}/raw-${TYPE}-harness" "${WORKERS}" 3 "${FAIL_AT}")
      endforeach()
    endif()
  endforeach()
endforeach()
COMPILE(bool-only "type Flag:\n  enabled:Bool\nfn make()->[Flag]:\n  [Flag {enabled:true},Flag {enabled:false}]\nfn main()->Bool ! TaskError:\n  rows=try parallel:\n    try await spawn make()\n  rows[0].enabled and not rows[1].enabled\n")
EXPECT(bool-only true)
set(DECL "type Point:\n  x:int\n  valid:Bool\nfn make()->[Point]:\n  [Point {x:2,valid:true},Point {x:3,valid:false}]\n")
foreach(TYPE IN ITEMS int32 uint32 int64 uint64)
  COMPILE("index-${TYPE}" "${DECL}fn pick(rows:[Point],i:${TYPE})->Point:\n  rows[i]\nfn main():\n  pick(make(),${TYPE}(1)).x\n")
  EXPECT("index-${TYPE}" 3)
  if(TYPE MATCHES "^u")
    if(TYPE STREQUAL "uint64")
      set(BAD "18446744073709551615")
    else()
      set(BAD "4294967295")
    endif()
  else()
    set(BAD -1)
  endif()
  COMPILE("bounds-${TYPE}" "${DECL}fn pick(rows:[Point],i:${TYPE})->Point:\n  rows[i]\nfn main():\n  pick(make(),${BAD}).x\n")
  execute_process(COMMAND "${OUTPUT_DIR}/bounds-${TYPE}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "BoundsFault")
    message(FATAL_ERROR "Record array bounds guard failed: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
COMPILE(recovery "${DECL}fn bad(rows:[Point],divisor:int)->[Point]:\n  [Point {x:rows[0].x/divisor,valid:true}]\nfn attempt()->[Point] ! TaskError:\n  try parallel:\n    try await spawn bad(make(),0)\nfn main():\n  rows=attempt() catch fn(error): [Point {x:7,valid:false},Point {x:8,valid:true}]\n  rows[0].x+rows[1].x\n")
EXPECT(recovery 15)
COMPILE(join "${DECL}fn choose(flag:Bool)->[Point]:\n  if flag: make()\n  else: [Point {x:9,valid:false}]\nfn main():\n  length(choose(true))+length(choose(false))\n")
EXPECT(join 3)
COMPILE(order "${DECL}fn index(i:int):\n  [1][i]\nfn divide(i:int):\n  1/i\nfn main():\n  rows=[Point {x:index(5),valid:true},Point {x:divide(0),valid:false}]\n  length(rows)\n")
execute_process(COMMAND "${OUTPUT_DIR}/order" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "BoundsFault")
  message(FATAL_ERROR "Record array literal order changed: ${STATUS}: ${OUT}${ERR}")
endif()
file(WRITE "${OUTPUT_DIR}/library.k" "${DECL}export fn all()->[Point]:\n  make()\nexport fn pick(rows:[Point],i:int)->Point:\n  rows[i]\n")
COMPILE(modules "from \"./library.k\" import all,pick\nfn main()->int ! TaskError:\n  rows=try parallel:\n    try await spawn all()\n  point=try parallel:\n    try await spawn pick(rows,1)\n  point.x\n")
EXPECT(modules 3)
foreach(NAME IN ITEMS sync-int64 worker-int64 field-int64 capture-int64)
  foreach(FAIL_AT RANGE 1 20)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}" "${OUTPUT_DIR}/${NAME}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(STATUS EQUAL 0)
      if(NAME STREQUAL "field-int64")
        set(EXPECTED "[4, 5]\n")
      elseif(NAME STREQUAL "capture-int64")
        set(EXPECTED "[4, 6]\n")
      else()
        set(EXPECTED "27\n")
      endif()
      if(NOT OUT STREQUAL EXPECTED)
        message(FATAL_ERROR "Allocation sweep changed record array result: ${OUT}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Record array failure published output or leaked owners: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Record array sanitizer failure: ${ERR}")
    endif()
  endforeach()
endforeach()
file(WRITE "${OUTPUT_DIR}/reject.k" "${DECL}fn main():\n  make()\n")
foreach(SUFFIX IN ITEMS exe ll mlir)
  file(WRITE "${OUTPUT_DIR}/reject.${SUFFIX}" "preserve-${SUFFIX}")
endforeach()
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/reject.k" -o "${OUTPUT_DIR}/reject.exe" --emit-llvm "${OUTPUT_DIR}/reject.ll" --emit-mlir "${OUTPUT_DIR}/reject.mlir"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0)
  message(FATAL_ERROR "Unsupported record array main display compiled")
endif()
foreach(SUFFIX IN ITEMS exe ll mlir)
  file(READ "${OUTPUT_DIR}/reject.${SUFFIX}" CONTENT)
  if(NOT CONTENT STREQUAL "preserve-${SUFFIX}")
    message(FATAL_ERROR "Failed record array build replaced ${SUFFIX}")
  endif()
endforeach()
message(STATUS "Record arrays: construction, indexing, helper/worker returns, retained nested fields, callbacks, exact snapshots, cancellation, invalid descriptors, failures and artifact preservation passed")
file(READ "${SOURCE_DIR}/../docs/design/record-arrays.md" DOC)
string(REGEX MATCH "```kalandra\n([^`]+)```" EXAMPLE "${DOC}")
COMPILE(documentation "${CMAKE_MATCH_1}")
EXPECT(documentation 6)

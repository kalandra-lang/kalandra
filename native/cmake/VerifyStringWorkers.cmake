include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(HELPERS "fn echo(text:String)->String:\n  text\nfn nested(text:String)->String ! TaskError:\n  try parallel:\n    work=spawn echo(text)\n    first=try await work\n    again=try await work\n    if first==again: again\n    else: \"bad\"\nfn probe(text:String)->String ! TaskError:\n  try parallel:\n    try await spawn nested(text)\n")
COMPILE(roundtrip "${HELPERS}fn main()->String ! TaskError:\n  try probe(\"é\\0👩‍💻\")\n" --test-entry probe)
# The CLI is binary-safe; the harness checks the embedded NUL result directly.
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/StringWorkerRuntimeTests.cpp" "${OUTPUT_DIR}/roundtrip.ll" "${RUNTIME}"
  -o "${OUTPUT_DIR}/harness")
foreach(WORKERS IN ITEMS 1 2 4)
  RUN_OK("${OUTPUT_DIR}/harness" "${WORKERS}")
endforeach()
COMPILE(operations "fn transform(text:String,index:uint32,start:int64,end:uint64)->String:\n  slice(text,start,end)+text[index]\nfn main()->String ! TaskError:\n  try parallel:\n    work=spawn transform(\"aé👩\",2,1,3)\n    a=try await work\n    b=try await work\n    a+b\n")
EXPECT(operations "é👩👩é👩👩")
COMPILE(siblings "fn echo(text:String)->String:\n  text\nfn main()->String ! TaskError:\n  text=\"é\"\n  try parallel:\n    left=spawn echo(text)\n    right=spawn echo(text)\n    a=try await left\n    b=try await right\n    a+b\n")
EXPECT(siblings "éé")
COMPILE(lengths "fn counts(text:String)->int64:\n  length(text)+byteLength(text)\nfn main()->int64 ! TaskError:\n  try parallel:\n    try await spawn counts(\"aé👩\")\n")
EXPECT(lengths 10)
COMPILE(captures "fn work(text:String)->[int64]:\n  map([1,2,3],fn(x): length(text+\"!\")+x)\nfn main()->[int64] ! TaskError:\n  try parallel:\n    try await spawn work(\"é👩\")\n")
EXPECT(captures "[4, 5, 6]")
COMPILE(local-capture "fn main()->[int64]:\n  text=\"é\"\n  map([1,2],fn(x): length(text)+x)\n")
EXPECT(local-capture "[2, 3]")
COMPILE(conditional "fn choose(flag:Bool,a:String,b:String)->String:\n  if flag: a\n  else: b\nfn main()->String ! TaskError:\n  try parallel:\n    try await spawn choose(false,\"x\",\"é\")\n")
EXPECT(conditional "é")
set(FAULT "fn pick(text:String,index:int64)->String:\n  text[index]\nfn attempt()->String ! TaskError:\n  try parallel:\n    try await spawn pick(\"é\",1)\n")
COMPILE(recovery "${FAULT}fn main()->String:\n  attempt() catch fn(error): \"recovered\"\n")
EXPECT(recovery recovered)
COMPILE(rethrow "${FAULT}fn relay()->String ! TaskError:\n  attempt() catch fn(error): fail error\nfn main()->String:\n  relay() catch fn(error): \"recovered\"\n")
EXPECT(rethrow recovered)
COMPILE(diagnostic "${FAULT}fn message()->String:\n  attempt() catch fn(error):\n    match error:\n      TaskError.Fault {message}: message\n      _: \"unexpected\"\nfn main()->String ! TaskError:\n  try parallel:\n    try await spawn echo(message())\nfn echo(text:String)->String:\n  slice(text,0,length(text))+\"!\"\n")
EXPECT(diagnostic "index out of bounds!")
COMPILE(diagnostic-length "${FAULT}fn main()->int64:\n  ignored=attempt() catch fn(error):\n    match error:\n      TaskError.Fault {message}: slice(message,0,0)+message[0]\n      _: \"?\"\n  length(ignored)\n")
EXPECT(diagnostic-length 1)
file(WRITE "${OUTPUT_DIR}/text.k" "export fn append(text:String)->String:\n  text+\"!\"\n")
COMPILE(imports "from \"./text.k\" import append\nfn main()->String ! TaskError:\n  try parallel:\n    try await spawn append(\"سلام\")\n")
EXPECT(imports "سلام!")
COMPILE(empty "fn echo(text:String)->String:\n  text\nfn main()->String ! TaskError:\n  try parallel:\n    try await spawn echo(\"\")\n")
EXPECT(empty "")
COMPILE(fault "${FAULT}fn main()->String ! TaskError:\n  try attempt()\n")
execute_process(COMMAND "${OUTPUT_DIR}/fault" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "TaskError[.]Fault")
  message(FATAL_ERROR "Failed String worker published output: ${STATUS}: ${OUT}${ERR}")
endif()
# Sweep failures in invocation storage (separate from task-admission allocation).
foreach(FAIL_AT RANGE 1 36)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}"
    "${OUTPUT_DIR}/operations" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(STATUS EQUAL 0)
    if(NOT OUT STREQUAL "é👩👩é👩👩\n" OR NOT ERR STREQUAL "")
      message(FATAL_ERROR "String allocation sweep changed result at ${FAIL_AT}: ${OUT}${ERR}")
    endif()
  elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "Allocation|TaskError[.]Fault")
    message(FATAL_ERROR "String allocation failure exposed output at ${FAIL_AT}: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
message(STATUS "String workers: 14 programs, nested/cached results, mixed parameters, captures, diagnostics, recovery and 36 storage-failure positions passed")

if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-record-array-field-tests-${VARIANT} tests/RecordArrayFieldsTests.cpp)
    target_compile_options(kalandra-record-array-field-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-record-array-field-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-record-array-field-tests-${VARIANT} PRIVATE KALANDRA_RECORD_ARRAY_FIELD_FRONTEND_ONLY)
      target_compile_options(kalandra-record-array-field-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-record-array-field-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-record-array-field-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-record-array-fields-frontend-${VARIANT} COMMAND kalandra-record-array-field-tests-${VARIANT})
    set_tests_properties(native-record-array-fields-frontend-${VARIANT} PROPERTIES TIMEOUT 120)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(RAF_RUNTIME kalandra-native-runtime-sanitized)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(RAF_RUNTIME kalandra-native-runtime-thread-sanitized)
    else()
      set(RAF_RUNTIME kalandra-native-runtime)
    endif()
    add_test(NAME native-record-array-fields-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DVARIANT=${VARIANT}"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=$<TARGET_FILE:${RAF_RUNTIME}>"
        "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/record-array-fields-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyRecordArrayFields.cmake")
    set_tests_properties(native-record-array-fields-${VARIANT} PROPERTIES TIMEOUT 600)
  endforeach()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
function(FAULT NAME EXPECTED)
  execute_process(COMMAND "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "${EXPECTED}")
    message(FATAL_ERROR "Record fault mismatch: ${NAME}: ${STATUS}: ${OUT}${ERR}")
  endif()
endfunction()
foreach(TYPE IN ITEMS int32 uint32 int64 uint64 float32 float64)
  set(DECL "type Point:\n  x:${TYPE}\n  y:${TYPE}\n  enabled:Bool\n")
  COMPILE("record-${TYPE}" "${DECL}fn shift(p:Point, dx:${TYPE})->Point:\n  p with {x:p.x+dx}\nfn choose(flag:Bool,p:Point):\n  if flag: shift(p,10)\n  else: p\nfn main()->${TYPE}:\n  original=Point {enabled:true,y:3,x:2}\n  moved=choose(true,original)\n  if moved.enabled: moved.x+original.x+moved.y\n  else: 0\n")
  EXPECT("record-${TYPE}" 17)
  COMPILE("map-${TYPE}" "${DECL}fn project(value:${TYPE}):\n  first=Point {x:value,y:2,enabled:true}\n  second=first with {y:3}\n  if second.enabled: first.x+second.y\n  else: first.y\nfn main():\n  map([${TYPE}(1),${TYPE}(2),${TYPE}(3)],project)\n")
  EXPECT("map-${TYPE}" "[4, 5, 6]")
endforeach()

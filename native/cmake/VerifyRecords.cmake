EXPECT(tensor-field "tensor([1, 2, 3, 4], [2, 2])")
set(DECL "type Point:\n  x:int\n  y:int\n")
file(WRITE "${OUTPUT_DIR}/a.k" "${DECL}export fn make():\n  Point {x:1,y:2}\nexport fn total(p:Point):\n  p.x+p.y\n")
file(WRITE "${OUTPUT_DIR}/b.k" "from \"./a.k\" import make, total\nexport fn go():\n  total(make() with {x:40})\n")
COMPILE(modules "from \"./b.k\" import go\nfn main():\n  go()\n")
EXPECT(modules 42)
COMPILE(conditional "${DECL}fn choose(flag:Bool)->Point:\n  if flag: Point {x:1,y:2}\n  else: Point {x:3,y:4}\nfn main():\n  choose(false).x+choose(true).y\n")
EXPECT(conditional 5)
# Distinct faults identify evaluation order, including written initializer order
# differing from declaration order and base-before-update evaluation.
set(HELPERS "${DECL}fn overflow(x:int):\n  x+1\nfn badindex(i:int):\n  [1][i]\nfn base(i:int)->Point:\n  Point {x:badindex(i),y:0}\n")
COMPILE(order-construct "${HELPERS}fn main():\n  p=Point {y:badindex(5),x:overflow(9223372036854775807)}\n  p.x\n")
FAULT(order-construct Bounds)
COMPILE(order-update "${HELPERS}fn main():\n  p=Point {x:0,y:0} with {y:badindex(5),x:overflow(9223372036854775807)}\n  p.x\n")
FAULT(order-update Bounds)
COMPILE(order-base "${HELPERS}fn main():\n  (base(5) with {x:overflow(9223372036854775807)}).x\n")
FAULT(order-base Bounds)
COMPILE(arithmetic "${HELPERS}fn main():\n  (Point {x:overflow(9223372036854775807),y:0}).x\n")
FAULT(arithmetic Arithmetic)
COMPILE(selected-path "${HELPERS}fn choose(flag:Bool):\n  if flag: Point {x:overflow(9223372036854775807),y:0}\n  else: Point {x:7,y:2}\nfn main():\n  choose(false).x\n")
EXPECT(selected-path 7)
# Failed record builds preserve existing artifacts, rather than publishing a
# partially checked executable or emitted IR.
file(WRITE "${OUTPUT_DIR}/reject.k" "${DECL}fn main():\n  Point {x:1,y:2}\n")
foreach(SUFFIX IN ITEMS exe ll mlir)
  file(WRITE "${OUTPUT_DIR}/reject.${SUFFIX}" "preserve-${SUFFIX}")
endforeach()
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/reject.k" -o "${OUTPUT_DIR}/reject.exe"
  --emit-llvm "${OUTPUT_DIR}/reject.ll" --emit-mlir "${OUTPUT_DIR}/reject.mlir" ${EXTRA}
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT ERR MATCHES "native entry requires")
  message(FATAL_ERROR "Unsupported direct record display admitted: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(SUFFIX IN ITEMS exe ll mlir)
  file(READ "${OUTPUT_DIR}/reject.${SUFFIX}" CONTENT)
  if(NOT CONTENT STREQUAL "preserve-${SUFFIX}")
    message(FATAL_ERROR "Failed record build replaced ${SUFFIX}")
  endif()
endforeach()
message(STATUS "Records: numeric/Bool layouts, unchanged originals, exact values, helpers/recursion, selected paths, modules, maps, evaluation order and failure preservation passed")

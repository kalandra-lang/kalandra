file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(ROOT "${OUTPUT_DIR}")
function(query NAME EXPECTED)
  execute_process(COMMAND "${CHECKER}" ${ARGN}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 30)
  if(NOT STATUS EQUAL EXPECTED OR NOT ERROR STREQUAL "")
    message(FATAL_ERROR "${NAME}: ${STATUS}: stdout=${OUT}; stderr=${ERROR}")
  endif()
  string(JSON VERSION ERROR_VARIABLE PARSE_ERROR GET "${OUT}" formatVersion)
  string(JSON ENCODING GET "${OUT}" positionEncoding)
  if(NOT PARSE_ERROR STREQUAL "NOTFOUND" OR NOT VERSION EQUAL 1 OR NOT ENCODING STREQUAL "utf-16")
    message(FATAL_ERROR "${NAME}: invalid versioned JSON response: ${OUT}")
  endif()
  string(JSON OK GET "${OUT}" ok)
  string(JSON COUNT LENGTH "${OUT}" diagnostics)
  if(EXPECTED EQUAL 0)
    string(JSON FUNCTIONS GET "${OUT}" summary functions)
    if(NOT OK OR NOT COUNT EQUAL 0 OR FUNCTIONS LESS 1)
      message(FATAL_ERROR "${NAME}: invalid success: ${OUT}")
    endif()
  else()
    string(JSON SUMMARY_TYPE TYPE "${OUT}" summary)
    if(OK OR COUNT LESS 1 OR NOT SUMMARY_TYPE STREQUAL "NULL")
      message(FATAL_ERROR "${NAME}: partial success leaked: ${OUT}")
    endif()
  endif()
  set(RESPONSE "${OUT}" PARENT_SCOPE)
endfunction()
function(code EXPECTED)
  string(JSON CODE GET "${RESPONSE}" diagnostics 0 code)
  if(NOT CODE STREQUAL EXPECTED)
    message(FATAL_ERROR "Expected ${EXPECTED}, got ${RESPONSE}")
  endif()
endfunction()
file(WRITE "${ROOT}/good.k" "fn main()->int:\n  42\n")
query(success 0 --diagnostics=json "${ROOT}/good.k")
query(after-source 0 "${ROOT}/good.k" --diagnostics=json)

query(cpu-placement-error 1 --diagnostics=json "${ROOT}/placed.k")
code(S045)
foreach(CASE IN ITEMS missing duplicate unknown dump-ir dump-plan bad-package missing-package missing-project both)
  if(CASE STREQUAL "missing")
    set(ARGS --diagnostics=json)
  elseif(CASE STREQUAL "duplicate")
    set(ARGS --diagnostics=json --diagnostics=json "${ROOT}/good.k")
  elseif(CASE STREQUAL "unknown")
    set(ARGS --invalid --diagnostics=json "${ROOT}/good.k")
  elseif(CASE STREQUAL "dump-ir" OR CASE STREQUAL "dump-plan")
    set(ARGS "--${CASE}" --diagnostics=json "${ROOT}/good.k")
  elseif(CASE STREQUAL "bad-package")
    set(ARGS --diagnostics=json --package invalid "${ROOT}/good.k")
  elseif(CASE STREQUAL "missing-package")
    set(ARGS --diagnostics=json --package)
  elseif(CASE STREQUAL "missing-project")
    set(ARGS --diagnostics=json --project)
  else()
    set(ARGS --diagnostics=json "${ROOT}/good.k" --project "${ROOT}/kalandra.toml")
  endif()
  query("cli-${CASE}" 2 ${ARGS})
  code(CLI001)
endforeach()
# Existing terminal, dump and option-value behavior remains separate from the JSON protocol.
execute_process(COMMAND "${CHECKER}" "${ROOT}/good.k" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR NOT OUT MATCHES "^Checked 1 functions" OR NOT ERROR STREQUAL "")
  message(FATAL_ERROR "Legacy text success changed: ${STATUS}: ${OUT} ${ERROR}")
endif()
execute_process(COMMAND "${CHECKER}" "${ROOT}/crlf.k" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 1 OR NOT OUT STREQUAL "" OR NOT ERROR MATCHES "error\\[S016\\]")
  message(FATAL_ERROR "Legacy text diagnostics changed: ${STATUS}: ${OUT} ${ERROR}")
endif()
execute_process(COMMAND "${CHECKER}" --dump-ir "${ROOT}/good.k" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR OUT STREQUAL "" OR NOT ERROR STREQUAL "")
  message(FATAL_ERROR "Legacy typed IR output changed: ${STATUS}: ${OUT} ${ERROR}")
endif()
execute_process(COMMAND "${CHECKER}" --project --diagnostics=json RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 1 OR NOT OUT STREQUAL "" OR NOT ERROR MATCHES "toml extension")
  message(FATAL_ERROR "Option value selected JSON output: ${STATUS}: ${OUT} ${ERROR}")
endif()
message(STATUS "Structured checker CLI: 29 JSON responses plus four legacy protocol checks passed")

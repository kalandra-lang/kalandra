  file(READ "${OUTPUT_DIR}/identity-${TYPE}.ll" CANCEL_LLVM)
  string(REPLACE "@kalandra_poll_slow_v1(" "@kalandra_array_tensor_poll_gate_v1(" CANCEL_LLVM "${CANCEL_LLVM}")
  file(WRITE "${OUTPUT_DIR}/cancel-${TYPE}.ll" "${CANCEL_LLVM}")
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}"
    "${SOURCE_DIR}/tests/ArrayTensorCancellationTests.cpp" "${OUTPUT_DIR}/cancel-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/cancel-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/cancel-${TYPE}-harness")
  COMPILE("shape-${TYPE}" "fn convert(input:[${TYPE}])->Tensor[${TYPE},2]:\n  tensor(input)\nfn main()->int64:\n  0\n" --test-entry convert)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}"
    "${SOURCE_DIR}/tests/ArrayTensorShapeTests.cpp" "${OUTPUT_DIR}/shape-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/shape-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/shape-${TYPE}-harness")
  if(TYPE STREQUAL "float32")
    set(DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "float64")
    set(DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "int64")
    set(DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "uint64")
    set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "uint32")
    set(DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(DEFINES)
  endif()
  set(SOURCE "fn failing(value:int64)->int64:\n  1/value\nfn uncertain(flag:Bool)->[${TYPE}]:\n  if flag: [${TYPE}(1)]\n  else: [${TYPE}(1),${TYPE}(2),${TYPE}(3),${TYPE}(4)]\nfn shaped(values:[${TYPE}])->Tensor[${TYPE},4]:\n  tensor(values)\nfn run(values:[${TYPE}],offset:${TYPE}):\n  values -> map(fn(x): reduceSum(tensor(map([x],fn(y): y+y+offset)))) -> tensor()\nfn inner(values:[${TYPE}]) ! TaskError:\n  try parallel:\n    work=spawn tensor(values)\n    first=try await work\n    again=try await work\n    again\nfn bad(values:[${TYPE}],divisor:int):\n  tensor(map(values,fn(x): ${TYPE}(failing(divisor))))\nfn faultProbe()->Tensor[${TYPE},?] ! TaskError:\n  divisor=0\n  values=[${TYPE}(1)]\n  try parallel:\n    work=spawn bad(values,divisor)\n    try await work\nfn shapeProbe()->Tensor[${TYPE},4] ! TaskError:\n  values=uncertain(true)\n  try parallel:\n    work=spawn shaped(values)\n    try await work\nfn emptyProbe()->Tensor[${TYPE},?] ! TaskError:\n  divisor=0\n  empty=map([],fn(x:${TYPE}): ${TYPE}(failing(divisor)))\n  try parallel:\n    work=spawn tensor(empty)\n    try await work\nfn probe() ! TaskError:\n  original=[${TYPE}(1),${TYPE}(2),${TYPE}(3),${TYPE}(4)]\n  offset=${TYPE}(0)\n  mapped=map(original,fn(x): x+x)\n  arithmeticAttempt=faultProbe()\n  arithmeticRecovered=arithmeticAttempt catch fn(error): tensor(mapped)\n  shapeAttempt=shapeProbe()\n  shapeRecovered=shapeAttempt catch fn(error): tensor(mapped)\n  try parallel:\n    nested=spawn inner(mapped)\n    left=spawn run(original,offset)\n    right=spawn tensor(mapped)\n    n=try await nested\n    a=try await left\n    b=try await right\n    again=try await right\n    (n+a+b+again+shapeRecovered+arithmeticRecovered)/6\nfn main()->${TYPE} ! TaskError:\n  result=try probe()\n  reduceSum(result)\n")
  foreach(KIND IN ITEMS probe emptyProbe faultProbe shapeProbe)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -DTENSOR_RANK=1 -DCONVERSION_RESULT=1 ${DEFINES}

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
# Every supported scalar family must coexist in capture frames and keep its own layout.
set(PARAMS "a:f64,b:f32,c:i64,d:u64,e:i32,f:u32")
set(ARGS "1.0000000000000002,1.5,9007199254740993,18446744073709551615,2147483647,4294967295")
set(PREFIX "")
foreach(FIELDS IN ITEMS "wide,f64,a" "small,f32,b" "signed,i64,c" "unsigned,u64,d" "signed32,i32,e" "unsigned32,u32,f")
  string(REPLACE "," ";" FIELDS "${FIELDS}")
  list(GET FIELDS 0 NAME)
  list(GET FIELDS 1 TYPE)
  list(GET FIELDS 2 VALUE)
  string(APPEND PREFIX "fn ${NAME}(${PARAMS}) -> ${TYPE}:\n  return ${VALUE}\n")
endforeach()
foreach(FIELDS IN ITEMS "wide,f64,1.0000000000000002" "small,f32,1.5" "signed,i64,9007199254740993" "unsigned,u64,18446744073709551615" "signed32,i32,2147483647" "unsigned32,u32,4294967295")
  string(REPLACE "," ";" FIELDS "${FIELDS}")
  list(GET FIELDS 0 NAME)
  list(GET FIELDS 1 TYPE)
  list(GET FIELDS 2 EXPECTED)
  set(SOURCE "${PREFIX}fn main() -> ${TYPE} ! TaskError:\n  return try parallel:\n    work = spawn ${NAME}(${ARGS})\n    alias=work\n    first=try await work\n    try await alias\n")
  COMPILE("mixed-${NAME}" "${SOURCE}")
  foreach(WORKERS IN ITEMS 1 2 4)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/mixed-${NAME}")
    if(NOT OUTPUT STREQUAL "${EXPECTED}\n")
      message(FATAL_ERROR "Mixed numeric captures/results changed ${NAME}: ${OUTPUT}")
    endif()
  endforeach()
endforeach()
file(READ "${OUTPUT_DIR}/mixed-wide.ll" LLVM)
foreach(LAYOUT IN ITEMS scalar.float64 scalar.int64 scalar.uint64 scalar.int32 scalar.uint32)
  if(NOT LLVM MATCHES "value.layout.${LAYOUT}")
    message(FATAL_ERROR "Mixed frame lost layout ${LAYOUT}")
  endif()
endforeach()
if(NOT LLVM MATCHES "value.layout.scalar\"? =")
  message(FATAL_ERROR "Mixed frame lost the established f32 layout")
endif()
set(CASE 0)
foreach(TEST IN ITEMS "-0.0|8000000000000000" "4.9406564584124654e-324|0000000000000001" "1.0000000000000002|3ff0000000000001" "1.7976931348623157e308|7fefffffffffffff" "1.0/0|7ff0000000000000" "0.0/0|7ff8000000000000" "1.0000000000000002 * -0.9999999999999998 + 1.0000000000000002|3cb0000000000000" "(9007199254740992.0 + 1) - 9007199254740992.0|0000000000000000")
  string(REPLACE "|" ";" FIELDS "${TEST}")
  list(GET FIELDS 0 EXPR)
  list(GET FIELDS 1 BITS)
  set(SOURCE "fn make() -> f64:\n  return ${EXPR}\nfn identity(x:f64) -> f64:\n  return x\nfn nested() -> f64 ! TaskError:\n  return try parallel:\n    produced=spawn make()\n    value=try await produced\n    work=spawn identity(value)\n    alias=work\n    first=try await work\n    try await alias\nfn main() -> f64 ! TaskError:\n  return try parallel:\n    work=spawn nested()\n    try await work\n")
  COMPILE("exact-${CASE}" "${SOURCE}" --test-entry main)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-I${SOURCE_DIR}/include"
    "${SOURCE_DIR}/tests/Float64TaskTests.cpp" "${OUTPUT_DIR}/exact-${CASE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/exact-${CASE}-harness")
  foreach(WORKERS IN ITEMS 1 2 4)
    RUN_OK("${OUTPUT_DIR}/exact-${CASE}-harness" "${WORKERS}" "${BITS}" 0 0)
  endforeach()
  math(EXPR CASE "${CASE}+1")
endforeach()
# A failed integer sibling does not corrupt a binary64 capture used by recovery.
# Owned f32 input must settle even when the child or root is rejected.
set(SOURCE "fn bad(x:i64) -> i64:\n  return x+1\nfn calculate(values:Tensor[f32,?],saved:f64) -> f64 ! TaskError:\n  return try parallel:\n    work=spawn bad(9223372036854775807)\n    try await work\n    saved+1\nfn main() -> f64:\n  saved:f64=1.0000000000000002\n  values:Tensor[f32,3]=tensor([1,2,3])\n  result=calculate(values,saved)\n  recovered=result catch fn(error):\n    return match error:\n      TaskError.Fault {kind:cause,message:detail}:\n        match cause:\n          FaultKind.Arithmetic: saved\n          FaultKind.Allocation: saved\n          _: 0\n      _: 0\n  return try parallel:\n    child=spawn wide(recovered,1.5,9007199254740993,18446744073709551615,2147483647,4294967295)\n    try await child\n")
# A containing fallible function is required for the second parallel scope.
string(REPLACE "fn main() -> f64:" "fn main() -> f64 ! TaskError:" SOURCE "${SOURCE}")
COMPILE(recovered "${PREFIX}${SOURCE}" --test-entry main)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-I${SOURCE_DIR}/include"
  "${SOURCE_DIR}/tests/Float64TaskTests.cpp" "${OUTPUT_DIR}/recovered.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/recovered-harness")
foreach(WORKERS IN ITEMS 1 2 4)
  foreach(MODE IN ITEMS 0 1 2 4)
    RUN_OK("${OUTPUT_DIR}/recovered-harness" "${WORKERS}" 3ff0000000000001 "${MODE}" 0)
  endforeach()
  foreach(ATTEMPT RANGE 1 24)
    RUN_OK("${OUTPUT_DIR}/recovered-harness" "${WORKERS}" 3ff0000000000001 3 "${ATTEMPT}")
  endforeach()
  RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/recovered")
  if(NOT OUTPUT STREQUAL "1.0000000000000002\n")
    message(FATAL_ERROR "Recovery lost binary64 precision")
  endif()
endforeach()
foreach(INVALID IN ITEMS 0 65 invalid)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${INVALID}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/mixed-wide"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 88 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "TaskError.AdmissionRejected" OR NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Binary64 root admission failure did not settle: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
message(STATUS "f64 exact scalar worker captures/results, mixed numeric packets, nested/cached awaits, typed layout rejection and recovered allocation/cancellation/deadline/admission lifetimes passed with 1/2/4 workers")

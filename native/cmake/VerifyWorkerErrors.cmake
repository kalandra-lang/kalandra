include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES "error A:\n  Bad:\n    text:String\n    values:[i64]\nerror B:\n  Missing\ntype Mixed=A | B | TaskError\n")
set(CHILD "fn child(mode:i64)->i64 ! (A | B):\n  if mode==0:fail A.Bad {text:\"é\"+\"🙂\",values:[20,22]}\n  if mode==1:fail B.Missing\n  return 8/(mode-2)\n")
set(HANDLER "catch fn(error):\n    return match error:\n      A.Bad {text,values}:length(text)+values[0]+values[1]\n      B.Missing:7\n      TaskError.Fault {kind,message}:\n        match kind:\n          FaultKind.Arithmetic:100+length(message)\n          _:900\n      _:800\n")
string(REPLACE "\n" "\n    " GROUP_HANDLER "${HANDLER}")
string(REGEX REPLACE " +$" "" GROUP_HANDLER "${GROUP_HANDLER}")
COMPILE(propagate "${TYPES}${CHILD}fn work(mode:i64)->i64 ! Mixed:\n  return try parallel:\n    try await spawn child(mode)\nfn recover(mode:i64)->i64:\n  return work(mode) ${HANDLER}fn main()->[i64]:\n  return [recover(0),recover(1),recover(2),recover(4)]\n")
foreach(WORKERS IN ITEMS 1 2 4)
  RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/propagate")
  if(NOT OUTPUT STREQUAL "[44, 7, 124, 4]\n")
    message(FATAL_ERROR "Worker error propagation changed: ${OUTPUT}")
  endif()
endforeach()
COMPILE(cached "${TYPES}${CHILD}fn work(mode:i64)->i64 ! TaskError:\n  try parallel:\n    job=spawn child(mode)\n    first=await job ${GROUP_HANDLER}    second=await job ${GROUP_HANDLER}    first+second\nfn main()->[i64] ! TaskError:\n  [try work(0),try work(1),try work(4)]\n")
EXPECT(cached "[88, 14, 8]")
COMPILE(siblings "${TYPES}${CHILD}fn work()->i64 ! Mixed:\n  try parallel:\n    failed=spawn child(0)\n    sibling=spawn child(4)\n    first=await failed ${GROUP_HANDLER}    second=try await sibling\n    first+second\nfn main()->i64 ! Mixed:\n  try work()\n")
EXPECT(siblings 48)
COMPILE(nested "${TYPES}${CHILD}fn inner(mode:i64)->i64 ! Mixed:\n  return try parallel:\n    try await spawn child(mode)\nfn outer(mode:i64)->i64 ! Mixed:\n  return try parallel:\n    try await spawn inner(mode)\nfn recover(mode:i64)->i64:\n  return outer(mode) ${HANDLER}fn main()->[i64]:\n  return [recover(0),recover(1),recover(2),recover(4)]\n")
EXPECT(nested "[44, 7, 124, 4]")
COMPILE(rethrow "${TYPES}${CHILD}fn work(mode:i64)->i64 ! Mixed:\n  return try parallel:\n    value=await spawn child(mode) catch fn(error):fail error\n    try value\nfn recover(mode:i64)->i64:\n  return work(mode) ${HANDLER}fn main()->[i64]:\n  return [recover(0),recover(1),recover(2),recover(4)]\n")
EXPECT(rethrow "[44, 7, 124, 4]")
# Once a child fault is observed, a later application propagation cannot
# replace the primary execution failure or reopen the group.
COMPILE(prior-fault "${TYPES}${CHILD}fn work()->i64 ! Mixed:\n  return try parallel:\n    failed=spawn child(2)\n    ignored=await failed catch fn(error):return 0\n    try child(0)\nfn main()->i64:\n  return work() ${HANDLER}")
EXPECT(prior-fault 124)
COMPILE(local-body "${TYPES}${CHILD}fn work(mode:i64)->i64 ! Mixed:\n  return try parallel:\n    try child(mode)\nfn recover(mode:i64)->i64:\n  return work(mode) ${HANDLER}fn main()->[i64]:\n  return [recover(0),recover(1),recover(4)]\n")
EXPECT(local-body "[44, 7, 4]")
COMPILE(guard "${TYPES}fn identity(value:i64)->i64:\n  return value\nfn work(bad:bool)->i64 ! Mixed:\n  return try parallel:\n    job=spawn identity(10)\n    if bad:fail A.Bad {text:\"é\"+\"🙂\",values:[20,22]}\n    try await job\nfn main()->i64:\n  return work(true) ${HANDLER}")
EXPECT(guard 44)
COMPILE(replace "${TYPES}${CHILD}fn work()->i64 ! Mixed:\n  return try parallel:\n    value=await spawn child(0) catch fn(error):fail B.Missing\n    try value\nfn main()->i64:\n  return work() ${HANDLER}")
EXPECT(replace 7)
# Success payloads and expected payloads must remain independent across reads.
foreach(TYPE IN ITEMS i8 u8 i16 u16 i32 u32 i64 u64 f32 f64)
  COMPILE("width-${TYPE}" "error E:\n  Bad:\n    value:${TYPE}\nfn child(ok:bool)->${TYPE} ! E:\n  return if ok:5\n  else:fail E.Bad {value:7}\nfn work(ok:bool)->${TYPE} ! (E | TaskError):\n  return try parallel:\n    try await spawn child(ok)\nfn recover(ok:bool)->${TYPE}:\n  return work(ok) catch fn(error):\n    return match error:\n      E.Bad {value}:value\n      _:0\nfn main()->${TYPE}:\n  return recover(false)+recover(true)\n")
  EXPECT("width-${TYPE}" 12)
endforeach()
set(STRING "error E:\n  Bad:\n    text:String\nfn child(ok:bool)->String ! E:\n  return if ok:\"ok\"+\"!\"\n  else:fail E.Bad {text:\"é\"+\"🙂\"}\nfn work(ok:bool)->String ! (E | TaskError):\n  return try parallel:\n    try await spawn child(ok)\nfn recover(ok:bool)->String:\n  return work(ok) catch fn(error):\n    return match error:\n      E.Bad {text}:text\n      _:\"fault\"\nfn main()->String:\n  return recover(false)+recover(true)\n")
COMPILE(strings "${STRING}")
EXPECT(strings "é🙂ok!")
COMPILE(array "error E:\n  Bad:\n    values:[String]\nfn child(ok:bool)->[String] ! E:\n  return if ok:[\"ok\"+\"!\"]\n  else:fail E.Bad {values:[\"é\"+\"🙂\",\"done\"]}\nfn work(ok:bool)->[String] ! (E | TaskError):\n  return try parallel:\n    try await spawn child(ok)\nfn recover(ok:bool)->[String]:\n  return work(ok) catch fn(error):\n    return match error:\n      E.Bad {values}:values\n      _:[\"fault\"]\nfn main()->String:\n  return recover(false)[0]+recover(true)[0]\n")
EXPECT(array "é🙂ok!")
COMPILE(managed "${TYPES}type Box:\n  text:String\n  values:[i64]\nfn child(ok:bool)->Box ! A:\n  return if ok:Box {text:\"ok\"+\"!\",values:[10,20]}\n  else:fail A.Bad {text:\"é\"+\"🙂\",values:[20,22]}\nfn work(ok:bool)->Box ! (A | TaskError):\n  return try parallel:\n    try await spawn child(ok)\nfn recover(ok:bool)->Box:\n  return work(ok) catch fn(error):\n    return match error:\n      A.Bad {text,values}:Box {text:text,values:values}\n      _:Box {text:\"fault\",values:[0]}\nfn main()->[i64]:\n  first=recover(false)\n  second=recover(true)\n  return [length(first.text)+first.values[1]+length(second.text)+second.values[1]]\n")
EXPECT(managed "[47]")
foreach(MODE IN ITEMS 0 2)
  COMPILE("unhandled-${MODE}" "${TYPES}${CHILD}fn main()->i64 ! Mixed:\n  return try parallel:\n    try await spawn child(${MODE})\n")
  execute_process(COMMAND "${OUTPUT_DIR}/unhandled-${MODE}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(MODE EQUAL 0)
    if(NOT "${STATUS}" STREQUAL "89" OR NOT ERR MATCHES "A.Bad" OR NOT OUT STREQUAL "")
      message(FATAL_ERROR "Lost application classification: ${STATUS}: ${OUT}${ERR}")
    endif()
  elseif(NOT "${STATUS}" STREQUAL "88" OR NOT ERR MATCHES "TaskError.Fault at source 11:3" OR NOT OUT STREQUAL "")
    message(FATAL_ERROR "Lost task classification: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
# Failed allocations can occur in the parent (uncatchable execution fault),
# child (TaskError), or handler. Every path must release all retained backing.
foreach(NAME IN ITEMS propagate cached nested managed)
  foreach(ATTEMPT RANGE 1 32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Worker error cleanup failed: ${NAME} ${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(("${STATUS}" STREQUAL "86" AND NOT ERR MATCHES "AllocationFault") OR ("${STATUS}" STREQUAL "88" AND NOT ERR MATCHES "TaskError.Fault") OR (NOT "${STATUS}" STREQUAL "0" AND NOT OUT STREQUAL ""))
      message(FATAL_ERROR "Worker allocation classification changed: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()

# Selection metadata only: never replace existing labels, commands, locks,
# environments, timeouts, dependencies or registration conditions.
function(kalandra_label_tests directory)
  get_property(tests DIRECTORY "${directory}" PROPERTY TESTS)
  foreach(test IN LISTS tests)
    set(labels feature-full)
    if(test MATCHES "^frontend-|function-type-syntax")
      list(APPEND labels feature-frontend)
    endif()
    if(test MATCHES "format|editor|lsp|rename|project|scaffold|module|package")
      list(APPEND labels feature-tooling)
    endif()
    if(test MATCHES "return|loop|collect|rebinding|local-storage|control")
      list(APPEND labels feature-control)
    endif()
    if(test MATCHES "task|cancel|invocation|group|scope|ownership|capture|callable|closure|array")
      list(APPEND labels feature-tasks)
    endif()
    if(test MATCHES "arithmetic|numeric|float|integer|tensor|matmul|reduction|matrix|conversion|cast|simd|strict|sort|relu|range|remainder")
      list(APPEND labels feature-numerics)
    endif()
    if(test MATCHES "metal|cuda|vulkan|gpu|device")
      list(APPEND labels feature-gpu)
    endif()
    if(test MATCHES "standalone|packag|install|bundle|cross.*(toolchain|qualification|target)|release")
      list(APPEND labels feature-packaging)
    endif()
    if(test MATCHES "^native-")
      list(APPEND labels feature-runtime)
    endif()
    if(test MATCHES "thread-sanitized|tsan")
      list(APPEND labels variant-thread-sanitized)
    elseif(test MATCHES "sanitized|asan|ubsan")
      list(APPEND labels variant-sanitized)
    elseif(test MATCHES "optimized|release")
      list(APPEND labels variant-optimized)
    elseif(test MATCHES "debug")
      list(APPEND labels variant-debug)
    else()
      list(APPEND labels variant-default)
    endif()
    set_property(TEST "${test}" DIRECTORY "${directory}" APPEND PROPERTY LABELS ${labels})
  endforeach()
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    kalandra_label_tests("${child}")
  endforeach()
endfunction()

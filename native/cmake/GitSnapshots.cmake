if(BUILD_TESTING)
  find_program(KALANDRA_PYTHON3 python3 REQUIRED)
  add_library(kalandra-git-snapshots-sanitized STATIC lib/GitSnapshot.cpp)
  target_link_libraries(kalandra-git-snapshots-sanitized PUBLIC kalandra-project-sanitized PRIVATE LLVM)
  target_include_directories(kalandra-git-snapshots-sanitized SYSTEM PRIVATE ${KALANDRA_TOML_INCLUDES} ${LLVM_INCLUDE_DIRS})
  target_compile_definitions(kalandra-git-snapshots-sanitized PRIVATE TOML_HEADER_ONLY=1 TOML_ENABLE_UNRELEASED_FEATURES=0)
  target_compile_options(kalandra-git-snapshots-sanitized PRIVATE -Wall -Wextra -Werror -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
  target_link_options(kalandra-git-snapshots-sanitized PUBLIC -fsanitize=address,undefined -fno-sanitize-recover=all)
  add_library(kalandra-packages-sanitized STATIC lib/PackageInstall.cpp lib/PackageLock.cpp)
  target_link_libraries(kalandra-packages-sanitized PUBLIC kalandra-git-snapshots-sanitized PRIVATE LLVM)
  target_include_directories(kalandra-packages-sanitized SYSTEM PRIVATE ${KALANDRA_TOML_INCLUDES} ${LLVM_INCLUDE_DIRS})
  target_compile_definitions(kalandra-packages-sanitized PRIVATE TOML_HEADER_ONLY=1 TOML_ENABLE_UNRELEASED_FEATURES=0)
  target_compile_options(kalandra-packages-sanitized PRIVATE -Wall -Wextra -Werror -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
  target_link_options(kalandra-packages-sanitized PUBLIC -fsanitize=address,undefined -fno-sanitize-recover=all)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-git-snapshot-tests-${VARIANT} tests/GitSnapshotTests.cpp)
    target_compile_options(kalandra-git-snapshot-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-git-snapshot-tests-${VARIANT} PRIVATE kalandra-git-snapshots-sanitized kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-git-snapshot-tests-${VARIANT} PRIVATE KALANDRA_SNAPSHOT_FRONTEND_ONLY)
      target_compile_options(kalandra-git-snapshot-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-git-snapshot-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-git-snapshot-tests-${VARIANT} PRIVATE kalandra-git-snapshots kalandra-backend)
      target_include_directories(kalandra-git-snapshot-tests-${VARIANT} SYSTEM PRIVATE ${LLVM_INCLUDE_DIRS})
    endif()
    add_test(NAME native-git-snapshots-${VARIANT} COMMAND "${KALANDRA_PYTHON3}"
      "${CMAKE_CURRENT_SOURCE_DIR}/tests/GitSnapshotFixtures.py" "$<TARGET_FILE:kalandra-git-snapshot-tests-${VARIANT}>"
      "${CMAKE_CURRENT_BINARY_DIR}/git-snapshots-${VARIANT}")
    set_tests_properties(native-git-snapshots-${VARIANT} PROPERTIES TIMEOUT 180)
  endforeach()
  set_tests_properties(native-git-snapshots-debug PROPERTIES FIXTURES_SETUP native-git-snapshot-fixture)
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(SNAPSHOT_RUNTIME kalandra-native-runtime-sanitized)
      set(SNAPSHOT_ENTRY kalandra-collection-entry-sanitized)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(SNAPSHOT_RUNTIME kalandra-native-runtime-thread-sanitized)
      set(SNAPSHOT_ENTRY kalandra-collection-entry-thread-sanitized)
    else()
      set(SNAPSHOT_RUNTIME kalandra-native-runtime)
      set(SNAPSHOT_ENTRY kalandra-collection-entry-debug)
    endif()
    add_test(NAME native-git-snapshot-runtime-${VARIANT} COMMAND "${CMAKE_COMMAND}"
      "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DVARIANT=${VARIANT}"
      "-DENTRY=$<TARGET_FILE:${SNAPSHOT_ENTRY}>" "-DRUNTIME=$<TARGET_FILE:${SNAPSHOT_RUNTIME}>"
      "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/git-snapshot-runtime-${VARIANT}"
      "-DFIXTURE_DIR=${CMAKE_CURRENT_BINARY_DIR}/git-snapshots-debug"
      -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyGitSnapshotRuntime.cmake")
    set_tests_properties(native-git-snapshot-runtime-${VARIANT} PROPERTIES TIMEOUT 90 FIXTURES_REQUIRED native-git-snapshot-fixture)
  endforeach()
endif()

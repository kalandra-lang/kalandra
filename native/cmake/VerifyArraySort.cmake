include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int8 int16 int32 int64 uint8 uint16 uint32 uint64 float32 float64)
foreach(ID RANGE 0 9)
  list(GET TYPES ${ID} TYPE)
  COMPILE("sort-${TYPE}" "fn ordered(mut a:[${TYPE}])->int:\n  b=sort(a)\n  length(b)\nfn main()->int:\n  0\n" --test-entry ordered)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}"
    "${SOURCE_DIR}/tests/ArraySortRuntimeTests.cpp" "${OUTPUT_DIR}/sort-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/sort-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/sort-${TYPE}-harness")
  COMPILE("copy-${TYPE}" "fn main()->int:\n  a=[${TYPE}(3),${TYPE}(1),${TYPE}(2)]\n  alias=a\n  b=sorted(a)\n  b[0]=${TYPE}(7)\n  c=sort(a)\n  int(alias[0])*100+int(c[2])*10+int(b[0])\n")
  EXPECT("copy-${TYPE}" 137)
  COMPILE("raw-copy-${TYPE}" "fn ordered(a:[${TYPE}])->[${TYPE}]:\n  sorted(a)\nfn main()->int:\n  0\n" --test-entry ordered)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}" -DSORT_COPY
    "${SOURCE_DIR}/tests/ArraySortRuntimeTests.cpp" "${OUTPUT_DIR}/raw-copy-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/raw-copy-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/raw-copy-${TYPE}-harness")
endforeach()
COMPILE(bool "fn main()->int:\n  a=[true,false,true,false]\n  b=sorted(a)\n  c=sort(a)\n  if not a[0] and not c[1] and b[2] and b[3]:42\n  else:0\n")
EXPECT(bool 42)
COMPILE(empty "fn main()->int:\n  a:[int]=[]\n  b:[Bool]=[]\n  length(sort(a))+length(sorted(b))+sort([42])[0]\n")
EXPECT(empty 42)
COMPILE(task "fn main()->int ! TaskError:\n  a=[3,1,2]\n  b=try parallel:\n    try await spawn sorted(a)\n  c=sort(b)\n  a[0]*100+b[0]*10+c[2]\n")
EXPECT(task 313)
COMPILE(worker "fn work()->[int]:\n  a=[3,1,2]\n  sort(a)\nfn main()->int ! TaskError:\n  a=try parallel:\n    try await spawn work()\n  a[0]*100+a[2]\n")
EXPECT(worker 103)
message(STATUS "Sorting: ten numeric types/Bool, raw bits/strides, copy isolation, empty arrays and tasks passed")
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/ArraySortCancellationTests.cpp" "${OUTPUT_DIR}/sort-int64.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/cancellation-harness")
RUN_OK("${OUTPUT_DIR}/cancellation-harness")
COMPILE(publication "fn run(mut a:[int],n:int)->int:\n  f=fn()->[int]:a\n  i=0\n  while i<n:\n    f()[0]=f()[0]+1\n    i=i+1\n  a[0]\nfn main()->int:\n  0\n" --test-entry run)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/ArrayAliasPublicationTests.cpp" "${OUTPUT_DIR}/publication.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/publication-harness")
RUN_OK("${OUTPUT_DIR}/publication-harness")
include("${CMAKE_CURRENT_LIST_DIR}/VerifyArraySortHardware.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES i8 u8 i16 u16 i32 u32 i64 u64 f32 f64)
set(IDENTITIES 0 4 1 5 2 6 3 7 8 9)
foreach(SOURCE_INDEX RANGE 0 9)
  list(GET TYPES ${SOURCE_INDEX} SOURCE_TYPE)
  list(GET IDENTITIES ${SOURCE_INDEX} SOURCE_ID)
  if(DEFINED SOURCE_FILTER AND NOT SOURCE_TYPE STREQUAL SOURCE_FILTER)
    continue()
  endif()
  foreach(DESTINATION_INDEX RANGE 0 9)
    list(GET TYPES ${DESTINATION_INDEX} DESTINATION_TYPE)
    list(GET IDENTITIES ${DESTINATION_INDEX} DESTINATION_ID)
    set(RANKS 2)
    if("${SOURCE_TYPE}-${DESTINATION_TYPE}" MATCHES "^(int64-float32|float64-uint64|float64-float32|float32-float64|int8-uint8|uint8-int16|int16-uint16|uint16-int8|float64-int8|uint16-float32)$")
      list(APPEND RANKS 0 1 3)
    endif()
    if(SMOKE AND NOT "${SOURCE_TYPE}-${DESTINATION_TYPE}" STREQUAL "float64-uint64")
      continue()
    endif()
    foreach(RANK IN LISTS RANKS)
      set(SHAPE "")
      foreach(AXIS RANGE 1 ${RANK})
        if(RANK GREATER 0)
          string(APPEND SHAPE ",?")
        endif()
      endforeach()
      set(NAME "${SOURCE_TYPE}-${DESTINATION_TYPE}-${RANK}")
      COMPILE("${NAME}" "fn operation(value:Tensor[${SOURCE_TYPE}${SHAPE}]) -> Tensor[${DESTINATION_TYPE}${SHAPE}]:\n  return ${DESTINATION_TYPE}(value)\nfn main() -> i64:\n  return 0\n" --test-entry operation)
      RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
        "-DSOURCE_TYPE=${SOURCE_ID}" "-DDESTINATION_TYPE=${DESTINATION_ID}" "-DTENSOR_RANK=${RANK}" -isystem "${LLVM_ROOT}/include"
        "${SOURCE_DIR}/tests/TensorConversionRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}"
        "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
      RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
    endforeach()
  endforeach()
endforeach()
if(SMOKE)
  return()
endif()
foreach(INDEX RANGE 0 9)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDENTITIES ${INDEX} ID)
  if(DEFINED SOURCE_FILTER AND NOT TYPE STREQUAL SOURCE_FILTER)
    continue()
  endif()
  if(TYPE STREQUAL "i8")
    set(RESULT_DEFINES -DINTEGER_BITS=8)
  elseif(TYPE STREQUAL "u8")
    set(RESULT_DEFINES -DINTEGER_BITS=8 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "i16")
    set(RESULT_DEFINES -DINTEGER_BITS=16)
  elseif(TYPE STREQUAL "u16")
    set(RESULT_DEFINES -DINTEGER_BITS=16 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "f32")
    set(RESULT_DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "f64")
    set(RESULT_DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "i64")
    set(RESULT_DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "u64")
    set(RESULT_DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "u32")
    set(RESULT_DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(RESULT_DEFINES)
  endif()
  set(FUNCTIONS "")
  set(SPAWNS "")
  set(AWAITS "")
  set(SUM "original")
  foreach(INPUT_TYPE IN LISTS TYPES)
    string(APPEND FUNCTIONS "fn from_${INPUT_TYPE}(value:Tensor[${INPUT_TYPE},?,?]) -> Tensor[${TYPE},?,?]:\n  return ${TYPE}(value)\n")
    string(APPEND SPAWNS "    input_${INPUT_TYPE}:Tensor[${INPUT_TYPE},2,2]=tensor([[1,2],[3,4]])\n    work_${INPUT_TYPE}=spawn from_${INPUT_TYPE}(input_${INPUT_TYPE})\n")
    string(APPEND AWAITS "    result_${INPUT_TYPE}=try await work_${INPUT_TYPE}\n")
    string(APPEND SUM "+result_${INPUT_TYPE}")
  endforeach()
  set(SOURCE "fn failing(value:Tensor[f64,?,?]) -> Tensor[u64,?,?]:\n  return u64(value)\n${FUNCTIONS}fn inner(value:Tensor[${TYPE},?,?]) -> Tensor[${TYPE},?,?] ! TaskError:\n  return try parallel:\n    work=spawn ${TYPE}(value)\n    first=try await work\n    again=try await work\n    again\nfn attempt(value:Tensor[${TYPE},?,?]) -> Tensor[${TYPE},?,?] ! TaskError:\n  return try parallel:\n    bad=spawn failing(tensor([[1.0,2.0],[3.0,-1.0]]))\n    sibling=spawn inner(value)\n    try await bad\n    try await sibling\nfn probe() -> Tensor[${TYPE},?,?] ! TaskError:\n  original:Tensor[${TYPE},2,2]=tensor([[1,2],[3,4]])\n  result=attempt(original)\n  recovered=result catch fn(error): return original\n  return try parallel:\n    work=spawn inner(recovered)\n    first=try await work\n    again=try await work\n${SPAWNS}${AWAITS}    (again+(${SUM}))/6\nfn faultProbe() -> Tensor[${TYPE},?,?] ! TaskError:\n  return try parallel:\n    bad=spawn failing(tensor([[1.0,2.0],[3.0,-1.0]]))\n    try await bad\n    original:Tensor[${TYPE},2,2]=tensor([[1,2],[3,4]])\n    original\nfn main() -> ${TYPE} ! TaskError:\n  value=try probe()\n  return reduceSum(value)\n")
  COMPILE("worker-${TYPE}" "${SOURCE}" --test-entry probe)
  COMPILE("fault-${TYPE}" "${SOURCE}" --test-entry faultProbe)
  EXPECT("worker-${TYPE}" 20)
  COMPILE("empty-${TYPE}" "fn convert(value:Tensor[f64,?,?]) -> Tensor[${TYPE},?,?]:\n  return ${TYPE}(value)\nfn probe() -> Tensor[${TYPE},?,?] ! TaskError:\n  empty:Tensor[f64,2,0]=tensor([], [2,0])\n  return try parallel:\n    try await spawn convert(empty)\nfn main() -> ${TYPE} ! TaskError:\n  value=try probe()\n  return reduceSum(value)\n" --test-entry probe)
  EXPECT("empty-${TYPE}" 0)
  foreach(KIND IN ITEMS worker fault empty)
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      -DTENSOR_RANK=2 -DCONVERSION_RESULT=1 ${RESULT_DEFINES}
      "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  foreach(WORKERS IN ITEMS 1 2 4)
    RUN_OK("${OUTPUT_DIR}/worker-${TYPE}-harness" "${WORKERS}" 3 0)
    RUN_OK("${OUTPUT_DIR}/empty-${TYPE}-harness" "${WORKERS}" 4 0)
    RUN_OK("${OUTPUT_DIR}/fault-${TYPE}-harness" "${WORKERS}" 7 0)
    foreach(MODE IN ITEMS 1 2 4)
      RUN_OK("${OUTPUT_DIR}/worker-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    if(TYPE STREQUAL "f64" OR TYPE MATCHES "^(u?int)(8|16)$")
      set(ALLOCATION_ATTEMPTS 24)
      if(TYPE STREQUAL "f64")
        set(ALLOCATION_ATTEMPTS 32)
      endif()
      foreach(ATTEMPT RANGE 1 ${ALLOCATION_ATTEMPTS})
        RUN_OK("${OUTPUT_DIR}/worker-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" "${OUTPUT_DIR}/worker-${TYPE}-harness" "${WORKERS}" 3 3)
      endforeach()
    endif()
  endforeach()
endforeach()
if(DEFINED SOURCE_FILTER AND NOT SOURCE_FILTER STREQUAL "f64")
  message(STATUS "CPU tensor conversions ${SOURCE_FILTER}: lane and worker checks passed")
  return()
endif()
COMPILE(literal-fault "fn main() -> u64:\n  input:Tensor[f64,2]=tensor([1.0,-1.0])\n  value=u64(input)\n  return reduceSum(value)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/literal-fault"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 3:9" OR NOT ERR MATCHES "cleanup: live=0")
  message(FATAL_ERROR "Tensor literal fault/cleanup failed: ${STATUS}: ${OUT}${ERR}")
endif()
message(STATUS "CPU tensor conversions ${SOURCE_FILTER}: shape preservation, strict lane checks, worker captures/results and transactional failure cleanup passed")
COMPILE(aliases "fn main() -> i32:\n  original:Tensor[i64,2]=tensor([1,3])\n  converted=f64(original)\n  narrowed=i32(converted)\n  return reduceSum(narrowed)\n")
EXPECT(aliases 4)

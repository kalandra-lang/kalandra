file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(EXTRA)
set(LINK_FLAGS -O0)
if(VARIANT STREQUAL "optimized")
  list(APPEND EXTRA -O2)
  set(LINK_FLAGS -O2)
elseif(VARIANT STREQUAL "sanitized")
  list(APPEND EXTRA --sanitize)
  set(LINK_FLAGS -O1 -fsanitize=address,undefined -fno-sanitize-recover=all)
endif()
function(RUN_OK)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE STATUS OUTPUT_VARIABLE STDOUT ERROR_VARIABLE STDERR)
  if(NOT "${STATUS}" STREQUAL "0" OR NOT STDERR STREQUAL "")
    message(FATAL_ERROR "Command failed: ${ARGN}: ${STATUS}: ${STDOUT}${STDERR}")
  endif()
  set(OUTPUT "${STDOUT}" PARENT_SCOPE)
endfunction()
set(EXECUTABLE "${OUTPUT_DIR}/projection")
set(IR "${OUTPUT_DIR}/projection.ll")
RUN_OK("${COMPILER}" "${FIXTURE}" -o "${EXECUTABLE}" --emit-llvm "${IR}"
  --emit-mlir "${OUTPUT_DIR}/projection.mlir" --test-entry reference ${EXTRA})
RUN_OK("${CMAKE_COMMAND}" -E env PATH=/usr/bin:/bin "${EXECUTABLE}")
if(NOT OUTPUT STREQUAL "163\n")
  message(FATAL_ERROR "Compiled source did not produce 163: ${OUTPUT}")
endif()
file(READ "${IR}" LLVM_IR)
if(NOT LLVM_IR MATCHES "call [^\n]*@kalandra_fn_" OR
   NOT LLVM_IR MATCHES "noinline" OR NOT LLVM_IR MATCHES "@kalandra_free_v1" OR
   LLVM_IR MATCHES "@kalandra_fault[(]" OR
   LLVM_IR MATCHES "@_mlir_memref_to_llvm_(alloc|free)" OR
   NOT LLVM_IR MATCHES "@kalandra_poll_slow_v1" OR
   LLVM_IR MATCHES "[ \t](fast|reassoc|contract|afn|nnan|ninf|nsz|arcp)[ \t]")
  message(FATAL_ERROR "Source compiler lost function/ownership/numerical contract")
endif()
RUN_OK(/usr/bin/otool -L "${EXECUTABLE}")
if(OUTPUT MATCHES "libLLVM|libMLIR|JavaScriptCore|libnode|libbun")
  message(FATAL_ERROR "Executable unexpectedly depends on compiler/JS runtime")
endif()
set(HARNESS "${OUTPUT_DIR}/harness")
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror ${LINK_FLAGS} -ffp-contract=off -Wno-override-module
  "${HARNESS_SOURCE}" "${IR}" "${RUNTIME}" -o "${HARNESS}")
file(STRINGS "${CASE_DIR}/cases.txt" CASES)
list(LENGTH CASES CASE_COUNT)
if(NOT CASE_COUNT EQUAL 49)
  message(FATAL_ERROR "Missing reference cases")
endif()
foreach(CASE IN LISTS CASES)
  string(REPLACE "|" ";" FIELDS "${CASE}")
  list(GET FIELDS 0 NAME)
  list(GET FIELDS 1 EXPECTED)
  list(GET FIELDS 2 IS_NAN)
  RUN_OK("${HARNESS}" --input "${CASE_DIR}/${NAME}.bin")
  string(JSON BITS GET "${OUTPUT}" bits)
  string(JSON ALLOCATIONS GET "${OUTPUT}" allocations)
  string(JSON RELEASES GET "${OUTPUT}" releases)
  string(JSON LIVE GET "${OUTPUT}" live)
  if(IS_NAN)
    math(EXPR EXPONENT "${BITS} & 0x7f800000")
    math(EXPR PAYLOAD "${BITS} & 0x007fffff")
    if(NOT EXPONENT EQUAL 2139095040 OR PAYLOAD EQUAL 0)
      message(FATAL_ERROR "Expected NaN: ${NAME}: ${OUTPUT}")
    endif()
  elseif(NOT BITS EQUAL EXPECTED)
    message(FATAL_ERROR "Numeric mismatch: ${NAME}: ${OUTPUT}, expected ${EXPECTED}")
  endif()
  if(LIVE OR NOT ALLOCATIONS EQUAL RELEASES)
    message(FATAL_ERROR "Unbalanced ownership: ${OUTPUT}")
  endif()
endforeach()
RUN_OK("${HARNESS}" --repeat 10000)
string(JSON ALLOCATIONS GET "${OUTPUT}" allocations)
string(JSON RELEASES GET "${OUTPUT}" releases)
if(NOT ALLOCATIONS EQUAL RELEASES OR ALLOCATIONS LESS 10000)
  message(FATAL_ERROR "Repeated source-call ownership failed: ${OUTPUT}")
endif()
RUN_OK("${HARNESS}")
string(JSON PER_CALL GET "${OUTPUT}" allocations)
foreach(FAIL_AT RANGE 1 ${PER_CALL})
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}"
    KALANDRA_TEST_REPORT_CLEANUP=1 "${HARNESS}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE STDOUT ERROR_VARIABLE STDERR)
  math(EXPR SUCCEEDED "${FAIL_AT} - 1")
  if(NOT "${STATUS}" STREQUAL "86" OR NOT STDOUT STREQUAL "" OR
     NOT STDERR MATCHES "AllocationFault" OR
     NOT STDERR MATCHES "cleanup: live=0 allocations=${SUCCEEDED} releases=${SUCCEEDED}")
    message(FATAL_ERROR "Fault cleanup failed at allocation ${FAIL_AT}: ${STATUS}: ${STDOUT}${STDERR}")
  endif()
endforeach()
RUN_OK("${CLANGXX}" -O2 -ffp-contract=off -S -Wno-override-module "${IR}" -o "${OUTPUT_DIR}/projection.s")
file(READ "${OUTPUT_DIR}/projection.s" ASSEMBLY)
if(ASSEMBLY MATCHES "[ \t](fmadd|fmsub|fnmadd|fnmsub|fmla|fmls)[ \t]")
  message(FATAL_ERROR "Fused arithmetic appeared in strict source compilation")
endif()
message(STATUS "Compiled Kalandra source: 163, 49 numeric cases, 10000 calls, all allocation-failure positions pass")

get_filename_component(TEST_FIXTURES "${HARNESS_SOURCE}" DIRECTORY)
set(TEST_FIXTURES "${TEST_FIXTURES}/fixtures")
set(DYNAMIC_IR "${OUTPUT_DIR}/dynamic.ll")
set(DYNAMIC_HARNESS "${OUTPUT_DIR}/dynamic-harness")
RUN_OK("${COMPILER}" "${TEST_FIXTURES}/dynamic-projection.k" -o "${OUTPUT_DIR}/dynamic"
  --emit-llvm "${DYNAMIC_IR}" --test-entry reference ${EXTRA})
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror ${LINK_FLAGS} -ffp-contract=off -Wno-override-module
  "${HARNESS_SOURCE}" "${DYNAMIC_IR}" "${RUNTIME}" -o "${DYNAMIC_HARNESS}")
file(READ "${DYNAMIC_IR}" DYNAMIC_LLVM)
if(NOT DYNAMIC_LLVM MATCHES "fmul <4 x float>" OR
   NOT DYNAMIC_LLVM MATCHES "fadd <4 x float>" OR
   NOT DYNAMIC_LLVM MATCHES "fmul <2 x float>" OR
   NOT DYNAMIC_LLVM MATCHES "fadd <2 x float>" OR
   DYNAMIC_LLVM MATCHES "llvm[.]fma" OR
   DYNAMIC_LLVM MATCHES "[ \t](fast|reassoc|contract|afn|nnan|ninf|nsz|arcp)[ \t]")
  message(FATAL_ERROR "Matrix code lost strict two/four-lane SIMD arithmetic")
endif()
if(VARIANT STREQUAL "optimized")
  RUN_OK("${CLANGXX}" -O2 -ffp-contract=off -Wno-override-module -S "${DYNAMIC_IR}"
    -o "${OUTPUT_DIR}/dynamic.s")
  file(READ "${OUTPUT_DIR}/dynamic.s" ASSEMBLY)
  if(NOT ASSEMBLY MATCHES "fmul[.]4s" OR NOT ASSEMBLY MATCHES "fadd[.]4s" OR
     NOT ASSEMBLY MATCHES "fmul[.]2s" OR NOT ASSEMBLY MATCHES "fadd[.]2s" OR
     ASSEMBLY MATCHES "[ \t](fmla|fmls|fmadd|fmsub)")
    message(FATAL_ERROR "ARM64 kernel lost SIMD instructions or contracted arithmetic")
  endif()
endif()
# Inspect every output cell, rather than only a final sum that could hide lane
# permutations. The private tensor-result wrapper leaves output owned by context.
get_filename_component(HARNESS_DIR "${HARNESS_SOURCE}" DIRECTORY)
RUN_OK("${COMPILER}" "${TEST_FIXTURES}/matrix-result.k" -o "${OUTPUT_DIR}/matrix-result"
  --emit-llvm "${OUTPUT_DIR}/matrix-result.ll" --test-entry reference ${EXTRA})
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror ${LINK_FLAGS} -ffp-contract=off -Wno-override-module
  "${HARNESS_DIR}/MatrixHarness.cpp" "${OUTPUT_DIR}/matrix-result.ll" "${RUNTIME}"
  -o "${OUTPUT_DIR}/matrix-cells")
RUN_OK("${OUTPUT_DIR}/matrix-cells")
if(NOT OUTPUT MATCHES "Verified 3681 per-cell matrix cases")
  message(FATAL_ERROR "Matrix cell conformance missing: ${OUTPUT}")
endif()
if(VARIANT STREQUAL "optimized")
  RUN_OK("${CLANGXX}" -std=c++23 -O2 -Dkalandra_alloc_v1=kalandra_probe_alloc_v1
    -c "${HARNESS_DIR}/../runtime/Runtime.cpp" -o "${OUTPUT_DIR}/probe-runtime.o")
  RUN_OK("${CLANGXX}" -std=c++23 -O2 -Wall -Wextra -Werror -ffp-contract=off -Wno-override-module
    "${HARNESS_DIR}/MatrixAllocationProbe.cpp" "${OUTPUT_DIR}/matrix-result.ll"
    "${OUTPUT_DIR}/probe-runtime.o" -o "${OUTPUT_DIR}/matrix-allocation-probe")
  RUN_OK("${OUTPUT_DIR}/matrix-allocation-probe")
  if(NOT OUTPUT MATCHES "Verified 506 actual matrix allocation payloads")
    message(FATAL_ERROR "Matrix scratch payload conformance missing: ${OUTPUT}")
  endif()
endif()
RUN_OK("${COMPILER}" "${TEST_FIXTURES}/matrix-result.k" -o "${OUTPUT_DIR}/matrix-shared"
  --emit-llvm "${OUTPUT_DIR}/matrix-shared.ll" --test-entry shared ${EXTRA})
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror ${LINK_FLAGS} -ffp-contract=off -Wno-override-module
  -DKALANDRA_MATRIX_SHARED "${HARNESS_DIR}/MatrixHarness.cpp" "${OUTPUT_DIR}/matrix-shared.ll"
  "${RUNTIME}" -o "${OUTPUT_DIR}/matrix-shared-cells")
RUN_OK("${OUTPUT_DIR}/matrix-shared-cells")
if(NOT OUTPUT MATCHES "Verified 46 shared-input matrix cases")
  message(FATAL_ERROR "Source-level shared matrix conformance missing: ${OUTPUT}")
endif()
RUN_OK("${DYNAMIC_HARNESS}" --sweep)
if(NOT OUTPUT MATCHES "Verified 1617 runtime-shape/content cases; live=0")
  message(FATAL_ERROR "Runtime conformance corpus failed: ${OUTPUT}")
endif()
# Per-cell reduction scratch used to allocate rows*columns times. Require a
# bounded number even across repeated odd-sized contractions, without tying
# this gate to an exact count that would prevent further allocation removal.
RUN_OK("${DYNAMIC_HARNESS}" --rows 17 --inner 33 --columns 17 --verify --repeat 2)
string(JSON SCRATCH_ALLOCATIONS GET "${OUTPUT}" allocations)
string(JSON SCRATCH_RELEASES GET "${OUTPUT}" releases)
if(SCRATCH_ALLOCATIONS GREATER 6 OR NOT SCRATCH_ALLOCATIONS EQUAL SCRATCH_RELEASES)
  message(FATAL_ERROR "Matrix reduction scratch is not reused/settled: ${OUTPUT}")
endif()
foreach(CASE IN ITEMS "3|5|4|1168932864" "1|1|1|1065353216" "1|7|3|1150484480"
  "2|0|2|0" "0|3|2|0" "2|3|0|0" "0|9223372036854775807|0|0"
  "9223372036854775807|0|0|0")
  string(REPLACE "|" ";" FIELDS "${CASE}")
  list(GET FIELDS 0 ROWS)
  list(GET FIELDS 1 INNER)
  list(GET FIELDS 2 COLUMNS)
  list(GET FIELDS 3 EXPECTED)
  RUN_OK("${DYNAMIC_HARNESS}" --rows "${ROWS}" --inner "${INNER}" --columns "${COLUMNS}")
  string(JSON ACTUAL GET "${OUTPUT}" bits)
  string(JSON LIVE GET "${OUTPUT}" live)
  if(NOT ACTUAL EQUAL EXPECTED OR NOT LIVE EQUAL 0)
    message(FATAL_ERROR "Dynamic/empty contraction failed: ${CASE}: ${OUTPUT}")
  endif()
endforeach()
function(EXPECT_FAULT BINARY EXPECTED_EXIT EXPECTED_NAME)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 ${FAULT_ENV} "${BINARY}" ${ARGN}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE STDOUT ERROR_VARIABLE STDERR)
  if(NOT "${STATUS}" STREQUAL "${EXPECTED_EXIT}" OR NOT STDOUT STREQUAL "" OR
     NOT STDERR MATCHES "${EXPECTED_NAME}" OR NOT STDERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Runtime guard/cleanup failed: ${STATUS}: ${STDOUT}${STDERR}")
  endif()
  set(FAULT_DIAGNOSTICS "${STDERR}" PARENT_SCOPE)
endfunction()
EXPECT_FAULT("${DYNAMIC_HARNESS}" 87 ShapeFault --right-rows 4)
EXPECT_FAULT("${DYNAMIC_HARNESS}" 87 ShapeFault --negative)
EXPECT_FAULT("${DYNAMIC_HARNESS}" 86 AllocationFault --oversize)
EXPECT_FAULT("${HARNESS}" 87 ShapeFault --inner 4)
RUN_OK("${COMPILER}" "${TEST_FIXTURES}/identity.k" -o "${OUTPUT_DIR}/identity" ${EXTRA})
RUN_OK("${OUTPUT_DIR}/identity")
if(NOT OUTPUT STREQUAL "20\n")
  message(FATAL_ERROR "Returned input alias lifetime failed: ${OUTPUT}")
endif()
RUN_OK("${COMPILER}" "${TEST_FIXTURES}/refine-after-allocation.k"
  -o "${OUTPUT_DIR}/refine" --emit-llvm "${OUTPUT_DIR}/refine.ll" --test-entry reference ${EXTRA})
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror ${LINK_FLAGS} -ffp-contract=off -Wno-override-module
  "${HARNESS_SOURCE}" "${OUTPUT_DIR}/refine.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/refine-harness")
EXPECT_FAULT("${OUTPUT_DIR}/refine-harness" 87 ShapeFault --rows 3)
RUN_OK("${OUTPUT_DIR}/refine-harness" --isolation --rows 3)
if(NOT OUTPUT MATCHES "Isolated fault settled; parent inputs preserved; next invocation returned 163")
  message(FATAL_ERROR "Source invocation fault isolation failed: ${OUTPUT}")
endif()
RUN_OK("${OUTPUT_DIR}/refine-harness")
string(JSON REFINE_ALLOCATIONS GET "${OUTPUT}" allocations)
foreach(FAIL_AT RANGE 1 ${REFINE_ALLOCATIONS})
  RUN_OK("${OUTPUT_DIR}/refine-harness" --isolation --isolation-fail "${FAIL_AT}")
endforeach()
# The guard above must have run after projection allocated real storage.
if(NOT FAULT_DIAGNOSTICS MATCHES "allocations=[1-9][0-9]*")
  message(FATAL_ERROR "Shape fault did not exercise live tensor cleanup")
endif()
# Repeated immutable arguments, aliases, nested tensor returns, and retained results.
RUN_OK("${COMPILER}" "${TEST_FIXTURES}/shared-tensors.k"
  -o "${OUTPUT_DIR}/shared" --emit-llvm "${OUTPUT_DIR}/shared.ll" --test-entry reference ${EXTRA})
RUN_OK("${OUTPUT_DIR}/shared")
if(NOT OUTPUT STREQUAL "118\n")
  message(FATAL_ERROR "Shared/nested tensor lifetime failed: ${OUTPUT}")
endif()
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror ${LINK_FLAGS} -ffp-contract=off -Wno-override-module
  "${HARNESS_SOURCE}" "${OUTPUT_DIR}/shared.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/shared-harness")
RUN_OK("${OUTPUT_DIR}/shared-harness" --inner 2 --repeat 1000)
string(JSON SHARED_BITS GET "${OUTPUT}" bits)
string(JSON ALLOCATIONS GET "${OUTPUT}" allocations)
if(NOT SHARED_BITS EQUAL 1122762752)
  message(FATAL_ERROR "Shared tensor result failed: ${OUTPUT}")
endif()
math(EXPR SHARED_PER_CALL "${ALLOCATIONS} / 1000")
foreach(FAIL_AT RANGE 1 ${SHARED_PER_CALL})
  set(FAULT_ENV "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}")
  EXPECT_FAULT("${OUTPUT_DIR}/shared-harness" 86 AllocationFault --inner 2)
  math(EXPR SUCCEEDED "${FAIL_AT} - 1")
  if(NOT FAULT_DIAGNOSTICS MATCHES "allocations=${SUCCEEDED} releases=${SUCCEEDED}")
    message(FATAL_ERROR "Shared tensor cleanup skipped a live allocation: ${FAULT_DIAGNOSTICS}")
  endif()
endforeach()
unset(FAULT_ENV)
RUN_OK("${COMPILER}" "${TEST_FIXTURES}/evaluation-order.k"
  -o "${OUTPUT_DIR}/order" --emit-llvm "${OUTPUT_DIR}/order.ll" --test-entry reference ${EXTRA})
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror ${LINK_FLAGS} -ffp-contract=off -Wno-override-module
  "${HARNESS_SOURCE}" "${OUTPUT_DIR}/order.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/order-harness")
EXPECT_FAULT("${OUTPUT_DIR}/order-harness" 87 ShapeFault --rows 3)
if(NOT FAULT_DIAGNOSTICS MATCHES "ShapeFault at source 2:")
  message(FATAL_ERROR "Call arguments did not fault left-to-right: ${FAULT_DIAGNOSTICS}")
endif()
file(WRITE "${OUTPUT_DIR}/scalar.k" "fn main() -> float32:\n  2 + 3 * 4\n")
RUN_OK("${COMPILER}" "${OUTPUT_DIR}/scalar.k" -o "${OUTPUT_DIR}/scalar" ${EXTRA})
RUN_OK("${OUTPUT_DIR}/scalar")
if(NOT OUTPUT STREQUAL "14\n")
  message(FATAL_ERROR "Scalar arithmetic lowering failed")
endif()
file(WRITE "${OUTPUT_DIR}/rankzero.k" "fn main() -> float32:\n  x: Tensor[float32] = tensor(2)\n  reduceSum(x)\n")
RUN_OK("${COMPILER}" "${OUTPUT_DIR}/rankzero.k" -o "${OUTPUT_DIR}/rankzero" ${EXTRA})
RUN_OK("${OUTPUT_DIR}/rankzero")
if(NOT OUTPUT STREQUAL "2\n")
  message(FATAL_ERROR "Rank-zero lowering failed")
endif()
file(WRITE "${OUTPUT_DIR}/invalid.k" "fn main() -> float32:\n  missing\n")
file(WRITE "${OUTPUT_DIR}/preserved-output" "keep existing artifact\n")
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid.k" -o "${OUTPUT_DIR}/preserved-output"
  RESULT_VARIABLE STATUS ERROR_VARIABLE STDERR)
file(READ "${OUTPUT_DIR}/preserved-output" PRESERVED)
if(NOT "${STATUS}" STREQUAL "1" OR NOT STDERR MATCHES "S016" OR NOT PRESERVED STREQUAL "keep existing artifact\n")
  message(FATAL_ERROR "Invalid source did not preserve the old artifact")
endif()
execute_process(COMMAND "${COMPILER}" "${FIXTURE}" -o "${FIXTURE}" RESULT_VARIABLE STATUS ERROR_VARIABLE STDERR)
if(NOT "${STATUS}" STREQUAL "2" OR NOT STDERR MATCHES "must be distinct")
  message(FATAL_ERROR "Compiler allowed output to overwrite its source")
endif()
message(STATUS "Dynamic extents, empty tensors, descriptor/shape/size faults, returned aliases, scalar/rank-zero code, and artifact preservation pass")

foreach(CASE IN ITEMS
  "rankone|Tensor[float32, 3]|tensor([1, 2, 3])|6"
  "rankthree|Tensor[float32, 2, 1, 2]|tensor([[[1, 2]], [[3, 4]]])|10"
  "emptyrankthree|Tensor[float32, 2, 0]|tensor([[], []])|0"
  "negativezero|Tensor[float32, 1]|tensor([-0])|-0")
  string(REPLACE "|" ";" FIELDS "${CASE}")
  list(GET FIELDS 0 NAME)
  list(GET FIELDS 1 TYPE)
  list(GET FIELDS 2 VALUE)
  list(GET FIELDS 3 EXPECTED)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k"
    "fn main() -> float32:\n  x: ${TYPE} = ${VALUE}\n  reduceSum(x)\n")
  RUN_OK("${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" ${EXTRA})
  RUN_OK("${OUTPUT_DIR}/${NAME}")
  if(NOT OUTPUT STREQUAL "${EXPECTED}\n")
    message(FATAL_ERROR "${NAME} conformance failed: ${OUTPUT}")
  endif()
endforeach()
message(STATUS "1617 runtime cases, 3727 per-cell matrix cases, nested/shared tensors, call order, ranked reductions and failure cleanup pass")

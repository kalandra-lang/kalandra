file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(RUN_OK)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "Scoped package command failed: ${ARGV}: ${STATUS}: ${OUT}${ERR}")
  endif()
endfunction()
set(FLAGS -O0 -g)
if(VARIANT STREQUAL "optimized")
  set(FLAGS -O2)
elseif(VARIANT STREQUAL "sanitized")
  set(FLAGS -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
elseif(VARIANT STREQUAL "thread-sanitized")
  set(FLAGS -O1 -g -fsanitize=thread -fno-omit-frame-pointer)
endif()
set(IR scoped.ll)
if(VARIANT STREQUAL "sanitized" OR VARIANT STREQUAL "thread-sanitized")
  set(IR "scoped-${VARIANT}.ll")
endif()
RUN_OK("${CLANGXX}" -Wno-override-module ${FLAGS} "${FIXTURE_DIR}/${IR}" "${ENTRY}" "${RUNTIME}" -o "${OUTPUT_DIR}/scoped")
foreach(WORKERS IN ITEMS 1 4)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/scoped"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  string(STRIP "${OUT}" OUT)
  if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "[12, 11]")
    message(FATAL_ERROR "Scoped version/worker result failed: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
message(STATUS "Two Git snapshots and a transitive worker produced [12, 11]")

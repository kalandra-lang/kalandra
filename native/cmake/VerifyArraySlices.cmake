include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDENTITIES 2 6 3 7 8 9)
set(BOUNDS int32 uint32 int64 uint64)
set(BOUND_IDS 2 6 3 7)
foreach(N RANGE 0 5)
  list(GET TYPES ${N} TYPE)
  list(GET IDENTITIES ${N} ID)
  foreach(B RANGE 0 3)
    list(GET BOUNDS ${B} BOUND)
    list(GET BOUND_IDS ${B} BOUND_ID)
    set(NAME "raw-${TYPE}-${BOUND}")
    COMPILE("${NAME}" "fn part(values:[${TYPE}],start:${BOUND},end:${BOUND})->[${TYPE}]:\n  slice(values,start,end)\nfn main()->int:\n  0\n" --test-entry part)
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "-DNUMERIC_TYPE=${ID}" "-DBOUND_TYPE=${BOUND_ID}"
      "${SOURCE_DIR}/tests/ArraySliceRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${NAME}-harness")
    RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
  endforeach()
  COMPILE("worker-${TYPE}" "fn part(values:[${TYPE}],start:int,end:int)->[${TYPE}]:\n  slice(values,start,end)\nfn nested(values:[${TYPE}])->[${TYPE}] ! TaskError:\n  try parallel:\n    work=spawn part(values,1,3)\n    first=try await work\n    again=try await work\n    again\nfn main()->[${TYPE}] ! TaskError:\n  original:[${TYPE}]=[1,2,3,4]\n  result=try nested(original)\n  [original[0],result[0],result[1],original[3]]\n")
  EXPECT("worker-${TYPE}" "[1, 2, 3, 4]")
endforeach()
COMPILE(direct "fn main()->[int] ! TaskError:\n  try parallel:\n    try await spawn slice([1,2,3,4],1,3)\n")
EXPECT(direct "[2, 3]")
COMPILE(pipeline "fn main()->[int]:\n  [1,2,3,4]->slice(1,3)->map(fn(x):x*2)\n")
EXPECT(pipeline "[4, 6]")
COMPILE(bool "fn part(values:[Bool],a:uint32,b:int32)->[Bool]:\n  slice(values,a,b)\nfn main()->[Bool] ! TaskError:\n  try parallel:\n    try await spawn part([false,true,false],1,3)\n")
EXPECT(bool "[true, false]")
COMPILE(strings "fn part(values:[String],a:int,b:int)->[String]:\n  slice(values,a,b)\nfn nested()->[String] ! TaskError:\n  try parallel:\n    work=spawn part([\"unused\",\"é\",\"a\\0👩\"],1,3)\n    first=try await work\n    again=try await work\n    again\nfn main()->[String] ! TaskError:\n  values=try nested()\n  map(values,fn(text):text+\"!\")\n")
EXPECT(strings "[\"é!\", \"a\\u0000👩!\"]")
set(RECORD "type Row:\n  texts:[String]\n  flags:[Bool]\n  numbers:[int]\n  matrix:Tensor[float32,1,2]\nfn part(values:[Row],a:int,b:int)->[Row]:\n  slice(values,a,b)\n")
COMPILE(records "${RECORD}fn child(values:[Row])->[Row] ! TaskError:\n  try parallel:\n    work=spawn part(values,1,3)\n    a=try await work\n    b=try await work\n    b\nfn main()->[String] ! TaskError:\n  shared=[\"é\",\"👩\"]\n  row=Row {texts:shared,flags:[true,false],numbers:[20,22],matrix:tensor([[1,2]])}\n  rows=try child([row,row,row])\n  map(rows,fn(r):r.texts[1]+r.texts[0])\n")
EXPECT(records "[\"👩é\", \"👩é\"]")
COMPILE(empty "fn main()->[String] ! TaskError:\n  try parallel:\n    try await spawn slice([\"a\"],1,1)\n")
EXPECT(empty "[]")
COMPILE(empty-context "fn main()->[float32]:\n  slice([],0,0)\n")
EXPECT(empty-context "[]")
COMPILE(capture "fn main()->[int] ! TaskError:\n  values=[1,2,3,4]\n  try parallel:\n    try await spawn map([0,1],fn(i):slice(values,i,i+2)[1])\n")
EXPECT(capture "[2, 3]")
COMPILE(branch "fn part(flag:Bool,a:int,b:int)->[int]:\n  input:[int]=if flag:[1,2,3]\n  else:[]\n  slice(input,a,b)\nfn main()->[int]:\n  part(true,1,3)\n")
EXPECT(branch "[2, 3]")
set(BAD "fn part(values:[String],a:int,b:uint)->[String]:\n  slice(values,a,b)\nfn bad()->[String] ! TaskError:\n  try parallel:\n    try await spawn part([\"a\"],0,2)\n")
COMPILE(recovery "${BAD}fn main()->[String]:\n  bad() catch fn(error):\n    match error:\n      TaskError.Fault {message}:[message]\n      _:[\"unexpected\"]\n")
EXPECT(recovery "[\"index out of bounds\"]")
COMPILE(rethrow "${BAD}fn relay()->[String] ! TaskError:\n  bad() catch fn(error):fail error\nfn main()->[String]:\n  relay() catch fn(error):[\"recovered\"]\n")
EXPECT(rethrow "[\"recovered\"]")
file(WRITE "${OUTPUT_DIR}/library.k" "export fn middle(values:[String])->[String]:\n  slice(values,1,3)\n")
file(WRITE "${OUTPUT_DIR}/facade.k" "export from \"./library.k\" import middle as part\n")
COMPILE(project "from \"text\" import part\nfn main()->[String] ! TaskError:\n  try parallel:\n    try await spawn part([\"unused\",\"a\",\"b\",\"unused\"])\n" --package "text=${OUTPUT_DIR}/facade.k")
file(WRITE "${OUTPUT_DIR}/kalandra.toml" "format=1\n[project]\nentry='project.k'\n[packages]\ntext='facade.k'\n")
# Recompile through the manifest after supplying the bare library mapping.
RUN_OK("${CHECKER}" --project "${OUTPUT_DIR}/kalandra.toml")
RUN_OK("${COMPILER}" --project "${OUTPUT_DIR}/kalandra.toml" -o "${OUTPUT_DIR}/project" ${EXTRA})
EXPECT(project "[\"a\", \"b\"]")
set(OWNED "type Envelope:\n  data:Data\n  duplicate:[String]\n  numbers:[int64]\ntype Data:\n  names:[String]\n  enabled:Bool\n  label:String\nfn copy(p:Envelope)->Envelope:\n  names=slice(p.data.names,0,length(p.data.names))\n  p with {data:p.data with {names:names},duplicate:names}\nfn child(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    work=spawn copy(p)\n    a=try await work\n    b=try await work\n    b\nfn probe(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    work=spawn child(p)\n    a=try await work\n    b=try await work\n    b\nfn main()->int:\n  0\n")
COMPILE(owned "${OWNED}" --test-entry probe)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/RecordStringArrayFieldsWorkerTests.cpp" "${OUTPUT_DIR}/owned.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/owned-harness")
foreach(WORKERS IN ITEMS 1 4)
  foreach(MODE IN ITEMS 0 1 2 4 5 6 7 8 9)
    RUN_OK("${OUTPUT_DIR}/owned-harness" "${WORKERS}" "${MODE}" 0)
  endforeach()
  foreach(FAIL_AT RANGE 1 20)
    RUN_OK("${OUTPUT_DIR}/owned-harness" "${WORKERS}" 3 "${FAIL_AT}")
  endforeach()
endforeach()
foreach(NAME IN ITEMS worker-int64 strings records capture pipeline)
  RUN_OK("${OUTPUT_DIR}/${NAME}")
  set(EXPECTED "${OUTPUT}")
  foreach(FAIL_AT RANGE 1 20)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}"
      "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(STATUS EQUAL 0)
      if(NOT OUT STREQUAL EXPECTED OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
        message(FATAL_ERROR "Slice result/cleanup mismatch: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Failed slice published output or leaked: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()
COMPILE(order "fn first(n:int)->int:\n  1/n\nfn second(n:int)->int:\n  2/n\nfn part(a:int,b:int)->[int]:\n  slice([1,2],first(a),second(b))\nfn main()->[int]:\n  part(0,0)\n")
execute_process(COMMAND "${OUTPUT_DIR}/order" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault.*2:3")
  message(FATAL_ERROR "Slice bound evaluation order lost: ${STATUS}: ${OUT}${ERR}")
endif()
COMPILE(bounds "fn part(values:[int],a:int,b:uint)->[int]:\n  slice(values,a,b)\nfn main()->[int]:\n  part([1,2],-1,1)\n")
execute_process(COMMAND "${OUTPUT_DIR}/bounds" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "BoundsFault.*2:3")
  message(FATAL_ERROR "Slice bounds location/partial output changed: ${STATUS}: ${OUT}${ERR}")
endif()
message(STATUS "Array slices: six numeric types/four bound types, Bool/String/records, explicit project, retained workers, allocation failures and checked ranges passed")

file(READ "${SOURCE_DIR}/../docs/design/array-slicing.md" GUIDE)
string(REGEX MATCHALL "```kalandra\n[^`]*```" EXAMPLES "${GUIDE}")
list(LENGTH EXAMPLES EXAMPLE_COUNT)
if(NOT EXAMPLE_COUNT EQUAL 2)
  message(FATAL_ERROR "Array slicing documentation examples changed")
endif()
set(I 0)
foreach(EXAMPLE IN LISTS EXAMPLES)
  string(REGEX REPLACE "^```kalandra\n|```$" "" SOURCE "${EXAMPLE}")
  COMPILE("documented-${I}" "${SOURCE}")
  if(I EQUAL 0)
    EXPECT("documented-${I}" "[10, 20, 30, 40]")
  else()
    EXPECT("documented-${I}" "[2, 3]")
  endif()
  math(EXPR I "${I}+1")
endforeach()

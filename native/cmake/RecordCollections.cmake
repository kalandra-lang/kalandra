if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(RC_RUNTIME kalandra-native-runtime-sanitized)
      set(RC_FLAGS -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(RC_RUNTIME kalandra-native-runtime-thread-sanitized)
      set(RC_FLAGS -O1 -g -fsanitize=thread -fno-omit-frame-pointer)
    else()
      set(RC_RUNTIME kalandra-native-runtime)
      set(RC_FLAGS -O0)
      if(VARIANT STREQUAL "optimized")
        set(RC_FLAGS -O2)
      endif()
    endif()
    add_executable(kalandra-record-collection-storage-${VARIANT} tests/RecordCollectionRuntimeTests.cpp)
    target_compile_options(kalandra-record-collection-storage-${VARIANT} PRIVATE -Wall -Wextra -Werror ${RC_FLAGS})
    target_link_options(kalandra-record-collection-storage-${VARIANT} PRIVATE ${RC_FLAGS})
    target_link_libraries(kalandra-record-collection-storage-${VARIANT} PRIVATE ${RC_RUNTIME})
    add_test(NAME native-record-collection-storage-${VARIANT} COMMAND kalandra-record-collection-storage-${VARIANT})
    add_test(NAME native-record-collections-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DVARIANT=${VARIANT}"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=$<TARGET_FILE:${RC_RUNTIME}>"
        "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}"
        "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/record-collections-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyRecordCollections.cmake")
    set_tests_properties(native-record-collections-${VARIANT} PROPERTIES TIMEOUT 900)
  endforeach()
endif()
if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-record-collection-tests-${VARIANT} tests/RecordCollectionTests.cpp)
    target_compile_options(kalandra-record-collection-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-record-collection-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_options(kalandra-record-collection-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-record-collection-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-record-collection-tests-${VARIANT} PRIVATE kalandra-semantics)
    endif()
    add_test(NAME native-record-collections-frontend-${VARIANT} COMMAND kalandra-record-collection-tests-${VARIANT})
  endforeach()
endif()

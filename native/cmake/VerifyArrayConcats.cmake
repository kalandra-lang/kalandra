include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDENTITIES 2 6 3 7 8 9)
foreach(N RANGE 0 5)
  list(GET TYPES ${N} TYPE)
  list(GET IDENTITIES ${N} ID)
  COMPILE("raw-${TYPE}" "fn join(a:[${TYPE}],b:[${TYPE}])->[${TYPE}]:\n  concat(a,b)\nfn main()->int:\n  0\n" --test-entry join)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DNUMERIC_TYPE=${ID}" "${SOURCE_DIR}/tests/ArrayConcatRuntimeTests.cpp"
    "${OUTPUT_DIR}/raw-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/raw-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/raw-${TYPE}-harness")
  COMPILE("worker-${TYPE}" "fn join(a:[${TYPE}],b:[${TYPE}])->[${TYPE}]:\n  concat(a,b)\nfn nested(a:[${TYPE}],b:[${TYPE}])->[${TYPE}] ! TaskError:\n  try parallel:\n    work=spawn join(a,b)\n    first=try await work\n    again=try await work\n    again\nfn main()->[${TYPE}] ! TaskError:\n  a:[${TYPE}]=[1,2]\n  b:[${TYPE}]=[3,4]\n  joined=try nested(a,b)\n  [a[0],joined[1],joined[2],b[1]]\n")
  EXPECT("worker-${TYPE}" "[1, 2, 3, 4]")
endforeach()
COMPILE(direct "fn main()->[int] ! TaskError:\n  try parallel:\n    try await spawn concat([1,2],[3,4])\n")
EXPECT(direct "[1, 2, 3, 4]")
COMPILE(pipeline "fn main()->[int]:\n  [1,2]->concat([3,4])->slice(1,3)->map(fn(x):x*2)\n")
EXPECT(pipeline "[4, 6]")
COMPILE(bool "fn main()->[Bool] ! TaskError:\n  try parallel:\n    try await spawn concat([false,true],[false])\n")
EXPECT(bool "[false, true, false]")
COMPILE(strings "fn join(a:[String],b:[String])->[String]:\n  concat(a,b)\nfn main()->[String] ! TaskError:\n  joined=try parallel:\n    work=spawn join([\"é\"],[\"a\\0👩\"])\n    first=try await work\n    again=try await work\n    again\n  map(joined,fn(text):text+\"!\")\n")
EXPECT(strings "[\"é!\", \"a\\u0000👩!\"]")
COMPILE(empties "fn main()->[String] ! TaskError:\n  try parallel:\n    first=spawn concat([],[\"é\"])\n    a=try await first\n    second=spawn concat(a,[])\n    try await second\n")
EXPECT(empties "[\"é\"]")
COMPILE(empty-context "fn main()->[float32]:\n  concat([],[])\n")
EXPECT(empty-context "[]")
COMPILE(alias "fn main()->[int]:\n  values=[1,2]\n  concat(values,values)\n")
EXPECT(alias "[1, 2, 1, 2]")
COMPILE(capture "fn main()->[int] ! TaskError:\n  a=[1,2]\n  b=[3,4]\n  try parallel:\n    try await spawn map([0,1,2,3],fn(i):concat(a,b)[i])\n")
EXPECT(capture "[1, 2, 3, 4]")
COMPILE(records "type Row:\n  texts:[String]\n  flags:[Bool]\n  numbers:[int]\n  matrix:Tensor[float32,1,2]\nfn join(a:[Row],b:[Row])->[Row]:\n  concat(a,b)\nfn main()->[String] ! TaskError:\n  row=Row {texts:[\"é\"],flags:[true],numbers:[1,2],matrix:tensor([[3,4]])}\n  other=row with {texts:[\"👩\"]}\n  rows=try parallel:\n    work=spawn join([row],[other])\n    a=try await work\n    b=try await work\n    b\n  map(rows,fn(r):r.texts[0])\n")
EXPECT(records "[\"é\", \"👩\"]")
set(BAD "fn bad(a:[String],end:int)->[String]:\n  concat(a,slice(a,0,end))\nfn attempt()->[String] ! TaskError:\n  try parallel:\n    try await spawn bad([\"a\"],2)\n")
COMPILE(recovery "${BAD}fn main()->[String]:\n  attempt() catch fn(error):\n    match error:\n      TaskError.Fault {message}:[message]\n      _:[\"unexpected\"]\n")
EXPECT(recovery "[\"index out of bounds\"]")
COMPILE(rethrow "${BAD}fn relay()->[String] ! TaskError:\n  attempt() catch fn(error):fail error\nfn main()->[String]:\n  relay() catch fn(error):[\"recovered\"]\n")
EXPECT(rethrow "[\"recovered\"]")
file(WRITE "${OUTPUT_DIR}/library.k" "export fn join(a:[String],b:[String])->[String]:\n  concat(a,b)\n")
file(WRITE "${OUTPUT_DIR}/facade.k" "export from \"./library.k\" import join\n")
COMPILE(project "from \"text\" import join\nfn main()->[String] ! TaskError:\n  try parallel:\n    try await spawn join([\"a\"],[\"b\"])\n" --package "text=${OUTPUT_DIR}/facade.k")
file(WRITE "${OUTPUT_DIR}/kalandra.toml" "format=1\n[project]\nentry='project.k'\n[packages]\ntext='facade.k'\n")
RUN_OK("${CHECKER}" --project "${OUTPUT_DIR}/kalandra.toml")
RUN_OK("${COMPILER}" --project "${OUTPUT_DIR}/kalandra.toml" -o "${OUTPUT_DIR}/project" ${EXTRA})
EXPECT(project "[\"a\", \"b\"]")
set(OWNED "type Envelope:\n  data:Data\n  duplicate:[String]\n  numbers:[int64]\ntype Data:\n  names:[String]\n  enabled:Bool\n  label:String\nfn copy(p:Envelope)->Envelope:\n  names=concat(slice(p.data.names,0,length(p.data.names)/2),slice(p.data.names,length(p.data.names)/2,length(p.data.names)))\n  p with {data:p.data with {names:names},duplicate:names}\nfn child(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    work=spawn copy(p)\n    a=try await work\n    b=try await work\n    b\nfn probe(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    work=spawn child(p)\n    a=try await work\n    b=try await work\n    b\nfn main()->int:\n  0\n")
COMPILE(owned "${OWNED}" --test-entry probe)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/RecordStringArrayFieldsWorkerTests.cpp" "${OUTPUT_DIR}/owned.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/owned-harness")
foreach(WORKERS IN ITEMS 1 4)
  foreach(MODE IN ITEMS 0 1 2 4 5 6 7 8 9)
    RUN_OK("${OUTPUT_DIR}/owned-harness" "${WORKERS}" "${MODE}" 0)
  endforeach()
  foreach(FAIL_AT RANGE 1 20)
    RUN_OK("${OUTPUT_DIR}/owned-harness" "${WORKERS}" 3 "${FAIL_AT}")
  endforeach()
endforeach()
foreach(NAME IN ITEMS worker-int64 strings records capture pipeline)
  RUN_OK("${OUTPUT_DIR}/${NAME}")
  set(EXPECTED "${OUTPUT}")
  foreach(FAIL_AT RANGE 1 20)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}"
      "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(STATUS EQUAL 0)
      if(NOT OUT STREQUAL EXPECTED OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
        message(FATAL_ERROR "Concat result/cleanup mismatch: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Failed concat published output or leaked: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()

COMPILE(order "fn left(n:int)->[int]:\n  [1/n]\nfn right(n:int)->[int]:\n  [2/n]\nfn main()->[int]:\n  concat(left(0),right(0))\n")
execute_process(COMMAND "${OUTPUT_DIR}/order" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault.*2:4")
  message(FATAL_ERROR "Concat operand order changed: ${STATUS}: ${OUT}${ERR}")
endif()
message(STATUS "Array concat: all existing array element types, strict order, retained workers, project composition and failure cleanup passed")

file(READ "${SOURCE_DIR}/../docs/design/array-concatenation.md" GUIDE)
string(REGEX MATCHALL "```kalandra\n[^`]*```" EXAMPLES "${GUIDE}")
list(LENGTH EXAMPLES COUNT)
if(NOT COUNT EQUAL 1)
  message(FATAL_ERROR "Concat documentation example count changed")
endif()
list(GET EXAMPLES 0 EXAMPLE)
string(REGEX REPLACE "^```kalandra\n|```$" "" SOURCE "${EXAMPLE}")
COMPILE(documented "${SOURCE}")
EXPECT(documented "[20, 30]")

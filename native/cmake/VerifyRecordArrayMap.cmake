include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDS 2 6 3 7 8 9)
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDS ${INDEX} ID)
  set(DECL "type Row:\n  data:Data\n  enabled:Bool\ntype Data:\n  amount:${TYPE}\n  values:[${TYPE}]\n  matrix:Tensor[${TYPE},1,2]\ntype Output:\n  amount:${TYPE}\n  values:[${TYPE}]\nfn wrap(x:${TYPE})->Row:\n  Row {data:Data {amount:x,values:[x,x+1],matrix:tensor([[x,x+2]])},enabled:true}\nfn extract(row:Row)->${TYPE}:\n  row.data.amount\nfn change(row:Row)->Output:\n  Output {amount:row.data.amount+10,values:map(row.data.values,fn(x):x+2)}\nfn run(values:[${TYPE}])->[Output]:\n  values -> map(wrap) -> map(change)\n")
  COMPILE("named-${TYPE}" "${DECL}fn main()->[${TYPE}]:\n  rows=run([1,2,3])\n  map(rows,fn(row):row.amount+row.values[1])\n")
  EXPECT("named-${TYPE}" "[15, 17, 19]")
  COMPILE("anonymous-${TYPE}" "${DECL}fn main()->[${TYPE}]:\n  offset:${TYPE}=4\n  original=map([1,2,3],wrap)\n  rows=map(original,fn(row):row with {data:row.data with {amount:row.data.amount+offset}})\n  map(rows,extract)\n")
  EXPECT("anonymous-${TYPE}" "[5, 6, 7]")
  COMPILE("worker-${TYPE}" "${DECL}fn main()->[${TYPE}] ! TaskError:\n  rows=try parallel:\n    work=spawn run([1,2,3])\n    first=try await work\n    again=try await work\n    again\n  try parallel:\n    try await spawn map(rows,fn(row):row.amount+row.values[1])\n")
  EXPECT("worker-${TYPE}" "[15, 17, 19]")
  COMPILE("empty-${TYPE}" "${DECL}fn outOfBounds(row:Row)->Output:\n  Output {amount:row.data.values[9],values:[]}\nfn main()->int ! TaskError:\n  rows=try parallel:\n    try await spawn map([],outOfBounds)\n  length(rows)+length(map([],fn(row:Row)->${TYPE}:row.data.values[9]))+length(map([],wrap))\n")
  EXPECT("empty-${TYPE}" 0)
  COMPILE("identity-${TYPE}" "${DECL}fn main()->[${TYPE}]:\n  rows=map([1,2,3],wrap)\n  untouched=map(rows,fn(row):row)\n  map(untouched,fn(row):row.data.matrix[0,1]+row.data.values[0])\n")
  EXPECT("identity-${TYPE}" "[4, 6, 8]")
  set(RAW "type Reading:\n  amount:${TYPE}\n  enabled:Bool\n  values:[${TYPE}]\n  matrix:Tensor[${TYPE},1,2]\nfn echo(rows:[Reading])->[Reading]:\n  map(rows,fn(row):row with {values:map(row.values,fn(x):x)})\nfn child(rows:[Reading])->[Reading] ! TaskError:\n  try parallel:\n    work=spawn echo(rows)\n    first=try await work\n    again=try await work\n    again\nfn probe(rows:[Reading])->[Reading] ! TaskError:\n  try parallel:\n    work=spawn child(rows)\n    first=try await work\n    again=try await work\n    again\nfn main()->int:\n  0\n")
  COMPILE("raw-${TYPE}" "${RAW}" --test-entry probe)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}" -DKALANDRA_RECORD_ARRAY_LARGE
    "${SOURCE_DIR}/tests/RecordArrayWorkerTests.cpp" "${OUTPUT_DIR}/raw-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/raw-${TYPE}-harness")
  foreach(WORKERS IN ITEMS 1 4)
    foreach(MODE IN ITEMS 0 1 2 4 5 6 7)
      RUN_OK("${OUTPUT_DIR}/raw-${TYPE}-harness" "${WORKERS}" "${MODE}" 0)
    endforeach()
    if(TYPE STREQUAL "int64")
      foreach(FAIL_AT RANGE 1 24)
        RUN_OK("${OUTPUT_DIR}/raw-${TYPE}-harness" "${WORKERS}" 3 "${FAIL_AT}")
      endforeach()
    endif()
  endforeach()
endforeach()
COMPILE(bool-field "type Flag:\n  enabled:Bool\nfn main()->Bool:\n  rows=map([1,2],fn(x):Flag {enabled:x==1})\n  rows[0].enabled and not rows[1].enabled\n")
EXPECT(bool-field true)
set(DECL "type Row:\n  x:int\nfn wrap(x:int)->Row:\n  Row {x:x}\nfn bad(row:Row)->Row:\n  row with {x:10/row.x}\nfn attempt()->[Row] ! TaskError:\n  try parallel:\n    try await spawn map([Row {x:2},Row {x:0},Row {x:1}],bad)\n")
COMPILE(recovery "${DECL}fn main()->[int]:\n  rows=attempt() catch fn(error): [Row {x:7}]\n  map(rows,fn(row):row.x)\n")
EXPECT(recovery "[7]")
COMPILE(fault "${DECL}fn main():\n  rows=map([Row {x:2},Row {x:0}],bad)\n  length(rows)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/fault"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault" OR
   NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
  message(FATAL_ERROR "Record map fault published output or leaked: ${STATUS}: ${OUT}${ERR}")
endif()
file(WRITE "${OUTPUT_DIR}/library.k" "type Row:\n  x:int\nexport fn wrap(x:int)->Row:\n  Row {x:x}\nexport fn extract(row:Row)->int:\n  row.x\n")
COMPILE(modules "from \"./library.k\" import wrap,extract\nfn main()->[int] ! TaskError:\n  rows=try parallel:\n    try await spawn map([1,2,3],wrap)\n  map(rows,extract)\n")
EXPECT(modules "[1, 2, 3]")
foreach(NAME IN ITEMS named-int64 anonymous-int64 worker-int64 identity-int64 recovery)
  foreach(FAIL_AT RANGE 1 32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}" "${OUTPUT_DIR}/${NAME}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(STATUS EQUAL 0)
      if(NAME STREQUAL "anonymous-int64")
        set(EXPECTED "[5, 6, 7]\n")
      elseif(NAME STREQUAL "identity-int64")
        set(EXPECTED "[4, 6, 8]\n")
      elseif(NAME STREQUAL "recovery")
        set(EXPECTED "[7]\n")
      else()
        set(EXPECTED "[15, 17, 19]\n")
      endif()
      if(NOT OUT STREQUAL EXPECTED)
        message(FATAL_ERROR "Allocation sweep changed record map result: ${OUT}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Record map allocation failure published output or leaked: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Record map sanitizer failure: ${ERR}")
    endif()
  endforeach()
endforeach()
set(NESTED "type Row:\n  x:int\n  values:[int]\nfn transform(rows:[Row],offset:int)->[Row]:\n  map(rows,fn(row):row with {values:map(row.values,fn(value):value+row.x+offset)})\n")
COMPILE(nested "${NESTED}fn main()->[int] ! TaskError:\n  rows=try parallel:\n    try await spawn transform([Row {x:2,values:[1,2]},Row {x:3,values:[4,5]}],10)\n  map(rows,fn(row):row.values[0])\n")
EXPECT(nested "[13, 17]")
foreach(NAME IN ITEMS nominal result effect)
  set(PRELUDE "type Row:\n  x:int\ntype Other:\n  x:int\nfn extract(row:Row)->int:\n  row.x\n")
  if(NAME STREQUAL "nominal")
    set(BODY "fn main():\n  map([Other {x:1}],extract)\n")
  elseif(NAME STREQUAL "result")
    set(BODY "fn main():\n  map([Row {x:1}],fn(row):[row.x])\n")
  else()
    set(BODY "fn worker(row:Row)->Row ! TaskError:\n  try parallel:\n    try await spawn identity(row)\nfn identity(row:Row)->Row:\n  row\nfn callback(row:Row)->Row:\n  worker(row) catch fn(error):row\nfn main():\n  map([],callback)\n")
  endif()
  file(WRITE "${OUTPUT_DIR}/reject-${NAME}.k" "${PRELUDE}${BODY}")
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(WRITE "${OUTPUT_DIR}/reject-${NAME}.${SUFFIX}" "preserve-${SUFFIX}")
  endforeach()
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/reject-${NAME}.k" -o "${OUTPUT_DIR}/reject-${NAME}.exe"
    --emit-llvm "${OUTPUT_DIR}/reject-${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/reject-${NAME}.mlir"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "error\\[S[0-9]+\\]")
    message(FATAL_ERROR "Invalid record map not rejected semantically: ${STATUS}: ${OUT}${ERR}")
  endif()
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(READ "${OUTPUT_DIR}/reject-${NAME}.${SUFFIX}" CONTENT)
    if(NOT CONTENT STREQUAL "preserve-${SUFFIX}")
      message(FATAL_ERROR "Rejected map replaced ${SUFFIX}")
    endif()
  endforeach()
endforeach()
message(STATUS "Record maps: named/anonymous numeric-record combinations, nested collections/captures, workers, retained results, raw bits, failures and artifact preservation passed")
file(READ "${SOURCE_DIR}/../docs/design/array-map.md" GUIDE)
string(REGEX MATCH "```kalandra\n(type Reading:[^`]+)```" DOCUMENTATION "${GUIDE}")
if(NOT DOCUMENTATION)
  message(FATAL_ERROR "Record map documentation example missing")
endif()
COMPILE(documentation "${CMAKE_MATCH_1}")
EXPECT(documentation "[11, 12, 13]")

EXPECT(worker-record 44)
COMPILE(eager "fn divide(value:int)->int:\n  10/value\nfn create(value:int)->fn(int)->int:\n  checked=10/value\n  divide\nfn main()->int:\n  length(map([],create(0)))\n")
execute_process(COMMAND "${OUTPUT_DIR}/eager" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "86" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 4:11" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
  message(FATAL_ERROR "Empty map skipped callback creation or lost its checked fault: ${STATUS}: ${OUT}${ERR}")
endif()
COMPILE(callee-order "fn divide(value:int)->int:\n  10/value\nfn create(value:int)->fn(int)->int:\n  checked=10/value\n  divide\nfn main()->int:\n  create(0)(divide(0))\n")
execute_process(COMMAND "${OUTPUT_DIR}/callee-order" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "86" OR NOT ERR MATCHES "ArithmeticFault at source 4:11")
  message(FATAL_ERROR "Indirect call evaluated arguments before its callee: ${STATUS}: ${OUT}${ERR}")
endif()

foreach(NAME IN ITEMS records strings worker worker-record)
  foreach(ATTEMPT RANGE 1 24)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Function-value cleanup failed: ${NAME} ${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(NOT "${STATUS}" STREQUAL "0")
      if(NOT OUT STREQUAL "" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
        message(FATAL_ERROR "Failed indirect invocation leaked owners or published a value: ${OUT}${ERR}")
      endif()
    endif()
  endforeach()
endforeach()
file(WRITE "${OUTPUT_DIR}/rejected.k" "${FUNCTIONS}fn main()->int:\n  f:fn(float)->float=double\n  0\n")
foreach(OUTPUT IN ITEMS rejected rejected.mlir rejected.ll)
  file(WRITE "${OUTPUT_DIR}/${OUTPUT}" "preserved")
endforeach()
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/rejected.k" -o "${OUTPUT_DIR}/rejected" --emit-mlir "${OUTPUT_DIR}/rejected.mlir" --emit-llvm "${OUTPUT_DIR}/rejected.ll" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if("${STATUS}" STREQUAL "0" OR NOT ERR MATCHES "S010")
  message(FATAL_ERROR "Invalid function-value signature was not diagnosed: ${OUT}${ERR}")
endif()
foreach(OUTPUT IN ITEMS rejected rejected.mlir rejected.ll)
  file(READ "${OUTPUT_DIR}/${OUTPUT}" CONTENT)
  if(NOT CONTENT STREQUAL "preserved")
    message(FATAL_ERROR "Rejected function value overwrote ${OUTPUT}")
  endif()
endforeach()

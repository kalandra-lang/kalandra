  COMPILE("identity-${TYPE}" "fn identity(value:${TYPE})->${TYPE}:\n  value\nfn run(values:[${TYPE}])->[${TYPE}]:\n  f=identity\n  map(values,f)\nfn main()->int:\n  0\n" --test-entry run)

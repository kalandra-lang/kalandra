include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDENTITIES 2 6 3 7 8 9)
foreach(SOURCE_INDEX RANGE 0 5)
  list(GET TYPES ${SOURCE_INDEX} SOURCE_TYPE)
  list(GET IDENTITIES ${SOURCE_INDEX} SOURCE_ID)
  foreach(DESTINATION_INDEX RANGE 0 5)
    list(GET TYPES ${DESTINATION_INDEX} DESTINATION_TYPE)
    list(GET IDENTITIES ${DESTINATION_INDEX} DESTINATION_ID)
    if(SMOKE AND NOT "${SOURCE_TYPE}-${DESTINATION_TYPE}" MATCHES "^(int64-float32|float64-uint64|float64-float32|float32-float64)$")
      continue()
    endif()
    set(NAME "${SOURCE_TYPE}-${DESTINATION_TYPE}")
    COMPILE("${NAME}" "fn operation(value:${SOURCE_TYPE}) -> ${DESTINATION_TYPE}:\n  ${DESTINATION_TYPE}(value)\nfn main() -> int64:\n  0\n" --test-entry operation)
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "-DSOURCE_TYPE=${SOURCE_ID}" "-DDESTINATION_TYPE=${DESTINATION_ID}" -isystem "${LLVM_ROOT}/include"
      "${SOURCE_DIR}/tests/ConversionRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}"
      "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
    RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
  endforeach()
endforeach()
if(SMOKE)
  return()
endif()
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDENTITIES ${INDEX} ID)
  set(MIXED_FUNCTIONS "")
  set(MIXED_SPAWNS "")
  set(MIXED_AWAITS "")
  set(MIXED_SUM "0")
  foreach(INPUT_TYPE IN LISTS TYPES)
    string(APPEND MIXED_FUNCTIONS "fn from_${INPUT_TYPE}(value:${INPUT_TYPE}) -> ${TYPE}:\n  ${TYPE}(value)\n")
    string(APPEND MIXED_SPAWNS "    mixed_${INPUT_TYPE}=spawn from_${INPUT_TYPE}(4)\n")
    string(APPEND MIXED_AWAITS "    result_${INPUT_TYPE}=try await mixed_${INPUT_TYPE}\n")
    string(APPEND MIXED_SUM "+result_${INPUT_TYPE}")
  endforeach()
  set(SOURCE "fn failing(value:float64) -> uint64:\n  uint64(value)\n${MIXED_FUNCTIONS}fn convert(value:float64) -> ${TYPE}:\n  ${TYPE}(value)\nfn attempt(values:Tensor[float,?]) -> ${TYPE} ! TaskError:\n  try parallel:\n    bad=spawn failing(-1)\n    sibling=spawn convert(reduceSum(values))\n    try await bad\n    try await sibling\nfn probe() -> ${TYPE} ! TaskError:\n  original:Tensor[float,2]=tensor([2,-0.0])\n  result=attempt(original)\n  recovered=result catch fn(error): ${TYPE}(reduceSum(original))\n  try parallel:\n    work=spawn ${TYPE}(reduceSum(original))\n    first=try await work\n    again=try await work\n${MIXED_SPAWNS}${MIXED_AWAITS}    recovered+(again+(${MIXED_SUM})/12)/2\nfn faultProbe() -> ${TYPE} ! TaskError:\n  try parallel:\n    try await spawn failing(-1)\n    0\nfn main() -> ${TYPE} ! TaskError:\n  try probe()\n")
  COMPILE("worker-${TYPE}" "${SOURCE}" --test-entry probe)
  COMPILE("fault-${TYPE}" "${SOURCE}" --test-entry faultProbe)
  EXPECT("worker-${TYPE}" 4)
  if(TYPE STREQUAL "float32")
    set(EXPECTED 40800000)
  elseif(TYPE STREQUAL "float64")
    set(EXPECTED 4010000000000000)
  else()
    set(EXPECTED 4)
  endif()
  foreach(KIND IN ITEMS worker fault)
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "-DDESTINATION_TYPE=${ID}" "${SOURCE_DIR}/tests/ConversionTaskTests.cpp"
      "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  foreach(WORKERS IN ITEMS 1 2 4)
    RUN_OK("${OUTPUT_DIR}/worker-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" 0 0)
    RUN_OK("${OUTPUT_DIR}/fault-${TYPE}-harness" "${WORKERS}" 0 5 0)
    foreach(MODE IN ITEMS 1 2 4)
      RUN_OK("${OUTPUT_DIR}/worker-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" "${MODE}" 0)
    endforeach()
    if(TYPE STREQUAL "float64")
      foreach(ATTEMPT RANGE 1 24)
        RUN_OK("${OUTPUT_DIR}/worker-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" 3 "${ATTEMPT}")
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" "${OUTPUT_DIR}/worker-${TYPE}-harness" "${WORKERS}" "${EXPECTED}" 3 0)
      endforeach()
    endif()
  endforeach()
endforeach()
COMPILE(aliases "fn main() -> float:\n  count=3\n  float(uint(int(count)))/2.0\n")
EXPECT(aliases 1.5)
COMPILE(sync-fault "fn operation(value:int64) -> uint32:\n  uint32(value)\nfn main() -> uint32:\n  operation(-1)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/sync-fault"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 2:3" OR NOT ERR MATCHES "cleanup: live=0")
  message(FATAL_ERROR "Synchronous conversion fault/cleanup failed: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(NAME IN ITEMS invalid overflow nonfinite)
  if(NAME STREQUAL "invalid")
    set(SOURCE "fn main() -> uint32:\n  value=-1\n  uint32(value)\n")
  elseif(NAME STREQUAL "overflow")
    set(SOURCE "fn main() -> float32:\n  value=3.5e38\n  float32(value)\n")
  else()
    set(SOURCE "fn main() -> int32:\n  value=0.0/0.0\n  int32(value)\n")
  endif()
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES S055 OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Constant conversion/artifact guard failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/int32-float32.k" --target metal -o "${OUTPUT_DIR}/unsupported-metal" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(NOT STATUS EQUAL 1 OR EXISTS "${OUTPUT_DIR}/unsupported-metal")
  message(FATAL_ERROR "GPU conversion gate failed: ${STATUS}: ${ERR}")
endif()
message(STATUS "36 explicit scalar conversion pairs: exact rounding/ranges, known-invalid diagnostics, worker Arithmetic faults/recovery, typed cached results and failure settlement passed")

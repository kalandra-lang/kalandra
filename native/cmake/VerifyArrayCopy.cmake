include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES i8 i16 i32 i64 u8 u16 u32 u64 f32 f64)
foreach(ID RANGE 0 9)
  list(GET TYPES ${ID} TYPE)
  COMPILE("copy-${TYPE}" "fn copied(input:[${TYPE}])->[${TYPE}]:\n  return copy(input)\nfn main()->i64:\n  return 0\n" --test-entry copied)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}"
    "${SOURCE_DIR}/tests/ArrayCopyRuntimeTests.cpp" "${OUTPUT_DIR}/copy-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/copy-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/copy-${TYPE}-harness")
endforeach()
COMPILE(empty "fn main()->[i64]:\n  return copy([])\n")
EXPECT(empty "[]")
COMPILE(owned "fn main()->i64 ! TaskError:\n  flags=[true,false,true]\n  names=[\"a\",\"é\"]\n  return try parallel:\n    left=spawn copy(flags)\n    right=spawn copy(names)\n    a=try await left\n    b=try await right\n    if a[2]: length(b[1])\n    else: 0\n")
EXPECT(owned 1)
COMPILE(shadow "fn copy(n:i64)->i64:\n  return n+1\nfn main()->i64:\n  return copy(41)\n")
EXPECT(shadow 42)

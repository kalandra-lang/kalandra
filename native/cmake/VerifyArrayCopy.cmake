include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int8 int16 int32 int64 uint8 uint16 uint32 uint64 float32 float64)
foreach(ID RANGE 0 9)
  list(GET TYPES ${ID} TYPE)
  COMPILE("copy-${TYPE}" "fn copied(input:[${TYPE}])->[${TYPE}]:\n  copy(input)\nfn main()->int:\n  0\n" --test-entry copied)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}"
    "${SOURCE_DIR}/tests/ArrayCopyRuntimeTests.cpp" "${OUTPUT_DIR}/copy-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/copy-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/copy-${TYPE}-harness")
endforeach()
COMPILE(empty "fn main()->[int]:\n  copy([])\n")
EXPECT(empty "[]")
COMPILE(owned "fn main()->int ! TaskError:\n  flags=[true,false,true]\n  names=[\"a\",\"é\"]\n  try parallel:\n    left=spawn copy(flags)\n    right=spawn copy(names)\n    a=try await left\n    b=try await right\n    if a[2]: length(b[1])\n    else: 0\n")
EXPECT(owned 1)
COMPILE(shadow "fn copy(n:int)->int:\n  n+1\nfn main()->int:\n  copy(41)\n")
EXPECT(shadow 42)

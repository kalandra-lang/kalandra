file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(ROOT "${OUTPUT_DIR}")
file(WRITE "${ROOT}/input.txt" "fn main()->int:\n  42\n")
file(WRITE "${ROOT}/main.k" "fn main()->int:\n  missing\n")
function(query EXPECTED INPUT)
  execute_process(COMMAND "${CHECKER}" ${ARGN} --diagnostics=json
    INPUT_FILE "${INPUT}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 30)
  if(NOT STATUS EQUAL EXPECTED OR NOT ERROR STREQUAL "")
    message(FATAL_ERROR "Unexpected status/output: ${STATUS}: ${OUT} ${ERROR}")
  endif()
  string(JSON VERSION GET "${OUT}" formatVersion)
  string(JSON OK GET "${OUT}" ok)
  if(NOT VERSION EQUAL 1 OR (EXPECTED EQUAL 0 AND NOT OK) OR (NOT EXPECTED EQUAL 0 AND OK))
    message(FATAL_ERROR "Invalid checker response: ${OUT}")
  endif()
  set(RESPONSE "${OUT}" PARENT_SCOPE)
endfunction()
query(0 "${ROOT}/input.txt" --stdin "${ROOT}/main.k")
query(1 "${ROOT}/input.txt" "${ROOT}/main.k") # Disk still contains the error.
query(0 "${ROOT}/input.txt" "${ROOT}/new.k" --stdin)
if(EXISTS "${ROOT}/new.k")
  message(FATAL_ERROR "Checker wrote the unsaved root")
endif()
file(WRITE "${ROOT}/lib.k" "export fn value()->int:\n  3\n")
file(WRITE "${ROOT}/input.txt" "from \"./lib.k\" import value\nfn main()->int:\n  value()\n")
query(0 "${ROOT}/input.txt" --stdin "${ROOT}/new.k")
file(WRITE "${ROOT}/project.toml" "format=1\n[project]\nentry=\"new.k\"\n[packages]\nmath=\"lib.k\"\n")
file(WRITE "${ROOT}/input.txt" "from \"math\" import value\nfn main()->int:\n  value()\n")
query(0 "${ROOT}/input.txt" --stdin --project "${ROOT}/project.toml")
query(0 "${ROOT}/input.txt" --stdin --package "math=${ROOT}/lib.k" "${ROOT}/new.k")
file(WRITE "${ROOT}/input.txt" "fn main()->String:\n  \"😀é\" + missing\n")
query(1 "${ROOT}/input.txt" --stdin "${ROOT}/new.k")
string(JSON CHARACTER GET "${RESPONSE}" diagnostics 0 range start character)
string(JSON FILE GET "${RESPONSE}" diagnostics 0 file)
if(NOT CHARACTER EQUAL 10 OR NOT FILE STREQUAL "${ROOT}/new.k")
  message(FATAL_ERROR "Unsaved source lost its filename/range: ${RESPONSE}")
endif()
file(WRITE "${ROOT}/input.txt" "")
query(1 "${ROOT}/input.txt" --stdin "${ROOT}/new.k")
string(JSON CODE GET "${RESPONSE}" diagnostics 0 code)
if(NOT CODE STREQUAL "P001")
  message(FATAL_ERROR "Empty stdin fell back to disk: ${RESPONSE}")
endif()
query(2 "${ROOT}/input.txt" --stdin --stdin "${ROOT}/new.k")
query(2 "${ROOT}/input.txt" --stdin)
query(1 "${ROOT}/input.txt" --stdin "${ROOT}/invalid.txt")
string(REPEAT " " 16777216 TOO_BIG)
file(WRITE "${ROOT}/input.txt" "${TOO_BIG}")
unset(TOO_BIG)
query(1 "${ROOT}/input.txt" --stdin "${ROOT}/new.k")
string(JSON CODE GET "${RESPONSE}" diagnostics 0 code)
if(NOT CODE STREQUAL "IO001")
  message(FATAL_ERROR "Stdin byte limit bypassed: ${RESPONSE}")
endif()
file(WRITE "${ROOT}/input.txt" "fn main()->int:\n  42\n")
execute_process(COMMAND "${CHECKER}" --stdin "${ROOT}/new.k" INPUT_FILE "${ROOT}/input.txt"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR NOT OUT MATCHES "^Checked 1 functions" OR NOT ERROR STREQUAL "")
  message(FATAL_ERROR "Default stdin terminal output incorrect: ${STATUS} ${OUT} ${ERROR}")
endif()
message(STATUS "Unsaved checker CLI: 12 JSON checks and terminal output passed")

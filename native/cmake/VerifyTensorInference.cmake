include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
COMPILE(default-int "fn main():\n  values=tensor([[1,2],[3,4]])\n  reduceSum(values)\n")
EXPECT(default-int 10)
COMPILE(default-float "fn main():\n  values=tensor([1.0,2.5,3.0])\n  reduceSum(values)\n")
EXPECT(default-float 6.5)
COMPILE(scalar "fn main():\n  value=tensor(-7)\n  reduceSum(value)\n")
EXPECT(scalar -7)
COMPILE(shape "fn main():\n  value=tensor([1,2,3,4],[2,2])\n  reduceSum(matmul(value,value))\n")
EXPECT(shape 54)
COMPILE(tensor "fn choose(flag:Bool):\n  if flag:\n    values=tensor([-0.0,1.0000000000000002])\n    values\n  else:\n    values=tensor([4.9406564584124654e-324,1.7976931348623157e308,0.0])\n    values\nfn main()->int64:\n  0\n" --test-entry choose)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -isystem "${LLVM_ROOT}/include"
  "${SOURCE_DIR}/tests/ControlTensorRuntimeTests.cpp" "${OUTPUT_DIR}/tensor.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/tensor-harness")
RUN_OK("${OUTPUT_DIR}/tensor-harness")
foreach(TYPE IN ITEMS int32 uint32 int64 uint64 float32 float64)
  if(TYPE STREQUAL "float32")
    set(DEFINES -DFLOAT_RESULT=1)
    set(DATA "[[seed,seed*2],[seed*3,seed*4]]")
    set(WANT 20)
  else()
    set(DATA "[[seed,seed*2],[seed*3,seed*4]]")
    set(WANT 20)
    if(TYPE STREQUAL "float64")
      set(DEFINES -DFLOAT_RESULT=64)
    elseif(TYPE STREQUAL "int64")
      set(DEFINES -DINTEGER_BITS=64)
    elseif(TYPE STREQUAL "uint64")
      set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
    elseif(TYPE STREQUAL "uint32")
      set(DEFINES -DUNSIGNED_RESULT=1)
    else()
      set(DEFINES)
    endif()
  endif()
  COMPILE("worker-${TYPE}" "fn make(seed:${TYPE}):\n  tensor(${DATA})\nfn clone(value:Tensor[${TYPE},?,?]):\n  value\nfn inner(value:Tensor[${TYPE},?,?]) ! TaskError:\n  try parallel:\n    work=spawn clone(value)\n    first=try await work\n    again=try await work\n    again\nfn probe() ! TaskError:\n  value=make(${TYPE}(2))\n  try parallel:\n    left=spawn inner(value)\n    right=spawn inner(value)\n    a=try await left\n    b=try await right\n    again=try await right\n    (a+b+again)/3\nfn main()->${TYPE} ! TaskError:\n  value=try probe()\n  reduceSum(value)\n" --test-entry probe)
  EXPECT("worker-${TYPE}" "${WANT}")
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -DTENSOR_RANK=2 -DCONVERSION_RESULT=1 ${DEFINES}
    "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/worker-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/worker-${TYPE}-harness")
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/worker-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/worker-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
    endforeach()
  endforeach()
endforeach()
foreach(ORDER IN ITEMS first second)
  if(ORDER STREQUAL "first")
    set(LEAVES "first(0),second(0)")
    set(LINE 2)
  else()
    set(LEAVES "second(0),first(0)")
    set(LINE 4)
  endif()
  COMPILE("fault-${ORDER}" "fn first(value:int64)->int64:\n  1/value\nfn second(value:int64)->int64:\n  2/value\nfn main():\n  values=tensor([${LEAVES}])\n  reduceSum(values)\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/fault-${ORDER}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source ${LINE}:3" OR NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Inferred leaf evaluation order or cleanup failed: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
foreach(NAME IN ITEMS mixed empty)
  if(NAME STREQUAL "mixed")
    set(BODY "tensor([1,2.5])")
    set(CODE S010)
  else()
    set(BODY "tensor([])")
    set(CODE S026)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${NAME}.k" "fn main():\n  ${BODY}\n")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${NAME}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Inference diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
message(STATUS "Tensor inference: defaults, shapes, exact float bits, six typed worker families, retained owners and ordered failures passed")

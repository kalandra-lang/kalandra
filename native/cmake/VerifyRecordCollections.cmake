include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDS 2 6 3 7 8 9)
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDS ${INDEX} ID)
  set(DECL "type Envelope:\n  data:Data\n  enabled:Bool\ntype Data:\n  values:[${TYPE}]\n  matrix:Tensor[${TYPE},?,?]\n  scalar:Tensor[${TYPE}]\n")
  set(MAKE "fn make()->Envelope:\n  Envelope {enabled:true,data:Data {values:[1,2,3],matrix:tensor([[1,2],[3,4]]),scalar:tensor(7)}}\n")
  set(HELPERS "fn shift(p:Envelope)->Envelope:\n  p with {data:p.data with {values:map(p.data.values,fn(x):x+10),matrix:p.data.matrix*2}}\nfn child(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    task=spawn shift(p)\n    first=try await task\n    again=try await task\n    again\n")
  COMPILE("sync-${TYPE}" "${DECL}${MAKE}${HELPERS}fn main()->${TYPE}:\n  original=make()\n  moved=shift(original)\n  moved.data.values[1]+original.data.values[0]+moved.data.matrix[1,1]+array(moved.data.scalar)[0]\n")
  EXPECT("sync-${TYPE}" 28)
  COMPILE("worker-${TYPE}" "${DECL}${MAKE}${HELPERS}fn main()->${TYPE} ! TaskError:\n  original=make()\n  moved=try parallel:\n    task=spawn child(original)\n    first=try await task\n    again=try await task\n    again\n  moved.data.values[1]+original.data.values[0]+moved.data.matrix[1,1]+array(moved.data.scalar)[0]\n")
  EXPECT("worker-${TYPE}" 28)
  COMPILE("array-${TYPE}" "${DECL}${MAKE}${HELPERS}fn main()->[${TYPE}] ! TaskError:\n  moved=try child(make())\n  moved.data.values\n")
  EXPECT("array-${TYPE}" "[11, 12, 13]")
  COMPILE("empty-${TYPE}" "type Box:\n  array:[${TYPE}]\n  matrix:Tensor[${TYPE},2,0,3]\nfn echo(p:Box)->Box:\n  p\nfn main()->[${TYPE}] ! TaskError:\n  p=try parallel:\n    try await spawn echo(Box {array:[],matrix:tensor([],[2,0,3])})\n  p.array\n")
  EXPECT("empty-${TYPE}" "[]")
  set(RAW "type Envelope:\n  data:Data\n  duplicate:[${TYPE}]\ntype Data:\n  values:[${TYPE}]\n  enabled:Bool\nfn identity(p:Envelope)->Envelope:\n  p\nfn probe(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    child=spawn identity(p)\n    first=try await child\n    again=try await child\n    again\nfn main()->int:\n  0\n")
  COMPILE("raw-${TYPE}" "${RAW}" --test-entry probe)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}"
    "${SOURCE_DIR}/tests/RecordCollectionWorkerTests.cpp" "${OUTPUT_DIR}/raw-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/raw-${TYPE}-harness")
  foreach(WORKERS IN ITEMS 1 4)
    foreach(MODE IN ITEMS 0 1 2 4 5)
      RUN_OK("${OUTPUT_DIR}/raw-${TYPE}-harness" "${WORKERS}" "${MODE}" 0)
    endforeach()
    if(TYPE STREQUAL "int64")
      foreach(FAIL_AT RANGE 1 20)
        RUN_OK("${OUTPUT_DIR}/raw-${TYPE}-harness" "${WORKERS}" 3 "${FAIL_AT}")
      endforeach()
    endif()
  endforeach()
endforeach()
COMPILE(shapes "type Box:\n  values:[int]\nfn make(values:[int])->Box:\n  Box {values:values}\nfn main():\n  left=make([1])\n  right=make([2,3,4])\n  length(left.values)+length(right.values)\n")
EXPECT(shapes 4)
COMPILE(recovery "type Box:\n  values:[int]\nfn bad(p:Box,divisor:int)->Box:\n  p with {values:map(p.values,fn(x):x/divisor)}\nfn attempt()->Box ! TaskError:\n  try parallel:\n    try await spawn bad(Box {values:[1,2,3]},0)\nfn main():\n  value=attempt() catch fn(error): Box {values:[7,8]}\n  value.values\n")
EXPECT(recovery "[7, 8]")
COMPILE(fixed "type Box:\n  values:Tensor[int,2,2]\nfn make(values:Tensor[int,?,?])->Box:\n  Box {values:values}\nfn main():\n  make(tensor([[1,2],[3,4]])).values\n")
EXPECT(fixed "tensor([1, 2, 3, 4], [2, 2])")
COMPILE(shape-fault "type Box:\n  values:Tensor[int,2,2]\nfn make(values:Tensor[int,?,?])->Box:\n  Box {values:values}\nfn dynamic(rows:int,columns:int):\n  make(tensor([1,2,3],[rows,columns])).values\nfn main():\n  dynamic(1,3)\n")
execute_process(COMMAND "${OUTPUT_DIR}/shape-fault" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "Shape")
  message(FATAL_ERROR "record field shape guard failed: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(NAME IN ITEMS sync-int64 worker-int64 array-int64)
  foreach(FAIL_AT RANGE 1 20)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}" "${OUTPUT_DIR}/${NAME}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT STATUS EQUAL 0 AND (NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault"))
      message(FATAL_ERROR "record field allocation fault published partial output: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(STATUS EQUAL 0)
      if(NAME STREQUAL "array-int64")
        set(EXPECTED "[11, 12, 13]\n")
      else()
        set(EXPECTED "28\n")
      endif()
      if(NOT OUT STREQUAL EXPECTED)
        message(FATAL_ERROR "Allocation sweep changed successful result: ${OUT}")
      endif()
    else()
      if(NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
        message(FATAL_ERROR "Allocation sweep omitted cleanup or leaked owners: ${ERR}")
      endif()
    endif()
    if(ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "record field sanitizer failure: ${ERR}")
    endif()
  endforeach()
endforeach()
message(STATUS "Record collections: six types, owned helper/worker returns, rank zero/empty/static/dynamic shapes, cached/nested tasks, raw transport, recovery and allocation cleanup passed")

file(WRITE "${OUTPUT_DIR}/library.k" "type Box:\n  values:[int]\nexport fn make(values:[int]):\n  Box {values:values}\nexport fn change(p:Box):\n  p with {values:map(p.values,fn(x):x+10)}\n")
COMPILE(modules "from \"./library.k\" import make,change\nfn main()->[int] ! TaskError:\n  original=make([1,2,3])\n  moved=try parallel:\n    try await spawn change(original)\n  moved.values\n")
EXPECT(modules "[11, 12, 13]")
file(READ "${SOURCE_DIR}/../docs/design/record-collections.md" DOC)
string(REGEX MATCH "```kalandra\n([^`]+)```" EXAMPLE "${DOC}")
COMPILE(documentation "${CMAKE_MATCH_1}")
EXPECT(documentation "[11, 12, 13]")

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
function(RAW TYPE ID RANK LENGTH)
  set(NAME "raw-${TYPE}-${RANK}-${LENGTH}")
  set(DEFINES)
  if(LENGTH)
    set(INPUT "[${TYPE}]")
    set(EXPRESSION "length(input)")
    set(DEFINES -DQUERY_LENGTH=1)
  else()
    set(INPUT "Tensor[${TYPE}")
    if(RANK GREATER 0)
      math(EXPR LAST "${RANK}-1")
      foreach(AXIS RANGE 0 ${LAST})
        string(APPEND INPUT ",?")
      endforeach()
    endif()
    string(APPEND INPUT "]")
    set(EXPRESSION "shape(input)")
  endif()
  COMPILE("${NAME}" "fn query(input:${INPUT}):\n  ${EXPRESSION}\nfn main()->int:\n  0\n" --test-entry query)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DNUMERIC_TYPE=${ID}" "-DINPUT_RANK=${RANK}" ${DEFINES} -isystem "${LLVM_ROOT}/include"
    "${SOURCE_DIR}/tests/CollectionQueryRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}"
    "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
  RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
endfunction()
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDS 2 6 3 7 8 9)
foreach(N RANGE 0 5)
  list(GET TYPES ${N} TYPE)
  list(GET IDS ${N} ID)
  RAW("${TYPE}" "${ID}" 1 TRUE)
  RAW("${TYPE}" "${ID}" 2 FALSE)
  if(TYPE STREQUAL "int64" OR TYPE STREQUAL "float32")
    foreach(RANK IN ITEMS 0 1 3 8)
      RAW("${TYPE}" "${ID}" "${RANK}" FALSE)
    endforeach()
  endif()
  set(DATA)
  foreach(I RANGE 1 24)
    if(I GREATER 1)
      string(APPEND DATA ",")
    endif()
    string(APPEND DATA "${TYPE}(${I})")
  endforeach()
  set(SOURCE "fn failing(value:int)->int:\n  1/value\nfn make()->Tensor[${TYPE},1,2,3,4]:\n  tensor([${DATA}],[1,2,3,4])\nfn collect(values:Tensor[${TYPE},?,?,?,?],offset:int):\n  dimensions=shape(values)\n  map(dimensions,fn(x): x*2+offset+length(dimensions)-4)\nfn inner(values:Tensor[${TYPE},?,?,?,?]) ! TaskError:\n  try parallel:\n    work=spawn shape(values)\n    first=try await work\n    again=try await work\n    map(again,fn(x):x*2)\nfn queryFail(divisor:int):\n  shape(tensor(${TYPE}(failing(divisor))))\nfn faultProbe()->[int] ! TaskError:\n  try parallel:\n    work=spawn queryFail(0)\n    try await work\nfn shaped(values:Tensor[${TYPE},4]):\n  shape(values)\nfn uncertain(flag:Bool):\n  if flag: tensor([${TYPE}(1)])\n  else: tensor([${TYPE}(1),${TYPE}(2)])\nfn shapeProbe()->[int] ! TaskError:\n  values=uncertain(true)\n  try parallel:\n    work=spawn shaped(values)\n    try await work\nfn emptyProbe()->[int] ! TaskError:\n  scalar=tensor(${TYPE}(7))\n  try parallel:\n    work=spawn shape(scalar)\n    try await work\nfn probe()->[int] ! TaskError:\n  original=make()\n  attempt=faultProbe()\n  recovered=attempt catch fn(error): [2,4,6,8]\n  try parallel:\n    nested=spawn inner(original)\n    direct=spawn shape(original)\n    mapped=spawn collect(original,0)\n    sizes=try await direct\n    a=try await nested\n    b=try await mapped\n    sizeWork=spawn length(sizes)\n    rank=try await sizeWork\n    map(a,fn(x):x+length(b)-rank+recovered[0]-2)\nfn main()->int ! TaskError:\n  values=try probe()\n  reduceSum(tensor(values))\n")
  foreach(KIND IN ITEMS probe emptyProbe faultProbe shapeProbe)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      -DINTEGER_BITS=64 -DTENSOR_RANK=1 -DARRAY_RESULT=1 -DCONVERSION_RESULT=1
      "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  EXPECT("probe-${TYPE}" 20)
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    RUN_OK("${OUTPUT_DIR}/emptyProbe-${TYPE}-harness" "${WORKERS}" 4 0)
    RUN_OK("${OUTPUT_DIR}/faultProbe-${TYPE}-harness" "${WORKERS}" 7 0)
    RUN_OK("${OUTPUT_DIR}/shapeProbe-${TYPE}-harness" "${WORKERS}" 6 0)
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
      if(WORKERS EQUAL 2)
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
          "${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3)
      endif()
    endforeach()
  endforeach()
endforeach()
COMPILE(length "fn main():\n  [1,2,3] -> length()\n")
EXPECT(length 3)
COMPILE(rank-zero "fn main():\n  length(shape(tensor(7)))\n")
EXPECT(rank-zero 0)
COMPILE(dimensions "fn main():\n  dimensions=shape(tensor([[1,2,3],[4,5,6]]))\n  dimensions[0]*10+dimensions[1]\n")
EXPECT(dimensions 23)
COMPILE(after-group "fn main() ! TaskError:\n  dimensions=try parallel:\n    work=spawn shape(tensor([[1,2,3],[4,5,6]]))\n    try await work\n  length(dimensions)*10+dimensions[1]\n")
EXPECT(after-group 23)
COMPILE(awaited "fn make()->Tensor[int,2,3]:\n  tensor([[1,2,3],[4,5,6]])\nfn main() ! TaskError:\n  try parallel:\n    work=spawn make()\n    length(shape(try await work))\n")
EXPECT(awaited 2)
COMPILE(fault-order "fn failing(value:int)->int:\n  1/value\nfn main():\n  length([failing(0)])\n")
execute_process(COMMAND "${OUTPUT_DIR}/fault-order" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT ERR MATCHES "ArithmeticFault.*2:3")
  message(FATAL_ERROR "Metadata query suppressed operand fault: ${STATUS}: ${ERR}")
endif()
foreach(KIND IN ITEMS arity category identity)
  if(KIND STREQUAL "arity")
    set(INVALID "fn main():\n  shape(tensor(7),0)\n")
    set(CODE S027)
  elseif(KIND STREQUAL "category")
    set(INVALID "fn main():\n  shape([1,2])\n")
    set(CODE S064)
  else()
    set(INVALID "fn main()->uint:\n  length([1,2])\n")
    set(CODE S010)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${KIND}.k" "${INVALID}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${KIND}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Query diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
message(STATUS "Collection queries: six numeric input types, rank-zero/empty/dynamic dimensions, no payload reads, exact int64 metadata, retained shape arrays, direct/nested workers, cancellation, fault recovery and allocation failure passed")

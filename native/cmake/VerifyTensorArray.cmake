include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
function(RAW TYPE ID RANK)
  set(INPUT "Tensor[${TYPE}")
  if(RANK GREATER 0)
    math(EXPR LAST "${RANK}-1")
    foreach(AXIS RANGE 0 ${LAST})
      string(APPEND INPUT ",?")
    endforeach()
  endif()
  string(APPEND INPUT "]")
  set(NAME "raw-${TYPE}-${RANK}")
  COMPILE("${NAME}" "fn change(values:${INPUT})->[${TYPE}]:\n  array(values)\nfn main()->int:\n  0\n" --test-entry change)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DNUMERIC_TYPE=${ID}" "-DINPUT_RANK=${RANK}" -DOUTPUT_RANK=1 -DTENSOR_TO_ARRAY=1
    -isystem "${LLVM_ROOT}/include" "${SOURCE_DIR}/tests/TensorReshapeRuntimeTests.cpp"
    "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
  RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
endfunction()
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDS 2 6 3 7 8 9)
foreach(N RANGE 0 5)
  list(GET TYPES ${N} TYPE)
  list(GET IDS ${N} ID)
  RAW("${TYPE}" "${ID}" 2)
  if(TYPE STREQUAL "int64" OR TYPE STREQUAL "float32")
    foreach(RANK IN ITEMS 0 1 3 8)
      RAW("${TYPE}" "${ID}" "${RANK}")
    endforeach()
  endif()
  if(TYPE STREQUAL "float32")
    set(DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "float64")
    set(DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "int64")
    set(DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "uint64")
    set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "uint32")
    set(DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(DEFINES)
  endif()
  set(SOURCE "fn failing(value:int)->int:\n  1/value\nfn make()->Tensor[${TYPE},1,2,2]:\n  tensor([[[${TYPE}(1),${TYPE}(2)],[${TYPE}(3),${TYPE}(4)]]])\nfn changed(values:Tensor[${TYPE},?,?,?]):\n  array(values)\nfn mapped(values:Tensor[${TYPE},?,?,?],offset:${TYPE}):\n  map(array(values),fn(x):x*2+offset)\nfn callback(values:Tensor[${TYPE},?,?,?]):\n  map([${TYPE}(1),${TYPE}(2)],fn(x):array(values)[int(x)])\nfn inner(values:Tensor[${TYPE},?,?,?]) ! TaskError:\n  try parallel:\n    work=spawn array(values)\n    first=try await work\n    again=try await work\n    again\nfn bad(values:Tensor[${TYPE},?,?,?],divisor:int):\n  array(values+${TYPE}(failing(divisor)))\nfn faultProbe()->[${TYPE}] ! TaskError:\n  try parallel:\n    work=spawn bad(make(),0)\n    try await work\nfn emptyProbe()->[${TYPE}] ! TaskError:\n  values:Tensor[${TYPE},2,0,3]=tensor([],[2,0,3])\n  try parallel:\n    work=spawn array(values)\n    try await work\nfn probe()->[${TYPE}] ! TaskError:\n  original=make()\n  attempt=faultProbe()\n  recovered=attempt catch fn(error): array(original)\n  try parallel:\n    nested=spawn inner(original)\n    direct=spawn array(original)\n    measure=spawn mapped(original,${TYPE}(0))\n    closure=spawn callback(original)\n    helper=spawn changed(original)\n    a=try await nested\n    b=try await direct\n    again=try await direct\n    measurement=try await measure\n    c=try await closure\n    h=try await helper\n    map(measurement,fn(x):x+a[0]+b[0]+again[0]+recovered[0]+h[0]+c[0]+c[1]-10)\nfn main()->${TYPE} ! TaskError:\n  result=try probe()\n  reduceSum(tensor(result))\n")
  foreach(KIND IN ITEMS probe emptyProbe faultProbe)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      -DTENSOR_RANK=1 -DCONVERSION_RESULT=1 -DARRAY_RESULT=1 ${DEFINES} "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp"
      "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  EXPECT("probe-${TYPE}" 20)
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    RUN_OK("${OUTPUT_DIR}/emptyProbe-${TYPE}-harness" "${WORKERS}" 4 0)
    RUN_OK("${OUTPUT_DIR}/faultProbe-${TYPE}-harness" "${WORKERS}" 7 0)
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
      if(WORKERS EQUAL 2)
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
          "${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3)
      endif()
    endforeach()
  endforeach()
endforeach()
COMPILE(pipeline "fn main():\n  tensor([[1,2],[3,4]]) -> array() -> map(fn(x):x*2) -> tensor() -> reduceSum()\n")
EXPECT(pipeline 20)
COMPILE(rank-zero "fn main():\n  array(tensor(7))[0]\n")
EXPECT(rank-zero 7)
COMPILE(after-group "fn main() ! TaskError:\n  values=try parallel:\n    work=spawn array(tensor([[1,2],[3,4]]))\n    try await work\n  values[3]\n")
EXPECT(after-group 4)
COMPILE(awaited "fn make():\n  tensor([[1,2],[3,4]])\nfn main() ! TaskError:\n  try parallel:\n    work=spawn make()\n    array(try await work)[2]\n")
EXPECT(awaited 3)
COMPILE(known-length "fn consume(values:[int])->Tensor[int,6]:\n  tensor(values)\nfn main():\n  matrix=tensor([[1,2,3],[4,5,6]])\n  flat=array(matrix)\n  length(flat)+reduceSum(consume(flat))\n")
EXPECT(known-length 27)
COMPILE(empty "fn main():\n  values:Tensor[int,2,0,3]=tensor([],[2,0,3])\n  length(array(values))\n")
EXPECT(empty 0)
COMPILE(argument-order "fn failFirst(value:int):\n  1/value\nfn main():\n  array(tensor([[failFirst(0)]]))[0]\n")
execute_process(COMMAND "${OUTPUT_DIR}/argument-order" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT ERR MATCHES "ArithmeticFault.*2:3")
  message(FATAL_ERROR "Tensor-to-array argument fault order changed: ${STATUS}: ${ERR}")
endif()
foreach(KIND IN ITEMS category identity implicit)
  if(KIND STREQUAL "category")
    set(INVALID "fn main():\n  array([1,2])\n")
    set(CODE S026)
  elseif(KIND STREQUAL "identity")
    set(INVALID "fn change(values:Tensor[int,?])->[float32]:\n  array(values)\nfn main()->int:\n  0\n")
    set(CODE S010)
  else()
    set(INVALID "fn change(values:Tensor[int,?])->[int]:\n  values\nfn main()->int:\n  0\n")
    set(CODE S010)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${KIND}.k" "${INVALID}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${KIND}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Tensor-to-array diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
message(STATUS "Tensor-to-array: exact six-type logical copies, ranks zero/one/two/three/eight, borrowed source independence, non-contiguous input, checked metadata, active cancellation, map callbacks, direct/nested workers and retained array results passed")

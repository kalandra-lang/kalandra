if(NUMERIC_TYPE STREQUAL "uint64")
  set(UNSIGNED 1)
  set(MAXIMUM 18446744073709551615)
else()
  set(UNSIGNED 0)
  set(MAXIMUM 9223372036854775807)
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(EXTRA)
set(FLAGS -O0)
set(OPT_LINK)
if(VARIANT STREQUAL "optimized")
  set(EXTRA -O2)
  set(FLAGS -O2)
  set(OPT_LINK "${OPT_RUNTIME}")
elseif(VARIANT STREQUAL "sanitized")
  set(EXTRA --sanitize)
  set(FLAGS -O1 -fsanitize=address,undefined -fno-sanitize-recover=all)
elseif(VARIANT STREQUAL "thread-sanitized")
  set(EXTRA --thread-sanitize)
  set(FLAGS -O1 -fsanitize=thread)
endif()
function(RUN_OK)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "0" OR NOT ERR STREQUAL "")
    message(FATAL_ERROR "Failed: ${ARGN}: ${STATUS}: ${OUT}${ERR}")
  endif()
  message(STATUS "${OUT}")
endfunction()
function(QUALIFY NAME SOURCE ENTRY RANK FLOAT UNSIGNED BITS SCENARIO)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  RUN_OK("${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" --test-entry "${ENTRY}"
    --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/${NAME}.mlir" ${EXTRA})
  RUN_OK("${OUTPUT_DIR}/${NAME}")
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DTENSOR_RANK=${RANK}" "-DINTEGER_BITS=${BITS}" "-DFLOAT_RESULT=${FLOAT}" "-DUNSIGNED_RESULT=${UNSIGNED}" "${HARNESS_SOURCE}" "${OUTPUT_DIR}/${NAME}.ll"
    ${OPT_LINK} "${RUNTIME}" -o "${OUTPUT_DIR}/${NAME}-harness")
  foreach(WORKERS IN ITEMS 1 2 4)
    RUN_OK("${OUTPUT_DIR}/${NAME}-harness" "${WORKERS}" "${SCENARIO}" 0)
  endforeach()
endfunction()
file(READ "${FIXTURES}/task-integer64-tensor-mixed.k" SOURCE)
QUALIFY(mixed-uint64 "${SOURCE}" wideUnsignedProbe 1 0 1 64 1)
QUALIFY(mixed-int64 "${SOURCE}" wideSignedProbe 1 0 0 64 1)
QUALIFY(mixed-uint32 "${SOURCE}" narrowUnsignedProbe 1 0 1 32 1)
QUALIFY(mixed-int32 "${SOURCE}" narrowSignedProbe 1 0 0 32 1)
QUALIFY(mixed-float "${SOURCE}" realProbe 1 1 0 32 8)
file(READ "${OUTPUT_DIR}/mixed-uint64.ll" IR)
foreach(TYPE IN ITEMS uint64 int64 uint32 int32)
  if(NOT IR MATCHES "value.layout.tensor.${TYPE}.1" OR NOT IR MATCHES "result.tensor.${TYPE}.1")
    message(FATAL_ERROR "Missing distinct ${TYPE} tensor task layout")
  endif()
endforeach()
if(NOT IR MATCHES "value.layout.tensor1" OR NOT IR MATCHES "result.tensor1" OR
   NOT IR MATCHES "value.layout.scalar.int64" OR NOT IR MATCHES "value.layout.scalar.uint64")
  message(FATAL_ERROR "Mixed tensor/scalar packet lost a numeric family")
endif()
file(READ "${FIXTURES}/task-uint32-tensor-nested.k" SOURCE)
string(REPLACE "uint32" "${NUMERIC_TYPE}" SOURCE "${SOURCE}")
string(REPLACE "2147483648" "9007199254740993" SOURCE "${SOURCE}")
if(NUMERIC_TYPE STREQUAL "int64")
  string(REPLACE ",10]" ",-10]" SOURCE "${SOURCE}")
endif()
QUALIFY(nested "${SOURCE}" probe 2 0 ${UNSIGNED} 64 2)
file(READ "${FIXTURES}/task-uint32-tensor-recovery.k" SOURCE)
string(REPLACE "uint32" "${NUMERIC_TYPE}" SOURCE "${SOURCE}")
string(REPLACE "4294967295" "${MAXIMUM}" SOURCE "${SOURCE}")
QUALIFY(recovery "${SOURCE}" probe 1 0 ${UNSIGNED} 64 5)
QUALIFY(arithmetic-fault "${SOURCE}" failedProbe 1 0 ${UNSIGNED} 64 7)
foreach(OP IN ITEMS subtraction multiply zero remainder negation signed-division)
  if(OP STREQUAL "subtraction")
    if(UNSIGNED)
      set(EXPR "values - 2")
    else()
      set(EXPR "values - -1")
    endif()
  elseif(OP STREQUAL "multiply")
    set(EXPR "values * 2")
  elseif(OP STREQUAL "zero")
    set(EXPR "values / 0")
  elseif(OP STREQUAL "remainder")
    set(EXPR "values % 0")
  elseif(OP STREQUAL "signed-division")
    if(UNSIGNED)
      continue()
    endif()
    set(EXPR "values / -1")
  else()
    set(EXPR "-values")
  endif()
  string(REPLACE "values + 1" "${EXPR}" FAULT "${SOURCE}")
  if(NOT UNSIGNED AND (OP STREQUAL "negation" OR OP STREQUAL "signed-division"))
    string(REPLACE "${MAXIMUM}" "-9223372036854775808" FAULT "${FAULT}")
  endif()
  QUALIFY("${OP}-fault" "${FAULT}" failedProbe 1 0 ${UNSIGNED} 64 7)
endforeach()
set(SOURCE "fn shift(values:Tensor[${NUMERIC_TYPE}],amount:${NUMERIC_TYPE}) -> Tensor[${NUMERIC_TYPE}]:\n  values + amount\nfn combine(a:Tensor[${NUMERIC_TYPE}],b:Tensor[${NUMERIC_TYPE}]) -> Tensor[${NUMERIC_TYPE}]:\n  a + b\nfn probe() -> Tensor[${NUMERIC_TYPE}] ! TaskError:\n  values:Tensor[${NUMERIC_TYPE}] = tensor(9007199254740993)\n  try parallel:\n    work = spawn shift(values,1)\n    first = try await work\n    again = try await work\n    try await spawn combine(first,again)\nfn main() -> ${NUMERIC_TYPE}:\n  0\n")
QUALIFY(rankzero "${SOURCE}" probe 0 0 ${UNSIGNED} 64 0)
set(SOURCE "fn twice(values:Tensor[${NUMERIC_TYPE},?,?,?]) -> Tensor[${NUMERIC_TYPE},?,?,?]:\n  values + values\nfn probe() -> Tensor[${NUMERIC_TYPE},?,?,?] ! TaskError:\n  values:Tensor[${NUMERIC_TYPE},2,1,2] = tensor([1,2,3,4],[2,1,2])\n  try parallel:\n    try await spawn twice(values)\nfn main() -> ${NUMERIC_TYPE}:\n  0\n")
QUALIFY(rankthree "${SOURCE}" probe 3 0 ${UNSIGNED} 64 3)
set(SOURCE "fn divide(values:Tensor[${NUMERIC_TYPE},?,?]) -> Tensor[${NUMERIC_TYPE},?,?]:\n  values / 0\nfn probe() -> Tensor[${NUMERIC_TYPE},?,?] ! TaskError:\n  values:Tensor[${NUMERIC_TYPE},2,0] = tensor([],[2,0])\n  try parallel:\n    try await spawn divide(values)\nfn main() -> ${NUMERIC_TYPE}:\n  0\n")
QUALIFY(empty "${SOURCE}" probe 2 0 ${UNSIGNED} 64 4)
set(SOURCE "fn identity(values:Tensor[${NUMERIC_TYPE},?]) -> Tensor[${NUMERIC_TYPE},?]:\n  values\nfn coordinate(values:Tensor[${NUMERIC_TYPE},?]) -> Tensor[${NUMERIC_TYPE},?] ! TaskError:\n  try parallel:\n    try await spawn identity(values)\nfn probe() -> Tensor[${NUMERIC_TYPE},2] ! TaskError:\n  values:Tensor[${NUMERIC_TYPE},1] = tensor([9])\n  fallback:Tensor[${NUMERIC_TYPE},2] = tensor([1,2])\n  result = coordinate(values)\n  recovered = result catch fn(error): fallback\n  checked:Tensor[${NUMERIC_TYPE},2] = recovered\n  checked\nfn main() -> ${NUMERIC_TYPE}:\n  0\n")
QUALIFY(shape-fault "${SOURCE}" probe 1 0 ${UNSIGNED} 64 6)
foreach(WORKERS IN ITEMS 1 2 4)
  RUN_OK("${OUTPUT_DIR}/nested-harness" "${WORKERS}" 2 1)
  RUN_OK("${OUTPUT_DIR}/nested-harness" "${WORKERS}" 2 2)
  RUN_OK("${OUTPUT_DIR}/nested-harness" "${WORKERS}" 2 4)
  foreach(ATTEMPT RANGE 1 24)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
      "${OUTPUT_DIR}/recovery-harness" "${WORKERS}" 5 3)
  endforeach()
endforeach()
# Tensor tasks still reject GPU integer arithmetic.
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/nested.k" --target metal
  -o "${OUTPUT_DIR}/unsupported-metal" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "${NUMERIC_TYPE}" OR EXISTS "${OUTPUT_DIR}/unsupported-metal")
  message(FATAL_ERROR "Tensor task support accidentally enabled Metal ${NUMERIC_TYPE}: ${STATUS}: ${ERR}")
endif()

# Matrix multiplication now shares the qualified integer task path.
file(REMOVE "${OUTPUT_DIR}/unsupported-matmul.k" "${OUTPUT_DIR}/unsupported-reduceSum.k")
file(WRITE "${OUTPUT_DIR}/supported-matmul.k" "fn f(x:Tensor[${NUMERIC_TYPE},?,?]) -> Tensor[${NUMERIC_TYPE},?,?]:\n  matmul(x,x)\nfn main() -> ${NUMERIC_TYPE} ! TaskError:\n  try parallel:\n    0\n")
RUN_OK("${COMPILER}" "${OUTPUT_DIR}/supported-matmul.k" -o "${OUTPUT_DIR}/supported-matmul" ${EXTRA})
RUN_OK("${OUTPUT_DIR}/supported-matmul")
message(STATUS "Shared ${NUMERIC_TYPE} tensor task captures/results, five tensor families, both 64-bit scalar families, distinct layouts, retained owners, nested/cached awaits, arithmetic/shape faults, recovery and failure settlement passed with 1/2/4 workers")

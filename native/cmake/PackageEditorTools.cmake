cmake_minimum_required(VERSION 3.28)
if(NOT IS_ABSOLUTE "${BUILD_DIR}" OR NOT EXISTS "${BUILD_DIR}/cmake_install.cmake"
   OR NOT IS_ABSOLUTE "${OUTPUT_DIR}" OR NOT DEFINED CONFIG)
  message(FATAL_ERROR "Packaging requires an absolute configured BUILD_DIR, OUTPUT_DIR and CONFIG")
endif()
if(NOT EXISTS "${BUILD_DIR}/native/tool-install/${CONFIG}/toolchain.json")
  message(FATAL_ERROR "The requested native tools configuration was not generated")
endif()
if(PACKAGE_METAL AND (NOT PACKAGE_CPU OR NOT EXISTS "${BUILD_DIR}/native/metal-install/${CONFIG}/toolchain.json"))
  message(FATAL_ERROR "Metal packaging requires a configured Metal build and CPU component")
endif()
# Keep GNUInstallDirs overrides for explicit installs. The archive has one
# predictable relative layout; reject incompatible configured destinations.
function(require_archive_directory key expected)
  file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _entries
    REGEX "^CMAKE_INSTALL_${key}:[^=]+=")
  list(LENGTH _entries _count)
  string(REGEX REPLACE "^CMAKE_INSTALL_${key}:[^=]+=" "" _value "${_entries}")
  if(NOT _count EQUAL 1 OR NOT _value STREQUAL "${expected}")
    message(FATAL_ERROR "The archive requires CMAKE_INSTALL_${key}=${expected}; got ${_entries}")
  endif()
endfunction()
# LLVM's Windows package declares these as STRING; GNUInstallDirs commonly
# declares PATH. Their exact relative values, rather than cache types, matter.
require_archive_directory(BINDIR bin)
require_archive_directory(DATAROOTDIR share)
if(PACKAGE_CPU)
  require_archive_directory(LIBDIR lib)
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(_work "${OUTPUT_DIR}/package-stage")
set(_name "kalandra-native-editor-tools")
if(PACKAGE_CPU)
  set(_name "kalandra-native-cpu")
endif()
if(PACKAGE_METAL)
  set(_name "kalandra-native-metal")
endif()
if(STANDALONE)
  string(APPEND _name "-standalone")
endif()
set(_prefix "${_work}/${_name}")
file(REMOVE_RECURSE "${_work}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=DESTDIR
  "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}"
  --prefix "${_prefix}" --component NativeEditorTools --strip
  RESULT_VARIABLE _status)
if(NOT _status EQUAL 0)
  message(FATAL_ERROR "Editor-tools staging failed; no archive published")
endif()
if(PACKAGE_CPU)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=DESTDIR
    "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}"
    --prefix "${_prefix}" --component NativeCPUCompiler --strip RESULT_VARIABLE _status)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "CPU compiler staging failed; no archive published")
  endif()
endif()
if(PACKAGE_METAL)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=DESTDIR
    "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}"
    --prefix "${_prefix}" --component NativeMetalCompiler --strip RESULT_VARIABLE _status)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "Metal compiler staging failed; no archive published")
  endif()
endif()
if(STANDALONE)
  find_program(_python NAMES python3 python REQUIRED)
  file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _llvm REGEX "^KALANDRA_LLVM_ROOT:PATH=")
  string(REGEX REPLACE "^KALANDRA_LLVM_ROOT:PATH=" "" _llvm "${_llvm}")
  set(_cpu)
  if(PACKAGE_CPU)
    set(_cpu --cpu)
  endif()
  if(PACKAGE_METAL)
    foreach(_key IN ITEMS CROSS TOOLS)
      file(STRINGS "${BUILD_DIR}/CMakeCache.txt" _root REGEX "^KALANDRA_SPIRV_${_key}_ROOT:PATH=")
      string(REGEX REPLACE "^KALANDRA_SPIRV_${_key}_ROOT:PATH=" "" _root "${_root}")
      string(TOLOWER "${_key}" _lower)
      list(APPEND _cpu "--spirv-${_lower}" "${_root}")
    endforeach()
  endif()
  set(_bundler BundleMachO.py)
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(_bundler BundleELF.py)
    set(_cpu)
  elseif(CMAKE_HOST_WIN32)
    set(_bundler BundlePE.py)
    set(_cpu)
  endif()
  execute_process(COMMAND "${_python}" "${CMAKE_CURRENT_LIST_DIR}/../packaging/${_bundler}"
    "${_prefix}" --llvm "${_llvm}" ${_cpu} RESULT_VARIABLE _status)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "Standalone dependency staging failed; previous archive preserved")
  endif()
endif()
if(STANDALONE AND PACKAGE_CPU AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
  execute_process(COMMAND "${_python}"
    "${CMAKE_CURRENT_LIST_DIR}/../../.github/scripts/macos_link_imports.py"
    --package "${_prefix}" --clang "${_llvm}/bin/clang++" --nm "${_llvm}/bin/llvm-nm"
    --output "${_prefix}/share/kalandra-native-tools/macos-link-imports"
    --interfaces-only --staged RESULT_VARIABLE _status)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "macOS public import validation failed; previous archive preserved")
  endif()
endif()
file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE RELATIVE "${_prefix}" "${_prefix}/*")
list(SORT _files)
set(_checksums "")
foreach(_file IN LISTS _files)
  file(SHA256 "${_prefix}/${_file}" _hash)
  string(APPEND _checksums "${_hash}  ${_file}\n")
endforeach()
file(WRITE "${_prefix}/SHA256SUMS" "${_checksums}")
file(READ "${BUILD_DIR}/native/tool-install/${CONFIG}/toolchain.json" _metadata)
string(JSON _platform GET "${_metadata}" platform)
set(_archive "${OUTPUT_DIR}/${_name}-${_platform}.tar.gz")
find_program(_python NAMES python3 python REQUIRED)
execute_process(COMMAND "${_python}" "${CMAKE_CURRENT_LIST_DIR}/../packaging/CreateArchive.py"
  "${_prefix}" "${_archive}.tmp" RESULT_VARIABLE _status)
if(NOT _status EQUAL 0)
  file(REMOVE "${_archive}.tmp")
  message(FATAL_ERROR "Editor-tools archiving failed; previous archive preserved")
endif()
file(RENAME "${_archive}.tmp" "${_archive}")
file(SHA256 "${_archive}" _digest)
file(WRITE "${_archive}.sha256" "${_digest}  ${_name}-${_platform}.tar.gz\n")
message(STATUS "Native package: ${_archive}")

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
function(QUALIFY NAME RANK OP MODE EXPR)
  set(TYPE "Tensor[float64")
  if(RANK GREATER 0)
    foreach(I RANGE 1 ${RANK})
      string(APPEND TYPE ",?")
    endforeach()
  endif()
  string(APPEND TYPE "]")
  set(PREFIX "")
  if(MODE EQUAL 5)
    set(PREFIX "fn fixed(x:Tensor[float64,2,2]) -> Tensor[float64,2,2]:\n  x+1\n")
  endif()
  COMPILE("${NAME}" "${PREFIX}fn operation(a:${TYPE},b:${TYPE},scalar:float) -> ${TYPE}:\n  ${EXPR}\nfn main() -> float:\n  0\n" --test-entry operation)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module -ffp-contract=off ${FLAGS}
    "-DTENSOR_RANK=${RANK}" -isystem "${LLVM_ROOT}/include" "${SOURCE_DIR}/tests/Float64TensorRuntimeTests.cpp"
    "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
  RUN_OK("${OUTPUT_DIR}/${NAME}-harness" "${OP}" "${MODE}")
  file(READ "${OUTPUT_DIR}/${NAME}.ll" LLVM)
  # LLVM may spell an exact sign-bit flip as fneg; rounded arithmetic must remain integer-only.
  if(LLVM MATCHES "(fadd|fsub|fmul|fdiv) double|fpext|fptrunc")
    message(FATAL_ERROR "Tensor float64 arithmetic bypassed strict lowering or changed precision")
  endif()
endfunction()
foreach(OP IN ITEMS add sub mul div)
  if(OP STREQUAL "add")
    set(SYMBOL "+")
    set(CODE 0)
  elseif(OP STREQUAL "sub")
    set(SYMBOL "-")
    set(CODE 3)
  elseif(OP STREQUAL "mul")
    set(SYMBOL "*")
    set(CODE 1)
  else()
    set(SYMBOL "/")
    set(CODE 5)
  endif()
  QUALIFY("${OP}-pair" 2 "${CODE}" 0 "a ${SYMBOL} b")
  QUALIFY("${OP}-right" 2 "${CODE}" 1 "a ${SYMBOL} scalar")
  QUALIFY("${OP}-left" 2 "${CODE}" 2 "scalar ${SYMBOL} b")
endforeach()
QUALIFY(composed 2 2 0 "a*b+a")
QUALIFY(negate 2 4 3 "-a")
QUALIFY(identity 2 6 3 "+a")
foreach(RANK IN ITEMS 0 1 3)
  QUALIFY("rank-${RANK}" ${RANK} 0 0 "a+b")
endforeach()
QUALIFY(refinement 2 0 5 "fixed(a)")
QUALIFY(literal-0 0 6 4 "tensor(scalar)")
QUALIFY(literal-1 1 6 4 "tensor([scalar,1.0000000000000002,4.9406564584124654e-324,1.7976931348623157e308])")
QUALIFY(literal-2 2 6 4 "tensor([[scalar,1.0000000000000002],[4.9406564584124654e-324,1.7976931348623157e308]])")
QUALIFY(literal-3 3 6 4 "tensor([scalar,1.0000000000000002,4.9406564584124654e-324,1.7976931348623157e308],[2,2,1])")
QUALIFY(literal-empty-vector 1 6 7 "tensor([])")
QUALIFY(literal-empty-matrix 2 6 7 "tensor([],[0,3])")
function(REJECT NAME SOURCE MATCH)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  file(WRITE "${OUTPUT_DIR}/preserved.ll" "preserved llvm")
  set(IR_FLAGS --emit-llvm "${OUTPUT_DIR}/preserved.ll")
  if(NAME STREQUAL "metal")
    set(IR_FLAGS)
  endif()
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/preserved" ${IR_FLAGS} ${ARGN}
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" EXE)
  file(READ "${OUTPUT_DIR}/preserved.ll" IR)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${MATCH}" OR NOT EXE STREQUAL "preserved executable" OR NOT IR STREQUAL "preserved llvm")
    message(FATAL_ERROR "${NAME} gate failed: ${STATUS}: ${ERR}")
  endif()
endfunction()
REJECT(metal "fn f(x:Tensor[float,?]) -> Tensor[float,?]:\n  x+1\nfn main() -> float:\n  0\n" "float64" --target metal)
REJECT(size "fn f(x:Tensor[float,1152921504606846976]) -> float:\n  0\n" "S002")
REJECT(overflow "fn f() -> Tensor[float,1]:\n  tensor([1.8e308])\n" "S015")
message(STATUS "CPU float64 ranked literals/elementwise operations, scalar lifting, exact IEEE lanes, immutable views, retained owners and guarded Metal admission passed")

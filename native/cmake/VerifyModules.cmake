include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
foreach(TYPE IN LISTS TYPES)
  set(FOLDER "${OUTPUT_DIR}/${TYPE}")
  file(MAKE_DIRECTORY "${FOLDER}")
  file(WRITE "${FOLDER}/base.k" "export fn explode(value:int):\n  1/value\nexport fn make()->Tensor[${TYPE},1,2,2]:\n  tensor([[[${TYPE}(1),${TYPE}(2)],[${TYPE}(3),${TYPE}(4)]]])\nexport fn twice(value:${TYPE}):\n  value*2\n")
  file(WRITE "${FOLDER}/left.k" "from \"./base.k\" import twice\nfn helper(value:${TYPE}):\n  value+1\nexport fn process(values:Tensor[${TYPE},?,?,?]):\n  map(array(values),fn(x):twice(x)+helper(${TYPE}(0))-1)\n")
  file(WRITE "${FOLDER}/right.k" "from \"./base.k\" import twice\nfn helper(value:${TYPE}):\n  value+100\nexport fn unchanged(values:[${TYPE}]):\n  map(values,fn(x):helper(x)-100)\n")
  # Import paths are relative to each source file, not the process working directory.
  set(SOURCE "from \"./${TYPE}/base.k\" import make, twice, explode\nfrom \"./${TYPE}/left.k\" import process as run\nfrom \"./${TYPE}/right.k\" import unchanged\nfn inner(values:Tensor[${TYPE},?,?,?]) ! TaskError:\n  try parallel:\n    work=spawn run(values)\n    first=try await work\n    again=try await work\n    again\nfn bad(value:int):\n  array(make()+${TYPE}(explode(value)))\nfn faultProbe()->[${TYPE}] ! TaskError:\n  try parallel:\n    work=spawn bad(0)\n    try await work\nfn emptyProbe()->[${TYPE}] ! TaskError:\n  values:Tensor[${TYPE},2,0,3]=tensor([],[2,0,3])\n  try parallel:\n    work=spawn run(values)\n    try await work\nfn probe()->[${TYPE}] ! TaskError:\n  original=make()\n  attempt=faultProbe()\n  recovered=attempt catch fn(error): map(array(original),twice)\n  try parallel:\n    nested=spawn inner(original)\n    direct=spawn run(original)\n    other=spawn unchanged(recovered)\n    a=try await nested\n    b=try await direct\n    again=try await direct\n    c=try await other\n    map(a,fn(x):x+b[0]+again[0]+c[0]-6)\nfn main()->${TYPE} ! TaskError:\n  result=try probe()\n  reduceSum(tensor(result))\n")
  if(TYPE STREQUAL "float32")
    set(DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "float64")
    set(DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "int64")
    set(DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "uint64")
    set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "uint32")
    set(DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(DEFINES)
  endif()
  foreach(KIND IN ITEMS probe emptyProbe faultProbe)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      -DTENSOR_RANK=1 -DCONVERSION_RESULT=1 -DARRAY_RESULT=1 ${DEFINES}
      "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  RUN_OK("${CHECKER}" "${OUTPUT_DIR}/probe-${TYPE}.k")
  EXPECT("probe-${TYPE}" 20)
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    RUN_OK("${OUTPUT_DIR}/emptyProbe-${TYPE}-harness" "${WORKERS}" 4 0)
    RUN_OK("${OUTPUT_DIR}/faultProbe-${TYPE}-harness" "${WORKERS}" 7 0)
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
      if(WORKERS EQUAL 2)
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
          "${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3)
      endif()
    endforeach()
  endforeach()
endforeach()
file(WRITE "${OUTPUT_DIR}/predicate.k" "export fn positive(value:int)->Bool:\n  value>0\n")
COMPILE(imported-bool "from \"./predicate.k\" import positive as predicate\nfn main() ! TaskError:\n  try parallel:\n    work=spawn predicate(42)\n    try await work\n")
EXPECT(imported-bool true)
file(WRITE "${OUTPUT_DIR}/shape-contract.k" "export fn square(values:Tensor[int,?,?]):\n  reshape(values,[2,2])\n")
COMPILE(imported-shape "from \"./shape-contract.k\" import square\nfn main():\n  reduceSum(square(tensor([[1,2,3]])))\n")
execute_process(COMMAND "${OUTPUT_DIR}/imported-shape" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT ERR MATCHES "ShapeFault.*2:3")
  message(FATAL_ERROR "Imported shape guard lost original location: ${STATUS}: ${ERR}")
endif()
# A module cannot see a caller's helper, and duplicate private names remain local.
file(WRITE "${OUTPUT_DIR}/private.k" "fn helper(x:int):\n  x+1\nexport fn run(x:int):\n  helper(x)\nfn main():\n  999\n")
COMPILE(isolation "from \"./private.k\" import run as imported\nfn helper(x:int):\n  x+100\nfn main():\n  imported(3)+helper(3)\n")
EXPECT(isolation 107)
file(WRITE "${OUTPUT_DIR}/private.k" "fn helper(x:int):\n  x+2\nexport fn run(x:int):\n  helper(x)\nfn main():\n  999\n")
COMPILE(refreshed "from \"./private.k\" import run as imported\nfn helper(x:int):\n  x+100\nfn main():\n  imported(3)+helper(3)\n")
EXPECT(refreshed 108)
EXPECT(isolation 107)
# Runtime locations retain the dependency's line and column, not concatenated offsets.
file(WRITE "${OUTPUT_DIR}/fault.k" "export fn failHere(value:int):\n  1/value\n")
COMPILE(origin "from \"./fault.k\" import failHere\nfn main():\n  failHere(0)\n")
execute_process(COMMAND "${OUTPUT_DIR}/origin" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT ERR MATCHES "ArithmeticFault.*2:3")
  message(FATAL_ERROR "Imported runtime fault lost original line/column: ${STATUS}: ${ERR}")
endif()
# Outputs must never replace imported files, directly or through filesystem aliases.
file(READ "${OUTPUT_DIR}/private.k" PRIVATE_BEFORE)
foreach(KIND IN ITEMS direct hardlink symlink llvm mlir)
  set(DEST "${OUTPUT_DIR}/private.k")
  if(KIND STREQUAL "hardlink" OR KIND STREQUAL "symlink")
    set(DEST "${OUTPUT_DIR}/private-${KIND}.k")
    file(REMOVE "${DEST}")
    if(KIND STREQUAL "symlink")
      file(CREATE_LINK "${OUTPUT_DIR}/private.k" "${DEST}" SYMBOLIC)
    else()
      file(CREATE_LINK "${OUTPUT_DIR}/private.k" "${DEST}")
    endif()
  endif()
  set(ARGS -o "${DEST}")
  if(KIND STREQUAL "llvm")
    set(ARGS -o "${OUTPUT_DIR}/preserved" --emit-llvm "${DEST}")
  elseif(KIND STREQUAL "mlir")
    set(ARGS -o "${OUTPUT_DIR}/preserved" --emit-mlir "${DEST}")
  endif()
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/isolation.k" ${ARGS} RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/private.k" PRIVATE_AFTER)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 2 OR NOT ERR MATCHES "module source and output paths must be distinct" OR NOT PRIVATE_AFTER STREQUAL PRIVATE_BEFORE OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Imported source output protection failed: ${KIND}: ${STATUS}: ${ERR}")
  endif()
endforeach()
# Failed graph/semantic checks preserve all requested published artifacts.
foreach(KIND IN ITEMS private cycle missing type dependency)
  if(KIND STREQUAL "private")
    set(SOURCE "from \"./private.k\" import helper\nfn main():\n  helper(1)\n")
    set(CODE S067)
  elseif(KIND STREQUAL "cycle")
    file(WRITE "${OUTPUT_DIR}/cycle.k" "from \"./invalid-cycle.k\" import main\nexport fn other():\n  1\n")
    set(SOURCE "from \"./cycle.k\" import other\nexport fn main():\n  1\n")
    set(CODE M003)
  elseif(KIND STREQUAL "missing")
    set(SOURCE "from \"./absent.k\" import other\nfn main():\n  1\n")
    set(CODE M002)
  elseif(KIND STREQUAL "dependency")
    file(WRITE "${OUTPUT_DIR}/broken.k" "export fn broken(value:int):\n  missing(value)\n")
    set(SOURCE "from \"./broken.k\" import broken\nfn main():\n  broken(1)\n")
    set(CODE "broken.k:2:3: error\\[S031\\]")
  else()
    set(SOURCE "from \"./private.k\" import run\nfn main():\n  run(float32(1))\n")
    set(CODE S010)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${KIND}.k" "${SOURCE}")
  foreach(EXT IN ITEMS bin ll mlir)
    file(WRITE "${OUTPUT_DIR}/preserved.${EXT}" "preserved ${EXT}")
  endforeach()
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${KIND}.k" -o "${OUTPUT_DIR}/preserved.bin"
    --emit-llvm "${OUTPUT_DIR}/preserved.ll" --emit-mlir "${OUTPUT_DIR}/preserved.mlir" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}")
    message(FATAL_ERROR "Module diagnostic failed: ${KIND}: ${STATUS}: ${ERR}")
  endif()
  foreach(EXT IN ITEMS bin ll mlir)
    file(READ "${OUTPUT_DIR}/preserved.${EXT}" AFTER)
    if(NOT AFTER STREQUAL "preserved ${EXT}")
      message(FATAL_ERROR "Failed module build replaced ${EXT}")
    endif()
  endforeach()
endforeach()
message(STATUS "Modules: six-type reusable CPU helpers, alias/diamond/scoped callbacks, direct/nested workers, retained array outputs, original fault locations, source protection and failed-build artifact preservation passed")

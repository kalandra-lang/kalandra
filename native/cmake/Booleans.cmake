foreach(VARIANT IN ITEMS debug sanitized thread-sanitized)
  add_library(kalandra-bool-entry-${VARIANT} STATIC runtime/BoolEntry.cpp)
  target_compile_options(kalandra-bool-entry-${VARIANT} PRIVATE -Wall -Wextra -Werror)
  if(VARIANT STREQUAL "sanitized")
    target_compile_options(kalandra-bool-entry-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
  elseif(VARIANT STREQUAL "thread-sanitized")
    target_compile_options(kalandra-bool-entry-${VARIANT} PRIVATE -fsanitize=thread -fno-omit-frame-pointer)
  endif()
endforeach()
target_compile_definitions(kalandra PRIVATE
  KALANDRA_BOOL_ENTRY="$<TARGET_FILE:kalandra-bool-entry-debug>"
  KALANDRA_BOOL_SANITIZED_ENTRY="$<TARGET_FILE:kalandra-bool-entry-sanitized>"
  KALANDRA_BOOL_THREAD_SANITIZED_ENTRY="$<TARGET_FILE:kalandra-bool-entry-thread-sanitized>")
kalandra_compiler_runtimes(kalandra-bool-entry-debug kalandra-bool-entry-sanitized kalandra-bool-entry-thread-sanitized)
if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-boolean-tests-${VARIANT} tests/BooleanTests.cpp)
    target_compile_options(kalandra-boolean-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-boolean-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-boolean-tests-${VARIANT} PRIVATE KALANDRA_BOOLEAN_FRONTEND_ONLY)
      target_compile_options(kalandra-boolean-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-boolean-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-boolean-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-booleans-frontend-${VARIANT} COMMAND kalandra-boolean-tests-${VARIANT})
    set_tests_properties(native-booleans-frontend-${VARIANT} PROPERTIES TIMEOUT 120)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(BOOLEAN_RUNTIME "$<TARGET_FILE:kalandra-native-runtime-sanitized>")
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(BOOLEAN_RUNTIME "$<TARGET_FILE:kalandra-native-runtime-thread-sanitized>")
    else()
      set(BOOLEAN_RUNTIME "$<TARGET_FILE:kalandra-native-runtime>")
    endif()
    add_test(NAME native-booleans-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DCLANGXX=${CMAKE_CXX_COMPILER}"
        "-DLLVM_ROOT=${KALANDRA_LLVM_ROOT}" "-DRUNTIME=${BOOLEAN_RUNTIME}" "-DVARIANT=${VARIANT}"
        "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/booleans-${VARIANT}" "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyBooleans.cmake")
    set_tests_properties(native-booleans-${VARIANT} PROPERTIES TIMEOUT 900)
  endforeach()
endif()

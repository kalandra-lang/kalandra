if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-bool-array-tests-${VARIANT} tests/BoolArrayTests.cpp)
    target_compile_options(kalandra-bool-array-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-bool-array-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-bool-array-tests-${VARIANT} PRIVATE KALANDRA_BOOL_ARRAY_FRONTEND_ONLY)
      target_compile_options(kalandra-bool-array-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-bool-array-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-bool-array-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-bool-arrays-frontend-${VARIANT} COMMAND kalandra-bool-array-tests-${VARIANT})
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(BA_RUNTIME kalandra-native-runtime-sanitized)
      set(BA_FLAGS -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(BA_RUNTIME kalandra-native-runtime-thread-sanitized)
      set(BA_FLAGS -O1 -g -fsanitize=thread -fno-omit-frame-pointer)
    else()
      set(BA_RUNTIME kalandra-native-runtime)
      set(BA_FLAGS -O0)
      if(VARIANT STREQUAL "optimized")
        set(BA_FLAGS -O2)
      endif()
    endif()
    add_executable(kalandra-bool-array-storage-${VARIANT} tests/BoolArrayRuntimeTests.cpp)
    target_include_directories(kalandra-bool-array-storage-${VARIANT} PRIVATE include)
    target_compile_options(kalandra-bool-array-storage-${VARIANT} PRIVATE -Wall -Wextra -Werror ${BA_FLAGS})
    target_link_options(kalandra-bool-array-storage-${VARIANT} PRIVATE ${BA_FLAGS})
    target_link_libraries(kalandra-bool-array-storage-${VARIANT} PRIVATE ${BA_RUNTIME})
    add_test(NAME native-bool-array-storage-${VARIANT} COMMAND kalandra-bool-array-storage-${VARIANT})
    add_test(NAME native-bool-arrays-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DVARIANT=${VARIANT}"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=$<TARGET_FILE:${BA_RUNTIME}>"
        "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/bool-arrays-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyBoolArrays.cmake")
    set_tests_properties(native-bool-arrays-${VARIANT} PROPERTIES TIMEOUT 900)
  endforeach()
endif()

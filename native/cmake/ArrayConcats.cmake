if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-array-concat-tests-${VARIANT} tests/ArrayConcatTests.cpp)
    target_compile_options(kalandra-array-concat-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-array-concat-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-array-concat-tests-${VARIANT} PRIVATE KALANDRA_ARRAY_CONCAT_FRONTEND_ONLY)
      target_compile_options(kalandra-array-concat-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-array-concat-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-array-concat-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-array-concats-frontend-${VARIANT} COMMAND kalandra-array-concat-tests-${VARIANT})
    set_tests_properties(native-array-concats-frontend-${VARIANT} PROPERTIES TIMEOUT 90)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(CONCAT_RUNTIME kalandra-native-runtime-sanitized)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(CONCAT_RUNTIME kalandra-native-runtime-thread-sanitized)
    else()
      set(CONCAT_RUNTIME kalandra-native-runtime)
    endif()
    add_test(NAME native-array-concats-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DCHECKER=$<TARGET_FILE:kalandra-check>" "-DVARIANT=${VARIANT}"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=$<TARGET_FILE:${CONCAT_RUNTIME}>"
        "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/array-concats-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyArrayConcats.cmake")
    set_tests_properties(native-array-concats-${VARIANT} PROPERTIES TIMEOUT 300)
  endforeach()
endif()

if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-nested-record-tests-${VARIANT} tests/NestedRecordTests.cpp)
    target_compile_options(kalandra-nested-record-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-nested-record-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-nested-record-tests-${VARIANT} PRIVATE KALANDRA_RECORD_FRONTEND_ONLY)
      target_compile_options(kalandra-nested-record-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-nested-record-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-nested-record-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-nested-records-frontend-${VARIANT} COMMAND kalandra-nested-record-tests-${VARIANT})
    set_tests_properties(native-nested-records-frontend-${VARIANT} PROPERTIES TIMEOUT 120)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(RECORD_RUNTIME "$<TARGET_FILE:kalandra-native-runtime-sanitized>")
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(RECORD_RUNTIME "$<TARGET_FILE:kalandra-native-runtime-thread-sanitized>")
    else()
      set(RECORD_RUNTIME "$<TARGET_FILE:kalandra-native-runtime>")
    endif()
    add_test(NAME native-nested-records-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DCHECKER=$<TARGET_FILE:kalandra-check>"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=${RECORD_RUNTIME}" "-DVARIANT=${VARIANT}"
        "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/nested-records-${VARIANT}" "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyNestedRecords.cmake")
    set_tests_properties(native-nested-records-${VARIANT} PROPERTIES TIMEOUT 900)
  endforeach()
endif()

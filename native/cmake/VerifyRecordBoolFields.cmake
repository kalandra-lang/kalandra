include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(DECL "type Box:\n  data:Data\n  duplicate:[Bool]\n  values:[int]\ntype Data:\n  flags:[Bool]\n  enabled:Bool\n")
set(MAKE "fn make()->Box:\n  flags=[true,false,true]\n  Box {data:Data {flags:flags,enabled:true},duplicate:flags,values:[1,2,3]}\n")
set(HELPERS "fn change(box:Box)->Box:\n  box with {data:box.data with {flags:map(box.data.flags,fn(flag):not flag)}}\nfn echo(box:Box)->Box:\n  box\nfn child(box:Box)->Box ! TaskError:\n  try parallel:\n    work=spawn change(box)\n    first=try await work\n    again=try await work\n    again\n")
COMPILE(sync "${DECL}${MAKE}${HELPERS}fn main()->[Bool]:\n  original=make()\n  changed=change(original)\n  [original.data.flags[0],changed.data.flags[0],changed.duplicate[0]]\n")
EXPECT(sync "[true, false, true]")
COMPILE(worker "${DECL}${MAKE}${HELPERS}fn main()->[Bool] ! TaskError:\n  original=make()\n  changed=try child(original)\n  [original.data.flags[0],changed.data.flags[0],changed.duplicate[0]]\n")
EXPECT(worker "[true, false, true]")
COMPILE(empty "${DECL}${HELPERS}fn main()->[Bool] ! TaskError:\n  result=try parallel:\n    try await spawn echo(Box {data:Data {flags:[],enabled:false},duplicate:[],values:[]})\n  result.data.flags\n")
EXPECT(empty "[]")
COMPILE(length "${DECL}${MAKE}${HELPERS}fn choose(flag:Bool)->Box:\n  if flag: make()\n  else: Box {data:Data {flags:[],enabled:false},duplicate:[],values:[]}\nfn main()->int:\n  length(choose(true).data.flags)+length(choose(false).data.flags)\n")
EXPECT(length 3)
COMPILE(record-array "${DECL}${MAKE}${HELPERS}fn rows()->[Box]:\n  [make(),Box {data:Data {flags:[false],enabled:true},duplicate:[],values:[4]}]\nfn apply(input:[Box])->[Box]:\n  map(input,change)\nfn main()->[Bool] ! TaskError:\n  values=try parallel:\n    work=spawn apply(rows())\n    first=try await work\n    again=try await work\n    again\n  map(values,fn(box):box.data.flags[0])\n")
EXPECT(record-array "[false, true]")
COMPILE(capture "${DECL}${MAKE}${HELPERS}fn keep(value:int,flag:Bool)->int:\n  if flag: value\n  else: 0\nfn main()->[int] ! TaskError:\n  box=try parallel:\n    try await spawn echo(make())\n  try parallel:\n    try await spawn map([0,1,2],fn(i):keep(box.values[i],box.data.flags[i]))\n")
EXPECT(capture "[1, 0, 3]")
COMPILE(nested-capture "${DECL}${MAKE}${HELPERS}fn main()->[Bool] ! TaskError:\n  box=make()\n  try parallel:\n    try await spawn map([0,1,2],fn(i):map(box.data.flags,fn(flag):flag and box.duplicate[i])[i])\n")
EXPECT(nested-capture "[true, false, true]")
COMPILE(recovery "${DECL}${MAKE}${HELPERS}fn bad(box:Box,i:int)->Box:\n  box with {data:box.data with {flags:[box.data.flags[i]]}}\nfn attempt()->Box ! TaskError:\n  try parallel:\n    try await spawn bad(make(),9)\nfn main()->[Bool]:\n  result=attempt() catch fn(error): Box {data:Data {flags:[false,true],enabled:true},duplicate:[],values:[]}\n  result.data.flags\n")
EXPECT(recovery "[false, true]")
COMPILE(fault "${DECL}${MAKE}${HELPERS}fn bad(box:Box,i:int)->Bool:\n  box.data.flags[i]\nfn main()->Bool:\n  bad(make(),9)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/fault"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "BoundsFault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
  message(FATAL_ERROR "Bool field bounds fault published output or leaked: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(TYPE IN ITEMS int32 uint32 int64 uint64 float32 float64)
  set(MIXED "type Mixed:\n  flags:[Bool]\n  values:[${TYPE}]\n  matrix:Tensor[${TYPE},1,2]\nfn make()->Mixed:\n  Mixed {flags:[true,false],values:[2,3],matrix:tensor([[4,5]])}\nfn choose(value:${TYPE},flag:Bool)->${TYPE}:\n  if flag:value\n  else:0\nfn selected(p:Mixed)->[${TYPE}]:\n  map([0,1],fn(i):choose(p.values[i]+p.matrix[0,i],p.flags[i]))\n")
  COMPILE("mixed-${TYPE}" "${MIXED}fn main()->[${TYPE}] ! TaskError:\n  try parallel:\n    try await spawn selected(make())\n")
  EXPECT("mixed-${TYPE}" "[6, 0]")
endforeach()
set(RAW "type Envelope:\n  data:Data\n  duplicate:[Bool]\n  numbers:[int64]\ntype Data:\n  flags:[Bool]\n  enabled:Bool\nfn identity(p:Envelope)->Envelope:\n  p with {data:p.data with {flags:p.data.flags},duplicate:p.duplicate}\nfn child(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    work=spawn identity(p)\n    first=try await work\n    again=try await work\n    again\nfn probe(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    work=spawn child(p)\n    first=try await work\n    again=try await work\n    again\nfn main()->int:\n  0\n")
COMPILE(raw "${RAW}" --test-entry probe)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/RecordBoolFieldsWorkerTests.cpp" "${OUTPUT_DIR}/raw.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/raw-harness")
foreach(WORKERS IN ITEMS 1 4)
  foreach(MODE IN ITEMS 0 1 2 4 5 6 7 8)
    RUN_OK("${OUTPUT_DIR}/raw-harness" "${WORKERS}" "${MODE}" 0)
  endforeach()
  foreach(FAIL_AT RANGE 1 24)
    RUN_OK("${OUTPUT_DIR}/raw-harness" "${WORKERS}" 3 "${FAIL_AT}")
  endforeach()
endforeach()
file(WRITE "${OUTPUT_DIR}/library.k" "type Box:\n  flags:[Bool]\nexport fn make()->Box:\n  Box {flags:[true,false]}\nexport fn flip(box:Box)->Box:\n  box with {flags:map(box.flags,fn(flag):not flag)}\n")
COMPILE(modules "from \"./library.k\" import make,flip\nfn main()->[Bool] ! TaskError:\n  result=try parallel:\n    try await spawn flip(make())\n  result.flags\n")
EXPECT(modules "[false, true]")
foreach(NAME IN ITEMS sync worker record-array capture nested-capture)
  foreach(FAIL_AT RANGE 1 24)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}" "${OUTPUT_DIR}/${NAME}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(STATUS EQUAL 0)
      if(NAME STREQUAL "record-array")
        set(EXPECTED "[false, true]\n")
      elseif(NAME STREQUAL "capture")
        set(EXPECTED "[1, 0, 3]\n")
      elseif(NAME STREQUAL "nested-capture")
        set(EXPECTED "[true, false, true]\n")
      else()
        set(EXPECTED "[true, false, true]\n")
      endif()
      if(NOT OUT STREQUAL EXPECTED)
        message(FATAL_ERROR "Bool field allocation sweep changed result: ${OUT}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Bool field allocation failure published output or leaked: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Bool field sanitizer failure: ${ERR}")
    endif()
  endforeach()
endforeach()
foreach(NAME IN ITEMS tensor mixed record-array)
  if(NAME STREQUAL "tensor")
    set(SOURCE "type Bad:\n  values:Tensor[Bool,2]\nfn main():\n  0\n")
  elseif(NAME STREQUAL "mixed")
    set(SOURCE "type Bad:\n  values:[Bool]\nfn main():\n  Bad {values:[1]}\n")
  else()
    set(SOURCE "type Bad:\n  values:[Bad]\nfn main():\n  Bad {values:[true]}\n")
  endif()
  file(WRITE "${OUTPUT_DIR}/reject-${NAME}.k" "${SOURCE}")
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(WRITE "${OUTPUT_DIR}/reject-${NAME}.${SUFFIX}" "preserve-${SUFFIX}")
  endforeach()
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/reject-${NAME}.k" -o "${OUTPUT_DIR}/reject-${NAME}.exe"
    --emit-llvm "${OUTPUT_DIR}/reject-${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/reject-${NAME}.mlir"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "error\\[S[0-9]+\\]")
    message(FATAL_ERROR "Invalid Bool field program not rejected: ${STATUS}: ${OUT}${ERR}")
  endif()
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(READ "${OUTPUT_DIR}/reject-${NAME}.${SUFFIX}" CONTENT)
    if(NOT CONTENT STREQUAL "preserve-${SUFFIX}")
      message(FATAL_ERROR "Rejected Bool field program replaced ${SUFFIX}")
    endif()
  endforeach()
endforeach()
message(STATUS "Record Bool fields: nested records, updates, record arrays, callbacks, six mixed numeric types, retained workers and failure cleanup passed")
file(READ "${SOURCE_DIR}/../docs/design/record-bool-fields.md" GUIDE)
string(REGEX MATCH "```kalandra\n([^`]+)```" DOCUMENTATION "${GUIDE}")
if(NOT DOCUMENTATION)
  message(FATAL_ERROR "Record Bool-field documentation example missing")
endif()
COMPILE(documentation "${CMAKE_MATCH_1}")
EXPECT(documentation "[false, true, false]")

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
file(WRITE "${OUTPUT_DIR}/math.k" "export fn twice(value:int)->int:\n  value*2\n")
COMPILE(main "from \"./math.k\" import twice\nfn main()->int:\n  twice(3)+1\n")
EXPECT(main 7)
RUN_OK("${CHECKER}" "${OUTPUT_DIR}/main.k")
RUN_OK("${PARSER}" "${OUTPUT_DIR}/main.k")
file(WRITE "${OUTPUT_DIR}/old.kalandra" "fn main()->int:\n  0\n")
foreach(TOOL IN ITEMS COMPILER CHECKER PARSER)
  if(TOOL STREQUAL "COMPILER")
    set(OPTIONS -o "${OUTPUT_DIR}/preserved.exe" --emit-llvm "${OUTPUT_DIR}/preserved.ll" --emit-mlir "${OUTPUT_DIR}/preserved.mlir")
  else()
    set(OPTIONS)
  endif()
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(WRITE "${OUTPUT_DIR}/preserved.${SUFFIX}" "preserve-${SUFFIX}")
  endforeach()
  execute_process(COMMAND "${${TOOL}}" "${OUTPUT_DIR}/old.kalandra" ${OPTIONS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "source files must use the .k extension")
    message(FATAL_ERROR "${TOOL} accepted retired extension: ${STATUS}: ${OUT}${ERR}")
  endif()
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(READ "${OUTPUT_DIR}/preserved.${SUFFIX}" CONTENT)
    if(NOT CONTENT STREQUAL "preserve-${SUFFIX}")
      message(FATAL_ERROR "Invalid extension changed ${SUFFIX}")
    endif()
  endforeach()
endforeach()
file(WRITE "${OUTPUT_DIR}/old-import.k" "from \"./old.kalandra\" import main\nfn main():\n  0\n")
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/old-import.k" -o "${OUTPUT_DIR}/preserved.exe"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "M001")
  message(FATAL_ERROR "Retired import extension accepted: ${STATUS}: ${OUT}${ERR}")
endif()
file(READ "${OUTPUT_DIR}/preserved.exe" CONTENT)
if(NOT CONTENT STREQUAL "preserve-exe")
  message(FATAL_ERROR "Invalid import changed output")
endif()
message(STATUS ".k sources/imports accepted; retired root/import extensions rejected by compiler/checker/parser; existing outputs preserved")

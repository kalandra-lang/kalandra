include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
COMPILE(choose "fn choose(flag:bool)->[f64]:\n  return if flag:\n    [-0.0,1.0000000000000002]\n  else:\n    [4.9406564584124654e-324,1.7976931348623157e308,0.0]\nfn main()->i64:\n  return 0\n" --test-entry choose)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -isystem "${LLVM_ROOT}/include"
  "${SOURCE_DIR}/tests/ControlTensorRuntimeTests.cpp" "${OUTPUT_DIR}/choose.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/choose-harness")
RUN_OK("${OUTPUT_DIR}/choose-harness")
foreach(TYPE IN ITEMS i32 u32 i64 u64 f32 f64)
  if(TYPE STREQUAL "f32")
    set(DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "f64")
    set(DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "i64")
    set(DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "u64")
    set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "u32")
    set(DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(DEFINES)
  endif()
  set(SOURCE "fn failing(value:i64)->i64:\n  return 1/value\nfn make(seed:${TYPE}):\n  return [seed,seed*2,seed*3,seed*4]\nfn both(value:[${TYPE}],matrix:Tensor[${TYPE},?]):\n  return value\nfn clone(value:[${TYPE}])->[${TYPE}]:\n  return value\nfn inner(value:[${TYPE}]) ! TaskError:\n  return try parallel:\n    work=spawn clone(value)\n    first=try await work\n    again=try await work\n    again\nfn faultProbe()->[${TYPE}] ! TaskError:\n  return try parallel:\n    work=spawn failing(0)\n    try await work\n    []\nfn empty()->[${TYPE}]:\n  return []\nfn emptyProbe()->[${TYPE}] ! TaskError:\n  value=empty()\n  return try parallel:\n    work=spawn inner(value)\n    try await work\nfn probe() ! TaskError:\n  value=make(${TYPE}(2))\n  attempted=faultProbe()\n  recovered=attempted catch fn(error): return value\n  return try parallel:\n    left=spawn inner(recovered)\n    matrix:Tensor[${TYPE},4]=tensor([2,4,6,8])\n    right=spawn both(value,matrix)\n    a=try await left\n    b=try await right\n    again=try await right\n    again\nfn main()->i64 ! TaskError:\n  result=try probe()\n  return 7\n")
  foreach(KIND IN ITEMS probe emptyProbe faultProbe)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -DTENSOR_RANK=1 -DARRAY_RESULT=1 -DCONVERSION_RESULT=1 ${DEFINES}
      "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  EXPECT("probe-${TYPE}" 7)
  file(READ "${OUTPUT_DIR}/probe-${TYPE}.ll" IR)
  string(REGEX REPLACE "^i" "int" STORAGE_TYPE "${TYPE}")
  string(REGEX REPLACE "^u" "uint" STORAGE_TYPE "${STORAGE_TYPE}")
  string(REGEX REPLACE "^f" "float" STORAGE_TYPE "${STORAGE_TYPE}")
  if(NOT IR MATCHES "value.layout.array.${STORAGE_TYPE}" OR NOT IR MATCHES "value.layout.(tensor|tensor[.]${STORAGE_TYPE})")
    message(FATAL_ERROR "Array and tensor worker layouts lost their distinct source categories")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    RUN_OK("${OUTPUT_DIR}/emptyProbe-${TYPE}-harness" "${WORKERS}" 4 0)
    RUN_OK("${OUTPUT_DIR}/faultProbe-${TYPE}-harness" "${WORKERS}" 7 0)
    foreach(ATTEMPT RANGE 1 12)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
    endforeach()
  endforeach()
endforeach()
foreach(ORDER IN ITEMS first second)
  if(ORDER STREQUAL "first")
    set(LEAVES "first(0),second(0)")
    set(LINE 2)
  else()
    set(LEAVES "second(0),first(0)")
    set(LINE 4)
  endif()
  COMPILE("fault-${ORDER}" "fn first(value:i64)->i64:\n  return 1/value\nfn second(value:i64)->i64:\n  return 2/value\nfn main()->i64:\n  values=[${LEAVES}]\n  return 7\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/fault-${ORDER}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source ${LINE}:10" OR NOT ERR MATCHES "cleanup: live=0")
    message(FATAL_ERROR "Array evaluation order or cleanup failed: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
foreach(NAME IN ITEMS mixed empty category)
  if(NAME STREQUAL "mixed")
    set(BODY "return [1,2.5]")
    set(CODE S010)
  elseif(NAME STREQUAL "empty")
    set(BODY "return []")
    set(CODE S058)
  else()
    set(BODY "a=[1,2]\n  return reduceSum(a)")
    set(CODE S028)
  endif()
  file(WRITE "${OUTPUT_DIR}/invalid-${NAME}.k" "fn main():\n  ${BODY}\n")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/invalid-${NAME}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "${CODE}" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Array diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
message(STATUS "Immutable CPU arrays: exact data, dynamic lengths, six worker families, tensor layout separation, empty results, cached ownership and ordered faults passed")

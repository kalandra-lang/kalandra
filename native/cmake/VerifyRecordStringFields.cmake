include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(DECL "type Envelope:\n  data:Data\n  duplicate:String\n  numbers:[int64]\ntype Data:\n  text:String\n  enabled:Bool\n")
set(MAKE "fn make()->Envelope:\n  text=\"é👩\"\n  Envelope {data:Data {text:text,enabled:true},duplicate:text,numbers:[1,2,3]}\n")
set(HELPERS "fn change(p:Envelope)->Envelope:\n  p with {data:p.data with {text:p.data.text+\"!\"}}\nfn identity(p:Envelope)->Envelope:\n  p with {data:p.data with {text:p.data.text},duplicate:p.duplicate}\nfn child(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    work=spawn identity(p)\n    first=try await work\n    again=try await work\n    again\nfn probe(p:Envelope)->Envelope ! TaskError:\n  try parallel:\n    work=spawn child(p)\n    first=try await work\n    again=try await work\n    again\n")
COMPILE(sync "${DECL}${MAKE}${HELPERS}fn main()->String:\n  original=make()\n  changed=change(original)\n  original.data.text+\"/\"+changed.data.text+\"/\"+changed.duplicate\n")
EXPECT(sync "é👩/é👩!/é👩")
COMPILE(worker "${DECL}${MAKE}${HELPERS}fn main()->String ! TaskError:\n  original=make()\n  changed=try parallel:\n    try await spawn change(original)\n  original.data.text+\"/\"+changed.data.text+\"/\"+changed.duplicate\n")
EXPECT(worker "é👩/é👩!/é👩")
COMPILE(string-only "type Text:\n  value:String\nfn echo(p:Text)->Text:\n  p\nfn nested(p:Text)->Text ! TaskError:\n  try parallel:\n    work=spawn echo(p)\n    first=try await work\n    again=try await work\n    again\nfn main()->String ! TaskError:\n  original=Text {value:\"سلام\"}\n  moved=try nested(original)\n  moved.value\n")
EXPECT(string-only "سلام")
COMPILE(operations "${DECL}${MAKE}fn work(p:Envelope)->String:\n  text=p.data.text\n  if length(text)==2 and byteLength(text)==6 and text!=\"x\":\n    slice(text,1,2)+text[0]\n  else: \"bad\"\nfn main()->String ! TaskError:\n  try parallel:\n    try await spawn work(make())\n")
EXPECT(operations "👩é")
COMPILE(empty "${DECL}${HELPERS}fn main()->String ! TaskError:\n  moved=try probe(Envelope {data:Data {text:\"\",enabled:false},duplicate:\"\",numbers:[]})\n  moved.data.text+moved.duplicate\n")
EXPECT(empty "")
COMPILE(conditional "${DECL}${MAKE}fn choose(flag:Bool)->Envelope:\n  if flag: make()\n  else: Envelope {data:Data {text:\"no\",enabled:false},duplicate:\"\",numbers:[]}\nfn main()->String:\n  choose(true).data.text+choose(false).data.text\n")
EXPECT(conditional "é👩no")
COMPILE(record-array "${DECL}${MAKE}${HELPERS}fn rows()->[Envelope]:\n  [make(),make() with {duplicate:\"kept\"}]\nfn apply(values:[Envelope])->[Envelope]:\n  map(values,change)\nfn main()->String ! TaskError:\n  changed=try parallel:\n    work=spawn apply(rows())\n    first=try await work\n    again=try await work\n    again\n  changed[0].data.text+changed[1].duplicate\n")
EXPECT(record-array "é👩!kept")
COMPILE(capture "${DECL}${MAKE}${HELPERS}fn main()->[int64] ! TaskError:\n  p=try probe(make())\n  try parallel:\n    try await spawn map(p.numbers,fn(n):n+length(p.data.text)+length(p.duplicate))\n")
EXPECT(capture "[5, 6, 7]")
COMPILE(nested-capture "${DECL}${MAKE}${HELPERS}fn main()->[Bool] ! TaskError:\n  p=make()\n  try parallel:\n    try await spawn map([0,1],fn(i):map([true,false],fn(flag):flag and p.data.text==p.duplicate)[i])\n")
EXPECT(nested-capture "[true, false]")
COMPILE(record-map "${DECL}${MAKE}${HELPERS}fn main()->String ! TaskError:\n  p=make()\n  rows=try parallel:\n    try await spawn map([1,2],fn(n):p with {duplicate:p.data.text+\"!\"})\n  rows[0].duplicate+rows[1].data.text\n")
EXPECT(record-map "é👩!é👩")
set(FAULT "${DECL}${MAKE}fn bad(p:Envelope,index:int64)->Envelope:\n  p with {duplicate:p.data.text[index]}\nfn attempt()->Envelope ! TaskError:\n  try parallel:\n    try await spawn bad(make(),9)\n")
COMPILE(recovery "${FAULT}fn main()->String:\n  p=attempt() catch fn(error): make() with {duplicate:\"recovered\"}\n  p.duplicate\n")
EXPECT(recovery recovered)
COMPILE(rethrow "${FAULT}fn relay()->Envelope ! TaskError:\n  attempt() catch fn(error): fail error\nfn main()->String:\n  p=relay() catch fn(error): make() with {duplicate:\"recovered\"}\n  p.duplicate\n")
EXPECT(rethrow recovered)
COMPILE(diagnostic "${FAULT}${HELPERS}fn main()->String ! TaskError:\n  p=attempt() catch fn(error):\n    match error:\n      TaskError.Fault {message}: make() with {duplicate:message}\n      _: make()\n  moved=try probe(p)\n  moved.duplicate\n")
EXPECT(diagnostic "index out of bounds")
COMPILE(raw "${DECL}${HELPERS}fn main()->int:\n  0\n" --test-entry probe)
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/RecordStringFieldsWorkerTests.cpp" "${OUTPUT_DIR}/raw.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/raw-harness")
foreach(WORKERS IN ITEMS 1 4)
  foreach(MODE IN ITEMS 0 1 2 4 5 6 7 8 9 10 11)
    RUN_OK("${OUTPUT_DIR}/raw-harness" "${WORKERS}" "${MODE}" 0)
  endforeach()
  foreach(FAIL_AT RANGE 1 20)
    RUN_OK("${OUTPUT_DIR}/raw-harness" "${WORKERS}" 3 "${FAIL_AT}")
  endforeach()
endforeach()
foreach(TYPE IN ITEMS int32 uint32 int64 uint64 float32 float64)
  COMPILE("mixed-${TYPE}" "type Mixed:\n  name:String\n  flags:[Bool]\n  values:[${TYPE}]\n  matrix:Tensor[${TYPE},1,2]\nfn make()->Mixed:\n  Mixed {name:\"kept\",flags:[true,false],values:[2,3],matrix:tensor([[4,5]])}\nfn echo(p:Mixed)->Mixed:\n  p\nfn main()->[${TYPE}] ! TaskError:\n  p=try parallel:\n    try await spawn echo(make())\n  if p.name==\"kept\" and p.flags[0]:\n    [p.values[0]+p.matrix[0,0],p.values[1]+p.matrix[0,1]]\n  else: []\n")
  EXPECT("mixed-${TYPE}" "[6, 8]")
endforeach()
file(WRITE "${OUTPUT_DIR}/text.k" "type Text:\n  value:String\nexport fn make()->Text:\n  Text {value:\"سلام\"}\nexport fn append(p:Text)->Text:\n  p with {value:p.value+\"!\"}\n")
COMPILE(imports "from \"./text.k\" import make,append\nfn main()->String ! TaskError:\n  p=try parallel:\n    try await spawn append(make())\n  p.value\n")
EXPECT(imports "سلام!")
foreach(NAME IN ITEMS sync worker record-array capture record-map)
  foreach(FAIL_AT RANGE 1 24)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}"
      "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NAME STREQUAL "record-array")
      set(EXPECTED "é👩!kept\n")
    elseif(NAME STREQUAL "capture")
      set(EXPECTED "[5, 6, 7]\n")
    elseif(NAME STREQUAL "record-map")
      set(EXPECTED "é👩!é👩\n")
    else()
      set(EXPECTED "é👩/é👩!/é👩\n")
    endif()
    if(STATUS EQUAL 0)
      if(NOT OUT STREQUAL EXPECTED)
        message(FATAL_ERROR "String record allocation sweep changed result: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "String record allocation failure published or leaked: ${STATUS}: ${OUT}${ERR}")
    endif()
    if(NOT ERR STREQUAL "" AND (NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2))
      message(FATAL_ERROR "String record cleanup counters differ: ${ERR}")
    endif()
    if(ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "String record sanitizer failure: ${ERR}")
    endif()
  endforeach()
endforeach()
foreach(NAME IN ITEMS wrong-value string-array cycle)
  if(NAME STREQUAL "wrong-value")
    set(SOURCE "type Text:\n  value:String\nfn main():\n  Text {value:1}\n")
  elseif(NAME STREQUAL "string-array")
    set(SOURCE "type Text:\n  value:Tensor[String,2]\nfn main():\n  0\n")
  else()
    set(SOURCE "type Text:\n  value:String\n  next:Text\nfn main():\n  0\n")
  endif()
  file(WRITE "${OUTPUT_DIR}/reject-${NAME}.k" "${SOURCE}")
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(WRITE "${OUTPUT_DIR}/reject-${NAME}.${SUFFIX}" "preserve-${SUFFIX}")
  endforeach()
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/reject-${NAME}.k" -o "${OUTPUT_DIR}/reject-${NAME}.exe"
    --emit-llvm "${OUTPUT_DIR}/reject-${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/reject-${NAME}.mlir"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "error\\[S[0-9]+\\]")
    message(FATAL_ERROR "Invalid String record not rejected: ${STATUS}: ${OUT}${ERR}")
  endif()
  foreach(SUFFIX IN ITEMS exe ll mlir)
    file(READ "${OUTPUT_DIR}/reject-${NAME}.${SUFFIX}" CONTENT)
    if(NOT CONTENT STREQUAL "preserve-${SUFFIX}")
      message(FATAL_ERROR "Rejected String record replaced ${SUFFIX}")
    endif()
  endforeach()
endforeach()

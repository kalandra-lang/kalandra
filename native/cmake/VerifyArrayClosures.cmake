include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDENTITIES 2 6 3 7 8 9)
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDENTITIES ${INDEX} ID)
  # Preserve raw bits even for NaNs and signed zero. A captured Bool value
  # controls the branch without performing arithmetic on the returned element.
  COMPILE("identity-${TYPE}" "fn choose(value:${TYPE},flag:Bool)->${TYPE}:\n  if flag:\n    value\n  else:\n    value\nfn mapped(input:[${TYPE}]):\n  flag=true\n  map(input,fn(value): choose(value,flag))\nfn main()->int64:\n  0\n" --test-entry mapped)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} "-DNUMERIC_TYPE=${ID}" -isystem "${LLVM_ROOT}/include"
    "${SOURCE_DIR}/tests/ArrayMapRuntimeTests.cpp" "${OUTPUT_DIR}/identity-${TYPE}.ll" "${RUNTIME}" "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/identity-${TYPE}-harness")
  RUN_OK("${OUTPUT_DIR}/identity-${TYPE}-harness")
  if(TYPE STREQUAL "float32")
    set(DEFINES -DFLOAT_RESULT=1)
  elseif(TYPE STREQUAL "float64")
    set(DEFINES -DFLOAT_RESULT=64)
  elseif(TYPE STREQUAL "int64")
    set(DEFINES -DINTEGER_BITS=64)
  elseif(TYPE STREQUAL "uint64")
    set(DEFINES -DINTEGER_BITS=64 -DUNSIGNED_RESULT=1)
  elseif(TYPE STREQUAL "uint32")
    set(DEFINES -DUNSIGNED_RESULT=1)
  else()
    set(DEFINES)
  endif()
  set(SOURCE "fn failing(value:int64)->int64:\n  1/value\nfn keep(ignored:[${TYPE}],value:${TYPE})->${TYPE}:\n  value\nfn choose(value:${TYPE},flag:Bool,bias:Tensor[${TYPE},2])->${TYPE}:\n  if flag: value+reduceSum(bias)\n  else: value\nfn run(values:[${TYPE}],offset:${TYPE}):\n  extra=[${TYPE}(1),${TYPE}(2)]\n  flag=true\n  bias:Tensor[${TYPE},2]=tensor([offset,${TYPE}(0)])\n  values -> map(fn(x): keep(map(extra,fn(y): y+x+offset),choose(x,flag,bias)+x-offset))\nfn faultProbe()->[${TYPE}] ! TaskError:\n  divisor=0\n  try parallel:\n    work=spawn map([${TYPE}(1)],fn(x): keep([${TYPE}(failing(divisor))],x))\n    try await work\nfn emptyProbe()->[${TYPE}] ! TaskError:\n  divisor=0\n  try parallel:\n    work=spawn map([],fn(x:${TYPE}): keep([${TYPE}(failing(divisor))],x))\n    try await work\nfn probe() ! TaskError:\n  original=[${TYPE}(1),${TYPE}(2),${TYPE}(3),${TYPE}(4)]\n  offset=${TYPE}(10)\n  attempted=faultProbe()\n  recovered=attempted catch fn(error): original\n  try parallel:\n    left=spawn run(recovered,offset)\n    right=spawn map(original,fn(x): (x+offset)*${TYPE}(2)-offset*${TYPE}(2))\n    a=try await left\n    b=try await right\n    again=try await right\n    again\nfn main()->int64 ! TaskError:\n  result=try probe()\n  7\n")
  foreach(KIND IN ITEMS probe emptyProbe faultProbe)
    COMPILE("${KIND}-${TYPE}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS} -DTENSOR_RANK=1 -DARRAY_RESULT=1 -DCONVERSION_RESULT=1 ${DEFINES}
      "${SOURCE_DIR}/tests/Int32TensorTaskTests.cpp" "${OUTPUT_DIR}/${KIND}-${TYPE}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${KIND}-${TYPE}-harness")
  endforeach()
  EXPECT("probe-${TYPE}" 7)
  foreach(WORKERS IN ITEMS 1 2 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 "${MODE}")
    endforeach()
    RUN_OK("${OUTPUT_DIR}/emptyProbe-${TYPE}-harness" "${WORKERS}" 4 0)
    RUN_OK("${OUTPUT_DIR}/faultProbe-${TYPE}-harness" "${WORKERS}" 7 0)
    foreach(ATTEMPT RANGE 1 8)
      RUN_OK("${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3 "${ATTEMPT}")
      if(WORKERS EQUAL 2)
        RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}"
          "${OUTPUT_DIR}/probe-${TYPE}-harness" "${WORKERS}" 3 3)
      endif()
    endforeach()
  endforeach()
endforeach()
message(STATUS "Anonymous map: six numeric types, exact raw identities, lexical scalar/Bool/tensor/array captures, nested closures, direct/nested workers, empty callbacks, fault recovery, cancellation and allocation failure passed")

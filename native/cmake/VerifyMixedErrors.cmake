# Real admission rejection enters the same typed union without becoming an application error.
set(QUOTA "${TYPES}fn identity(x:i64)->i64:\n  return x\nfn work()->i64 ! Mixed:\n  result=parallel:\n")
foreach(INDEX RANGE 0 128)
  string(APPEND QUOTA "    job${INDEX}=spawn identity(1)\n")
endforeach()
foreach(INDEX RANGE 0 128)
  string(APPEND QUOTA "    try await job${INDEX}\n")
endforeach()
string(APPEND QUOTA "    0\n  return try result\nfn main()->i64:\n  return work() catch fn(error):\n    return match error:\n      TaskError.AdmissionRejected {reason}:length(reason)\n      _:0\n")

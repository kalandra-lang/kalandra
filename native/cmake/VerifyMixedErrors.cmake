  if("${STATUS}" STREQUAL "0")
    if(OUT STREQUAL "42\n")
      set(RECOVERED TRUE)
    elseif(NOT OUT STREQUAL "3\n")
      message(FATAL_ERROR "Unexpected mixed allocation recovery: ${OUT}${ERR}")
    endif()
  elseif(NOT "${STATUS}" STREQUAL "86" OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault")
    message(FATAL_ERROR "Mixed allocation fault escaped incorrectly: ${STATUS}: ${OUT}${ERR}")
  endif()
  if(NOT ERR STREQUAL "" AND (NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2))
    message(FATAL_ERROR "Mixed allocation cleanup differs: ${OUT}${ERR}")
  endif()
endforeach()

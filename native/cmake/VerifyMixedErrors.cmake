set(TYPES "error ReadError:\n  Bad:\n    reason:String\n    values:[i64]\nerror PublicError:\n  Unavailable\ntype Mixed=ReadError | TaskError\ntype All=PublicError | Mixed\ntype Only=TaskError | TaskError\n")
set(LEGACY "fn divide(x:i64)->i64:\n  return 1/x\nfn legacy(x:i64)->i64 ! Only:\n  return try parallel:\n    try await spawn divide(x)\n")
set(WORK "fn work(mode:i64)->i64 ! Mixed:\n  if mode==0:fail ReadError.Bad {reason:\"é\"+\"🙂\",values:[20,22]}\n  return try legacy(mode-1)\n")

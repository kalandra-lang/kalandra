include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES i16 u16)
set(IDS 1 5)
set(OPS add sub mul div rem neg eq ne lt le gt ge)
set(SIGNS + - * / % - == != < <= > >=)
foreach(N RANGE 0 1)
  list(GET TYPES ${N} TYPE)
  list(GET IDS ${N} ID)
  foreach(I RANGE 0 11)
    list(GET OPS ${I} OP)
    list(GET SIGNS ${I} SIGN)
    set(RESULT "${TYPE}")
    set(DEFINITION)
    set(EXPR "a ${SIGN} b")
    if(OP STREQUAL "neg")
      set(EXPR "-a")
    endif()
    if(I GREATER_EQUAL 6)
      set(RESULT bool)
      set(DEFINITION -DCOMPARISON)
    endif()
    COMPILE("${TYPE}-${OP}" "fn operation(a:${TYPE},b:${TYPE})->${RESULT}:\n  return ${EXPR}\nfn main()->i64:\n  return 0\n" --test-entry operation)
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "-DUNSIGNED_VALUE=${N}" -DINTEGER_BITS=16 ${DEFINITION} "${SOURCE_DIR}/tests/Int8RuntimeTests.cpp"
      "${OUTPUT_DIR}/${TYPE}-${OP}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${TYPE}-${OP}-harness")
    RUN_OK("${OUTPUT_DIR}/${TYPE}-${OP}-harness" "${OP}")
  endforeach()
  set(SOURCE "fn bad(x:${TYPE})->${TYPE}:\n  x+1\nfn step(x:${TYPE})->${TYPE}:\n  x+1\nfn fp(x:f32)->f32:\n  x*2\nfn child(x:${TYPE})->${TYPE} ! TaskError:\n  try parallel:\n    work=spawn step(x)\n    first=try await work\n    again=try await work\n    again\nfn probe()->${TYPE} ! TaskError:\n  try parallel:\n    literal:${TYPE}=41\n    work=spawn child(literal)\n    f=spawn fp(1.5)\n    a=try await work\n    b=try await work\n    value=try await f\n    if value==3:a\n    else:b\nfn faultProbe()->${TYPE} ! TaskError:\n  try parallel:\n    try await spawn bad(${TYPE}(${N}*32768+32767))\nfn recover()->${TYPE}:\n  faultProbe() catch fn(error):42\nfn main()->${TYPE} ! TaskError:\n  try probe()\n")
  foreach(KIND IN ITEMS probe faultProbe recover)
    COMPILE("${TYPE}-${KIND}" "${SOURCE}" --test-entry "${KIND}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "-DDESTINATION_TYPE=${ID}" "${SOURCE_DIR}/tests/ConversionTaskTests.cpp"
      "${OUTPUT_DIR}/${TYPE}-${KIND}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${TYPE}-${KIND}-harness")
  endforeach()
  EXPECT("${TYPE}-probe" 42)
  foreach(WORKERS IN ITEMS 1 4)
    foreach(MODE IN ITEMS 0 1 2 4)
      RUN_OK("${OUTPUT_DIR}/${TYPE}-probe-harness" "${WORKERS}" 2a "${MODE}" 0)
    endforeach()
    RUN_OK("${OUTPUT_DIR}/${TYPE}-faultProbe-harness" "${WORKERS}" 0 5 0)
    RUN_OK("${OUTPUT_DIR}/${TYPE}-recover-harness" "${WORKERS}" 2a 0 0)
    foreach(FAIL_AT RANGE 1 12)
      RUN_OK("${OUTPUT_DIR}/${TYPE}-probe-harness" "${WORKERS}" 2a 3 "${FAIL_AT}")
    endforeach()
  endforeach()
endforeach()
set(ALL_TYPES i16 u16 i8 u8 i32 u32 i64 u64 f32 f64)
set(ALL_IDS 1 5 0 4 2 6 3 7 8 9)
foreach(A RANGE 0 9)
  list(GET ALL_TYPES ${A} SRC)
  list(GET ALL_IDS ${A} SRC_ID)
  foreach(B RANGE 0 9)
    if(A GREATER 1 AND B GREATER 1)
      continue()
    endif()
    list(GET ALL_TYPES ${B} DST)
    list(GET ALL_IDS ${B} DST_ID)
    COMPILE("convert-${SRC}-${DST}" "fn operation(value:${SRC})->${DST}:\n  return ${DST}(value)\nfn main()->i64:\n  return 0\n" --test-entry operation)
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "-DSOURCE_TYPE=${SRC_ID}" "-DDESTINATION_TYPE=${DST_ID}" -isystem "${LLVM_ROOT}/include"
      "${SOURCE_DIR}/tests/ConversionRuntimeTests.cpp" "${OUTPUT_DIR}/convert-${SRC}-${DST}.ll" "${RUNTIME}"
      "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/convert-${SRC}-${DST}-harness")
    RUN_OK("${OUTPUT_DIR}/convert-${SRC}-${DST}-harness")
  endforeach()
endforeach()
COMPILE(signed-main "fn main()->i16:\n  return -32768\n")
EXPECT(signed-main -32768)
COMPILE(unsigned-main "fn main()->u16:\n  return 65535\n")
EXPECT(unsigned-main 65535)
COMPILE(signed-worker "fn identity(x:i16)->i16:\n  return x\nfn main()->i16 ! TaskError:\n  return try parallel:\n    try await spawn identity(-32768)\n")
EXPECT(signed-worker -32768)
COMPILE(index "fn get(i:i16)->i64:\n  return [10,20][i]\nfn main()->i64:\n  return get(1)\n")
EXPECT(index 20)
COMPILE(slice "fn get(a:i16,b:u16)->String:\n  return slice(\"aé👩\",a,b)\nfn main()->String:\n  return get(1,3)\n")
EXPECT(slice "é👩")
COMPILE(capture "fn main()->[i64] ! TaskError:\n  offset:i16=-2\n  return try parallel:\n    try await spawn map([1,2],fn(x):return x+i64(offset))\n")
EXPECT(capture "[-1, 0]")
COMPILE(metadata "fn reshapeTo(size:u16)->[i64]:\n  return array(reshape(tensor([1,2]),[size]))\nfn main()->[i64]:\n  reshapeTo(2)\n")
EXPECT(metadata "[1, 2]")
COMPILE(string-result "fn count(names:[String],i:u16)->i16:\n  return i16(length(names[i]))\nfn main()->i16 ! TaskError:\n  return try parallel:\n    work=spawn count([\"é\",\"👩‍💻\"],1)\n    first=try await work\n    again=try await work\n    again\n")
EXPECT(string-result 3)
foreach(NAME IN ITEMS capture string-result)
  RUN_OK("${OUTPUT_DIR}/${NAME}")
  set(EXPECTED "${OUTPUT}")
  foreach(FAIL_AT RANGE 1 20)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}"
      "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(STATUS EQUAL 0)
      # Scalar CLI success enforces live==0 itself and deliberately stays silent.
      if(NAME STREQUAL "string-result")
        if(NOT OUT STREQUAL EXPECTED OR NOT ERR STREQUAL "")
          message(FATAL_ERROR "Narrow16 scalar result/cleanup mismatch: ${OUT}${ERR}")
        endif()
      elseif(NOT OUT STREQUAL EXPECTED OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
        message(FATAL_ERROR "Narrow16 result/cleanup mismatch: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Failed narrow16 worker leaked or published output: ${STATUS}: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()
file(WRITE "${OUTPUT_DIR}/narrow16.k" "export fn step(x:u16)->u16:\n  return x-1\n")
COMPILE(project "from \"narrow16\" import step\nfn main()->u16 ! TaskError:\n  return try parallel:\n    try await spawn step(65535)\n" --package "narrow16=${OUTPUT_DIR}/narrow16.k")
file(WRITE "${OUTPUT_DIR}/kalandra.toml" "format=1\n[project]\nentry='project.k'\n[packages]\nnarrow16='narrow16.k'\n")
RUN_OK("${CHECKER}" --project "${OUTPUT_DIR}/kalandra.toml")
RUN_OK("${COMPILER}" --project "${OUTPUT_DIR}/kalandra.toml" -o "${OUTPUT_DIR}/project" ${EXTRA})
EXPECT(project 65534)
message(STATUS "int16/uint16: all-value/boundary/random scalar arithmetic/comparisons, 36 conversion pairs, isolated worker layouts and narrow CLI results passed")

COMPILE(mixed "fn signed(x:i16)->i16:\n  return x\nfn unsigned(x:u16)->u16:\n  return x\nfn main()->i64 ! TaskError:\n  return try parallel:\n    s=spawn signed(-32768)\n    u=spawn unsigned(65535)\n    a=try await s\n    b=try await u\n    i64(a)+i64(b)\n")
EXPECT(mixed 32767)
file(READ "${SOURCE_DIR}/../docs/design/int16-scalars.md" GUIDE)
string(REGEX MATCHALL "```kalandra\n[^`]*```" EXAMPLES "${GUIDE}")
list(LENGTH EXAMPLES COUNT)
if(NOT COUNT EQUAL 1)
  message(FATAL_ERROR "Narrow16 scalar documentation changed")
endif()
list(GET EXAMPLES 0 EXAMPLE)
string(REGEX REPLACE "^```kalandra\n|```$" "" SOURCE "${EXAMPLE}")
COMPILE(documented "${SOURCE}")
EXPECT(documented 42)

COMPILE(mixed-widths "fn byte(x:i8)->i8:\n  return x\nfn half(x:i16)->i16:\n  return x\nfn ubyte(x:u8)->u8:\n  return x\nfn uhalf(x:u16)->u16:\n  return x\nfn main()->i64 ! TaskError:\n  return try parallel:\n    a=spawn byte(-128)\n    b=spawn half(-32768)\n    c=spawn ubyte(255)\n    d=spawn uhalf(65535)\n    av=try await a\n    bv=try await b\n    cv=try await c\n    dv=try await d\n    i64(av)+i64(bv)+i64(cv)+i64(dv)\n")
EXPECT(mixed-widths 32894)

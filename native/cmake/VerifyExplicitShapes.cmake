file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${OUTPUT_DIR}/shape.k" "fn identity(values:Tensor[float32,?,?]) -> Tensor[float32,?,?]:\n  values\n\nfn main() -> float32:\n  emptyRows:Tensor[float32,0,3] = tensor([], [0,3])\n  emptyColumns:Tensor[float32,3,0] = tensor([], [3,0])\n  left:Tensor[float32,2,3] = tensor([1,2,3,4,5,6], [2,3])\n  right:Tensor[float32,3,2] = tensor([1,2,3,4,5,6], [3,2])\n  scalar:Tensor[float32] = tensor([2], [])\n  alias=identity(emptyRows)\n  reduceSum(matmul(left,right))+reduceSum(alias)+reduceSum(emptyColumns)+reduceSum(scalar)\n")
foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
  if(VARIANT STREQUAL "debug")
    set(FLAG -O0)
  elseif(VARIANT STREQUAL "optimized")
    set(FLAG -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAG --sanitize)
  else()
    set(FLAG --thread-sanitize)
  endif()
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/shape.k" -o "${OUTPUT_DIR}/${VARIANT}" ${FLAG}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${VARIANT} explicit shape compilation: ${STATUS}: ${OUT} ${ERROR}")
  endif()
  execute_process(COMMAND "${OUTPUT_DIR}/${VARIANT}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "165\n")
    message(FATAL_ERROR "${VARIANT} explicit shape result: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endforeach()

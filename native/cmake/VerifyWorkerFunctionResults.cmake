include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
file(GLOB SOURCES "${SOURCE_DIR}/tests/fixtures/worker-function-results/*.k")
foreach(PATH IN LISTS SOURCES)
  get_filename_component(NAME "${PATH}" NAME_WE)
  file(READ "${PATH}" TEXT)
  COMPILE("${NAME}" "${TEXT}")
  EXPECT("${NAME}" 42)
endforeach()
file(READ "${SOURCE_DIR}/../docs/design/fixtures/worker-function-results.k" GUIDE)
COMPILE(guide "${GUIDE}")
EXPECT(guide 42)
foreach(TYPE IN ITEMS i8 u8 i16 u16 i32 u32 i64 u64 f32 f64)
  COMPILE("width-${TYPE}" "fn make(offset:${TYPE})->fn(${TYPE})->${TYPE}:\n  values:[${TYPE}]=[offset]\n  return fn(value:${TYPE}):return values[0]+value\nfn main()->${TYPE} ! TaskError:\n  f=try parallel:\n    try await spawn make(40)\n  return f(2)\n")
  EXPECT("width-${TYPE}" 42)
endforeach()
file(APPEND "${OUTPUT_DIR}/raw.ll" "\n@kalandra_result_test_entry = constant ptr @task.entry.0\n")
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/WorkerFunctionResultRuntimeTests.cpp" "${OUTPUT_DIR}/raw.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/context-harness")
RUN_OK("${OUTPUT_DIR}/context-harness")
foreach(WORKERS IN ITEMS 1 2 4)
  foreach(NAME IN ITEMS cached nested owned conditional coordinator expected expected-failure callback-error error-callback)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}")
    if(NOT OUTPUT STREQUAL "42\n")
      message(FATAL_ERROR "Returned closure changed ${NAME}: ${OUTPUT}")
    endif()
  endforeach()
endforeach()
foreach(NAME IN ITEMS cached nested owned)
  foreach(ATTEMPT RANGE 1 32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Result allocation probe failed: ${NAME}/${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
    endif()
    if("${STATUS}" STREQUAL "0")
      if(NOT OUT STREQUAL "42\n")
        message(FATAL_ERROR "Result allocation probe changed result: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Result allocation probe leaked/published output: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()
set(PROMOTED
  "fn make(functions:[fn(i64)->i64])->fn(i64)->i64:\n  return fn(value:i64):return functions[0](value)\nfn main()->i64 ! TaskError:\n  f=try parallel:\n    try await spawn make([fn(value:i64):return value])\n  return f(42)\n"
  "fn double(value:i64)->i64:\n  return value*2\nfn forward(f:fn(i64)->i64)->fn(i64)->i64:\n  return f\nfn main()->i64 ! TaskError:\n  f=try parallel:\n    try await spawn forward(double)\n  return f(21)\n"
)
set(INDEX 0)
foreach(TEXT IN LISTS PROMOTED)
  math(EXPR INDEX "${INDEX}+1")
  COMPILE("parameter-${INDEX}" "${TEXT}")
  EXPECT("parameter-${INDEX}" 42)
endforeach()
set(REJECTIONS
  "error E:\n  Bad:\n    callback:fn(i64)->i64\nfn make(callback:fn(i64)->i64)->(fn(i64)->i64) ! E:\n  fail E.Bad {callback:callback}\nfn submit(callback:fn(i64)->i64)->i64 ! (E | TaskError):\n  f=try parallel:\n    try await spawn make(callback)\n  return f(21)\nfn main()->i64:\n  return 42\n")
set(INDEX 0)
foreach(TEXT IN LISTS REJECTIONS)
  math(EXPR INDEX "${INDEX}+1")
  set(NAME "reject-${INDEX}")
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${TEXT}")
  foreach(KIND IN ITEMS binary ll mlir)
    file(WRITE "${OUTPUT_DIR}/${NAME}.${KIND}" "preserve-${KIND}")
  endforeach()
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}.binary" --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" --emit-mlir "${OUTPUT_DIR}/${NAME}.mlir" ${EXTRA}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "S074")
    message(FATAL_ERROR "Unsupported function result bypassed the boundary: ${NAME}: ${STATUS}: ${OUT}${ERR}")
  endif()
  foreach(KIND IN ITEMS binary ll mlir)
    file(READ "${OUTPUT_DIR}/${NAME}.${KIND}" KEPT)
    if(NOT KEPT STREQUAL "preserve-${KIND}")
      message(FATAL_ERROR "Rejected result replaced ${KIND}")
    endif()
  endforeach()
endforeach()

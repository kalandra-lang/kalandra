foreach(TARGET IN ITEMS kalandra-native-runtime kalandra-native-runtime-sanitized kalandra-native-runtime-thread-sanitized kalandra-task-core-optimized)
  target_sources(${TARGET} PRIVATE runtime/StringArray.cpp)
endforeach()
foreach(VARIANT IN ITEMS debug sanitized thread-sanitized)
  add_library(kalandra-string-array-entry-${VARIANT} STATIC runtime/StringArrayEntry.cpp)
  target_include_directories(kalandra-string-array-entry-${VARIANT} PRIVATE include)
  target_compile_options(kalandra-string-array-entry-${VARIANT} PRIVATE -Wall -Wextra -Werror)
  if(VARIANT STREQUAL "sanitized")
    target_compile_options(kalandra-string-array-entry-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
  elseif(VARIANT STREQUAL "thread-sanitized")
    target_compile_options(kalandra-string-array-entry-${VARIANT} PRIVATE -O1 -g -fsanitize=thread -fno-omit-frame-pointer)
  endif()
endforeach()
target_compile_definitions(kalandra PRIVATE
  KALANDRA_STRING_ARRAY_ENTRY="$<TARGET_FILE:kalandra-string-array-entry-debug>"
  KALANDRA_STRING_ARRAY_SANITIZED_ENTRY="$<TARGET_FILE:kalandra-string-array-entry-sanitized>"
  KALANDRA_STRING_ARRAY_THREAD_SANITIZED_ENTRY="$<TARGET_FILE:kalandra-string-array-entry-thread-sanitized>")
kalandra_compiler_runtimes(kalandra-string-array-entry-debug kalandra-string-array-entry-sanitized kalandra-string-array-entry-thread-sanitized)
if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS debug sanitized)
    add_executable(kalandra-string-array-tests-${VARIANT} tests/StringArrayTests.cpp)
    target_compile_options(kalandra-string-array-tests-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    if(VARIANT STREQUAL "sanitized")
      target_link_libraries(kalandra-string-array-tests-${VARIANT} PRIVATE kalandra-semantics-sanitized)
      target_compile_definitions(kalandra-string-array-tests-${VARIANT} PRIVATE KALANDRA_STRING_ARRAY_FRONTEND_ONLY)
      target_compile_options(kalandra-string-array-tests-${VARIANT} PRIVATE -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-string-array-tests-${VARIANT} PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=all)
    else()
      target_link_libraries(kalandra-string-array-tests-${VARIANT} PRIVATE kalandra-backend)
    endif()
    add_test(NAME native-string-arrays-frontend-${VARIANT} COMMAND kalandra-string-array-tests-${VARIANT})
    set_tests_properties(native-string-arrays-frontend-${VARIANT} PROPERTIES TIMEOUT 90)
  endforeach()
  foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
    if(VARIANT STREQUAL "sanitized")
      set(SA_RUNTIME kalandra-native-runtime-sanitized)
      set(SA_ENTRY kalandra-string-array-entry-sanitized)
    elseif(VARIANT STREQUAL "thread-sanitized")
      set(SA_RUNTIME kalandra-native-runtime-thread-sanitized)
      set(SA_ENTRY kalandra-string-array-entry-thread-sanitized)
    else()
      set(SA_RUNTIME kalandra-native-runtime)
      set(SA_ENTRY kalandra-string-array-entry-debug)
    endif()
    add_test(NAME native-string-arrays-${VARIANT}
      COMMAND "${CMAKE_COMMAND}" "-DCOMPILER=$<TARGET_FILE:kalandra>" "-DVARIANT=${VARIANT}"
        "-DCLANGXX=${CMAKE_CXX_COMPILER}" "-DRUNTIME=$<TARGET_FILE:${SA_RUNTIME}>"
        "-DENTRY=$<TARGET_FILE:${SA_ENTRY}>"
        "-DSOURCE_DIR=${CMAKE_CURRENT_SOURCE_DIR}" "-DOUTPUT_DIR=${CMAKE_CURRENT_BINARY_DIR}/string-arrays-${VARIANT}"
        -P "${CMAKE_CURRENT_SOURCE_DIR}/cmake/VerifyStringArrays.cmake")
    set_tests_properties(native-string-arrays-${VARIANT} PROPERTIES TIMEOUT 300)
  endforeach()
endif()

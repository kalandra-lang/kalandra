if(BUILD_TESTING)
  foreach(VARIANT IN ITEMS optimized sanitized thread-sanitized)
    add_executable(kalandra-control-arena-${VARIANT} gpu-runtime/ControlArenaTests.cpp)
    target_compile_options(kalandra-control-arena-${VARIANT} PRIVATE -Wall -Wextra -Werror)
    target_link_libraries(kalandra-control-arena-${VARIANT} PRIVATE Threads::Threads)
    if(VARIANT STREQUAL "optimized")
      target_compile_options(kalandra-control-arena-${VARIANT} PRIVATE -O2)
    elseif(VARIANT STREQUAL "sanitized")
      target_compile_options(kalandra-control-arena-${VARIANT} PRIVATE
        -O1 -g -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
      target_link_options(kalandra-control-arena-${VARIANT} PRIVATE -fsanitize=address,undefined)
    else()
      target_compile_options(kalandra-control-arena-${VARIANT} PRIVATE
        -O1 -g -fsanitize=thread -fno-omit-frame-pointer)
      target_link_options(kalandra-control-arena-${VARIANT} PRIVATE -fsanitize=thread)
    endif()
    add_test(NAME native-control-arena-${VARIANT} COMMAND kalandra-control-arena-${VARIANT})
    set_tests_properties(native-control-arena-${VARIANT} PROPERTIES TIMEOUT 30)
  endforeach()
endif()

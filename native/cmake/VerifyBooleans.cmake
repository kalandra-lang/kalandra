include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
set(TYPES int32 uint32 int64 uint64 float32 float64)
set(IDENTITIES 2 6 3 7 8 9)
set(OPERATORS == != < <= > >=)
foreach(INDEX RANGE 0 5)
  list(GET TYPES ${INDEX} TYPE)
  list(GET IDENTITIES ${INDEX} ID)
  foreach(OP RANGE 0 5)
    list(GET OPERATORS ${OP} SPELLING)
    set(NAME "${TYPE}-${OP}")
    COMPILE("${NAME}" "fn compare(a:${TYPE},b:${TYPE})->Bool:\n  a${SPELLING}b\nfn main()->Bool:\n  compare(1,2)\n" --test-entry compare)
    file(READ "${OUTPUT_DIR}/${NAME}.ll" IR)
    if(IR MATCHES "fcmp ")
      message(FATAL_ERROR "Floating comparison bypassed integer-only lowering")
    endif()
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "-DNUMERIC_TYPE=${ID}" "-DOPERATION=${OP}" -isystem "${LLVM_ROOT}/include"
      "${SOURCE_DIR}/tests/BooleanRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}"
      "-L${LLVM_ROOT}/lib" "-Wl,-rpath,${LLVM_ROOT}/lib" -lLLVM -o "${OUTPUT_DIR}/${NAME}-harness")
    RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
  endforeach()
endforeach()
COMPILE(literal "fn identity(value:Bool)->Bool:\n  value\nfn main()->Bool:\n  identity(false)==false\n")
EXPECT(literal true)
COMPILE(unequal "fn main()->Bool:\n  true!=true\n")
EXPECT(unequal false)
COMPILE(precedence "fn twice(value:int64)->int64:\n  value*2\nfn main()->Bool:\n  1+2->twice==6\n")
EXPECT(precedence true)
COMPILE(zero "fn main()->Bool:\n  -0.0==0.0\n")
EXPECT(zero true)
COMPILE(nan "fn main()->Bool:\n  value=0.0/0.0\n  value!=value\n")
EXPECT(nan true)
COMPILE(ordered "fn main()->Bool:\n  value=0.0/0.0\n  value<=value\n")
EXPECT(ordered false)
set(FUNCTIONS "fn failing(value:int64)->Bool:\n  int32(value)==0\n")
set(SPAWNS "")
set(AWAITS "")
foreach(TYPE IN LISTS TYPES)
  string(APPEND FUNCTIONS "fn from_${TYPE}(value:${TYPE},flag:Bool)->Bool:\n  (value<3)==flag\n")
  string(APPEND SPAWNS "    work_${TYPE}=spawn from_${TYPE}(2,true)\n")
  string(APPEND AWAITS "    result_${TYPE}=try await work_${TYPE}\n")
endforeach()
set(SOURCE "${FUNCTIONS}fn passthrough(flag:Bool)->Bool:\n  flag\nfn nested(flag:Bool)->Bool ! TaskError:\n  try parallel:\n    work=spawn passthrough(flag)\n    result=try await work\n    again=try await work\n    result==again\nfn attempt(values:Tensor[int64,?])->Bool ! TaskError:\n  try parallel:\n    bad=spawn failing(2147483648)\n    sibling=spawn nested(reduceSum(values)==3)\n    try await bad\n    try await sibling\nfn probe()->Bool ! TaskError:\n  original:Tensor[int64,2]=tensor([1,2])\n  result=attempt(original)\n  recovered=result catch fn(error): reduceSum(original)==3\n  try parallel:\n    nestedWork=spawn nested(recovered)\n    nestedResult=try await nestedWork\n${SPAWNS}${AWAITS}    (((((result_int32==result_uint32)==(result_int64==result_uint64))==(result_float32==result_float64))==true)==nestedResult)\nfn falseProbe()->Bool ! TaskError:\n  try parallel:\n    work=spawn passthrough(false)\n    try await work\nfn faultProbe()->Bool ! TaskError:\n  try parallel:\n    try await spawn failing(2147483648)\nfn main()->Bool ! TaskError:\n  try probe()\n")
foreach(KIND IN ITEMS probe falseProbe faultProbe)
  COMPILE("worker-${KIND}" "${SOURCE}" --test-entry "${KIND}")
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "${SOURCE_DIR}/tests/BooleanTaskTests.cpp" "${OUTPUT_DIR}/worker-${KIND}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/worker-${KIND}-harness")
endforeach()
EXPECT(worker-probe true)
foreach(WORKERS IN ITEMS 1 2 4)
  RUN_OK("${OUTPUT_DIR}/worker-probe-harness" "${WORKERS}" 1 0 0)
  RUN_OK("${OUTPUT_DIR}/worker-falseProbe-harness" "${WORKERS}" 0 0 0)
  RUN_OK("${OUTPUT_DIR}/worker-faultProbe-harness" "${WORKERS}" 0 5 0)
  foreach(MODE IN ITEMS 1 2 4)
    RUN_OK("${OUTPUT_DIR}/worker-probe-harness" "${WORKERS}" 1 "${MODE}" 0)
  endforeach()
  foreach(ATTEMPT RANGE 1 32)
    RUN_OK("${OUTPUT_DIR}/worker-probe-harness" "${WORKERS}" 1 3 "${ATTEMPT}")
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" "${OUTPUT_DIR}/worker-probe-harness" "${WORKERS}" 1 3 0)
  endforeach()
endforeach()
foreach(TYPE IN LISTS TYPES)
  foreach(EXPECTED IN ITEMS true false)
    set(NAME "mixed-${TYPE}-${EXPECTED}")
    COMPILE("${NAME}" "fn compare(value:${TYPE},flag:Bool)->Bool:\n  (value<3)==flag\nfn probe()->Bool ! TaskError:\n  try parallel:\n    try await spawn compare(2,${EXPECTED})\nfn main()->Bool ! TaskError:\n  try probe()\n" --test-entry probe)
    EXPECT("${NAME}" "${EXPECTED}")
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "${SOURCE_DIR}/tests/BooleanTaskTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${NAME}-harness")
    if(EXPECTED STREQUAL "true")
      set(BITS 1)
    else()
      set(BITS 0)
    endif()
    foreach(WORKERS IN ITEMS 1 2 4)
      RUN_OK("${OUTPUT_DIR}/${NAME}-harness" "${WORKERS}" "${BITS}" 0 0)
    endforeach()
  endforeach()
endforeach()
foreach(OP RANGE 0 1)
  list(GET OPERATORS ${OP} SPELLING)
  COMPILE("Bool-${OP}" "fn compare(a:Bool,b:Bool)->Bool:\n  a${SPELLING}b\nfn main()->Bool:\n  compare(true,false)\n" --test-entry compare)
  RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
    "-DOPERATION=${OP}" "${SOURCE_DIR}/tests/BooleanValueRuntimeTests.cpp" "${OUTPUT_DIR}/Bool-${OP}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/Bool-${OP}-harness")
  RUN_OK("${OUTPUT_DIR}/Bool-${OP}-harness")
endforeach()
foreach(NAME IN ITEMS chain mixed reserved)
  if(NAME STREQUAL "chain")
    set(INVALID "fn main()->Bool:\n  1<2<3\n")
  elseif(NAME STREQUAL "mixed")
    set(INVALID "fn main()->Bool:\n  true==1\n")
  else()
    set(INVALID "fn main()->Bool:\n  true=false\n  true\n")
  endif()
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${INVALID}")
  file(WRITE "${OUTPUT_DIR}/preserved" "preserved executable")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/preserved" RESULT_VARIABLE STATUS ERROR_VARIABLE ERR)
  file(READ "${OUTPUT_DIR}/preserved" PRESERVED)
  if(NOT STATUS EQUAL 1 OR NOT ERR MATCHES "(S056|S013|P034)" OR NOT PRESERVED STREQUAL "preserved executable")
    message(FATAL_ERROR "Boolean diagnostic/artifact preservation failed: ${STATUS}: ${ERR}")
  endif()
endforeach()
COMPILE(order "fn left(value:int64)->int64:\n  int64(int32(value))\nfn right(value:int64)->int64:\n  value/(value-value)\nfn main()->Bool:\n  left(2147483648)<right(2)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/order"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT STATUS EQUAL 86 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "ArithmeticFault at source 2:9" OR NOT ERR MATCHES "cleanup: live=0")
  message(FATAL_ERROR "Comparison evaluation order/fault cleanup failed: ${STATUS}: ${OUT}${ERR}")
endif()
message(STATUS "CPU Bool values and comparisons: exact results, CLI output, worker captures/results, fault recovery and settled owners passed")

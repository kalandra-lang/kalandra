# Full SemVer is authoritative; CMake's project VERSION takes its numeric core.
set(KALANDRA_VERSION_FILE "${CMAKE_CURRENT_LIST_DIR}/../../VERSION")
file(READ "${KALANDRA_VERSION_FILE}" KALANDRA_VERSION)
string(STRIP "${KALANDRA_VERSION}" KALANDRA_VERSION)
set(_version_core "(0|[1-9][0-9]*)")
set(_version_identifier "[0-9A-Za-z-]+")
if(NOT KALANDRA_VERSION MATCHES "^${_version_core}\\.${_version_core}\\.${_version_core}(-${_version_identifier}(\\.${_version_identifier})*)?(\\+${_version_identifier}(\\.${_version_identifier})*)?$")
  message(FATAL_ERROR "VERSION must contain a SemVer version without the v prefix")
endif()
string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" KALANDRA_VERSION_CORE "${KALANDRA_VERSION}")
string(REGEX REPLACE "^[0-9]+\\.[0-9]+\\.[0-9]+" "" _version_suffix "${KALANDRA_VERSION}")
if(_version_suffix MATCHES "^-([^+]+)")
  string(REPLACE "." ";" _version_prerelease "${CMAKE_MATCH_1}")
  foreach(_identifier IN LISTS _version_prerelease)
    if(_identifier MATCHES "^0[0-9]+$")
      message(FATAL_ERROR "Numeric prerelease identifiers in VERSION must not have leading zeros")
    endif()
  endforeach()
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${KALANDRA_VERSION_FILE}")

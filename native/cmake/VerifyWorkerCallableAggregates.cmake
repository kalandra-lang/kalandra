include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
file(GLOB SOURCES "${SOURCE_DIR}/tests/fixtures/worker-callable-aggregates/*.k")
foreach(PATH IN LISTS SOURCES)
  get_filename_component(NAME "${PATH}" NAME_WE)
  file(READ "${PATH}" TEXT)
  COMPILE("${NAME}" "${TEXT}")
  EXPECT("${NAME}" 42)
endforeach()
file(READ "${SOURCE_DIR}/../docs/design/fixtures/worker-callable-aggregates.k" GUIDE)
COMPILE(guide "${GUIDE}")
EXPECT(guide 42)
foreach(TYPE IN ITEMS int8 uint8 int16 uint16 int32 uint32 int64 uint64 float32 float64)
  COMPILE("width-${TYPE}" "type Job:\n  callbacks:[fn(${TYPE})->${TYPE}]\nfn make()->Job:\n  values:[${TYPE}]=[40]\n  Job {callbacks:[fn(value):values[0]+value]}\nfn main()->${TYPE} ! TaskError:\n  job=try parallel:\n    try await spawn make()\n  job.callbacks[0](2)\n")
  EXPECT("width-${TYPE}" 42)
endforeach()
file(READ "${OUTPUT_DIR}/raw.ll" IR)
string(REGEX MATCH "@kalandra_environment_alloc_v1\\([^\n]*i64 40, ptr (nonnull )?@(kalandra_callable_[0-9]+)" TARGET "${IR}")
set(CODE "${CMAKE_MATCH_2}")
if(CODE STREQUAL "")
  message(FATAL_ERROR "Private aggregate entry changed")
endif()
file(APPEND "${OUTPUT_DIR}/raw.ll" "\n@kalandra_aggregate_test_array = constant ptr @task.entry.0\n@kalandra_aggregate_test_enum = constant ptr @task.entry.1\n@kalandra_aggregate_test_captured = constant ptr @task.entry.2\n@kalandra_aggregate_test_words = constant ptr @task.entry.3\n@kalandra_aggregate_test_apply = constant ptr @task.entry.4\n@kalandra_aggregate_test_code = constant ptr @${CODE}\n")
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/WorkerCallableAggregateRuntimeTests.cpp" "${OUTPUT_DIR}/raw.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/context-harness")
RUN_OK("${OUTPUT_DIR}/context-harness")
foreach(WORKERS IN ITEMS 1 2 4)
  foreach(NAME IN ITEMS array-argument array-result record-argument record-result record-array enum captured mixed-signatures slice-concat empty)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}")
    if(NOT OUTPUT STREQUAL "42\n")
      message(FATAL_ERROR "Callable aggregate changed ${NAME}: ${OUTPUT}")
    endif()
  endforeach()
endforeach()
foreach(NAME IN ITEMS array-result record-array captured)
  foreach(ATTEMPT RANGE 1 40)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Aggregate allocation probe failed: ${NAME}/${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
    endif()
    if("${STATUS}" STREQUAL "0")
      if(NOT OUT STREQUAL "42\n")
        message(FATAL_ERROR "Aggregate allocation probe changed result: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Aggregate allocation probe leaked/published output: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()

include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
file(GLOB SOURCES "${SOURCE_DIR}/tests/fixtures/worker-closures/*.k")
foreach(PATH IN LISTS SOURCES)
  get_filename_component(NAME "${PATH}" NAME_WE)
  file(READ "${PATH}" TEXT)
  COMPILE("${NAME}" "${TEXT}")
  EXPECT("${NAME}" 42)
endforeach()
file(READ "${SOURCE_DIR}/../docs/design/fixtures/worker-closures.k" GUIDE)
COMPILE(guide "${GUIDE}")
EXPECT(guide 42)
foreach(TYPE IN ITEMS int8 uint8 int16 uint16 int32 uint32 int64 uint64 float32 float64)
  COMPILE("width-${TYPE}" "fn apply(value:${TYPE},f:fn(${TYPE})->${TYPE})->${TYPE}:\n  f(value)\nfn main()->${TYPE} ! TaskError:\n  offset:${TYPE}=40\n  values:[${TYPE}]=[1]\n  enabled=true\n  f=fn(value:${TYPE}):\n    if enabled:value+offset+values[0]\n    else:${TYPE}(0)\n  try parallel:\n    try await spawn apply(1,f)\n")
  EXPECT("width-${TYPE}" 42)
endforeach()
file(READ "${OUTPUT_DIR}/raw.ll" IR)
string(REGEX MATCH "@kalandra_environment_alloc_v1\\([^\n]*ptr [^@\n]*@(kalandra_callable_[0-9]+)" TARGET "${IR}")
set(CODE "${CMAKE_MATCH_1}")
if(CODE STREQUAL "")
  message(FATAL_ERROR "Private closure fixture lost its tagged entry")
endif()
file(APPEND "${OUTPUT_DIR}/raw.ll" "\n@kalandra_closure_test_entry = constant ptr @task.entry.0\n@kalandra_closure_test_layout = constant ptr @value.layout.function.reference.0\n@kalandra_closure_test_code = constant ptr @${CODE}\n")
RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
  "${SOURCE_DIR}/tests/WorkerClosureRuntimeTests.cpp" "${OUTPUT_DIR}/raw.ll" "${RUNTIME}"
  -o "${OUTPUT_DIR}/context-harness")
RUN_OK("${OUTPUT_DIR}/context-harness")
foreach(WORKERS IN ITEMS 1 2 4)
  foreach(NAME IN ITEMS array factory record arrays conditional coordinator fallible empty-rank-zero)
    RUN_OK("${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}")
    if(NOT OUTPUT STREQUAL "42\n")
      message(FATAL_ERROR "Captured worker changed ${NAME}: ${OUTPUT}")
    endif()
  endforeach()
endforeach()
foreach(NAME IN ITEMS factory record)
  foreach(ATTEMPT RANGE 1 36)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_TEST_FAIL_ALLOC_AT=${ATTEMPT}" KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/${NAME}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
    if(NOT "${STATUS}" MATCHES "^(0|86|88)$" OR ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
      message(FATAL_ERROR "Captured allocation probe failed: ${NAME}/${ATTEMPT}: ${STATUS}: ${OUT}${ERR}")
    endif()
    if("${STATUS}" STREQUAL "0")
      if(NOT OUT STREQUAL "42\n")
        message(FATAL_ERROR "Captured allocation probe changed result: ${OUT}${ERR}")
      endif()
    elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Captured allocation probe leaked/published output: ${OUT}${ERR}")
    endif()
  endforeach()
endforeach()
file(READ "${SOURCE_DIR}/tests/fixtures/worker-parameters/rejected/unsafe-capture.k" UNSAFE)
file(WRITE "${OUTPUT_DIR}/reject-nested.k" "${UNSAFE}")
foreach(KIND IN ITEMS binary ll mlir)
  file(WRITE "${OUTPUT_DIR}/reject-nested.${KIND}" "preserve-${KIND}")
endforeach()
execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/reject-nested.k" -o "${OUTPUT_DIR}/reject-nested.binary" --emit-llvm "${OUTPUT_DIR}/reject-nested.ll" --emit-mlir "${OUTPUT_DIR}/reject-nested.mlir" ${EXTRA}
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
if(NOT "${STATUS}" STREQUAL "1" OR NOT ERR MATCHES "S074")
  message(FATAL_ERROR "Unsafe capture bypassed the provenance boundary: ${STATUS}: ${OUT}${ERR}")
endif()
foreach(KIND IN ITEMS binary ll mlir)
  file(READ "${OUTPUT_DIR}/reject-nested.${KIND}" KEPT)
  if(NOT KEPT STREQUAL "preserve-${KIND}")
    message(FATAL_ERROR "Rejected nested capture replaced ${KIND}")
  endif()
endforeach()

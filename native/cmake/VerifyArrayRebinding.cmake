function(REJECT_REBIND NAME SOURCE MESSAGE)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${SOURCE}")
  file(WRITE "${OUTPUT_DIR}/${NAME}" "existing executable\n")
  file(WRITE "${OUTPUT_DIR}/${NAME}.ll" "existing LLVM\n")
  execute_process(COMMAND "${COMPILER}" "${OUTPUT_DIR}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    --emit-llvm "${OUTPUT_DIR}/${NAME}.ll" ${EXTRA} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(STATUS EQUAL 0 OR NOT ERR MATCHES "${MESSAGE}")
    message(FATAL_ERROR "${NAME}: unsupported replacement admitted or wrong diagnostic: ${STATUS}: ${OUT}${ERR}")
  endif()
  file(READ "${OUTPUT_DIR}/${NAME}" EXECUTABLE)
  file(READ "${OUTPUT_DIR}/${NAME}.ll" LLVM)
  if(NOT EXECUTABLE STREQUAL "existing executable\n" OR NOT LLVM STREQUAL "existing LLVM\n")
    message(FATAL_ERROR "${NAME}: rejected replacement clobbered an existing output")
  endif()
endfunction()

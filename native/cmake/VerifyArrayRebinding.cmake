include("${CMAKE_CURRENT_LIST_DIR}/Float64Driver.cmake")
foreach(TYPE IN ITEMS i8 i16 i32 i64 u8 u16 u32 u64 f32 f64)
  set(BODY "fn run(n:i64)->i64:\n  a=[${TYPE}(7),${TYPE}(8)]\n  saved=a\n  i=0\n  total=0\n  while i<n:\n    a=if i%2==0: [${TYPE}(1),${TYPE}(2),${TYPE}(3)]\n    else: [${TYPE}(4)]\n    total=total+length(a)\n    i=i+1\n  return i64(saved[0])+total+i64(a[0])+length(a)\nfn main()->i64:\n  return 0\n")
  foreach(KIND IN ITEMS literal callable finite-callable)
    set(SOURCE "${BODY}")
    if(NOT KIND STREQUAL "literal")
      string(REPLACE "    a=if i%2==0: [${TYPE}(1),${TYPE}(2),${TYPE}(3)]\n    else: [${TYPE}(4)]" "    a=f(i)" SOURCE "${SOURCE}")
      if(KIND STREQUAL "callable")
        set(BINDING "  f=choose\n")
      else()
        set(BINDING "  f=if n%2==0: choose\n  else: alternate\n")
      endif()
      string(REPLACE "fn run(n:i64)->i64:\n" "fn run(n:i64)->i64:\n${BINDING}" SOURCE "${SOURCE}")
      set(SOURCE "fn choose(i:i64)->[${TYPE}]:\n  if i%2==0: [${TYPE}(1),${TYPE}(2),${TYPE}(3)]\n  else: [${TYPE}(4)]\nfn alternate(i:i64)->[${TYPE}]:\n  [${TYPE}(4)]\n${SOURCE}")
    endif()
    set(NAME "lifetime-${TYPE}-${KIND}")
    COMPILE("${NAME}" "${SOURCE}" --test-entry run)
    RUN_OK("${CLANGXX}" -std=c++23 -Wall -Wextra -Werror -Wno-override-module ${FLAGS}
      "${SOURCE_DIR}/tests/ArrayRebindingRuntimeTests.cpp" "${OUTPUT_DIR}/${NAME}.ll" "${RUNTIME}" -o "${OUTPUT_DIR}/${NAME}-harness")
    RUN_OK("${OUTPUT_DIR}/${NAME}-harness")
  endforeach()
endforeach()

foreach(TYPE IN ITEMS int32 uint32 int64 uint64)
  if(TYPE MATCHES "^u")
    set(BAD 18446744073709551615)
    if(TYPE STREQUAL "uint32")
      set(BAD 4294967295)
    endif()
  else()
    set(BAD -1)
  endif()
  COMPILE("bounds-${TYPE}" "fn pick(values:[Bool],index:${TYPE})->Bool:\n  values[index]\nfn main()->Bool:\n  pick([true,false],${BAD})\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "${OUTPUT_DIR}/bounds-${TYPE}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(STATUS EQUAL 0 OR NOT OUT STREQUAL "" OR NOT ERR MATCHES "BoundsFault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
    message(FATAL_ERROR "Bool bounds/failure cleanup failed: ${STATUS}: ${OUT}${ERR}")
  endif()
endforeach()
foreach(FAIL_AT RANGE 1 24)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env KALANDRA_TEST_REPORT_CLEANUP=1 "KALANDRA_TEST_FAIL_ALLOC_AT=${FAIL_AT}" "${OUTPUT_DIR}/nested"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERR)
  if(STATUS EQUAL 0)
    if(NOT OUT STREQUAL "[true, false]\n")
      message(FATAL_ERROR "Bool allocation sweep changed result: ${OUT}")
    endif()
  elseif(NOT OUT STREQUAL "" OR NOT ERR MATCHES "AllocationFault|TaskError.Fault" OR NOT ERR MATCHES "cleanup: live=0 allocations=([0-9]+) releases=([0-9]+)" OR NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
    message(FATAL_ERROR "Bool allocation sweep published output or leaked: ${STATUS}: ${OUT}${ERR}")
  endif()
  if(ERR MATCHES "AddressSanitizer|runtime error:|ThreadSanitizer")
    message(FATAL_ERROR "Bool sanitizer failure: ${ERR}")
  endif()
endforeach()

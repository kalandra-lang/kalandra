file(READ "${SOURCE_DIR}/shared-helpers.k" SOURCE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(build_run NAME CONTENT BACKEND EXPECTED)
  set(FLAG -O2)
  if(ARGC GREATER 4)
    set(FLAG "${ARGV4}")
  endif()
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  set(EXECUTABLE "${OUTPUT_DIR}/${NAME}")
  if(BACKEND STREQUAL "metal")
    set(EXECUTABLE "${EXECUTABLE}/program")
  endif()
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target "${BACKEND}" -o "${OUTPUT_DIR}/${NAME}" "${FLAG}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: build failed: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${EXECUTABLE}"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "${EXPECTED}\n")
      message(FATAL_ERROR "${NAME}: unexpected result ${STATUS}: ${OUT} ${ERROR}")
    endif()
  endforeach()
endfunction()
build_run(both "${SOURCE}" metal "[41300000,41c80000,422c0000]")
# Inspect one unchanged helper's original tensor types and its CPU and GPU bodies.
file(READ "${OUTPUT_DIR}/both/cpu.mlir" CPU_IR)
file(READ "${OUTPUT_DIR}/both/kernel0.mlir" GPU_IR)
if(NOT CPU_IR MATCHES "tensor<.xf32>" OR NOT CPU_IR MATCHES "arith.mulf" OR NOT CPU_IR MATCHES "arith.addf"
   OR NOT GPU_IR MATCHES "arith.mulf" OR NOT GPU_IR MATCHES "arith.addf")
  message(FATAL_ERROR "Shared helper missing CPU tensor lowering or GPU lane lowering")
endif()
# The same definition works with the CPU-only compiler target and in CPU tasks.
string(FIND "${SOURCE}" "fn main()" MAIN)
string(SUBSTRING "${SOURCE}" 0 ${MAIN} FUNCTIONS)
set(CPU_MAIN "fn main() -> float32:\n  left: Tensor[float32,3] = tensor([1,2,3])\n  right: Tensor[float32,3] = tensor([4,5,6])\n  reduceSum(combine(left,right))\n")
build_run(cpu "${FUNCTIONS}${CPU_MAIN}" cpu "39.5")
set(TASK_MAIN "fn main() -> float32 ! TaskError:\n  try parallel:\n    left: Tensor[float32,3] = tensor([1,2,3])\n    right: Tensor[float32,3] = tensor([4,5,6])\n    work = spawn combine(left,right)\n    result = try await work\n    reduceSum(result)\n")
build_run(cpu-task "${FUNCTIONS}${TASK_MAIN}" cpu "39.5" --sanitize)
# Scalar lifting on the left and right, ranked CPU loops, and empty dimensions.
set(RANKED "fn mix(a: Tensor[float32,?,?], b: Tensor[float32,?,?]) -> Tensor[float32,?,?]:\n  0.5+(a*b)*2\nfn main() -> float32:\n  a: Tensor[float32,2,2] = tensor([[1,2],[3,4]])\n  b: Tensor[float32,2,2] = tensor([[5,6],[7,8]])\n  reduceSum(mix(a,b))\n")
build_run(ranked "${RANKED}" cpu "142" --thread-sanitize)
set(EMPTY "fn mix(a: Tensor[float32,?,?], b: Tensor[float32,?,?]) -> Tensor[float32,?,?]:\n  a*b+0.5\nfn main() -> float32:\n  a: Tensor[float32,2,0] = tensor([[],[]])\n  reduceSum(mix(a,a))\n")
build_run(empty-ranked "${EMPTY}" cpu "0" --sanitize)
# Ordinary CPU calls keep capabilities that are explicitly rejected on GPU use.
set(CPU_ONLY "fn divide(x: float32) -> float32:\n  x/2\n${SOURCE}")
string(REPLACE "    local = combine(left, right)" "    scale = divide(2)\n    local = combine(left, right)" CPU_ONLY "${CPU_ONLY}")
build_run(cpu-only-operation "${CPU_ONLY}" metal "[41300000,41c80000,422c0000]")
message(STATUS "Shared helper CPU/GPU calls, CPU tasks, ranked loops and tensor type preservation passed")

set(MISMATCH "fn forward(values: Tensor[float32, ?]) -> Tensor[float32, ?]:\n  values\n${SOURCE}")
string(REPLACE "    local = combine(left, right)" "    smaller: Tensor[float32, 2] = tensor([4,5])\n    local = combine(forward(left), forward(smaller))" MISMATCH "${MISMATCH}")
file(WRITE "${OUTPUT_DIR}/shape-fault.k" "${MISMATCH}")
execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/shape-fault.k" --target metal -o "${OUTPUT_DIR}/shape-fault" -O2
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0)
  message(FATAL_ERROR "Dynamic shared CPU call did not compile: ${OUT} ${ERROR}")
endif()
execute_process(COMMAND "${OUTPUT_DIR}/shape-fault/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 1 OR NOT OUT STREQUAL "" OR NOT ERROR MATCHES "Metal task failed: 1/1")
  message(FATAL_ERROR "Shared CPU shape constraint silently ignored: ${STATUS} ${OUT} ${ERROR}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/matrix-graph-reduction.k" SOURCE)
string(FIND "${SOURCE}" "\nfn main()" SPLIT)
string(SUBSTRING "${SOURCE}" 0 ${SPLIT} OPS)
string(SUBSTRING "${SOURCE}" ${SPLIT} -1 MAIN)
string(REPLACE "fn project(" "export fn project(" OPS "${OPS}")
file(WRITE "${ROOT}/operations.k" "${OPS}")
file(WRITE "${ROOT}/public.k" "export from \"./operations.k\" import project as calculate\n")
set(PREFIX "from \"./public.k\" import calculate as project\nfn forward(values:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  values\n")
set(MAIN "${PREFIX}${MAIN}")
foreach(NAME IN ITEMS input weights projection)
  string(REPLACE "transfer(${NAME}, gpu)" "transfer(forward(${NAME}), gpu)" MAIN "${MAIN}")
endforeach()
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
function(reject NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS}: ${ERROR}")
  endif()
endfunction()
compile(imported "${MAIN}")
file(READ "${OUTPUT_DIR}/imported/manifest.txt" MANIFEST)
if(NOT MANIFEST MATCHES "matrix_graph_products=2" OR NOT MANIFEST MATCHES "reduction_stage=kernel0-reduce" OR NOT MANIFEST MATCHES "scalar_stage=kernel0-scalar")
  message(FATAL_ERROR "Lost resident graph reduction stages: ${MANIFEST}")
endif()
string(REPLACE "finish(reduceSum(multiply(hidden, projection)), count)" "reduceSum(multiply(hidden, projection))" PLAIN "${OPS}")
file(WRITE "${ROOT}/operations.k" "${PLAIN}")
compile(plain "${MAIN}")
string(REPLACE "finish(reduceSum(multiply(hidden, projection)), count)" "total=reduceSum(multiply(hidden, projection))\n  total + total" REUSED "${OPS}")
file(WRITE "${ROOT}/operations.k" "${REUSED}")
compile(reused "${MAIN}")
string(REPLACE "finish(reduceSum(multiply(hidden, projection)), count)" "square=multiply(hidden,hidden)\n  finish(reduceSum(multiply(square,hidden)),count)" SHARED "${OPS}")
file(WRITE "${ROOT}/operations.k" "${SHARED}")
compile(shared "${MAIN}")
file(WRITE "${ROOT}/operations.k" "${OPS}")
string(REPLACE "transfer(forward(projection), gpu)" "transfer(forward(weights), gpu)" WRONG "${MAIN}")
compile(wrong-shape "${WRONG}")
if(DEFINED VARIANT)
  run(imported "c3d6c000\n" 0)
  run(plain "44564000\n" 0)
  run(reused "44d64000\n" 0)
  run(shared "c911b090\n" 0)
  run(wrong-shape "" 1)
  file(COPY "${OUTPUT_DIR}/imported/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "c3d6c000\n" 0)
else()
  # Only one strict matmul library is needed irrespective of graph length.
  foreach(STAGE IN ITEMS "" "-rows2" "-quad" "-reduce" "-scalar")
    file(SHA256 "${OUTPUT_DIR}/imported/kernel0${STAGE}.mlir" A)
    file(SHA256 "${OUTPUT_DIR}/shared/kernel0${STAGE}.mlir" B)
    if(NOT A STREQUAL B)
      message(FATAL_ERROR "Shared graph changed a strict kernel: ${STAGE}")
    endif()
  endforeach()
  foreach(CASE IN ITEMS unused early-reduction branch)
    if(CASE STREQUAL "unused")
      string(REPLACE "  hidden =" "  ignored=matmul(input,weights)\n  hidden =" BAD "${OPS}")
    elseif(CASE STREQUAL "early-reduction")
      string(REPLACE "finish(reduceSum(multiply(hidden, projection)), count)" "final=multiply(hidden,projection)\n  reduceSum(hidden)" BAD "${OPS}")
    else()
      string(REPLACE "  finish(reduceSum(multiply(hidden, projection)), count)" "  if true:\n    finish(reduceSum(multiply(hidden,projection)),count)\n  else:\n    count" BAD "${OPS}")
    endif()
    file(WRITE "${ROOT}/operations.k" "${BAD}")
    admit_case(${CASE} "${MAIN}")
  endforeach()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/post-matmul.k" SOURCE)
string(FIND "${SOURCE}" "\nfn main()" SPLIT)
string(SUBSTRING "${SOURCE}" 0 ${SPLIT} OPS)
string(SUBSTRING "${SOURCE}" ${SPLIT} -1 MAIN)
string(REPLACE "\nfn project(" "\nexport fn project(" OPS "${OPS}")
file(WRITE "${ROOT}/operations.k" "${OPS}")
file(WRITE "${ROOT}/public.k" "export from \"./operations.k\" import project as calculate\n")
set(PREFIX "from \"./public.k\" import calculate as project\nfn forward(values:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  values\n")
set(MAIN "${PREFIX}${MAIN}")
foreach(NAME IN ITEMS input weights bias)
  string(REPLACE "transfer(${NAME}, gpu)" "transfer(forward(${NAME}), gpu)" MAIN "${MAIN}")
endforeach()
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
function(reject NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS}: ${ERROR}")
  endif()
endfunction()
compile(imported "${MAIN}")
file(READ "${OUTPUT_DIR}/imported/kernel0.mlir" MATRIX)
file(READ "${OUTPUT_DIR}/imported/kernel0-post.mlir" POST)
file(READ "${OUTPUT_DIR}/imported/manifest.txt" MANIFEST)
if(NOT MATRIX MATCHES "kalandra_matmul" OR NOT POST MATCHES "arith.addf" OR NOT POST MATCHES "arith.mulf"
   OR NOT MANIFEST MATCHES "epilogue_tensor_bindings=0,2" OR NOT MANIFEST MATCHES "epilogue_tensors=4")
  message(FATAL_ERROR "Matrix/post artifacts lost their separate projected bindings")
endif()
# The post stage uses the same Tier 2 path when its physical reads exceed 29.
set(HIGH_FN "fn many(a:Tensor[float32,?,?],b:Tensor[float32,?,?]")
set(HIGH_EXPR "product")
set(HIGH_ARGS "a, b")
foreach(I RANGE 0 29)
  string(APPEND HIGH_FN ",bias${I}:Tensor[float32,?,?]")
  string(APPEND HIGH_EXPR " + bias${I}")
  string(APPEND HIGH_ARGS ", offset")
endforeach()
string(APPEND HIGH_FN ")->Tensor[float32,?,?]:\n  product=matmul(a,b)\n  ${HIGH_EXPR}\n")
string(REPLACE "spawn project(a, offset, 2, b)" "spawn many(${HIGH_ARGS})" HIGH_MAIN "${MAIN}")
compile(indirect "${HIGH_FN}${HIGH_MAIN}")
set(SQUARE_FN "fn square(values:Tensor[float32,?,?],bias:float32)->Tensor[float32,?,?]:\n  matmul(values,values)+bias\n")
string(REPLACE "spawn project(a, offset, 2, b)" "spawn square(offset,2)" SQUARE_MAIN "${MAIN}")
compile(single-input "${SQUARE_FN}${SQUARE_MAIN}")
file(READ "${OUTPUT_DIR}/indirect/manifest.txt" HIGH_MANIFEST)
if(NOT HIGH_MANIFEST MATCHES "epilogue_binding_layout=argument_buffer_tier2")
  message(FATAL_ERROR "High-arity post stage lost Tier 2 binding")
endif()
if(NOT DEFINED VARIANT)
  string(REPLACE "matmul(input, weights)" "matmul(input + 1, weights)" BAD "${OPS}")
  file(WRITE "${ROOT}/operations.k" "${BAD}")
  compile(pre-arithmetic "${MAIN}")
  string(REPLACE "  product = matmul" "  ignored = matmul(input, weights)\n  product = matmul" BAD "${OPS}")
  file(WRITE "${ROOT}/operations.k" "${BAD}")
  admit_case(two-matrices "${MAIN}")
  string(REPLACE "  finish(product, bias, scale)" "  if scale > 0: product + bias\n  else: product" BAD "${OPS}")
  file(WRITE "${ROOT}/operations.k" "${BAD}")
  admit_case(branch "${MAIN}")
  message(STATUS "Matrix/post source proof, mixed arguments, projection and transactional boundaries passed")
  return()
endif()
set(EXPECTED "[42380000,42700000,42d00000,43080000]\n")
run(imported "${EXPECTED}" 0)
run(indirect "[42500000,42b00000,430b0000,43380000]\n" 0)
run(single-input "[41100000,41400000,41880000,41c00000]\n" 0)
file(COPY "${OUTPUT_DIR}/imported/" DESTINATION "${OUTPUT_DIR}/relocated")
run(relocated "${EXPECTED}" 0)
set(SEPARATE "fn plain(a:Tensor[float32,?,?],b:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  matmul(a,b)\nfn finish(a:Tensor[float32,?,?],bias:Tensor[float32,?,?],scale:float32)->Tensor[float32,?,?]:\n  (a+bias)*scale\n${MAIN}")
string(REPLACE "    work = spawn project(a, offset, 2, b) on gpu" "    product = try await spawn plain(a, b) on gpu\n    work = spawn finish(product, offset, 2) on gpu" SEPARATE "${SEPARATE}")
compile(separate "${SEPARATE}")
run(separate "${EXPECTED}" 0)
foreach(SUFFIX IN ITEMS mlir lowered.mlir metal)
  file(SHA256 "${OUTPUT_DIR}/imported/kernel0.${SUFFIX}" A)
  file(SHA256 "${OUTPUT_DIR}/separate/kernel0.${SUFFIX}" B)
  if(NOT A STREQUAL B)
    message(FATAL_ERROR "Matrix/post changed strict matrix shader ${SUFFIX}")
  endif()
endforeach()
# Complete output shape is checked, including shapes with equal element counts.
string(REPLACE "Tensor[float32, 2, 2] = tensor([[1, 2], [3, 4]])" "Tensor[float32, 1, 4] = tensor([[1, 2, 3, 4]])" BAD "${MAIN}")
compile(bias-shape-fault "${BAD}")
run(bias-shape-fault "" 1)
string(REPLACE "finish(product, bias, scale)" "-(product + scale) / 2" SCALAR "${OPS}")
file(WRITE "${ROOT}/operations.k" "${SCALAR}")
compile(scalar "${MAIN}")
run(scalar "[c1400000,c1700000,c1cc0000,c2040000]\n" 0)
string(REPLACE "finish(product, bias, scale)" "product + product" REUSED "${OPS}")
file(WRITE "${ROOT}/operations.k" "${REUSED}")
compile(reused "${MAIN}")
run(reused "[42300000,42600000,42c40000,43000000]\n" 0)
message(STATUS "Matrix/post ${VARIANT}: tensor/scalar arithmetic, reused product, separate equivalence, imports, shape guards and relocation passed")

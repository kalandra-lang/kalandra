file(READ "${SOURCE_DIR}/tensor-negation.k" SOURCE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
set(EXPECTED "[c0000000,c0800000,c0c00000,c1000000,c1200000,c1400000]\n")
foreach(VARIANT IN ITEMS optimized sanitized thread-sanitized)
  if(VARIANT STREQUAL "optimized")
    set(FLAG -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAG --sanitize)
  else()
    set(FLAG --thread-sanitize)
  endif()
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${SOURCE_DIR}/tensor-negation.k" --target metal
    -o "${OUTPUT_DIR}/${VARIANT}" "${FLAG}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${VARIANT} compilation failed: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      "${OUTPUT_DIR}/${VARIANT}/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL EXPECTED)
      message(FATAL_ERROR "${VARIANT}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
  endforeach()
endforeach()
foreach(KERNEL RANGE 0 7)
  file(READ "${OUTPUT_DIR}/optimized/kernel${KERNEL}.lowered.mlir" STRICT)
  file(READ "${OUTPUT_DIR}/optimized/kernel${KERNEL}.kernel.mlir" SPIRV)
  if(STRICT MATCHES "arith\\.(addf|subf|negf|mulf|divf)" OR
      SPIRV MATCHES "spirv\\.(FAdd|FSub|FNegate|FMul|FDiv)|Fma|FPFastMathMode")
    message(FATAL_ERROR "Tensor unary kernel ${KERNEL} retained floating arithmetic")
  endif()
endforeach()
# Vector and matrix helpers use identical lane arithmetic, including scalar-first arguments.
foreach(KERNEL RANGE 0 3)
  math(EXPR VECTOR "${KERNEL} + 4")
  foreach(SUFFIX IN ITEMS mlir lowered.mlir spv)
    file(SHA256 "${OUTPUT_DIR}/optimized/kernel${KERNEL}.${SUFFIX}" A)
    file(SHA256 "${OUTPUT_DIR}/optimized/kernel${VECTOR}.${SUFFIX}" B)
    if(NOT A STREQUAL B)
      message(FATAL_ERROR "Rank changed unary arithmetic ${KERNEL}.${SUFFIX}")
    endif()
  endforeach()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/relocated")
file(COPY "${OUTPUT_DIR}/optimized/program" DESTINATION "${OUTPUT_DIR}/relocated")
foreach(KERNEL RANGE 0 7)
  file(COPY "${OUTPUT_DIR}/optimized/kernel${KERNEL}.metallib" DESTINATION "${OUTPUT_DIR}/relocated")
endforeach()
execute_process(COMMAND "${OUTPUT_DIR}/relocated/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL EXPECTED)
  message(FATAL_ERROR "Relocated unary bundle failed: ${STATUS}: ${OUT} ${ERROR}")
endif()
# Fixed mismatches are diagnosed transactionally; dynamic mismatches fail before reads.
string(REPLACE "Tensor[float32, 2, 3] = tensor([[7, 8, 9], [10, 11, 12]])"
  "Tensor[float32, 3, 2] = tensor([[7, 8], [9, 10], [11, 12]])" BAD "${SOURCE}")
file(WRITE "${OUTPUT_DIR}/bad.k" "${BAD}")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/bad")
file(WRITE "${OUTPUT_DIR}/bad/host.cpp" "sentinel")
execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/bad.k" --target metal -o "${OUTPUT_DIR}/bad"
  RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
file(READ "${OUTPUT_DIR}/bad/host.cpp" SENTINEL)
if(STATUS EQUAL 0 OR NOT ERROR MATCHES "(G001|S0)" OR NOT SENTINEL STREQUAL "sentinel")
  message(FATAL_ERROR "Known subtraction mismatch was not rejected transactionally: ${STATUS}: ${ERROR}")
endif()
set(FORWARD "fn forward(values: Tensor[float32, ?, ?]) -> Tensor[float32, ?, ?]:\n  values\n\n")
string(REPLACE "transfer(right, gpu)" "transfer(forward(right), gpu)" BAD "${BAD}")
file(WRITE "${OUTPUT_DIR}/dynamic.k" "${FORWARD}${BAD}")
execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/dynamic.k" --target metal -o "${OUTPUT_DIR}/dynamic" --sanitize
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0)
  message(FATAL_ERROR "Dynamic subtraction mismatch should compile: ${OUT} ${ERROR}")
endif()
foreach(WORKERS IN ITEMS 1 2 4)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
    "${OUTPUT_DIR}/dynamic/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 1 OR NOT OUT STREQUAL "" OR NOT ERROR MATCHES "Metal task failed: 1/1")
    message(FATAL_ERROR "Dynamic subtraction mismatch missing guard: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endforeach()
# The same TensorUnary IR must survive CPU task extraction, including inline negation.
string(FIND "${SOURCE}" "fn main()" MAIN)
string(SUBSTRING "${SOURCE}" 0 ${MAIN} FUNCTIONS)
set(CPU_MAIN "fn main() -> float32 ! TaskError:\n  try parallel:\n    a: Tensor[float32,2,3] = tensor([[1,2,3],[4,5,6]])\n    work = spawn negative(a)\n    negated = try await work\n    repeated = restored(negated)\n    back = -positive(repeated)\n    reduceSum(back)\n")
file(WRITE "${OUTPUT_DIR}/cpu-task.k" "${FUNCTIONS}${CPU_MAIN}")
# General ranked CPU lowering is not restricted to the current rank-one/two GPU subset.
set(RANK3 "fn main() -> float32:\n  a: Tensor[float32,2,1,2] = tensor([[[1,2]],[[3,4]]])\n  reduceSum(-a)\n")
file(WRITE "${OUTPUT_DIR}/rank3.k" "${RANK3}")
foreach(FLAG IN ITEMS -O2 --sanitize --thread-sanitize)
  string(REPLACE "--" "" NAME "${FLAG}")
  foreach(CASE IN ITEMS cpu-task rank3)
    execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${CASE}.k" --target cpu
      -o "${OUTPUT_DIR}/${CASE}-${NAME}" "${FLAG}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0)
      message(FATAL_ERROR "CPU unary ${CASE} compilation: ${OUT} ${ERROR}")
    endif()
    if(CASE STREQUAL "cpu-task")
      set(CPU_EXPECTED "21\n")
    else()
      set(CPU_EXPECTED "-10\n")
    endif()
    foreach(WORKERS IN ITEMS 1 2 4)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
        "${OUTPUT_DIR}/${CASE}-${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
      if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL CPU_EXPECTED)
        message(FATAL_ERROR "CPU unary ${CASE}: ${STATUS}: ${OUT} ${ERROR}")
      endif()
    endforeach()
  endforeach()
endforeach()
# Negation is not implicit await.
string(REPLACE "    negated = try await work" "    negated = -work" BAD "${CPU_MAIN}")
file(WRITE "${OUTPUT_DIR}/pending.k" "${FUNCTIONS}${BAD}")
execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/pending.k" --target cpu
  -o "${OUTPUT_DIR}/pending" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
if(STATUS EQUAL 0 OR NOT ERROR MATCHES "S017")
  message(FATAL_ERROR "Pending tensor negation bypassed task typing: ${ERROR}")
endif()
# A zero outer dimension still preserves the complete matrix shape.
set(EMPTY "fn main() -> Tensor[float32,0,3] ! TaskError:\n  try parallel:\n    gpu = devices.gpu()\n    values: Tensor[float32,0,3] = tensor([], [0, 3])\n    uploaded = try await transfer(values,gpu)\n    negated = try await spawn negative(uploaded) on gpu\n    try await transfer(negated,devices.cpu())\n")
file(WRITE "${OUTPUT_DIR}/empty.k" "${FUNCTIONS}${EMPTY}")
execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/empty.k" --target metal
  -o "${OUTPUT_DIR}/empty" --sanitize RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0)
  message(FATAL_ERROR "Empty matrix negation compilation: ${ERROR}")
endif()
execute_process(COMMAND "${OUTPUT_DIR}/empty/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "[]\n")
  message(FATAL_ERROR "Empty matrix negation failed: ${OUT} ${ERROR}")
endif()
message(STATUS "Whole tensor unary arithmetic, CPU tasks, strict artifacts and shape/lifetime qualification passed")

include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/tensor-sources.k" SOURCE)
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
compile(sources "${SOURCE}")
file(READ "${OUTPUT_DIR}/sources/manifest.txt" MANIFEST)
if(NOT MANIFEST MATCHES "kernel0.binding_layout=argument_buffer_tier2" OR NOT MANIFEST MATCHES "kernel1.matrix_graph_edges=0:1" OR NOT MANIFEST MATCHES "kernel1.map0_tensors=3" OR EXISTS "${OUTPUT_DIR}/sources/kernel1-map1.mlir")
  message(FATAL_ERROR "Two-source choice lost fused/broadcast bindings: ${MANIFEST}")
endif()
string(REPLACE "Tensor[float32, 3]" "Tensor[float32, 1, 3]" MATRIX "${SOURCE}")
string(REPLACE "tensor([1, 2, 3])" "tensor([[1, 2, 3]])" MATRIX "${MATRIX}")
string(REPLACE "tensor([4, 5, 6])" "tensor([[4, 5, 6]])" MATRIX "${MATRIX}")
compile(matrix "${MATRIX}")
string(REPLACE "choose(x, y, 2)" "choose(x, y, -2)" FALSE "${SOURCE}")
string(REPLACE "normalize(first, y, 1)" "normalize(first, y, 100)" FALSE "${FALSE}")
compile(false-arm "${FALSE}")
string(REPLACE "  if factor > 0:" "  if true:" CONSTANT "${SOURCE}")
compile(constant "${CONSTANT}")
string(REPLACE "  if total > threshold:" "  if false:" CONSTANT_FALSE "${SOURCE}")
compile(constant-false "${CONSTANT_FALSE}")
string(REPLACE "    a * factor" "    if factor>1:\n      a*factor\n    else:\n      b+factor" NESTED "${SOURCE}")
compile(nested "${NESTED}")
string(REPLACE "  total = reduceSum(a)" "  total = reduceSum(a)\n  left = a + threshold\n  right = b - threshold" INTERMEDIATE "${SOURCE}")
string(REPLACE "    a / total" "    left / total" INTERMEDIATE "${INTERMEDIATE}")
string(REPLACE "    b * threshold" "    right * threshold" INTERMEDIATE "${INTERMEDIATE}")
compile(intermediate "${INTERMEDIATE}")
# Rank-two equal element counts are not a proof of equal complete shapes.
string(REPLACE "Tensor[float32, 3]" "Tensor[float32, ?]" DYNAMIC "${SOURCE}")
string(REPLACE "Tensor[float32, 3]" "Tensor[float32, 0]" EMPTY "${SOURCE}")
string(REPLACE "tensor([1, 2, 3])" "tensor([])" EMPTY "${EMPTY}")
string(REPLACE "tensor([4, 5, 6])" "tensor([])" EMPTY "${EMPTY}")
compile(empty "${EMPTY}")
set(SUM "fn score(a:Tensor[float32,3],b:Tensor[float32,3],factor:float32)->float32:\n  chosen=if factor>0:\n    a*factor\n  else:\n    b/factor\n  reduceSum(chosen)\nfn main()->float32 ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,3]=tensor([1,2,3])\n    b:Tensor[float32,3]=tensor([4,5,6])\n    x=try await transfer(a,gpu)\n    y=try await transfer(b,gpu)\n    try await spawn score(x,y,2) on gpu\n")
compile(sum "${SUM}")
string(REPLACE "if factor>0" "if true" SUM_CONSTANT "${SUM}")
compile(sum-constant "${SUM_CONSTANT}")
set(THREE "fn choose(a:Tensor[float32,3],b:Tensor[float32,3],c:Tensor[float32,3],factor:float32)->Tensor[float32,3]:\n  if factor>0:\n    a\n  else:\n    if factor<0:\n      b\n    else:\n      c\nfn main()->Tensor[float32,3] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,3]=tensor([1,2,3])\n    x=try await transfer(a,gpu)\n    y=try await spawn choose(x,x,x,1) on gpu\n    try await transfer(y,devices.cpu())\n")
compile(three-sources "${THREE}")
if(DEFINED VARIANT)
  run(three-sources "[3f800000,40000000,40400000]\n" 0)
  run(sources "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(matrix "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(false-arm "[43c80000,43fa0000,44160000]\n" 0)
  run(constant "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(constant-false "[40800000,40a00000,40c00000]\n" 0)
  run(nested "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(intermediate "[3e800000,3ed55555,3f155555]\n" 0)
  run(empty "[]\n" 0)
  run(sum "41400000\n" 0)
  run(sum-constant "41400000\n" 0)
  file(COPY "${OUTPUT_DIR}/sources/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
else()
  function(reject NAME SOURCE)
    file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
    file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
    file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
    execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
    file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
    if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
      message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS} ${ERROR}")
    endif()
  endfunction()
  admit_case(dynamic "${DYNAMIC}")
  string(REPLACE "    a / total" "    a / reduceSum(b)" BAD "${SOURCE}")
  admit_case(primitive "${BAD}")
  set(SHAPES "fn choose(a:Tensor[float32,2,3],b:Tensor[float32,3,2],factor:float32)->Tensor[float32,?,?]:\n  if factor>0:\n    a\n  else:\n    b\nfn main()->Tensor[float32,?,?] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,2,3]=tensor([[1,2,3],[4,5,6]])\n    b:Tensor[float32,3,2]=tensor([[1,2],[3,4],[5,6]])\n    x=try await transfer(a,gpu)\n    y=try await transfer(b,gpu)\n    z=try await spawn choose(x,y,1) on gpu\n    try await transfer(z,devices.cpu())\n")
  admit_case(different-shapes "${SHAPES}")
  set(MATRIX_SUM "fn score(a:Tensor[float32,1,1],b:Tensor[float32,1,1],factor:float32)->float32:\n  chosen=if factor>0:\n    a\n  else:\n    b\n  reduceSum(matmul(chosen,a))\nfn main()->float32 ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,1,1]=tensor([[1]])\n    x=try await transfer(a,gpu)\n    try await spawn score(x,x,1) on gpu\n")
  compile(matrix-operand "${MATRIX_SUM}")
endif()

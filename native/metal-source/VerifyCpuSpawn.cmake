  elseif(VARIANT STREQUAL "sanitized")
    set(FLAG --sanitize)
  else()
    set(FLAG --thread-sanitize)
  endif()
  build_run(${VARIANT} "${SOURCE}" "${EXPECTED}" "${FLAG}")

include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/matmul-reduction.k" SOURCE)
string(FIND "${SOURCE}" "\nfn main()" SPLIT)
string(SUBSTRING "${SOURCE}" 0 ${SPLIT} OPS)
string(SUBSTRING "${SOURCE}" ${SPLIT} -1 MAIN)
string(REPLACE "fn project(" "export fn project(" OPS "${OPS}")
file(WRITE "${ROOT}/operations.k" "${OPS}")
file(WRITE "${ROOT}/public.k" "export from \"./operations.k\" import project as calculate\n")
set(PREFIX "from \"./public.k\" import calculate as project\nfn forward(values:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  values\n")
set(MAIN "${PREFIX}${MAIN}")
foreach(NAME IN ITEMS input weights bias)
  string(REPLACE "transfer(${NAME}, gpu)" "transfer(forward(${NAME}), gpu)" MAIN "${MAIN}")
endforeach()
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
function(reject NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS}: ${ERROR}")
  endif()
endfunction()
compile(imported "${MAIN}")
file(READ "${OUTPUT_DIR}/imported/manifest.txt" MANIFEST)
if(NOT MANIFEST MATCHES "reduction_stage=kernel0-reduce" OR
   NOT MANIFEST MATCHES "left_tensor_bindings=0" OR NOT MANIFEST MATCHES "right_tensor_bindings=1")
  message(FATAL_ERROR "Matrix/reduction stage manifest lost")
endif()
foreach(SIDE IN ITEMS plain left right)
  set(ONE "${OPS}")
  if(NOT SIDE STREQUAL "right")
    string(REPLACE "weights - 1" "weights" ONE "${ONE}")
  endif()
  if(NOT SIDE STREQUAL "left")
    string(REPLACE "input + scale" "input" ONE "${ONE}")
  endif()
  file(WRITE "${ROOT}/operations.k" "${ONE}")
  compile(${SIDE} "${MAIN}")
endforeach()
set(SQUARE "fn squared(v:Tensor[float32,?,?])->float32:\n  reduceSum(matmul(v,v))\n")
string(REPLACE "spawn project(a, 2, b)" "spawn squared(a)" SQUARE_MAIN "${MAIN}")
string(REPLACE "Tensor[float32, 2, 3] = tensor([[1, 2, 3], [4, 5, 6]])" "Tensor[float32, 2, 2] = tensor([[1, 2], [3, 4]])" SQUARE_MAIN "${SQUARE_MAIN}")
compile(repeated "${SQUARE}${SQUARE_MAIN}")
set(HIGH_FN "fn many(a:Tensor[float32,?,?],b:Tensor[float32,?,?]")
set(HIGH_EXPR "a")
set(HIGH_ARGS "a,b")
foreach(I RANGE 0 29)
  string(APPEND HIGH_FN ",extra${I}:Tensor[float32,?,?]")
  string(APPEND HIGH_EXPR " + extra${I}")
  string(APPEND HIGH_ARGS ",a")
endforeach()
string(APPEND HIGH_FN ")->float32:\n  prepared=${HIGH_EXPR}\n  totalMatrix(prepared,b)\n")
set(TOTAL_MATRIX "fn totalMatrix(a:Tensor[float32,?,?],b:Tensor[float32,?,?])->float32:\n  reduceSum(matmul(a,b))\n")
string(REPLACE "spawn project(a, 2, b)" "spawn many(${HIGH_ARGS})" HIGH_MAIN "${MAIN}")
compile(indirect "${TOTAL_MATRIX}${HIGH_FN}${HIGH_MAIN}")
file(READ "${OUTPUT_DIR}/indirect/manifest.txt" HIGH_MANIFEST)
if(NOT HIGH_MANIFEST MATCHES "left_binding_layout=argument_buffer_tier2")
  message(FATAL_ERROR "Large input-map signature lost Tier 2 binding")
endif()
if(NOT DEFINED VARIANT)
  foreach(BOUNDARY IN ITEMS two-matrices two-reductions intermediate-arithmetic scalar-epilogue branch)
    set(BAD "${OPS}")
    if(BOUNDARY STREQUAL "two-matrices")
      string(REPLACE "  product = matmul" "  ignored = matmul(input, weights)\n  product = matmul" BAD "${BAD}")
    elseif(BOUNDARY STREQUAL "two-reductions")
      string(REPLACE "  reduceSum(product)" "  ignored = reduceSum(product)\n  reduceSum(product)" BAD "${BAD}")
    elseif(BOUNDARY STREQUAL "intermediate-arithmetic")
      string(REPLACE "reduceSum(product)" "reduceSum(product + 1)" BAD "${BAD}")
    elseif(BOUNDARY STREQUAL "scalar-epilogue")
      string(REPLACE "reduceSum(product)" "reduceSum(product) + 1" BAD "${BAD}")
    else()
      string(REPLACE "  reduceSum(product)" "  if scale > 0: reduceSum(product)\n  else: 0" BAD "${BAD}")
    endif()
    file(WRITE "${ROOT}/operations.k" "${BAD}")
    if(BOUNDARY STREQUAL "intermediate-arithmetic" OR BOUNDARY STREQUAL "scalar-epilogue")
      compile(${BOUNDARY} "${MAIN}")
    else()
      admit_case(${BOUNDARY} "${MAIN}")
    endif()
  endforeach()
  message(STATUS "Matrix/reduction source composition, independent maps and bounded rejection passed")
  return()
endif()
run(imported "43350000\n" 0)
run(plain "43230000\n" 0)
run(left "43770000\n" 0)
run(right "42f20000\n" 0)
run(repeated "42580000\n" 0)
run(indirect "459de800\n" 0)
file(COPY "${OUTPUT_DIR}/imported/" DESTINATION "${OUTPUT_DIR}/relocated")
run(relocated "43350000\n" 0)
file(WRITE "${ROOT}/operations.k" "${OPS}")
string(REPLACE "Tensor[float32, 3, 2] = tensor([[1, 2], [3, 4], [5, 6]])" "Tensor[float32, 2, 2] = tensor([[1, 2], [3, 4]])" BAD "${MAIN}")
compile(shape-fault "${BAD}")
run(shape-fault "" 1)
set(SEPARATE "fn shift(v:Tensor[float32,?,?],s:float32)->Tensor[float32,?,?]:\n  v+s\nfn adjust(v:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  v-1\nfn multiply(a:Tensor[float32,?,?],b:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  matmul(a,b)\nfn sum(v:Tensor[float32,?,?])->float32:\n  reduceSum(v)\n${MAIN}")
string(REPLACE "    work = spawn project(a, 2, b) on gpu" "    left = try await spawn shift(a,2) on gpu\n    right = try await spawn adjust(b) on gpu\n    product = try await spawn multiply(left,right) on gpu\n    work = spawn sum(product) on gpu" SEPARATE "${SEPARATE}")
compile(separate "${SEPARATE}")
run(separate "43350000\n" 0)
foreach(SUFFIX IN ITEMS mlir lowered.mlir metal)
  foreach(STAGE IN ITEMS matrix reduction)
    if(STAGE STREQUAL "matrix")
      set(AFILE "kernel0.${SUFFIX}")
      set(BFILE "kernel2.${SUFFIX}")
    else()
      set(AFILE "kernel0-reduce.${SUFFIX}")
      set(BFILE "kernel3.${SUFFIX}")
    endif()
    file(SHA256 "${OUTPUT_DIR}/imported/${AFILE}" A)
    file(SHA256 "${OUTPUT_DIR}/separate/${BFILE}" B)
    if(NOT A STREQUAL B)
      message(FATAL_ERROR "Composition changed strict ${STAGE} shader ${SUFFIX}")
    endif()
  endforeach()
endforeach()
message(STATUS "Matrix/reduction ${VARIANT}: imports, maps, repeated input, Tier 2, shape fault, relocation and byte-identical primitives passed")

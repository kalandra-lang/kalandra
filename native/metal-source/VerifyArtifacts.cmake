foreach(FIXTURE IN ITEMS placed composed)
  set(BASE "${OUTPUT_DIR}/${FIXTURE}/kernel0")
  file(READ "${BASE}.mlir" RAW)
  file(READ "${BASE}.lowered.mlir" LOWERED)
  file(READ "${BASE}.spvasm" SPIRV)
  if(NOT RAW MATCHES "arith.addf" OR NOT RAW MATCHES "arith.mulf" OR
     LOWERED MATCHES "arith\\.(addf|mulf|divf)" OR SPIRV MATCHES "OpF(Add|Mul|Div)|Fma|FPFastMathMode")
    message(FATAL_ERROR "${FIXTURE}: source arithmetic or strict lowering changed")
  endif()
  file(READ "${BASE}.reflection.json" REFLECTION)
  string(JSON ENTRY GET "${REFLECTION}" entryPoints 0 name)
  string(JSON X GET "${REFLECTION}" entryPoints 0 workgroup_size 0)
  string(JSON Y GET "${REFLECTION}" entryPoints 0 workgroup_size 1)
  string(JSON Z GET "${REFLECTION}" entryPoints 0 workgroup_size 2)
  string(JSON BUFFERS LENGTH "${REFLECTION}" ssbos)
  if(NOT ENTRY STREQUAL "kalandra_elementwise" OR NOT X EQUAL 64 OR NOT Y EQUAL 1 OR NOT Z EQUAL 1 OR NOT BUFFERS EQUAL 4)
    message(FATAL_ERROR "${FIXTURE}: source kernel ABI changed")
  endif()
  foreach(I RANGE 0 3)
    string(JSON BINDING GET "${REFLECTION}" ssbos ${I} binding)
    string(JSON SIZE GET "${REFLECTION}" ssbos ${I} block_size)
    if(I EQUAL 3)
      set(EXPECTED 8)
    else()
      set(EXPECTED 0)
    endif()
    if(NOT BINDING EQUAL I OR NOT SIZE EQUAL EXPECTED)
      message(FATAL_ERROR "${FIXTURE}: source buffer layout changed")
    endif()
  endforeach()
endforeach()
file(SHA256 "${OUTPUT_DIR}/placed/kernel0.spv" PLACED)
file(SHA256 "${OUTPUT_DIR}/composed/kernel0.spv" COMPOSED)
if(PLACED STREQUAL COMPOSED)
  message(FATAL_ERROR "Different source bodies produced identical GPU kernels")
endif()
file(READ "${OUTPUT_DIR}/composed/kernel0.mlir" COMPOSED_IR)
if(NOT COMPOSED_IR MATCHES "arith.bitcast")
  message(FATAL_ERROR "Source scalar literal lowering missing")
endif()
message(STATUS "Distinct source kernels, strict arithmetic, scalar constants, and buffer ABI verified")

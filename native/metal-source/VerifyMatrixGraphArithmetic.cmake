include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/matrix-graph-arithmetic.k" SOURCE)
string(FIND "${SOURCE}" "\nfn main()" SPLIT)
string(SUBSTRING "${SOURCE}" 0 ${SPLIT} OPS)
string(SUBSTRING "${SOURCE}" ${SPLIT} -1 MAIN)
string(REPLACE "fn project(" "export fn project(" OPS "${OPS}")
file(WRITE "${ROOT}/operations.k" "${OPS}")
file(WRITE "${ROOT}/public.k" "export from \"./operations.k\" import project as calculate\n")
set(PREFIX "from \"./public.k\" import calculate as project\nfn forward(values:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  values\n")
set(MAIN "${PREFIX}${MAIN}")
foreach(NAME IN ITEMS input weights projection bias)
  string(REPLACE "transfer(${NAME}, gpu)" "transfer(forward(${NAME}), gpu)" MAIN "${MAIN}")
endforeach()
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
function(reject NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
  if(NAME STREQUAL "expansion" AND NOT ERROR MATCHES "GPU graph shader expansion limit exceeded")
    message(FATAL_ERROR "Graph expansion lost its bounded diagnostic: ${ERROR}")
  endif()

  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS}: ${ERROR}")
  endif()
endfunction()
compile(imported "${MAIN}")
file(READ "${OUTPUT_DIR}/imported/manifest.txt" MANIFEST)
if(NOT MANIFEST MATCHES "matrix_graph_products=2" OR NOT MANIFEST MATCHES "matrix_graph_stages=5" OR NOT MANIFEST MATCHES "map1_tensors=2" OR NOT MANIFEST MATCHES "map3_tensors=1")
  message(FATAL_ERROR "Lost arithmetic graph stages: ${MANIFEST}")
endif()
string(REPLACE "-(values + bias) / scale" "scale / (values - bias)" ORDERED "${OPS}")
file(WRITE "${ROOT}/operations.k" "${ORDERED}")
compile(operand-order "${MAIN}")
# Maps before the first product and after the last product also compose with a final reduction.
string(REPLACE "multiply(input, weights)" "multiply(input + scale, weights)" SCORE "${OPS}")
string(REPLACE "  multiply(shifted, projection)" "  reduceSum(multiply(shifted, projection) + bias) / scale" SCORE "${SCORE}")
string(REPLACE "scale: float32) -> Tensor[float32, ?, ?]:\n  hidden" "scale: float32) -> float32:\n  hidden" SCORE "${SCORE}")
file(WRITE "${ROOT}/operations.k" "${SCORE}")
string(REPLACE "fn main() -> Tensor[float32, ?, ?]" "fn main() -> float32" SCALAR_MAIN "${MAIN}")
string(REPLACE "try await transfer(cached, devices.cpu())" "cached" SCALAR_MAIN "${SCALAR_MAIN}")
compile(scalar "${SCALAR_MAIN}")
file(WRITE "${ROOT}/operations.k" "${OPS}")
string(REPLACE "transfer(forward(bias), gpu)" "transfer(forward(weights), gpu)" WRONG "${MAIN}")
compile(wrong-shape "${WRONG}")
string(REPLACE "  multiply(shifted, projection)" "  multiply(shifted, projection) - multiply(hidden, projection)" SHARED "${OPS}")
file(WRITE "${ROOT}/operations.k" "${SHARED}")
compile(shared "${MAIN}")
if(DEFINED VARIANT)
  run(imported "[c2620000,c2a60000,c3000000,c33c0000]\n" 0)
  run(operand-order "[3ea6ea6f,3eff0ff2,3e12ebf8,3e6193aa]\n" 0)
  run(scalar "c3a6e000\n" 0)
  run(shared "[c3228000,c36f0000,c3b88000,c4078000]\n" 0)
  run(wrong-shape "" 1)
  file(COPY "${OUTPUT_DIR}/imported/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "[c2620000,c2a60000,c3000000,c33c0000]\n" 0)
else()
  foreach(CASE IN ITEMS unused branch)
    if(CASE STREQUAL "unused")
      string(REPLACE "  hidden =" "  unused=matmul(input,weights)\n  hidden =" BAD "${OPS}")
    else()
      string(REPLACE "  multiply(shifted, projection)" "  if true:\n    multiply(shifted,projection)\n  else:\n    shifted" BAD "${OPS}")
    endif()
    file(WRITE "${ROOT}/operations.k" "${BAD}")
    admit_case(${CASE} "${MAIN}")
  endforeach()
  set(CHAIN "")
  set(PREVIOUS hidden)
  foreach(I RANGE 0 399)
    string(APPEND CHAIN "  v${I}=${PREVIOUS}+scale\n")
    set(PREVIOUS "v${I}")
  endforeach()
  string(APPEND CHAIN "  shifted=${PREVIOUS}")
  string(REPLACE "  shifted = adjust(hidden, bias, scale)" "${CHAIN}" EXPANSION "${OPS}")
  file(WRITE "${ROOT}/operations.k" "${EXPANSION}")
  reject(expansion "${MAIN}")

endif()

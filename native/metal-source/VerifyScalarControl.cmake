include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/scalar-control.k" SOURCE)
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
compile(control "${SOURCE}")
file(READ "${OUTPUT_DIR}/control/kernel0.mlir" IR)
file(READ "${OUTPUT_DIR}/control/manifest.txt" MANIFEST)
if(IR MATCHES "arith.cmpf" OR IR MATCHES "arith.select[^\n]*: f32" OR NOT IR MATCHES "arith.cmpi" OR NOT MANIFEST MATCHES "kernel1.graph_result=tensor")
  message(FATAL_ERROR "GPU control lost strict bitwise comparisons/selections or resident feedback")
endif()
# Branch-local bindings and nested scalar choices.
string(REPLACE "    total\n  else:\n    threshold" "    doubled=total * 2\n    doubled / 2\n  else:\n    if threshold==0:\n      1\n    else:\n      threshold" NESTED "${SOURCE}")
compile(nested "${NESTED}")
set(BOOLEAN_HELPER "fn above(a:float32,b:float32)->float32:\n  valid=(a>b or a<b) and not (a<=b)\n  if valid:\n    1\n  else:\n    0\n")
string(REPLACE "total > threshold and not (total != total)" "above(total,threshold)>0" BOOL "${SOURCE}")
compile(boolean-helper "${BOOLEAN_HELPER}${BOOL}")
# Select a sign/subnormal payload unchanged, without arithmetic in either arm.
set(SELECT "fn pick(a:float32,b:float32)->float32:\n  if a>b:\n    a\n  else:\n    b\nfn apply(values:Tensor[float32,?],a:float32,b:float32)->Tensor[float32,?]:\n  values / pick(a,b)\nfn main()->Tensor[float32,?] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    values:Tensor[float32,1]=tensor([1])\n    x=try await transfer(values,gpu)\n    y=try await spawn apply(x,0,-0.0) on gpu\n    try await transfer(y,devices.cpu())\n")
compile(signed-zero "${SELECT}")
# Single reduction is used only in the predicate, so it must still be captured.
set(PREDICATE "fn positive(values:Tensor[float32,?])->Tensor[float32,?]:\n  total=reduceSum(values)\n  factor:float32=if total>0:\n    2\n  else:\n    3\n  values * factor\nfn main()->Tensor[float32,?] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,2]=tensor([1,2])\n    x=try await transfer(a,gpu)\n    y=try await spawn positive(x) on gpu\n    try await transfer(y,devices.cpu())\n")
compile(predicate "${PREDICATE}")
# Constant predicates and identical arms must keep the generated interface valid.
string(REPLACE "    3" "    2" SAME "${PREDICATE}")
compile(same-arms "${SAME}")
string(REPLACE "    2" "    total" CONSTANT "${PREDICATE}")
string(REPLACE "total>0" "true" CONSTANT "${CONSTANT}")
compile(constant "${CONSTANT}")
# A scalar conditional may consume multiple reduced values in a final scalar join.
set(JOIN "fn choose(a:float32,b:float32)->float32:\n  if a>b:\n    a\n  else:\n    b\nfn maximum(a:Tensor[float32,?],b:Tensor[float32,?])->float32:\n  choose(reduceSum(a),reduceSum(b))\nfn main()->float32 ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,2]=tensor([1,2])\n    b:Tensor[float32,2]=tensor([3,4])\n    x=try await transfer(a,gpu)\n    y=try await transfer(b,gpu)\n    try await spawn maximum(x,y) on gpu\n")
compile(join "${JOIN}")
string(REPLACE "    a\n  else:" "    b\n  else:" JOIN_SAME "${JOIN}")
compile(join-same-arms "${JOIN_SAME}")
if(DEFINED VARIANT)
  run(control "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(nested "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(boolean-helper "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(signed-zero "[ff800000]\n" 0)
  run(predicate "[40000000,40800000]\n" 0)
  run(same-arms "[40000000,40800000]\n" 0)
  run(constant "[40400000,40c00000]\n" 0)
  run(join "40e00000\n" 0)
  run(join-same-arms "40e00000\n" 0)
  file(COPY "${OUTPUT_DIR}/control/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
else()
  # Branches with numerical primitives must not be speculated into a graph.
  string(REPLACE "  denominator = choose(total, threshold)" "  denominator:float32=if total>threshold:\n    reduceSum(values)\n  else:\n    threshold" BAD "${SOURCE}")
  admit_case(branch-reduction "${BAD}")
endif()

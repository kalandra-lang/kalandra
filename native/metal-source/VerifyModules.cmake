file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(COPY "${SOURCE_DIR}/modules/" DESTINATION "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${ROOT}/main.k" MAIN)
file(READ "${ROOT}/kernels/arithmetic.k" LIBRARY)

function(compile_source NAME)
  execute_process(COMMAND "${COMPILER}" --arithmetic software ${ARGN} -o "${OUTPUT_DIR}/${NAME}"
    WORKING_DIRECTORY "${OUTPUT_DIR}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()

function(run_program NAME EXPECTED)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      "${OUTPUT_DIR}/${NAME}/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "${EXPECTED}\n" OR
        ERROR MATCHES "(AddressSanitizer|runtime error:|ThreadSanitizer)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
  endforeach()
endfunction()

if(DEFINED VARIANT)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
  compile_source(relative "${ROOT}/main.k" --target metal ${FLAGS})
  run_program(relative 43108000)

  # Equivalent explicit package and manifest graphs; no registry or runtime lookup.
  string(REPLACE "\"./kernels/public.k\"" "\"math\"" PACKAGE_MAIN "${MAIN}")
  file(WRITE "${ROOT}/package.k" "${PACKAGE_MAIN}")
  compile_source(package "${ROOT}/package.k" --target metal --package "math=${ROOT}/kernels/public.k" ${FLAGS})
  run_program(package 43108000)
  file(WRITE "${ROOT}/kalandra.toml" "format=1\n[project]\nentry=\"package.k\"\n[packages]\nmath=\"kernels/public.k\"\n")
  compile_source(project --project "${ROOT}/kalandra.toml" --target metal ${FLAGS})
  run_program(project 43108000)

  file(READ "${SOURCE_DIR}/../../docs/design/native-metal-modules.md" GUIDE)
  string(REGEX MATCHALL "```kalandra\n[^`]*```" EXAMPLES "${GUIDE}")
  list(LENGTH EXAMPLES EXAMPLE_COUNT)
  if(NOT EXAMPLE_COUNT EQUAL 2)
    message(FATAL_ERROR "Expected the two-file Metal module guide example")
  endif()
  foreach(INDEX IN ITEMS 0 1)
    list(GET EXAMPLES ${INDEX} EXAMPLE)
    string(REGEX REPLACE "^```kalandra\n|```$" "" EXAMPLE "${EXAMPLE}")
    if(INDEX EQUAL 0)
      set(NAME math)
    else()
      set(NAME main)
    endif()
    file(WRITE "${ROOT}/guide/${NAME}.k" "${EXAMPLE}")
  endforeach()
  compile_source(guide "${ROOT}/guide/main.k" --target metal ${FLAGS})
  run_program(guide 41400000)

  # Split established numerical/recovery fixtures without changing their bodies.
  foreach(FIXTURE IN ITEMS matmul reduction matrix-elementwise resumable-helpers)
    file(READ "${SOURCE_DIR}/${FIXTURE}.k" SOURCE)
    string(REGEX MATCHALL "(^|\n)fn [A-Za-z_][A-Za-z_0-9]*" FUNCTIONS "${SOURCE}")
    set(IMPORTS "")
    foreach(FUNCTION IN LISTS FUNCTIONS)
      string(REGEX REPLACE "(^|\n)fn " "" FUNCTION "${FUNCTION}")
      if(NOT FUNCTION STREQUAL "main")
        if(NOT IMPORTS STREQUAL "")
          string(APPEND IMPORTS ", ")
        endif()
        string(APPEND IMPORTS "${FUNCTION}")
      endif()
    endforeach()
    # Every top-level declaration starts at column zero; expressions retain source text.
    string(REGEX MATCHALL "(^|\n)fn [^\n]*(\n  [^\n]*|\n)*" DECLARATIONS "${SOURCE}")
    set(HELPERS "")
    set(ENTRY "")
    foreach(DECLARATION IN LISTS DECLARATIONS)
      string(REGEX REPLACE "^\n" "" DECLARATION "${DECLARATION}")
      if(DECLARATION MATCHES "^fn main\\(")
        set(ENTRY "${DECLARATION}")
      else()
        string(APPEND HELPERS "export ${DECLARATION}\n")
      endif()
    endforeach()
    file(MAKE_DIRECTORY "${ROOT}/${FIXTURE}")
    file(WRITE "${ROOT}/${FIXTURE}/library.k" "${HELPERS}")
    file(WRITE "${ROOT}/${FIXTURE}/main.k" "from \"./library.k\" import ${IMPORTS}\n${ENTRY}\n")
    compile_source("split-${FIXTURE}" "${ROOT}/${FIXTURE}/main.k" --target metal ${FLAGS})
    if(FIXTURE STREQUAL "matmul")
      set(EXPECTED 43230000)
    elseif(FIXTURE STREQUAL "reduction")
      set(EXPECTED 41f80000)
    elseif(FIXTURE STREQUAL "matrix-elementwise")
      set(EXPECTED "[41a00000,41d80000,42080000,42240000,42400000,425c0000]")
    else()
      set(EXPECTED 43340000)
    endif()
    run_program("split-${FIXTURE}" "${EXPECTED}")
  endforeach()
  # Dependency changes are read on every build, including through re-exports.
  string(REPLACE "+ 0.5" "+ 1" CHANGED "${LIBRARY}")
  file(WRITE "${ROOT}/kernels/arithmetic.k" "${CHANGED}")
  compile_source(relative "${ROOT}/main.k" --target metal ${FLAGS})
  run_program(relative 43140000)
  # A compiled bundle has no source/manifest dependency and is relocatable.
  file(RENAME "${ROOT}" "${ROOT}-detached")
  file(RENAME "${OUTPUT_DIR}/project" "${OUTPUT_DIR}/relocated")
  run_program(relocated 43108000)
  file(RENAME "${ROOT}-detached" "${ROOT}")
  file(RENAME "${OUTPUT_DIR}/relocated" "${OUTPUT_DIR}/project")
  message(STATUS "Multi-file Metal ${VARIANT}: nine builds, 30 runs with 1/2/4 workers passed")
  return()
endif()

compile_source(valid "${ROOT}/main.k")
file(SHA256 "${OUTPUT_DIR}/valid/host.cpp" BEFORE)
compile_source(valid "${ROOT}/main.k")
file(SHA256 "${OUTPUT_DIR}/valid/host.cpp" AFTER)
if(NOT BEFORE STREQUAL AFTER)
  message(FATAL_ERROR "Multi-file compilation is not deterministic")
endif()
execute_process(COMMAND "${CHECKER}" --placement --dump-plan "${ROOT}/main.k"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR OUT STREQUAL "")
  message(FATAL_ERROR "Placement checker/planner rejected module graph: ${ERROR}")
endif()

function(reject NAME PATTERN)
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" "sentinel")
  execute_process(COMMAND "${COMPILER}" --arithmetic software ${ARGN} -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "${PATTERN}")
    message(FATAL_ERROR "${NAME}: missing ${PATTERN}: ${STATUS} ${OUT} ${ERROR}")
  endif()
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
  if(NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME}: failure published output")
  endif()
endfunction()

foreach(PAIR IN ITEMS "private|helper|S067" "missing|absent|S067" "duplicate|offset, offset|S004")
  string(REPLACE "|" ";" PARTS "${PAIR}")
  list(GET PARTS 0 NAME)
  list(GET PARTS 1 BINDING)
  list(GET PARTS 2 CODE)
  string(REPLACE "import offset\n" "import ${BINDING}\n" BAD "${MAIN}")
  file(WRITE "${ROOT}/${NAME}.k" "${BAD}")
  reject("${NAME}" "${CODE}" "${ROOT}/${NAME}.k")
endforeach()
string(REPLACE "value * 2" "missing(value)" BAD "${LIBRARY}")
file(WRITE "${ROOT}/kernels/arithmetic.k" "${BAD}")
reject(diagnostic "arithmetic.k:2:[0-9]+:" "${ROOT}/main.k")
file(WRITE "${ROOT}/kernels/arithmetic.k" "${LIBRARY}")
file(WRITE "${ROOT}/cycle.k" "from \"./cycle.k\" import x\nexport fn x()->float32:\n  0\n")
reject(cycle M003 "${ROOT}/cycle.k")
reject(duplicate-package "duplicate local package" "${ROOT}/main.k" --package "math=unused.k" --package "math=unused.k")

# Each possible publication target must protect all source dependencies, even hard links.
foreach(NAME IN ITEMS host.cpp cpu.ll placement.ir continuation.plan manifest.txt kernel0.mlir kernel0.metal program)
  set(DEST "${OUTPUT_DIR}/protect-${NAME}")
  file(MAKE_DIRECTORY "${DEST}")
  file(REMOVE "${DEST}/${NAME}")
  file(CREATE_LINK "${ROOT}/kernels/arithmetic.k" "${DEST}/${NAME}" RESULT LINK_STATUS)
  if(NOT LINK_STATUS STREQUAL "0")
    message(FATAL_ERROR "Cannot create source protection hard link: ${LINK_STATUS}")
  endif()
  file(SHA256 "${ROOT}/kernels/arithmetic.k" BEFORE)
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/main.k" -o "${DEST}" --build
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  file(SHA256 "${ROOT}/kernels/arithmetic.k" AFTER)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "source and output" OR NOT BEFORE STREQUAL AFTER)
    message(FATAL_ERROR "${NAME}: imported source was not protected: ${OUT} ${ERROR}")
  endif()
  file(REMOVE "${DEST}/${NAME}")
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/symlink")
file(REMOVE "${OUTPUT_DIR}/symlink/host.cpp")
file(CREATE_LINK "${ROOT}/kernels/arithmetic.k" "${OUTPUT_DIR}/symlink/host.cpp" SYMBOLIC)
execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/main.k" -o "${OUTPUT_DIR}/symlink"
  RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
if(STATUS EQUAL 0 OR NOT ERROR MATCHES "(source and output|symlink output)")
  message(FATAL_ERROR "Symlink source alias admitted: ${ERROR}")
endif()
file(REMOVE "${OUTPUT_DIR}/symlink/host.cpp")

file(WRITE "${ROOT}/project.toml" "format=1\n[project]\nentry=\"main.k\"\n")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/manifest-alias")
file(REMOVE "${OUTPUT_DIR}/manifest-alias/manifest.txt")
file(CREATE_LINK "${ROOT}/project.toml" "${OUTPUT_DIR}/manifest-alias/manifest.txt")
file(SHA256 "${ROOT}/project.toml" BEFORE)
execute_process(COMMAND "${COMPILER}" --arithmetic software --project "${ROOT}/project.toml" -o "${OUTPUT_DIR}/manifest-alias"
  RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
file(SHA256 "${ROOT}/project.toml" AFTER)
if(STATUS EQUAL 0 OR NOT ERROR MATCHES "source and output" OR NOT BEFORE STREQUAL AFTER)
  message(FATAL_ERROR "Manifest alias overwritten: ${ERROR}")
endif()
file(REMOVE "${OUTPUT_DIR}/manifest-alias/manifest.txt")

file(WRITE "${ROOT}/no-entry.k" "from \"./kernels/arithmetic.k\" import main as other\n")
reject(no-entry "missing main" "${ROOT}/no-entry.k")
string(REPLACE "left * right" "left % right" BAD "${LIBRARY}")
file(WRITE "${ROOT}/kernels/arithmetic.k" "${BAD}")
reject(unsupported-kernel "(G001|S0[0-9]+)" "${ROOT}/main.k")
file(WRITE "${ROOT}/kernels/arithmetic.k" "${LIBRARY}")
string(REPLACE "spawn run(values)" "spawn calculate(values, values) on devices.gpu()" BAD "${MAIN}")
file(WRITE "${ROOT}/hidden-upload.k" "${BAD}")
reject(hidden-upload "(G001|S0[0-9]+)" "${ROOT}/hidden-upload.k")
reject(conflicting-entry "usage:" "${ROOT}/main.k" --project "${ROOT}/project.toml")
reject(duplicate-output "usage:" "${ROOT}/main.k" -o "${OUTPUT_DIR}/other")
reject(conflicting-build "usage:" "${ROOT}/main.k" --build -O2 --sanitize)
message(STATUS "Multi-file Metal graph/diagnostic/CLI/source protection checks passed")

include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/tensor-control.k" SOURCE)
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
compile(control "${SOURCE}")
file(READ "${OUTPUT_DIR}/control/manifest.txt" MANIFEST)
if(NOT MANIFEST MATCHES "kernel1.matrix_graph_stages=1" OR NOT MANIFEST MATCHES "kernel1.reduction_broadcasts=0:0" OR EXISTS "${OUTPUT_DIR}/control/kernel1-map1.mlir")
  message(FATAL_ERROR "Tensor choice must be one fused map: ${MANIFEST}")
endif()
string(REPLACE "Tensor[float32, ?]" "Tensor[float32, ?, ?]" MATRIX "${SOURCE}")
string(REPLACE "Tensor[float32, 3] = tensor([1, 2, 3])" "Tensor[float32, 1, 3] = tensor([[1, 2, 3]])" MATRIX "${MATRIX}")
compile(matrix "${MATRIX}")
string(REPLACE "normalize(first, 1)" "normalize(first, 100)" FALSE "${SOURCE}")
compile(false-arm "${FALSE}")
string(REPLACE "    values / total" "    values * threshold" SAME "${SOURCE}")
compile(same-arms "${SAME}")
string(REPLACE "    values * factor" "    shifted=values+factor\n    if factor>1:\n      shifted*factor\n    else:\n      shifted/factor" NESTED "${SOURCE}")
compile(nested "${NESTED}")
set(HELPER "fn divided(values:Tensor[float32,?],factor:float32)->Tensor[float32,?]:\n  values/factor\n")
string(REPLACE "    values / total" "    unused=values+threshold\n    divided(values,total)" HELPERS "${SOURCE}")
compile(helpers "${HELPER}${HELPERS}")
string(REPLACE "  total = reduceSum(values)" "  total = reduceSum(values)\n  base = values + threshold" INTERMEDIATE "${SOURCE}")
string(REPLACE "    values / total" "    base / total" INTERMEDIATE "${INTERMEDIATE}")
string(REPLACE "    values * threshold" "    base * threshold" INTERMEDIATE "${INTERMEDIATE}")
compile(intermediate "${INTERMEDIATE}")
string(REPLACE "Tensor[float32, 3] = tensor([1, 2, 3])" "Tensor[float32, 0] = tensor([])" EMPTY "${SOURCE}")
compile(empty "${EMPTY}")
set(SUM "fn choose(values:Tensor[float32,?],factor:float32)->Tensor[float32,?]:\n  if factor>0:\n    values*factor\n  else:\n    -values/factor\nfn score(values:Tensor[float32,?],factor:float32)->float32:\n  reduceSum(choose(values,factor))\nfn main()->float32 ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,3]=tensor([1,2,3])\n    x=try await transfer(a,gpu)\n    try await spawn score(x,2) on gpu\n")
compile(sum "${SUM}")
set(PRODUCT "fn choose(values:Tensor[float32,?,?],factor:float32)->Tensor[float32,?,?]:\n  if factor>0:\n    values*factor\n  else:\n    -values/factor\nfn project(a:Tensor[float32,?,?],b:Tensor[float32,?,?],factor:float32)->Tensor[float32,?,?]:\n  matmul(choose(a,factor),b)\nfn main()->Tensor[float32,?,?] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,2,2]=tensor([[1,0],[0,1]])\n    x=try await transfer(a,gpu)\n    y=try await spawn project(x,x,2) on gpu\n    try await transfer(y,devices.cpu())\n")
compile(product "${PRODUCT}")
set(SCORE "fn score(values:Tensor[float32,?],threshold:float32)->float32:\n  total=reduceSum(values)\n  chosen=if total>threshold:\n    values/total\n  else:\n    values*threshold\n  reduceSum(chosen)\nfn main()->float32 ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,3]=tensor([1,2,3])\n    x=try await transfer(a,gpu)\n    try await spawn score(x,1) on gpu\n")
compile(score "${SCORE}")
if(DEFINED VARIANT)
  run(control "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(matrix "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(false-arm "[43480000,43c80000,44160000]\n" 0)
  run(same-arms "[40000000,40800000,40c00000]\n" 0)
  run(nested "[3e800000,3eaaaaab,3ed55555]\n" 0)
  run(helpers "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(intermediate "[3e800000,3ed55555,3f155555]\n" 0)
  run(empty "[]\n" 0)
  run(sum "41400000\n" 0)
  run(product "[40000000,00000000,00000000,40000000]\n" 0)
  run(score "3f800000\n" 0)
  file(COPY "${OUTPUT_DIR}/control/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
else()
  function(reject NAME SOURCE)
    file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
    file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
    file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
    execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
    file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
    if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
      message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS} ${ERROR}")
    endif()
  endfunction()
  string(REPLACE "    values / total" "    values/reduceSum(values)" BAD "${SOURCE}")
  admit_case(primitive "${BAD}")
  string(REPLACE "  total = reduceSum(values)" "  other=reduceSum(values)\n  total=reduceSum(values)" BAD "${SOURCE}")
  string(REPLACE "    values / total" "    unused=values/other\n    values/total" BAD "${BAD}")
  admit_case(unused-reduction "${BAD}")
  set(FIXED "fn fixed(values:Tensor[float32,3])->Tensor[float32,3]:\n  values\n")
  string(REPLACE "    values / total" "    fixed(values)" BAD "${SOURCE}")
  admit_case(fixed-helper "${FIXED}${BAD}")
  set(OTHER "fn choose(a:Tensor[float32,?],b:Tensor[float32,?],factor:float32)->Tensor[float32,?]:\n  if factor>0:\n    a+factor\n  else:\n    b-factor\nfn main()->Tensor[float32,?] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,2]=tensor([1,2])\n    b:Tensor[float32,3]=tensor([3,4,5])\n    x=try await transfer(a,gpu)\n    y=try await transfer(b,gpu)\n    z=try await spawn choose(x,y,1) on gpu\n    try await transfer(z,devices.cpu())\n")
  admit_case(other-source "${OTHER}")
endif()

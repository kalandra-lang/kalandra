file(READ "${SOURCE_DIR}/nested-parallel.k" SOURCE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(build_run NAME CONTENT EXPECTED FLAG)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal
    -o "${OUTPUT_DIR}/${NAME}" ${FLAG} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME} compilation: ${STATUS}: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      "${OUTPUT_DIR}/${NAME}/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL EXPECTED)
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}; expected ${EXPECTED}")
    endif()
  endforeach()
endfunction()
set(EXPECTED "42400000\n")
foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
  if(VARIANT STREQUAL "debug")
    set(FLAG "")
  elseif(VARIANT STREQUAL "optimized")
    set(FLAG -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAG --sanitize)
  else()
    set(FLAG --thread-sanitize)
  endif()
  build_run(${VARIANT} "${SOURCE}" "${EXPECTED}" "${FLAG}")
endforeach()
file(SHA256 "${OUTPUT_DIR}/optimized/host.cpp" HOST)
file(SHA256 "${OUTPUT_DIR}/optimized/cpu.ll" CPU)
execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/optimized.k" --target metal
  -o "${OUTPUT_DIR}/optimized" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
file(SHA256 "${OUTPUT_DIR}/optimized/host.cpp" HOST_AGAIN)
file(SHA256 "${OUTPUT_DIR}/optimized/cpu.ll" CPU_AGAIN)
if(NOT STATUS EQUAL 0 OR NOT HOST STREQUAL HOST_AGAIN OR NOT CPU STREQUAL CPU_AGAIN)
  message(FATAL_ERROR "Nested group compilation was not deterministic: ${ERROR}")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/relocated")
file(COPY "${OUTPUT_DIR}/optimized/program" "${OUTPUT_DIR}/optimized/kernel0.metallib"
  DESTINATION "${OUTPUT_DIR}/relocated")
execute_process(COMMAND "${OUTPUT_DIR}/relocated/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL EXPECTED)
  message(FATAL_ERROR "Relocated nested group program: ${STATUS}: ${OUT} ${ERROR}")
endif()

function(reject NAME CONTENT PATTERN)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" "sentinel")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal
    -o "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" SENTINEL)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "${PATTERN}" OR NOT SENTINEL STREQUAL "sentinel")
    message(FATAL_ERROR "${NAME} should reject transactionally: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()

string(FIND "${SOURCE}" "fn main()" MAIN)
string(SUBSTRING "${SOURCE}" 0 ${MAIN} FUNCTIONS)
set(START "fn main() -> float32 ! TaskError:\n  try parallel:\n    gpu = devices.gpu()\n")
# Numeric-only scopes still join; an outer annotation supplies literal context.
set(BODY "    host: Tensor[float32,3] = try parallel:\n      tensor([1,2,3])\n    result: float32 = try parallel:\n      1\n    input = try await transfer(host,gpu)\n    resident = try await spawn scale(input,result) on gpu\n    output = try await transfer(resident,devices.cpu())\n    reduceSum(output)\n")
build_run(context "${FUNCTIONS}${START}${BODY}" "40c00000\n" --sanitize)
string(REPLACE "float32,3" "float32,0" EMPTY "${BODY}")
string(REPLACE "tensor([1,2,3])" "tensor([])" EMPTY "${EMPTY}")
build_run(empty "${FUNCTIONS}${START}${EMPTY}" "00000000\n" --sanitize)
# Completed host tensors may escape several scopes and become the main result.
set(TENSOR "fn main() -> Tensor[float32,3] ! TaskError:\n  try parallel:\n    gpu = devices.gpu()\n    host: Tensor[float32,3] = try parallel:\n      nested: Tensor[float32,3] = try parallel:\n        tensor([1,2,3])\n      try await spawn shift(nested,1)\n    input = try await transfer(host,gpu)\n    resident = try await spawn scale(input,2) on gpu\n    try parallel:\n      try await transfer(resident,devices.cpu())\n")
build_run(tensor "${FUNCTIONS}${TENSOR}" "[40800000,40c00000,41000000]\n" --sanitize)
string(REPLACE "try await moved" "values" BAD "${SOURCE}")
reject(unobserved "${BAD}" "S038")
string(REPLACE "try await moved" "finished = try await moved\n        moved" BAD "${SOURCE}")
reject(task-escape "${BAD}" "S035")
string(REPLACE "try await moved" "finished = try await moved\n        gpu" BAD "${SOURCE}")
reject(target-escape "${BAD}" "S035")
string(REPLACE "result + reduceSum(values)" "result + inner" BAD "${SOURCE}")
reject(local-escape "${BAD}" "unknown value 'inner'")
string(REPLACE "prior + inner" "prior:float32 = 1\n      prior + inner" BAD "${SOURCE}")
reject(duplicate "${BAD}" "duplicate immutable binding")
string(REPLACE "try await spawn scale(input, 2) on gpu" "try await spawn scale(host, 2) on gpu" BAD "${SOURCE}")
reject(hidden-upload "${BAD}" "S047")
string(REPLACE "try await spawn total(host)" "try await spawn total(resident)" BAD "${SOURCE}")
reject(hidden-download "${BAD}" "explicit transfer")
# A dynamically checked CPU child fault must settle both inner and outer groups.
set(FIXED "fn fixed(values:Tensor[float32,2]) -> float32:\n  reduceSum(values)\n\nfn forward(values:Tensor[float32,?]) -> Tensor[float32,?]:\n  values\n\n")
string(REPLACE "try await spawn total(host)" "try await spawn fixed(forward(host))" BAD "${SOURCE}")
file(WRITE "${OUTPUT_DIR}/dynamic.k" "${FIXED}${BAD}")
execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/dynamic.k" --target metal
  -o "${OUTPUT_DIR}/dynamic" --sanitize RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0)
  message(FATAL_ERROR "Dynamic nested task mismatch should compile: ${OUT} ${ERROR}")
endif()
foreach(WORKERS IN ITEMS 1 2 4)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
    "${OUTPUT_DIR}/dynamic/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 1 OR NOT OUT STREQUAL "" OR NOT ERROR MATCHES "Metal task failed: 1/1")
    message(FATAL_ERROR "Nested child shape guard missing: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endforeach()

file(READ "${SOURCE_DIR}/unused-inputs.k" SOURCE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
foreach(VARIANT IN ITEMS optimized sanitized thread-sanitized)
  if(VARIANT STREQUAL "optimized")
    set(FLAG -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAG --sanitize)
  else()
    set(FLAG --thread-sanitize)
  endif()
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${SOURCE_DIR}/unused-inputs.k" --target metal
    -o "${OUTPUT_DIR}/${VARIANT}" "${FLAG}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${VARIANT}: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      "${OUTPUT_DIR}/${VARIANT}/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "[40a00000,41400000,41a80000]\n")
      message(FATAL_ERROR "${VARIANT}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
  endforeach()
endforeach()
file(READ "${OUTPUT_DIR}/optimized/manifest.txt" MANIFEST)
foreach(EXPECTED IN ITEMS "kernel0.tensor_bindings=1\n" "kernel1.tensor_bindings=1,3\n"
    "kernel2.tensor_bindings=39\n" "kernel2.tensors=40\n" "kernel3.tensor_bindings=1\n")
  string(FIND "${MANIFEST}" "${EXPECTED}" FOUND)
  if(FOUND EQUAL -1)
    message(FATAL_ERROR "Missing binding metadata: ${EXPECTED}")
  endif()
endforeach()
foreach(INDEX IN ITEMS 0 1 2 3)
  file(READ "${OUTPUT_DIR}/optimized/kernel${INDEX}.mlir" RAW)
  if(RAW MATCHES "memref.load %a0\\[")
    message(FATAL_ERROR "Unused first tensor still read in kernel ${INDEX}")
  endif()
  file(READ "${OUTPUT_DIR}/optimized/kernel${INDEX}.kernel.mlir" STRICT)
  if(STRICT MATCHES "spirv\\.(FAdd|FSub|FNegate|FMul|FDiv)|Fma|FPFastMathMode")
    message(FATAL_ERROR "Relaxed arithmetic in kernel ${INDEX}")
  endif()
endforeach()
# Keep compiled source contracts, even when a discarded operation is eliminated on device.
string(REPLACE "    local = compute(m, a, m, b, 1)" "" GPU_ONLY "${SOURCE}")
string(REPLACE "    dm = try await transfer(m, gpu)"
  "    dm = try await transfer(m, gpu)\n    n: Tensor[float32, 1, 4] = tensor([[7, 8, 9, 10]])\n    dn = try await transfer(n, gpu)"
  BAD "${GPU_ONLY}")
string(REPLACE "compute(dm, chosen, dm, db, 1)" "compute(dm, chosen, dn, db, 1)" BAD "${BAD}")
function(reject NAME CONTENT EXPECTED)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" "sentinel")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal
    -o "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" SENTINEL)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "${EXPECTED}" OR NOT SENTINEL STREQUAL "sentinel")
    message(FATAL_ERROR "${NAME}: missing transactional diagnostic: ${ERROR}")
  endif()
endfunction()
reject(discarded-shape "${BAD}" "S033")
string(REPLACE "transfer(n, gpu)" "transfer(forward(n), gpu)" DYNAMIC "${BAD}")
# Also reject before dispatch when the result domain is empty.
foreach(EMPTY IN ITEMS no yes)
  set(CONTENT "${DYNAMIC}")
  if(EMPTY STREQUAL "yes")
    string(REPLACE "Tensor[float32, 3] = tensor([1, 2, 3])" "Tensor[float32, 0] = tensor([])" CONTENT "${CONTENT}")
    string(REPLACE "Tensor[float32, 3] = tensor([4, 5, 6])" "Tensor[float32, 0] = tensor([])" CONTENT "${CONTENT}")
    string(REPLACE "fn main() -> Tensor[float32, 3]" "fn main() -> Tensor[float32, 0]" CONTENT "${CONTENT}")
  endif()
  file(WRITE "${OUTPUT_DIR}/dynamic-${EMPTY}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/dynamic-${EMPTY}.k" --target metal
    -o "${OUTPUT_DIR}/dynamic-${EMPTY}" --sanitize RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "Dynamic discarded shape failed to compile: ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      "${OUTPUT_DIR}/dynamic-${EMPTY}/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 1 OR NOT OUT STREQUAL "" OR NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "Discarded shape bypassed guard: ${STATUS}: ${OUT} ${ERROR}")
    endif()
  endforeach()
endforeach()
string(REPLACE "discarded = ignored + other" "discarded = ignored % other" BAD "${GPU_ONLY}")
reject(discarded-unsupported "${BAD}" "S019")
# All logical arguments remain subject to explicit transfer requirements.
string(REPLACE "spawn choose(dm, da, db)" "spawn choose(m, da, db)" BAD "${SOURCE}")
reject(unused-residency "${BAD}" "S047")
message(STATUS "Unused tensor captures, compact bindings, transitive and discarded shape contracts passed")

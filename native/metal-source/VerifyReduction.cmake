file(READ "${SOURCE_DIR}/reduction.k" SOURCE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(run NAME CONTENT EXPECTED FLAG)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal -o "${OUTPUT_DIR}/${NAME}" "${FLAG}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME} build failed: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "${EXPECTED}\n")
      message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
  endforeach()
endfunction()
run(source "${SOURCE}" "41f80000" -O2)
# Kernel remains an explicit adjacent-pair tree stage with strict integer lowering.
file(READ "${OUTPUT_DIR}/source/kernel1.mlir" RAW)
file(READ "${OUTPUT_DIR}/source/kernel1.lowered.mlir" STRICT)
file(READ "${OUTPUT_DIR}/source/kernel1.kernel.mlir" SPIRV)
if(NOT RAW MATCHES "kalandra_reduce_sum" OR NOT RAW MATCHES "arith.addf" OR NOT RAW MATCHES "scf.if"
   OR STRICT MATCHES "arith\\.(addf|mulf|divf)" OR SPIRV MATCHES "spirv\\.(FAdd|FMul|FDiv)|Fma|FPFastMathMode")
  message(FATAL_ERROR "Reduction artifact lost its strict adjacent-pair lowering")
endif()
string(REPLACE "    finish(result)" "    repeated = try await work\n    repeated" DIRECT "${SOURCE}")
run(repeated "${DIRECT}" "41f00000" --sanitize)
string(REPLACE "Tensor[float32, 5] = tensor([1, 2, 3, 4, 5])" "Tensor[float32, 0] = tensor([])" EMPTY "${DIRECT}")
run(empty "${EMPTY}" "00000000" --sanitize)
string(REPLACE "Tensor[float32, 5] = tensor([1, 2, 3, 4, 5])" "Tensor[float32, 1] = tensor([-0])" SINGLE "${DIRECT}")
run(negative-zero "${SINGLE}" "80000000" --thread-sanitize)
string(REPLACE "    finish(result)" "    next = try await spawn scale(uploaded, result) on gpu\n    final = try await spawn total(next) on gpu\n    finish(final)" CHAIN "${SOURCE}")
run(chained "${CHAIN}" "43e18000" -O2)
# Matrices reduce in flat row-major order, including pairs that cross row boundaries.
set(MATRIX "fn total(values: Tensor[float32, ?, ?]) -> float32:\n  reduceSum(values)\n\nfn forward(values: Tensor[float32, ?, ?]) -> Tensor[float32, ?, ?]:\n  values\n\nfn main() -> float32 ! TaskError:\n  try parallel:\n    values: Tensor[float32, 2, 3] = tensor([[1e20, 1, -1e20], [1, 1, 1]])\n    gpu = devices.gpu()\n    uploaded = try await transfer(forward(values), gpu)\n    alias = uploaded\n    work = spawn total(alias) on gpu\n    result = try await work\n    repeated = try await work\n    repeated\n")
run(matrix "${MATRIX}" "40000000" -O2)
string(REPLACE "Tensor[float32, 2, 3] = tensor([[1e20, 1, -1e20], [1, 1, 1]])" "Tensor[float32, 0, 3] = tensor([], [0, 3])" EMPTY_MATRIX "${MATRIX}")
run(matrix-empty-rows "${EMPTY_MATRIX}" "00000000" --sanitize)
string(REPLACE "Tensor[float32, 2, 3] = tensor([[1e20, 1, -1e20], [1, 1, 1]])" "Tensor[float32, 2, 0] = tensor([[], []])" EMPTY_MATRIX "${MATRIX}")
run(matrix-empty-columns "${EMPTY_MATRIX}" "00000000" --sanitize)
string(REPLACE "Tensor[float32, 2, 3] = tensor([[1e20, 1, -1e20], [1, 1, 1]])" "Tensor[float32, 1, 1] = tensor([[-0]])" SINGLE_MATRIX "${MATRIX}")
run(matrix-negative-zero "${SINGLE_MATRIX}" "80000000" --thread-sanitize)
# Rank-one and rank-two entries must share the exact same strict shader.
foreach(SUFFIX IN ITEMS mlir lowered.mlir spv)
  file(SHA256 "${OUTPUT_DIR}/source/kernel1.${SUFFIX}" VECTOR_HASH)
  file(SHA256 "${OUTPUT_DIR}/matrix/kernel0.${SUFFIX}" MATRIX_HASH)
  if(NOT VECTOR_HASH STREQUAL MATRIX_HASH)
    message(FATAL_ERROR "Rank-two reduction changed ${SUFFIX} arithmetic")
  endif()
endforeach()
# Native executable and offline shaders remain relocatable together.
file(COPY "${OUTPUT_DIR}/source/" DESTINATION "${OUTPUT_DIR}/relocated")
execute_process(COMMAND "${OUTPUT_DIR}/relocated/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "41f80000\n")
  message(FATAL_ERROR "Relocated reduction failed: ${OUT} ${ERROR}")
endif()
function(reject NAME CONTENT)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" "sentinel")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "(G001|S0)")
    message(FATAL_ERROR "${NAME} accepted unsupported source: ${STATUS} ${ERROR}")
  endif()
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" SENTINEL)
  if(NOT SENTINEL STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} changed existing output")
  endif()
endfunction()

reject(hidden-upload "${BAD}")
string(REPLACE "    total(host)" "    total(result)" BAD "${SOURCE}")
reject(hidden-download "${BAD}")
string(REPLACE "matmul(input, weights)" "matmul(input, weights) + 0.5" BAD "${SOURCE}")
run(composed-kernel "${BAD}" "43250000" --sanitize)
string(REPLACE "tensor([[1, 2, 3], [4, 5, 6]])" "tensor([[1, 2, 3], [4, 5]])" BAD "${SOURCE}")
reject(ragged-literal "${BAD}")
string(REPLACE "Tensor[float32, 3, 2] = tensor([[1, 2], [3, 4], [5, 6]])" "Tensor[float32, 2, 2] = tensor([[1, 2], [3, 4]])" BAD "${SOURCE}")
reject(known-inner-shape "${BAD}")
string(REPLACE "    total(host)" "    bad: Tensor[float32, 2, 3] = host\n    total(bad)" BAD "${SOURCE}")
reject(known-width "${BAD}")
function(fault NAME CONTENT)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal -o "${OUTPUT_DIR}/${NAME}" --sanitize
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME} must compile dynamic shapes: ${OUT} ${ERROR}")
  endif()
  execute_process(COMMAND "${OUTPUT_DIR}/${NAME}/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 1 OR NOT OUT STREQUAL "" OR NOT ERROR MATCHES "Metal task failed: 1/1")
    message(FATAL_ERROR "${NAME} failed to guard shapes: ${STATUS} ${OUT} ${ERROR}")
  endif()
endfunction()
string(REPLACE "    b = try await transfer(weights, gpu)" "    smaller: Tensor[float32, 2, 2] = tensor([[1, 2], [3, 4]])\n    b = try await transfer(forward(smaller), gpu)" BAD "${SOURCE}")

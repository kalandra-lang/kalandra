file(READ "${SOURCE_DIR}/matmul.k" SOURCE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(run NAME CONTENT EXPECTED FLAG)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal -o "${OUTPUT_DIR}/${NAME}" "${FLAG}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME} build failed: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "${EXPECTED}\n")
      message(FATAL_ERROR "${NAME}: unexpected ${STATUS}: ${OUT} ${ERROR}")
    endif()
  endforeach()
endfunction()
run(source "${SOURCE}" "43230000" -O2)
file(READ "${OUTPUT_DIR}/source/kernel0.mlir" RAW)
file(READ "${OUTPUT_DIR}/source/kernel0.lowered.mlir" STRICT)
file(READ "${OUTPUT_DIR}/source/kernel0.kernel.mlir" SPIRV)
if(NOT RAW MATCHES "kalandra_matmul" OR NOT RAW MATCHES "arith.mulf" OR NOT RAW MATCHES "arith.addf" OR NOT RAW MATCHES "memref.alloca"
   OR STRICT MATCHES "arith\\.(addf|mulf|divf)" OR SPIRV MATCHES "spirv\\.(FAdd|FMul|FDiv)|Fma|FPFastMathMode")
  message(FATAL_ERROR "Matmul strict product/tree lowering changed")
endif()
foreach(TILE IN ITEMS rows2 quad)
  file(READ "${OUTPUT_DIR}/source/kernel0-${TILE}.mlir" TILE_RAW)
  file(READ "${OUTPUT_DIR}/source/kernel0-${TILE}.lowered.mlir" TILE_STRICT)
  file(READ "${OUTPUT_DIR}/source/kernel0-${TILE}.kernel.mlir" TILE_SPIRV)
  if(NOT TILE_RAW MATCHES "kalandra_matmul_2x" OR TILE_STRICT MATCHES "arith\\.(addf|mulf|divf)"
      OR TILE_SPIRV MATCHES "spirv\\.(FAdd|FMul|FDiv)|Fma|FPFastMathMode")
    message(FATAL_ERROR "Matmul register tile strict artifact changed")
  endif()
endforeach()
# Runtime relocation needs only the executable and linked library, not the
# standalone tile libraries or compiler intermediates used during packaging.
file(MAKE_DIRECTORY "${OUTPUT_DIR}/relocated")
file(COPY "${OUTPUT_DIR}/source/program" "${OUTPUT_DIR}/source/kernel0.metallib"
  DESTINATION "${OUTPUT_DIR}/relocated")
execute_process(COMMAND "${OUTPUT_DIR}/relocated/program"
  RESULT_VARIABLE RELOCATED_STATUS OUTPUT_VARIABLE RELOCATED_OUT ERROR_VARIABLE RELOCATED_ERROR)
if(NOT RELOCATED_STATUS EQUAL 0 OR NOT RELOCATED_OUT STREQUAL "43230000\n")
  message(FATAL_ERROR "Linked matmul bundle relocation failed: ${RELOCATED_STATUS} ${RELOCATED_OUT} ${RELOCATED_ERROR}")
endif()
string(REPLACE "fn main() -> float32" "fn main() -> Tensor[float32, 2, 2]" MATRIX "${SOURCE}")
string(REPLACE "    total(host)" "    forward(host)" MATRIX "${MATRIX}")
run(matrix-result "${MATRIX}" "[41b00000,41e00000,42440000,42800000]" --sanitize)
string(REPLACE "Tensor[float32, 2, 3] = tensor([[1, 2, 3], [4, 5, 6]])" "Tensor[float32, 2, 0] = tensor([[], []])" ZERO "${SOURCE}")
string(REPLACE "Tensor[float32, 3, 2] = tensor([[1, 2], [3, 4], [5, 6]])" "Tensor[float32, 0, 2] = tensor([], [0, 2])" ZERO "${ZERO}")
run(zero-inner "${ZERO}" "00000000" --sanitize)
string(REPLACE "Tensor[float32, 2, 3] = tensor([[1, 2, 3], [4, 5, 6]])" "Tensor[float32, 0, 3] = tensor([], [0, 3])" EMPTY "${SOURCE}")
run(empty-rows "${EMPTY}" "00000000" --sanitize)
string(REPLACE "Tensor[float32, 3, 2] = tensor([[1, 2], [3, 4], [5, 6]])" "Tensor[float32, 3, 0] = tensor([[], [], []])" EMPTY "${SOURCE}")
run(empty-columns "${EMPTY}" "00000000" --thread-sanitize)
set(FACTORY "fn seed() -> Tensor[float32, 2, 3]:\n  tensor([[1, 2, 3], [4, 5, 6]])\n\n${SOURCE}")
string(REPLACE "tensor([[1, 2, 3], [4, 5, 6]])\n    weights" "seed()\n    weights" FACTORY "${FACTORY}")
string(REPLACE "    total(host)" "    identity: Tensor[float32, 2, 2] = tensor([[1, 0], [0, 1]])\n    total(project(forward(host), identity))" FACTORY "${FACTORY}")
run(cpu-factory-consumer "${FACTORY}" "43230000" -O2)
string(REPLACE "    total(host)" "    identity: Tensor[float32, 2, 2] = tensor([[1, 0], [0, 1]])\n    d = try await transfer(identity, gpu)\n    again = try await spawn project(result, d) on gpu\n    final = try await transfer(again, devices.cpu())\n    total(final)" CHAIN "${SOURCE}")
run(chained "${CHAIN}" "43230000" -O2)
# Reduce the matrix on its device: only the scalar crosses back to the host.
file(READ "${SOURCE_DIR}/matrix-reduction.k" RESIDENT)
run(resident-reduction "${RESIDENT}" "43230000" -O2)
run(resident-reduction-sanitized "${RESIDENT}" "43230000" --sanitize)
run(resident-reduction-thread-sanitized "${RESIDENT}" "43230000" --thread-sanitize)
file(READ "${OUTPUT_DIR}/resident-reduction/host.cpp" RESIDENT_HOST)
if(RESIDENT_HOST MATCHES "r\\.download" OR NOT RESIDENT_HOST MATCHES "r\\.reduceSum")
  message(FATAL_ERROR "Resident matrix reduction must not download the matrix")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/resident-relocated")
file(COPY "${OUTPUT_DIR}/resident-reduction/program" "${OUTPUT_DIR}/resident-reduction/kernel0.metallib"
  "${OUTPUT_DIR}/resident-reduction/kernel1.metallib" DESTINATION "${OUTPUT_DIR}/resident-relocated")
execute_process(COMMAND "${OUTPUT_DIR}/resident-relocated/program"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "43230000\n")
  message(FATAL_ERROR "Resident matmul/reduction relocation failed: ${STATUS} ${OUT} ${ERROR}")
endif()
string(REPLACE "    host = try await transfer(result, devices.cpu())\n    total(host)" "    try await spawn total(result) on gpu" ZERO_RESIDENT "${ZERO}")
run(resident-zero-inner "${ZERO_RESIDENT}" "00000000" --sanitize)
string(REPLACE "    host = try await transfer(result, devices.cpu())\n    total(host)" "    try await spawn total(result) on gpu" EMPTY_RESIDENT "${EMPTY}")
run(resident-empty-columns "${EMPTY_RESIDENT}" "00000000" --thread-sanitize)
function(reject NAME CONTENT)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" "sentinel")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "(G001|S0)")
    message(FATAL_ERROR "${NAME} missing diagnostic: ${STATUS} ${ERROR}")
  endif()
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" SENTINEL)
  if(NOT SENTINEL STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} changed existing output")
  endif()
endfunction()

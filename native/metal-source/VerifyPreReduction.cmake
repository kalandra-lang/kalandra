include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
set(OPS "export fn adjust(left:Tensor[float32,?,?], shift:float32, right:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  -(left + shift) / 2 + right\nexport fn total(left:Tensor[float32,?,?], shift:float32, right:Tensor[float32,?,?])->float32:\n  result=reduceSum(adjust(left,shift,right))\n  result\n")
if(POST)
  string(REPLACE "  result\n" "  finish(result,shift)\n" OPS "${OPS}")
  string(APPEND OPS "export fn finish(value:float32, shift:float32)->float32:\n  -(value+shift)/2\n")
endif()
file(WRITE "${ROOT}/operations.k" "${OPS}")
file(WRITE "${ROOT}/public.k" "export from \"./operations.k\" import total as sum\n")
set(MAIN "from \"./public.k\" import sum\nfn forward(v:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  v\nfn main()->float32 ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,1,3]=tensor([[1,2,3]])\n    b:Tensor[float32,1,3]=tensor([[10,20,30]])\n    left=try await transfer(forward(a),gpu)\n    right=try await transfer(forward(b),gpu)\n    work=spawn sum(left,2,right) on gpu\n    result=try await work\n    repeated=try await work\n    repeated\n")
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR
        ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape error: ${ERROR}")
    endif()
  endforeach()
endfunction()
function(reject NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS}: ${ERROR}")
  endif()
endfunction()
compile(imported "${MAIN}")
if(POST)
  file(READ "${OUTPUT_DIR}/imported/kernel0-post.mlir" EPILOGUE)
  if(NOT EPILOGUE MATCHES "arith.divf" OR NOT EPILOGUE MATCHES "arith.negf")
    message(FATAL_ERROR "Missing GPU scalar epilogue")
  endif()
endif()
file(READ "${OUTPUT_DIR}/imported/kernel0.mlir" MAP)
file(READ "${OUTPUT_DIR}/imported/kernel0-reduce.mlir" REDUCE)
file(READ "${OUTPUT_DIR}/imported/manifest.txt" MANIFEST)
if(NOT MAP MATCHES "kalandra_elementwise" OR NOT MAP MATCHES "arith.divf" OR NOT REDUCE MATCHES "kalandra_reduce_sum"
   OR NOT MANIFEST MATCHES "kernel0.reduction_stage=kernel0-reduce")
  message(FATAL_ERROR "Composed entry must publish explicit map and reduction artifacts")
endif()
if(NOT DEFINED VARIANT)
  string(REPLACE "reduceSum(adjust(left,shift,right))" "reduceSum(adjust(left,shift,right)) + 1" BAD "${OPS}")
  file(WRITE "${ROOT}/operations.k" "${BAD}")
  compile(post-reduction "${MAIN}")
  string(REPLACE "  result=reduceSum" "  discarded=reduceSum(left)\n  result=reduceSum" BAD "${OPS}")
  file(WRITE "${ROOT}/operations.k" "${BAD}")
  admit_case(two-reductions "${MAIN}")
  string(REPLACE "-(left + shift) / 2 + right" "if shift > 0: left\n  else: right" BAD "${OPS}")
  file(WRITE "${ROOT}/operations.k" "${BAD}")
  admit_case(branch "${MAIN}")
  message(STATUS "Pre-reduction source graph, imported/mixed arguments and transactional boundaries passed")
  return()
endif()
set(EXPECTED "42580000\n")
if(POST)
  set(EXPECTED "c1e00000\n")
endif()
run(imported "${EXPECTED}" 0) # 8.5 + 18 + 27.5 = 54
file(COPY "${OUTPUT_DIR}/imported/" DESTINATION "${OUTPUT_DIR}/relocated")
run(relocated "${EXPECTED}" 0)
# Same source operations explicitly placed in two calls have the same exact scalar bits.
set(SEPARATE "from \"./operations.k\" import adjust\nfn sum(v:Tensor[float32,?,?])->float32:\n  reduceSum(v)\n${MAIN}")
string(REPLACE "from \"./public.k\" import sum\n" "" SEPARATE "${SEPARATE}")
string(REPLACE "    work=spawn sum(left,2,right) on gpu" "    adjusted=try await spawn adjust(left,2,right) on gpu\n    work=spawn sum(adjusted) on gpu" SEPARATE "${SEPARATE}")
if(POST)
  string(REPLACE "import adjust\n" "import adjust, finish\n" SEPARATE "${SEPARATE}")
  string(REPLACE "    repeated\n" "    finish(repeated,2)\n" SEPARATE "${SEPARATE}")
endif()
compile(separate "${SEPARATE}")
run(separate "${EXPECTED}" 0)
# Equal element counts but different shapes remain invalid even in the graph path.
string(REPLACE "Tensor[float32,1,3]=tensor([[10,20,30]])" "Tensor[float32,3,1]=tensor([[10],[20],[30]])" BAD "${MAIN}")
compile(shape-fault "${BAD}")
run(shape-fault "" 1)
if(POST)
  set(DIRECT "fn total(values:Tensor[float32,?],bias:float32)->float32:\n  -(reduceSum(values)+bias)/2\nfn main()->float32 ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    values:Tensor[float32,3]=tensor([1,2,3])\n    input=try await transfer(values,gpu)\n    try await spawn total(input,2) on gpu\n")
  compile(direct-post "${DIRECT}")
  run(direct-post "c0800000\n" 0)
  string(REPLACE "Tensor[float32,3]=tensor([1,2,3])" "Tensor[float32,0]=tensor([])" EMPTY "${DIRECT}")
  compile(empty-post "${EMPTY}")
  run(empty-post "bf800000\n" 0)
  # Reuse one reduced binding twice; this is not two independent reductions.
  string(REPLACE "-(reduceSum(values)+bias)/2" "reduceSum(values)" REUSED "${DIRECT}")
  string(REPLACE "  reduceSum(values)" "  subtotal=reduceSum(values)\n  subtotal*subtotal+bias" REUSED "${REUSED}")
  compile(reused-post "${REUSED}")
  run(reused-post "42180000\n" 0)
endif()
message(STATUS "Pre-reduction ${VARIANT}: imported graph/separate equivalence, cached awaits, relocation and full-shape validation passed")

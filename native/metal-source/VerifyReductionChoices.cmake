include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/reduction-choices.k" SOURCE)
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 60)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 60)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
compile(choice "${SOURCE}")
file(READ "${OUTPUT_DIR}/choice/manifest.txt" MANIFEST)
file(READ "${OUTPUT_DIR}/choice/kernel0-post.mlir" POST)
if(NOT MANIFEST MATCHES "epilogue_stage=kernel0-post" OR MANIFEST MATCHES "matrix_graph_edges" OR NOT POST MATCHES "arith.select")
  message(FATAL_ERROR "Reduction choice lost the resident scalar stage: ${MANIFEST}")
endif()
string(REPLACE "score(input, 1)" "score(input, 10)" FALSE "${SOURCE}")
compile(false "${FALSE}")
string(REPLACE "tensor([1, 2, 3])" "tensor([-1, -2, -3])" NEGATIVE "${SOURCE}")
compile(negative "${NEGATIVE}")
string(REPLACE "Tensor[float32, 3] = tensor([1, 2, 3])" "Tensor[float32, 0] = tensor([])" EMPTY "${SOURCE}")
compile(empty "${EMPTY}")
string(REPLACE "if valid:" "if true:" CONSTANT "${SOURCE}")
compile(constant "${CONSTANT}")
string(REPLACE "    total * 2" "    7" PREDICATE "${SOURCE}")
string(REPLACE "    threshold\n" "    9\n" PREDICATE "${PREDICATE}")
compile(predicate-only "${PREDICATE}")
string(REPLACE "if valid:" "if threshold > 0:" ARM_ONLY "${SOURCE}")
compile(arm-only "${ARM_ONLY}")
string(REPLACE "    total * 2" "    if total < 8:\n      total * 2\n    else:\n      threshold" NESTED "${SOURCE}")
compile(nested "${NESTED}")
string(REPLACE "total = reduceSum(values)" "total = reduceSum(values + threshold)" MAPPED "${SOURCE}")
compile(mapped "${MAPPED}")
# Generate unordered/infinite values in the existing resident arithmetic stage.
string(REPLACE "reduceSum(values)" "reduceSum((values - values) / (threshold - 1))" NAN "${SOURCE}")
compile(nan "${NAN}")
string(REPLACE "reduceSum(values)" "reduceSum(values / (threshold - 1))" INF "${SOURCE}")
compile(infinity "${INF}")
# Single matrix-product/reduction pair, then scalar choices.
set(MATRIX "fn finish(total:float32,threshold:float32)->float32:\n  if total>threshold:\n    total*2\n  else:\n    threshold\nfn score(a:Tensor[float32,2,3],b:Tensor[float32,3,2],threshold:float32)->float32:\n  total=reduceSum(matmul(a,b))\n  finish(total,threshold)\nfn main()->float32 ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,2,3]=tensor([[1,2,3],[4,5,6]])\n    b:Tensor[float32,3,2]=tensor([[1,2],[3,4],[5,6]])\n    x=try await transfer(a,gpu)\n    y=try await transfer(b,gpu)\n    work=spawn score(x,y,1) on gpu\n    result=try await work\n    try await work\n")
compile(matrix "${MATRIX}")
file(READ "${OUTPUT_DIR}/matrix/manifest.txt" MATRIX_MANIFEST)
if(NOT MATRIX_MANIFEST MATCHES "scalar_stage=kernel0-scalar" OR MATRIX_MANIFEST MATCHES "matrix_graph_edges")
  message(FATAL_ERROR "Matrix reduction lost its scalar choice stage: ${MATRIX_MANIFEST}")
endif()
string(REPLACE "matmul(a,b)" "matmul(a+threshold,b-1)" MATRIX_MAPS "${MATRIX}")
compile(matrix-maps "${MATRIX_MAPS}")
if(DEFINED VARIANT)
  run(choice "41400000\n" 0)
  run(false "41200000\n" 0)
  run(negative "3f800000\n" 0)
  run(empty "3f800000\n" 0)
  run(constant "41400000\n" 0)
  run(predicate-only "40e00000\n" 0)
  run(arm-only "41400000\n" 0)
  run(nested "41400000\n" 0)
  run(mapped "41900000\n" 0)
  run(nan "3f800000\n" 0)
  run(infinity "7f800000\n" 0)
  run(matrix "43a30000\n" 0)
  run(matrix-maps "43970000\n" 0)
  file(COPY "${OUTPUT_DIR}/choice/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "41400000\n" 0)
endif()

if(NOT DEFINED VARIANT)
  function(reject NAME SOURCE)
    file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
    file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
    file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
    execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR TIMEOUT 60)
    file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
    if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
      message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS} ${ERROR}")
    endif()
  endfunction()
  # Place the primitive in score's own branch, where values is in scope.
  set(BAD "fn score(values:Tensor[float32,?],threshold:float32)->float32:\n  total=reduceSum(values)\n  if total>threshold:\n    total\n  else:\n    reduceSum(values)\n")
  string(FIND "${SOURCE}" "fn main()" SPLIT)
  string(SUBSTRING "${SOURCE}" ${SPLIT} -1 MAIN)
  admit_case(branch-primitive "${BAD}${MAIN}")
  string(REPLACE "-> float32:" "-> Bool:" BOOL "${SOURCE}")
  string(REPLACE "    total * 2" "    true" BOOL "${BOOL}")
  string(REPLACE "    threshold\n" "    false\n" BOOL "${BOOL}")
  string(REPLACE "fn main() -> float32 ! TaskError:" "fn main() -> Bool ! TaskError:" BOOL "${BOOL}")
  reject(bool-result "${BOOL}")
endif()

file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/host-control.k" SOURCE)
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(qualify NAME CONTENT EXPECTED CODE)
  file(WRITE "${OUTPUT_DIR}/src/${NAME}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/src/${NAME}.k" ${TARGET_FLAGS}
    -o "${OUTPUT_DIR}/${NAME}" ${FLAGS} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 90)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME} compile: ${STATUS}: ${OUT} ${ERROR}")
  endif()
  if(DEFINED VARIANT)
    foreach(WORKERS IN ITEMS 1 2 4)
      execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
        "${OUTPUT_DIR}/${NAME}/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 60)
      if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL EXPECTED OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
        message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
      endif()
      if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
        message(FATAL_ERROR "${NAME} lost selected-path shape failure: ${ERROR}")
      endif()
    endforeach()
  endif()
endfunction()
qualify(true "${SOURCE}" "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
string(REPLACE "enabled(sum, 0)" "enabled(sum, 10)" FALSE "${SOURCE}")
qualify(false "${FALSE}" "[00000000,3f800000,40000000]\n" 0)
string(REPLACE "enabled(sum, 0) and not (sum != sum)" "false" CONSTANT "${SOURCE}")
qualify(constant "${CONSTANT}" "[00000000,3f800000,40000000]\n" 0)
# Branch-specific dynamic shapes must be checked only on the selected path.
set(ROUTE "fn add(a:Tensor[float32,?],b:Tensor[float32,?])->Tensor[float32,?]:\n  a+b\nfn route(a:Tensor[float32,?],b:Tensor[float32,?],selected:Bool)->Tensor[float32,?] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    x=try await transfer(a,gpu)\n    y=try await transfer(b,gpu)\n    result=if selected:\n      x\n    else:\n      try await spawn add(x,y) on gpu\n    try await transfer(result,devices.cpu())\nfn main()->Tensor[float32,?] ! TaskError:\n  try route(tensor([1,2,3]),tensor([4,5]),true)\n")
qualify(skipped-shape "${ROUTE}" "[3f800000,40000000,40400000]\n" 0)
string(REPLACE ",true)" ",false)" BAD "${ROUTE}")
qualify(selected-shape "${BAD}" "" 1)
# A reduction/dispatch on the right of a Boolean operator must remain lazy.
string(REPLACE "selected = enabled(sum, 0) and not (sum != sum)"
  "selected = false and (try await spawn total(resident) on gpu) > 0" SHORT "${SOURCE}")
qualify(short-and "${SHORT}" "[00000000,3f800000,40000000]\n" 0)
string(REPLACE "false and" "true or" SHORT "${SHORT}")
qualify(short-or "${SHORT}" "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
string(REPLACE "selected = enabled(sum, 0) and not (sum != sum)"
  "selected = (sum == 6) == true and (sum <= 6) and (sum >= 6) and (sum < 7) and not false" COMPARES "${SOURCE}")
qualify(comparisons "${COMPARES}" "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
string(REPLACE "      try await spawn normalize(resident) on gpu"
  "      if sum > 0:\n        try await spawn normalize(resident) on gpu\n      else:\n        try await spawn adjust(resident) on gpu" NESTED "${SOURCE}")
qualify(nested "${NESTED}" "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
if(DEFINED VARIANT)
  file(COPY "${OUTPUT_DIR}/true/" DESTINATION "${OUTPUT_DIR}/relocated")
  execute_process(COMMAND "${OUTPUT_DIR}/relocated/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "[3e2aaaab,3eaaaaab,3f000000]\n")
    message(FATAL_ERROR "Relocated control failed: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endif()

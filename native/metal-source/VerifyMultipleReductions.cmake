include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/multiple-reductions.k" SOURCE)
string(FIND "${SOURCE}" "\nfn main()" SPLIT)
string(SUBSTRING "${SOURCE}" 0 ${SPLIT} OPS)
string(SUBSTRING "${SOURCE}" ${SPLIT} -1 MAIN)
string(REPLACE "fn project(" "export fn project(" OPS "${OPS}")
file(WRITE "${ROOT}/operations.k" "${OPS}")
file(WRITE "${ROOT}/public.k" "export from \"./operations.k\" import project as calculate\n")
set(PREFIX "from \"./public.k\" import calculate as project\nfn forward(values:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  values\n")
set(MAIN "${PREFIX}${MAIN}")
foreach(NAME IN ITEMS input weights projection)
  string(REPLACE "transfer(${NAME}, gpu)" "transfer(forward(${NAME}), gpu)" MAIN "${MAIN}")
endforeach()
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
function(reject NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS}: ${ERROR}")
  endif()
endfunction()
compile(imported "${MAIN}")
file(READ "${OUTPUT_DIR}/imported/manifest.txt" MANIFEST)
if(NOT MANIFEST MATCHES "reduction_inputs=3,4" OR NOT MANIFEST MATCHES "join_stage=kernel0-join")
  message(FATAL_ERROR "Lost resident reduction identities: ${MANIFEST}")
endif()
string(REPLACE "finish(left, right, count)" "(left + left - right) / count" REUSED "${OPS}")
file(WRITE "${ROOT}/operations.k" "${REUSED}")
compile(reused "${MAIN}")
# Pure vector reductions, with a map before one reduction and different input lengths.
set(VECTOR "fn sums(a:Tensor[float32,?],b:Tensor[float32,?],scale:float32)->float32:\n  adjusted=a/scale\n  (reduceSum(adjusted)-reduceSum(b))/scale\nfn main()->float32 ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,3]=tensor([2,4,6])\n    b:Tensor[float32,2]=tensor([1,3])\n    x=try await transfer(a,gpu)\n    y=try await transfer(b,gpu)\n    try await spawn sums(x,y,2) on gpu\n")
compile(vectors "${VECTOR}")
set(NO_SCALARS "fn sums(a:Tensor[float32,?],b:Tensor[float32,?])->float32:\n  values=a-b\n  reduceSum(values)+reduceSum(b)\nfn main()->float32 ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,3]=tensor([2,4,6])\n    b:Tensor[float32,3]=tensor([1,3,5])\n    x=try await transfer(a,gpu)\n    y=try await transfer(b,gpu)\n    try await spawn sums(x,y) on gpu\n")
compile(no-scalars "${NO_SCALARS}")

set(MANY "fn subtotal(values:Tensor[float32,?,?])->float32:\n  reduceSum(values)\nfn many(a:Tensor[float32,?,?],b:Tensor[float32,?,?],c:Tensor[float32,?,?],scale:float32)->float32:\n  hidden=matmul(a,b)\n  projected=matmul(hidden,c)\n")
set(EXPR "v0")
foreach(I RANGE 0 39)
  if(I EQUAL 0)
    string(APPEND MANY "  v${I}=subtotal(hidden)\n")
  else()
    string(APPEND MANY "  v${I}=subtotal(projected)\n")
    string(APPEND EXPR " + v${I}")
  endif()
endforeach()
string(APPEND MANY "  (${EXPR})/scale\n")
string(REPLACE "spawn project(a, b, c, 2)" "spawn many(a,b,c,2)" MANY_MAIN "${MAIN}")
compile(many "${MANY}${MANY_MAIN}")
file(READ "${OUTPUT_DIR}/many/host.cpp" HOST)
if(NOT HOST MATCHES "ElementwiseSignature\\{40,1,m::ElementwiseBinding::ArgumentBuffer")
  message(FATAL_ERROR "Large reduction joins lost indirect binding")
endif()
file(WRITE "${ROOT}/operations.k" "${OPS}")
string(REPLACE "transfer(forward(projection), gpu)" "transfer(forward(weights), gpu)" WRONG "${MAIN}")
compile(wrong-shape "${WRONG}")
if(DEFINED VARIANT)
  run(imported "c3ad8000\n" 0)
  run(reused "c384c000\n" 0)
  run(vectors "3f800000\n" 0)
  run(no-scalars "41400000\n" 0)
  run(many "46833200\n" 0)
  run(wrong-shape "" 1)
  file(COPY "${OUTPUT_DIR}/imported/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "c3ad8000\n" 0)
else()
  foreach(CASE IN ITEMS unused-reduction unused-product branch)
    if(CASE STREQUAL "unused-reduction")
      string(REPLACE "  left =" "  unused=reduceSum(input)\n  left =" BAD "${OPS}")
    elseif(CASE STREQUAL "unused-product")
      string(REPLACE "  hidden =" "  unused=matmul(input,weights)\n  hidden =" BAD "${OPS}")
    else()
      string(REPLACE "  finish(left, right, count)" "  if count>0:\n    reduceSum(hidden)\n  else:\n    reduceSum(projected)" BAD "${OPS}")
    endif()
    file(WRITE "${ROOT}/operations.k" "${BAD}")
    admit_case(${CASE} "${MAIN}")
  endforeach()
endif()

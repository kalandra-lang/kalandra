function(build_run NAME CONTENT EXPECTED FLAG)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal
    -o "${OUTPUT_DIR}/${NAME}" ${FLAG} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME} compilation: ${STATUS}: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      "${OUTPUT_DIR}/${NAME}/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL EXPECTED)
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}; expected ${EXPECTED}")
    endif()
  endforeach()
endfunction()
set(EXPECTED "43340000\n")
foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
  if(VARIANT STREQUAL "debug")
    set(FLAG "")
  elseif(VARIANT STREQUAL "optimized")
    set(FLAG -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAG --sanitize)
  else()
    set(FLAG --thread-sanitize)
  endif()
  build_run(${VARIANT} "${SOURCE}" "${EXPECTED}" "${FLAG}")
endforeach()

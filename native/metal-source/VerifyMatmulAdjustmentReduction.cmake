include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/matmul-adjust-reduction.k" SOURCE)
string(FIND "${SOURCE}" "\nfn main()" SPLIT)
string(SUBSTRING "${SOURCE}" 0 ${SPLIT} OPS)
string(SUBSTRING "${SOURCE}" ${SPLIT} -1 MAIN)
string(REPLACE "fn project(" "export fn project(" OPS "${OPS}")
file(WRITE "${ROOT}/operations.k" "${OPS}")
file(WRITE "${ROOT}/public.k" "export from \"./operations.k\" import project as calculate\n")
set(PREFIX "from \"./public.k\" import calculate as project\nfn forward(values:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  values\n")
set(MAIN "${PREFIX}${MAIN}")
foreach(NAME IN ITEMS input weights bias)
  string(REPLACE "transfer(${NAME}, gpu)" "transfer(forward(${NAME}), gpu)" MAIN "${MAIN}")
endforeach()
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
function(reject NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS}: ${ERROR}")
  endif()
endfunction()
compile(imported "${MAIN}")
file(READ "${OUTPUT_DIR}/imported/manifest.txt" MANIFEST)
if(NOT MANIFEST MATCHES "epilogue_tensor_bindings=0,3" OR NOT MANIFEST MATCHES "reduction_stage=kernel0-reduce")
  message(FATAL_ERROR "Matrix adjustment/reduction stages lost")
endif()
string(REPLACE "input + scale" "input" UNMAPPED "${OPS}")
string(REPLACE "weights - 1" "weights" UNMAPPED "${UNMAPPED}")
file(WRITE "${ROOT}/operations.k" "${UNMAPPED}")
compile(no-input-maps "${MAIN}")
string(REPLACE "finish(product, bias, scale)" "-(product + scale) / 2" SCALAR "${OPS}")
file(WRITE "${ROOT}/operations.k" "${SCALAR}")
compile(scalar-arithmetic "${MAIN}")
string(REPLACE "finish(product, bias, scale)" "product + product" REUSED "${OPS}")
file(WRITE "${ROOT}/operations.k" "${REUSED}")
compile(reused-product "${MAIN}")
set(HIGH_FN "fn many(a:Tensor[float32,?,?],b:Tensor[float32,?,?]")
set(HIGH_EXPR "product")
set(HIGH_ARGS "a,b")
foreach(I RANGE 0 29)
  string(APPEND HIGH_FN ",extra${I}:Tensor[float32,?,?]")
  string(APPEND HIGH_EXPR " + extra${I}")
  string(APPEND HIGH_ARGS ",offset")
endforeach()
string(APPEND HIGH_FN ")->float32:\n  product=multiply(a,b)\n  adjusted=${HIGH_EXPR}\n  sum(adjusted)\n")
set(HELPERS "fn multiply(a:Tensor[float32,?,?],b:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  matmul(a,b)\nfn sum(v:Tensor[float32,?,?])->float32:\n  reduceSum(v)\n")
string(REPLACE "spawn project(a, 2, b, offset)" "spawn many(${HIGH_ARGS})" HIGH_MAIN "${MAIN}")
compile(indirect "${HELPERS}${HIGH_FN}${HIGH_MAIN}")
file(READ "${OUTPUT_DIR}/indirect/manifest.txt" HIGH_MANIFEST)
if(NOT HIGH_MANIFEST MATCHES "epilogue_binding_layout=argument_buffer_tier2")
  message(FATAL_ERROR "Matrix adjustment lost Tier 2 bindings")
endif()
if(NOT DEFINED VARIANT)
  foreach(BOUNDARY IN ITEMS two-matrices two-reductions scalar-epilogue branch)
    set(BAD "${OPS}")
    if(BOUNDARY STREQUAL "two-matrices")
      string(REPLACE "  product = matmul" "  ignored = matmul(input, weights)\n  product = matmul" BAD "${BAD}")
    elseif(BOUNDARY STREQUAL "two-reductions")
      string(REPLACE "  reduceSum(finish(product, bias, scale))" "  ignored = reduceSum(product)\n  reduceSum(finish(product, bias, scale))" BAD "${BAD}")
    elseif(BOUNDARY STREQUAL "scalar-epilogue")
      string(REPLACE "  reduceSum(finish(product, bias, scale))" "  reduceSum(finish(product, bias, scale)) + 1" BAD "${BAD}")
    else()
      string(REPLACE "  reduceSum(finish(product, bias, scale))" "  if scale > 0: reduceSum(product)\n  else: 0" BAD "${BAD}")
    endif()
    file(WRITE "${ROOT}/operations.k" "${BAD}")
    if(BOUNDARY STREQUAL "scalar-epilogue")
      compile(${BOUNDARY} "${MAIN}")
    else()
      admit_case(${BOUNDARY} "${MAIN}")
    endif()
  endforeach()
  message(STATUS "Matrix adjustment/reduction source proof, signatures and transactional boundaries passed")
  return()
endif()
run(imported "43bf0000\n" 0)
run(no-input-maps "43ad0000\n" 0)
run(scalar-arithmetic "c2bd0000\n" 0)
run(reused-product "43b50000\n" 0)
run(indirect "43e78000\n" 0)
file(COPY "${OUTPUT_DIR}/imported/" DESTINATION "${OUTPUT_DIR}/relocated")
run(relocated "43bf0000\n" 0)
file(WRITE "${ROOT}/operations.k" "${OPS}")
string(REPLACE "Tensor[float32, 2, 2] = tensor([[1, 2], [3, 4]])" "Tensor[float32, 1, 4] = tensor([[1, 2, 3, 4]])" BAD "${MAIN}")
compile(shape-fault "${BAD}")
run(shape-fault "" 1)
set(SEPARATE "fn shift(v:Tensor[float32,?,?],s:float32)->Tensor[float32,?,?]:\n  v+s\nfn adjust(v:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  v-1\nfn multiply(a:Tensor[float32,?,?],b:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  matmul(a,b)\nfn finish(v:Tensor[float32,?,?],bias:Tensor[float32,?,?],scale:float32)->Tensor[float32,?,?]:\n  (v+bias)*scale\nfn sum(v:Tensor[float32,?,?])->float32:\n  reduceSum(v)\n${MAIN}")
string(REPLACE "    work = spawn project(a, 2, b, offset) on gpu" "    left = try await spawn shift(a,2) on gpu\n    right = try await spawn adjust(b) on gpu\n    product = try await spawn multiply(left,right) on gpu\n    adjusted = try await spawn finish(product,offset,2) on gpu\n    work = spawn sum(adjusted) on gpu" SEPARATE "${SEPARATE}")
compile(separate "${SEPARATE}")
run(separate "43bf0000\n" 0)
foreach(SUFFIX IN ITEMS mlir lowered.mlir metal)
  foreach(STAGE IN ITEMS matrix reduction)
    if(STAGE STREQUAL "matrix")
      set(AFILE "kernel0.${SUFFIX}")
      set(BFILE "kernel2.${SUFFIX}")
    else()
      set(AFILE "kernel0-reduce.${SUFFIX}")
      set(BFILE "kernel4.${SUFFIX}")
    endif()
    file(SHA256 "${OUTPUT_DIR}/imported/${AFILE}" A)
    file(SHA256 "${OUTPUT_DIR}/separate/${BFILE}" B)
    if(NOT A STREQUAL B)
      message(FATAL_ERROR "Adjustment changed strict ${STAGE} shader ${SUFFIX}")
    endif()
  endforeach()
endforeach()
message(STATUS "Matrix adjustment/reduction ${VARIANT}: imports, full/scalar/reused arithmetic, Tier 2, shape guards, relocation and separate equivalence passed")

file(READ "${SOURCE_DIR}/host-expressions.k" SOURCE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(build_run NAME CONTENT EXPECTED FLAG)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal
    -o "${OUTPUT_DIR}/${NAME}" ${FLAG} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME} compilation: ${STATUS}: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
      "${OUTPUT_DIR}/${NAME}/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL EXPECTED)
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}; expected ${EXPECTED}")
    endif()
  endforeach()
endfunction()
foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
  if(VARIANT STREQUAL "debug")
    set(FLAG "")
  elseif(VARIANT STREQUAL "optimized")
    set(FLAG -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAG --sanitize)
  else()
    set(FLAG --thread-sanitize)
  endif()
  build_run(${VARIANT} "${SOURCE}" "432d0000\n" "${FLAG}")
endforeach()
# The same expression signatures reuse checked kernels. User names never alias internal ones.
file(SHA256 "${OUTPUT_DIR}/optimized/host.cpp" HOST)
file(SHA256 "${OUTPUT_DIR}/optimized/cpu.ll" CPU)
execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/optimized.k" --target metal
  -o "${OUTPUT_DIR}/optimized" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
file(SHA256 "${OUTPUT_DIR}/optimized/host.cpp" HOST_AGAIN)
file(SHA256 "${OUTPUT_DIR}/optimized/cpu.ll" CPU_AGAIN)
if(NOT STATUS EQUAL 0 OR NOT HOST STREQUAL HOST_AGAIN OR NOT CPU STREQUAL CPU_AGAIN)
  message(FATAL_ERROR "Inline compilation was not deterministic: ${ERROR}")
endif()
# Restore the built bundle after checking deterministic generation, then relocate it.
file(MAKE_DIRECTORY "${OUTPUT_DIR}/relocated")
file(COPY "${OUTPUT_DIR}/optimized/program" "${OUTPUT_DIR}/optimized/kernel0.metallib"
  DESTINATION "${OUTPUT_DIR}/relocated")
execute_process(COMMAND "${OUTPUT_DIR}/relocated/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "432d0000\n")
  message(FATAL_ERROR "Relocated inline program: ${STATUS}: ${OUT} ${ERROR}")
endif()
string(FIND "${SOURCE}" "fn main()" MAIN)
string(SUBSTRING "${SOURCE}" 0 ${MAIN} FUNCTIONS)
set(VECTOR_HELPER "fn vectorScale(values: Tensor[float32,?], factor: float32) -> Tensor[float32,?]:\n  values * factor\n\n")
set(VECTOR_MAIN "fn main() -> Tensor[float32,3] ! TaskError:\n  try parallel:\n    values: Tensor[float32,3] = tensor([1,2,4])\n    gpu = devices.gpu()\n    input = try await transfer(values,gpu)\n    resident = try await spawn vectorScale(input, (2 + 2) / 4) on gpu\n    host = try await transfer(resident, devices.cpu())\n    total = reduceSum(-host)\n    result = (host + values) * 2 / 2 - values\n    +result\n")
build_run(vector "${FUNCTIONS}${VECTOR_HELPER}${VECTOR_MAIN}" "[3f800000,40000000,40800000]\n" --sanitize)
set(EMPTY_MAIN "fn main() -> float32 ! TaskError:\n  try parallel:\n    values: Tensor[float32,0,3] = tensor([], [0, 3])\n    weights: Tensor[float32,3,2] = tensor([[1,2],[3,4],[5,6]])\n    gpu = devices.gpu()\n    input = try await transfer(values,gpu)\n    resident = try await spawn scale(input,1) on gpu\n    host = try await transfer(resident,devices.cpu())\n    result = matmul(-(host + values) / 2, weights)\n    reduceSum(result) + -reduceSum(+host)\n")
build_run(empty "${FUNCTIONS}${EMPTY_MAIN}" "00000000\n" --sanitize)
# Keep all four arithmetic operations and unary signs in a scalar expression after GPU readback.
set(PREAMBLE "fn main() -> float32 ! TaskError:\n  try parallel:\n    values: Tensor[float32,1,1] = tensor([[1]])\n    gpu = devices.gpu()\n    input = try await transfer(values,gpu)\n    resident = try await spawn scale(input,1) on gpu\n    host = try await transfer(resident,devices.cpu())\n")
build_run(signed-zero "${FUNCTIONS}${PREAMBLE}    tiny: float32 = 1.401298464324817e-45\n    zero = tiny / 2\n    -zero\n" "80000000\n" --sanitize)
build_run(nan "${FUNCTIONS}${PREAMBLE}    zero = reduceSum(host) - 1\n    zero / zero\n" "7fc00000\n" --sanitize)
# Scalar division and multiplication by its rounded reciprocal remain distinct.
build_run(rounding "${FUNCTIONS}${PREAMBLE}    value = reduceSum(host) * 5\n    (value / 3) - (value * (1 / 3))\n" "b4000000\n" --sanitize)
function(reject NAME CONTENT PATTERN)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" "sentinel")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal
    -o "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" SENTINEL)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "${PATTERN}" OR NOT SENTINEL STREQUAL "sentinel")
    message(FATAL_ERROR "${NAME} should reject transactionally: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
string(REPLACE "projected = matmul(+host, weights)" "projected = matmul(+resident, weights)" BAD "${SOURCE}")
reject(hidden-download "${BAD}" "S047")
string(REPLACE "centered = -(projected - 1)" "centered = -work" BAD "${SOURCE}")
reject(pending "${BAD}" "S017")
string(REPLACE "centered = -(projected - 1)" "centered = projected + gpu" BAD "${SOURCE}")
reject(target "${BAD}" "S017")
string(REPLACE "projected = matmul(+host, weights)" "projected = matmul(host)" BAD "${SOURCE}")
reject(arity "${BAD}" "S027")
string(REPLACE "centered = -(projected - 1)" "centered = projected % 2" BAD "${SOURCE}")
reject(remainder "${BAD}" "S019")
string(REPLACE "weights: Tensor[float32, 3, 2] = tensor([[1, 0], [0, 1], [1, 1]])"
  "weights: Tensor[float32, 2, 3] = tensor([[1, 0, 0], [0, 1, 1]])" BAD "${SOURCE}")
# Remove the round trip here so the compiler knows both matmul shapes.
string(REPLACE "matmul(+host, weights)" "matmul(+(left + left), weights)" BAD "${BAD}")
reject(static-matmul "${BAD}" "S029")
# A named function hides dimensions from the bridge; the imported typed guard must catch it.
set(FORWARD "fn forward(values: Tensor[float32,?,?]) -> Tensor[float32,?,?]:\n  values\n\n")
string(REPLACE "matmul(+(left + left), weights)" "matmul(forward(host), weights)" DYNAMIC "${BAD}")
file(WRITE "${OUTPUT_DIR}/dynamic.k" "${FORWARD}${DYNAMIC}")
execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/dynamic.k" --target metal
  -o "${OUTPUT_DIR}/dynamic" --sanitize RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0)
  message(FATAL_ERROR "Dynamic inline mismatch should compile: ${OUT} ${ERROR}")
endif()
foreach(WORKERS IN ITEMS 1 2 4)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}"
    "${OUTPUT_DIR}/dynamic/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 1 OR NOT OUT STREQUAL "" OR NOT ERROR MATCHES "Metal task failed: 1/1")
    message(FATAL_ERROR "Dynamic inline shape guard missing: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endforeach()
# A same-rank axis mismatch must reject even when both tensors have equal element counts.
set(SHAPES "fn main() -> Tensor[float32,2,3] ! TaskError:\n  try parallel:\n    a: Tensor[float32,2,3] = tensor([[1,2,3],[4,5,6]])\n    b: Tensor[float32,3,2] = tensor([[1,2],[3,4],[5,6]])\n    gpu = devices.gpu()\n    input = try await transfer(a,gpu)\n    resident = try await spawn scale(input,1) on gpu\n    host = try await transfer(resident,devices.cpu())\n    (a + a) + b\n")
reject(axis-mismatch "${FUNCTIONS}${SHAPES}" "S011")
string(REPLACE "    (a + a) + b" "    a + vector" BAD "${SHAPES}")
string(REPLACE "    gpu = devices.gpu()" "    vector: Tensor[float32,6] = tensor([1,2,3,4,5,6])\n    gpu = devices.gpu()" BAD "${BAD}")
reject(rank-mismatch "${FUNCTIONS}${BAD}" "equal ranks")

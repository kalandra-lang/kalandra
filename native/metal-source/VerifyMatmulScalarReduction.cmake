include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/matmul-scalar-reduction.k" SOURCE)
string(FIND "${SOURCE}" "\nfn main()" SPLIT)
string(SUBSTRING "${SOURCE}" 0 ${SPLIT} OPS)
string(SUBSTRING "${SOURCE}" ${SPLIT} -1 MAIN)
string(REPLACE "fn project(" "export fn project(" OPS "${OPS}")
file(WRITE "${ROOT}/operations.k" "${OPS}")
file(WRITE "${ROOT}/public.k" "export from \"./operations.k\" import project as calculate\n")
set(PREFIX "from \"./public.k\" import calculate as project\nfn forward(values:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  values\n")
set(MAIN "${PREFIX}${MAIN}")
foreach(NAME IN ITEMS input weights bias)
  string(REPLACE "transfer(${NAME}, gpu)" "transfer(forward(${NAME}), gpu)" MAIN "${MAIN}")
endforeach()
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
function(reject NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS}: ${ERROR}")
  endif()
endfunction()
compile(imported "${MAIN}")
file(READ "${OUTPUT_DIR}/imported/manifest.txt" MANIFEST)
if(NOT MANIFEST MATCHES "scalar_stage=kernel0-scalar" OR NOT MANIFEST MATCHES "scalar_parameters=1")
  message(FATAL_ERROR "Final scalar stage lost")
endif()
string(REPLACE "input + scale" "input" UNMAPPED "${OPS}")
string(REPLACE "weights - 1" "weights" UNMAPPED "${UNMAPPED}")
file(WRITE "${ROOT}/operations.k" "${UNMAPPED}")
compile(no-input-maps "${MAIN}")
foreach(MAPS IN ITEMS with-maps bare)
  string(REPLACE "result(reduceSum(finish(product, bias, scale)), scale)" "reduceSum(product) / scale" SIMPLE "${OPS}")
  if(MAPS STREQUAL "bare")
    string(REPLACE "input + scale" "input" SIMPLE "${SIMPLE}")
    string(REPLACE "weights - 1" "weights" SIMPLE "${SIMPLE}")
  endif()
  file(WRITE "${ROOT}/operations.k" "${SIMPLE}")
  compile(${MAPS} "${MAIN}")
endforeach()
string(REPLACE "  result(reduceSum(finish(product, bias, scale)), scale)" "  value=reduceSum(finish(product,bias,scale))\n  value+value" REUSED "${OPS}")
file(WRITE "${ROOT}/operations.k" "${REUSED}")
compile(reused-scalar "${MAIN}")
set(HIGH_FN "fn many(a:Tensor[float32,?,?],b:Tensor[float32,?,?]")
set(HIGH_EXPR "value")
set(HIGH_ARGS "a,b")
foreach(I RANGE 0 39)
  string(APPEND HIGH_FN ",s${I}:float32")
  string(APPEND HIGH_EXPR " + s${I}")
  string(APPEND HIGH_ARGS ",2")
endforeach()
string(APPEND HIGH_FN ")->float32:\n  value=reduceSum(matmul(a,b))\n  ${HIGH_EXPR}\n")
string(REPLACE "spawn project(a, 2, b, offset)" "spawn many(${HIGH_ARGS})" HIGH_MAIN "${MAIN}")
compile(many-scalars "${HIGH_FN}${HIGH_MAIN}")
set(TENSOR_FN "fn tensors(a:Tensor[float32,?,?],b:Tensor[float32,?,?]")
set(TENSOR_EXPR "product")
set(TENSOR_ARGS "a,b")
foreach(I RANGE 0 29)
  string(APPEND TENSOR_FN ",t${I}:Tensor[float32,?,?]")
  string(APPEND TENSOR_EXPR " + t${I}")
  string(APPEND TENSOR_ARGS ",offset")
endforeach()
string(APPEND TENSOR_FN ")->float32:\n  product=multiply(a,b)\n  adjusted=${TENSOR_EXPR}\n  sum(adjusted)+1\n")
set(HELPERS "fn multiply(a:Tensor[float32,?,?],b:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  matmul(a,b)\nfn sum(v:Tensor[float32,?,?])->float32:\n  reduceSum(v)\n")
string(REPLACE "spawn project(a, 2, b, offset)" "spawn tensors(${TENSOR_ARGS})" TENSOR_MAIN "${MAIN}")
compile(indirect "${HELPERS}${TENSOR_FN}${TENSOR_MAIN}")
file(READ "${OUTPUT_DIR}/indirect/manifest.txt" TENSOR_MANIFEST)
if(NOT TENSOR_MANIFEST MATCHES "epilogue_binding_layout=argument_buffer_tier2" OR NOT TENSOR_MANIFEST MATCHES "scalar_parameters=0")
  message(FATAL_ERROR "Independent matrix/scalar captures lost")
endif()
if(NOT DEFINED VARIANT)
  foreach(BOUNDARY IN ITEMS two-matrices two-reductions)
    set(BAD "${OPS}")
    if(BOUNDARY STREQUAL "two-matrices")
      string(REPLACE "  product = matmul" "  ignored = matmul(input, weights)\n  product = matmul" BAD "${BAD}")
    elseif(BOUNDARY STREQUAL "two-reductions")
      string(REPLACE "  result(reduceSum(finish(product, bias, scale)), scale)" "  ignored=reduceSum(product)\n  result(reduceSum(finish(product,bias,scale)),scale)" BAD "${BAD}")
    endif()
    file(WRITE "${ROOT}/operations.k" "${BAD}")
    admit_case(${BOUNDARY} "${MAIN}")
  endforeach()
  # A pure choice over the completed scalar is now admitted.
  string(REPLACE "  -(value + scale) / scale" "  if scale > 0: value\n  else: 0" CHOICE "${OPS}")
  file(WRITE "${ROOT}/operations.k" "${CHOICE}")
  compile(branch "${MAIN}")
  message(STATUS "Final scalar source proof, arbitrary scalar captures, Tier 2 and transactional boundaries passed")
  return()
endif()
run(imported "c3400000\n" 0)
run(no-input-maps "c32e0000\n" 0)
run(with-maps "42b50000\n" 0)
run(bare "42a30000\n" 0)
run(reused-scalar "443f0000\n" 0)
run(many-scalars "43730000\n" 0)
run(indirect "43e80000\n" 0)
file(COPY "${OUTPUT_DIR}/imported/" DESTINATION "${OUTPUT_DIR}/relocated")
run(relocated "c3400000\n" 0)
file(WRITE "${ROOT}/operations.k" "${OPS}")
string(REPLACE "Tensor[float32, 2, 2] = tensor([[1, 2], [3, 4]])" "Tensor[float32, 1, 4] = tensor([[1, 2, 3, 4]])" BAD "${MAIN}")
compile(shape-fault "${BAD}")
run(shape-fault "" 1)
# Compare the final scalar shader against a separately placed reduction epilogue.
set(SEPARATE "fn matrix(a:Tensor[float32,?,?],b:Tensor[float32,?,?],bias:Tensor[float32,?,?],s:float32)->Tensor[float32,?,?]:\n  (matmul(a+s,b-1)+bias)*s\nfn total(v:Tensor[float32,?,?],s:float32)->float32:\n  -(reduceSum(v)+s)/s\n${MAIN}")
string(REPLACE "    work = spawn project(a, 2, b, offset) on gpu" "    adjusted=try await spawn matrix(a,b,offset,2) on gpu\n    work=spawn total(adjusted,2) on gpu" SEPARATE "${SEPARATE}")
compile(separate "${SEPARATE}")
run(separate "c3400000\n" 0)
foreach(SUFFIX IN ITEMS mlir lowered.mlir metal)
  file(SHA256 "${OUTPUT_DIR}/imported/kernel0-scalar.${SUFFIX}" A)
  file(SHA256 "${OUTPUT_DIR}/separate/kernel1-post.${SUFFIX}" B)
  if(NOT A STREQUAL B)
    message(FATAL_ERROR "Final scalar shader differs from separately placed epilogue ${SUFFIX}")
  endif()
endforeach()
message(STATUS "Final scalar ${VARIANT}: optional tensor stages, reused result, 40 scalars, Tier 2, shape guards and relocation passed")

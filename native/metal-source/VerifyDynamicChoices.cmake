include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/dynamic-choices.k" SOURCE)
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
compile(choices "${SOURCE}")
file(READ "${OUTPUT_DIR}/choices/manifest.txt" MANIFEST)
if(NOT MANIFEST MATCHES "kernel1.matrix_graph_edges=0:1,1:2" OR NOT MANIFEST MATCHES "kernel1.reduction_broadcasts=1:0")
  message(FATAL_ERROR "Dynamic choice lost resident shape-preserving stages: ${MANIFEST}")
endif()
string(REPLACE "Tensor[float32, ?]" "Tensor[float32, ?, ?]" MATRIX "${SOURCE}")
string(REPLACE "Tensor[float32, 3]" "Tensor[float32, 1, 3]" MATRIX "${MATRIX}")
string(REPLACE "tensor([1, 2, 3])" "tensor([[1, 2, 3]])" MATRIX "${MATRIX}")
string(REPLACE "tensor([4, 5, 6])" "tensor([[4, 5, 6]])" MATRIX "${MATRIX}")
compile(matrix "${MATRIX}")
string(REPLACE "normalize(first, y, 1)" "normalize(first, y, 100)" FALSE "${SOURCE}")
compile(false-arm "${FALSE}")
string(REPLACE "  if factor > 0:" "  if true:" CONSTANT "${SOURCE}")
compile(constant "${CONSTANT}")
string(REPLACE "    combined * factor" "    if factor>1:\n      combined*factor\n    else:\n      b+factor" NESTED "${SOURCE}")
compile(nested "${NESTED}")
string(REPLACE "    combined * factor" "    (combined + b) * factor" BRANCH_ARITHMETIC "${SOURCE}")
compile(branch-arithmetic "${BRANCH_ARITHMETIC}")
set(HELPER "fn add(a:Tensor[float32,?],b:Tensor[float32,?])->Tensor[float32,?]:\n  a+b\n")
string(REPLACE "combined = a + b" "combined = add(a, b)" HELPERS "${SOURCE}")
compile(helpers "${HELPER}${HELPERS}")
string(REPLACE "b: Tensor[float32, ?]" "b: Tensor[float32, 3]" MIXED "${SOURCE}")
compile(mixed "${MIXED}")
string(REPLACE "b: Tensor[float32, ?], factor" "b: Tensor[float32, ?], c: Tensor[float32, ?], factor" TRANSITIVE "${SOURCE}")
string(REPLACE "  combined = a + b\n  if factor" "  first = a + b\n  second = b + c\n  if factor" TRANSITIVE "${TRANSITIVE}")
string(REPLACE "    combined * factor" "    a * factor" TRANSITIVE "${TRANSITIVE}")
string(REPLACE "    b / factor" "    c / factor" TRANSITIVE "${TRANSITIVE}")
string(REPLACE "choose(x, y, 2)" "choose(x, y, x, 2)" TRANSITIVE "${TRANSITIVE}")
compile(transitive "${TRANSITIVE}")
string(REPLACE "Tensor[float32, 3]" "Tensor[float32, 0]" EMPTY "${SOURCE}")
string(REPLACE "tensor([1, 2, 3])" "tensor([])" EMPTY "${EMPTY}")
string(REPLACE "tensor([4, 5, 6])" "tensor([])" EMPTY "${EMPTY}")
compile(empty "${EMPTY}")
# Erase host-known dimensions to exercise the existing dynamic preconditions.
set(FORWARD "fn forward(a:Tensor[float32,?])->Tensor[float32,?]:\n  a\n")
string(REPLACE "transfer(a, gpu)" "transfer(forward(a), gpu)" FORWARDED "${SOURCE}")
string(REPLACE "transfer(b, gpu)" "transfer(forward(b), gpu)" FORWARDED "${FORWARDED}")
compile(forwarded "${FORWARD}${FORWARDED}")
string(REPLACE "b: Tensor[float32, 3] = tensor([4, 5, 6])" "b: Tensor[float32, 2] = tensor([4, 5])" WRONG "${FORWARDED}")
compile(mismatch "${FORWARD}${WRONG}")
string(REPLACE "transfer(b, gpu)" "transfer(forward(b), gpu)" TRANSITIVE_WRONG "${TRANSITIVE}")
string(REPLACE "b: Tensor[float32, 3] = tensor([4, 5, 6])" "b: Tensor[float32, 2] = tensor([4, 5])" TRANSITIVE_WRONG "${TRANSITIVE_WRONG}")
compile(transitive-mismatch "${FORWARD}${TRANSITIVE_WRONG}")
# Same element count does not establish equal dimensions.
set(MATRIX_FORWARD "fn forward(a:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  a\n")
string(REPLACE "transfer(a, gpu)" "transfer(forward(a), gpu)" WRONG_MATRIX "${MATRIX}")
string(REPLACE "transfer(b, gpu)" "transfer(forward(b), gpu)" WRONG_MATRIX "${WRONG_MATRIX}")
string(REPLACE "Tensor[float32, 1, 3] = tensor([[4, 5, 6]])" "Tensor[float32, 3, 1] = tensor([[4],[5],[6]])" WRONG_MATRIX "${WRONG_MATRIX}")
compile(matrix-mismatch "${MATRIX_FORWARD}${WRONG_MATRIX}")
if(DEFINED VARIANT)
  foreach(NAME IN ITEMS choices matrix constant nested helpers forwarded mixed)
    run(${NAME} "[3e7b823f,3eaaaaab,3ed79436]\n" 0)
  endforeach()
  run(branch-arithmetic "[3e8178a5,3eaaaaab,3ed3dcb1]\n" 0)
  run(transitive "[3e638e39,3eaaaaab,3ee38e39]\n" 0)
  run(transitive-mismatch "" 1)
  run(false-arm "[43c80000,43fa0000,44160000]\n" 0)
  run(empty "[]\n" 0)
  run(mismatch "" 1)
  run(matrix-mismatch "" 1)
  file(COPY "${OUTPUT_DIR}/choices/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "[3e7b823f,3eaaaaab,3ed79436]\n" 0)
else()
  function(reject NAME SOURCE)
    file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
    file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
    file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
    execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
    file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
    if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
      message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS} ${ERROR}")
    endif()
  endfunction()
  # Without the unconditional additions, independent dynamic extents have no proof.
  string(REPLACE "  combined = a + b\n" "" BAD "${SOURCE}")
  string(REPLACE "combined" "a" BAD "${BAD}")
  admit_case(unproven "${BAD}")
  string(REPLACE "    b / factor" "    (a+b) / factor" BAD "${BAD}")
  string(REPLACE "result = try await spawn normalize(first, y, 1) on gpu" "result = first" BAD "${BAD}")
  admit_case(branch-local-equality "${BAD}")
  # Alias facts from one helper invocation must not leak into another.
  set(ALIAS "fn pick(a:Tensor[float32,?],b:Tensor[float32,?],factor:float32)->Tensor[float32,?]:\n  if factor>0:\n    a\n  else:\n    b\nfn choose(a:Tensor[float32,?],b:Tensor[float32,?])->Tensor[float32,?]:\n  first=pick(a,a,1)\n  pick(a,b,1)\nfn main()->Tensor[float32,?] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,3]=tensor([1,2,3])\n    b:Tensor[float32,2]=tensor([4,5])\n    x=try await transfer(a,gpu)\n    y=try await transfer(b,gpu)\n    z=try await spawn choose(x,y) on gpu\n    try await transfer(z,devices.cpu())\n")
  admit_case(alias-isolation "${ALIAS}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/operand-choices.k" SOURCE)
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 60)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 60)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
compile(both "${SOURCE}")
file(READ "${OUTPUT_DIR}/both/manifest.txt" MANIFEST)
if(NOT MANIFEST MATCHES "left_tensor_bindings=0,1,2" OR NOT MANIFEST MATCHES "right_tensor_bindings=3,4" OR NOT MANIFEST MATCHES "left_binding_layout=argument_buffer_tier2" OR NOT MANIFEST MATCHES "right_binding_layout=argument_buffer_tier2" OR MANIFEST MATCHES "matrix_graph_edges")
  message(FATAL_ERROR "Independent single-matmul projections lost: ${MANIFEST}")
endif()
string(REPLACE "xx, yy, 2)" "xx, yy, 1)" MIDDLE "${SOURCE}")
compile(middle "${MIDDLE}")
string(REPLACE "xx, yy, 2)" "xx, yy, -1)" LAST "${SOURCE}")
compile(last "${LAST}")
string(REPLACE "if factor > 1:" "if true:" CONSTANT "${SOURCE}")
compile(constant "${CONSTANT}")
string(REPLACE "    y\n  matmul" "    x\n  matmul" IDENTICAL "${SOURCE}")
compile(identical "${IDENTICAL}")
string(REPLACE "  matmul(left, right)" "  matmul(left, right) * 2" POST "${SOURCE}")
compile(post "${POST}")
string(REPLACE "  matmul(left, right)" "  matmul(left, x)" LEFT_ONLY "${SOURCE}")
compile(left-only "${LEFT_ONLY}")
string(REPLACE "  matmul(left, right)" "  matmul(a, right)" RIGHT_ONLY "${SOURCE}")
compile(right-only "${RIGHT_ONLY}")
# A conditional operand also retains the independent multi-input result interface.
string(REPLACE "factor: float32) -> Tensor[float32, 2, 2]:" "bias: Tensor[float32, 2, 2], factor: float32) -> Tensor[float32, 2, 2]:" BIAS "${SOURCE}")
string(REPLACE "  matmul(left, right)" "  matmul(left, right) + bias" BIAS "${BIAS}")
string(REPLACE "    work = spawn project(aa, bb, cc, xx, yy, 2)" "    bias: Tensor[float32, 2, 2] = tensor([[1, 2], [3, 4]])\n    offset = try await transfer(bias, gpu)\n    work = spawn project(aa, bb, cc, xx, yy, offset, 2)" BIAS "${BIAS}")
compile(bias "${BIAS}")
file(READ "${OUTPUT_DIR}/bias/manifest.txt" BIAS_MANIFEST)
if(NOT BIAS_MANIFEST MATCHES "epilogue_binding_layout=argument_buffer_tier2" OR NOT BIAS_MANIFEST MATCHES "epilogue_tensor_bindings=0,6")
  message(FATAL_ERROR "Multi-input result map lost retained projections: ${BIAS_MANIFEST}")
endif()
# Cover the single-matmul + reduction admission path and scalar epilogue.
string(REPLACE "-> Tensor[float32, 2, 2]:" "-> float32:" SUM "${SOURCE}")
string(REPLACE "  matmul(left, right)" "  reduceSum(matmul(left, right)) * 2" SUM "${SUM}")
string(REPLACE "fn main() -> Tensor[float32, ?, ?]" "fn main() -> float32" SUM "${SUM}")
string(REPLACE "    try await transfer(cached, devices.cpu())" "    cached" SUM "${SUM}")
compile(sum "${SUM}")
# Dynamic operands need unconditional equality contracts, independently per side.
string(REPLACE "Tensor[float32, 2, 3]" "Tensor[float32, ?, ?]" DYNAMIC "${SOURCE}")
string(REPLACE "Tensor[float32, 3, 2]" "Tensor[float32, ?, ?]" DYNAMIC "${DYNAMIC}")
string(REPLACE "  if factor > 1:" "  aligned = a + b + c\n  if factor > 1:" DYNAMIC "${DYNAMIC}")
string(REPLACE "  right = if factor > 0:" "  aligned = x + y\n  right = if factor > 0:" DYNAMIC "${DYNAMIC}")
compile(dynamic "${DYNAMIC}")
set(FORWARD "fn forward(a:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  a\n")
string(REPLACE "transfer(c, gpu)" "transfer(forward(c), gpu)" MISMATCH "${DYNAMIC}")
string(REPLACE "tensor([[3, 4, 5], [6, 7, 8]])" "tensor([[3, 4], [5, 6], [7, 8]])" MISMATCH "${MISMATCH}")
compile(mismatch "${FORWARD}${MISMATCH}")
if(DEFINED VARIANT)
  run(dynamic "[41b00000,41e00000,42440000,42800000]\n" 0)
  run(mismatch "" 1)
  run(both "[41b00000,41e00000,42440000,42800000]\n" 0)
  run(middle "[41f80000,42200000,42680000,42980000]\n" 0)
  run(last "[42500000,42200000,42b00000,42860000]\n" 0)
  run(constant "[41b00000,41e00000,42440000,42800000]\n" 0)
  run(identical "[41b00000,41e00000,42440000,42800000]\n" 0)
  run(left-only "[41b00000,41e00000,42440000,42800000]\n" 0)
  run(right-only "[41b00000,41e00000,42440000,42800000]\n" 0)
  run(post "[42300000,42600000,42c40000,43000000]\n" 0)
  run(bias "[41b80000,41f00000,42500000,42880000]\n" 0)
  run(sum "43a30000\n" 0)
  file(COPY "${OUTPUT_DIR}/both/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "[41b00000,41e00000,42440000,42800000]\n" 0)
endif()

if(NOT DEFINED VARIANT)
  function(reject NAME SOURCE)
    file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
    file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
    file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
    execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR TIMEOUT 60)
    file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
    if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
      message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS} ${ERROR}")
    endif()
  endfunction()
  string(REPLACE "  aligned = a + b + c\n" "" UNPROVEN "${DYNAMIC}")
  admit_case(unproven "${UNPROVEN}")
  string(REPLACE "    a\n" "    a / reduceSum(a)\n" PRIMITIVE "${SOURCE}")
  admit_case(branch-primitive "${PRIMITIVE}")
endif()

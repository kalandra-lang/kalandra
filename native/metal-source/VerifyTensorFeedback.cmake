include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/tensor-feedback.k" SOURCE)
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
compile(normalize "${SOURCE}")
file(READ "${OUTPUT_DIR}/normalize/manifest.txt" MANIFEST)
file(READ "${OUTPUT_DIR}/normalize/kernel0-map0.mlir" MAP)
if(NOT MANIFEST MATCHES "graph_result=tensor" OR NOT MANIFEST MATCHES "reduction_inputs=0" OR NOT MAP MATCHES "memref.load %a2\\[%zero\\]" OR EXISTS "${OUTPUT_DIR}/normalize/kernel0-join.mlir" OR EXISTS "${OUTPUT_DIR}/normalize/kernel0-scalar.mlir")
  message(FATAL_ERROR "Lost resident tensor return: ${MANIFEST}")
endif()
string(REPLACE "Tensor[float32, ?]" "Tensor[float32, ?, ?]" MATRIX "${SOURCE}")
string(REPLACE "Tensor[float32, 3] = tensor([2, 4, 6])" "Tensor[float32, 1, 3] = tensor([[2, 4, 6]])" MATRIX "${MATRIX}")
compile(matrix "${MATRIX}")
string(REPLACE "values / denominator" "denominator / values" REVERSE "${SOURCE}")
compile(reverse "${REVERSE}")
string(REPLACE "  divide(values, total / scale)" "  adjusted=divide(values,total/scale)\n  adjusted / reduceSum(adjusted)" CHAIN "${SOURCE}")
compile(chain "${CHAIN}")
string(REPLACE "reduceSum(values)" "reduceSum(values * scale)" UPSTREAM "${SOURCE}")
compile(upstream "${UPSTREAM}")
string(REPLACE "total / scale" "total" NO_SCALARS "${SOURCE}")
string(REPLACE ", scale: float32" "" NO_SCALARS "${NO_SCALARS}")
string(REPLACE "normalize(input, 3)" "normalize(input)" NO_SCALARS "${NO_SCALARS}")
compile(no-scalars "${NO_SCALARS}")
set(PRODUCT "fn compute(a:Tensor[float32,?,?],b:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  first=matmul(a,b)\n  total=reduceSum(first)\n  matmul(first/total,b)\nfn main()->Tensor[float32,?,?] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,2,2]=tensor([[1,0],[0,1]])\n    x=try await transfer(a,gpu)\n    work=try await spawn compute(x,x) on gpu\n    try await transfer(work,devices.cpu())\n")
compile(products "${PRODUCT}")
set(WIDE "fn subtotal(a:Tensor[float32,?])->float32:\n  reduceSum(a)\nfn wide(a:Tensor[float32,?])->Tensor[float32,?]:\n")
set(EXPR "v0")
foreach(I RANGE 0 31)
  string(APPEND WIDE "  v${I}=subtotal(a)\n")
  if(I GREATER 0)
    string(APPEND EXPR " + v${I}")
  endif()
endforeach()
string(APPEND WIDE "  a/(${EXPR})\nfn main()->Tensor[float32,?] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,3]=tensor([2,4,6])\n    x=try await transfer(a,gpu)\n    work=try await spawn wide(x) on gpu\n    try await transfer(work,devices.cpu())\n")
compile(wide "${WIDE}")
file(READ "${OUTPUT_DIR}/wide/host.cpp" HOST)
if(NOT HOST MATCHES "ElementwiseSignature\\{33,0,m::ElementwiseBinding::ArgumentBuffer")
  message(FATAL_ERROR "Lost Tier 2 tensor-result broadcasts")
endif()
# Forward the returned tensor into a distinct GPU task before explicit download.
set(SCALE "fn scale(values:Tensor[float32,?])->Tensor[float32,?]:\n  values * 2\n")
string(REPLACE "try await transfer(cached, devices.cpu())" "shifted=try await spawn scale(cached) on gpu\n    try await transfer(shifted,devices.cpu())" FORWARD "${SOURCE}")
compile(forward "${SCALE}${FORWARD}")
if(DEFINED VARIANT)
  run(normalize "[3f000000,3f800000,3fc00000]\n" 0)
  run(matrix "[3f000000,3f800000,3fc00000]\n" 0)
  run(reverse "[40000000,3f800000,3f2aaaab]\n" 0)
  run(chain "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(upstream "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(no-scalars "[3e2aaaab,3eaaaaab,3f000000]\n" 0)
  run(products "[3f000000,00000000,00000000,3f000000]\n" 0)
  run(wide "[3baaaaab,3c2aaaab,3c800000]\n" 0)
  run(forward "[3f800000,40000000,40400000]\n" 0)
  file(COPY "${OUTPUT_DIR}/normalize/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "[3f000000,3f800000,3fc00000]\n" 0)
endif()
if(NOT DEFINED VARIANT)
  string(REPLACE "  total =" "  unused=reduceSum(values)\n  total =" UNUSED "${SOURCE}")
  admit_case(unused-reduction "${UNUSED}")
endif()

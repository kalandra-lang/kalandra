file(READ "${SOURCE_DIR}/tensor-results.k" SOURCE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(build_run NAME CONTENT EXPECTED FAILURE)
  set(FLAG -O2)
  if(ARGC GREATER 4)
    set(FLAG "${ARGV4}")
  endif()
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal -o "${OUTPUT_DIR}/${NAME}" "${FLAG}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: build failed: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(FAILURE)
      if(NOT STATUS EQUAL 1 OR NOT ERROR MATCHES "Metal task failed: 1/1" OR NOT OUT STREQUAL "")
        message(FATAL_ERROR "${NAME}: expected ShapeFault, got ${STATUS}: ${OUT} ${ERROR}")
      endif()
    elseif(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "${EXPECTED}\n")
      message(FATAL_ERROR "${NAME}: unexpected result ${STATUS}: ${OUT} ${ERROR}")
    endif()
  endforeach()
endfunction()
# Empty CPU returns must work even when MLIR can eliminate their allocation.
string(REPLACE "Tensor[float32, 3]" "Tensor[float32, 0]" EMPTY "${SOURCE}")
string(REPLACE "tensor([first, second, third])" "tensor([])" EMPTY "${EMPTY}")
build_run(empty "${EMPTY}" "[]" FALSE --sanitize)
# A partial final GPU workgroup fed by a no-argument CPU tensor factory.
set(VALUES "")
set(EXPECTED "[")
foreach(I RANGE 0 64)
  string(APPEND VALUES "${I}, ")
endforeach()
set(FACTORY "fn input() -> Tensor[float32, 65]:\n  tensor([${VALUES}])\n\n${SOURCE}")
string(REPLACE "prepare(seed(1, 2, 3))" "prepare(input())" FACTORY "${FACTORY}")
string(REPLACE "prepare(seed(4, 5, 6))" "prepare(input())" FACTORY "${FACTORY}")
string(REPLACE "fn main() -> Tensor[float32, 3]" "fn main() -> Tensor[float32, 65]" FACTORY "${FACTORY}")
# The expected values are exact float32 integers; supplied independently of compiler output.
set(EXPECTED "[00000000,40000000,40c00000,41400000,41a00000,41f00000,42280000,42600000,42900000,42b40000,42dc0000,43040000,431c0000,43360000,43520000,43700000,43880000,43990000,43ab0000,43be0000,43d20000,43e70000,43fd0000,440a0000,44160000,44228000,442f8000,443d0000,444b0000,44598000,44688000,44780000,44840000,448c4000,4494c000,449d8000,44a68000,44afc000,44b94000,44c30000,44cd0000,44d74000,44e1c000,44ec8000,44f78000,45016000,45072000,450d0000,45130000,45192000,451f6000,4525c000,452c4000,4532e000,4539a000,45408000,45478000,454ea000,4555e000,455d4000,4564c000,456c6000,45742000,457c0000,45820000]")
build_run(tail "${FACTORY}" "${EXPECTED}" FALSE)
# Preserve CPU-returned data across clones, transfers and an independent GPU result.
string(REPLACE "seed(1, 2, 3)" "seed(-0, 1e-45, 3)" PRESERVED "${SOURCE}")
string(REPLACE "    prepare(host)" "    prepare(left)" PRESERVED "${PRESERVED}")
build_run(immutable-bits "${PRESERVED}" "[80000000,00000001,40400000]" FALSE)
# Runtime dimensions: dynamic identity results cannot be assumed equal.
string(REPLACE "    right = prepare(seed(4, 5, 6))" "    smaller: Tensor[float32, 2] = tensor([4, 5])\n    right = prepare(smaller)" BAD "${SOURCE}")
build_run(gpu-shape-fault "${BAD}" "" TRUE)
string(REPLACE "    left = prepare(seed(1, 2, 3))" "    left: Tensor[float32, 2] = prepare(seed(1, 2, 3))" BAD "${SOURCE}")
build_run(binding-shape-fault "${BAD}" "" TRUE)
string(REPLACE "fn main() -> Tensor[float32, 3]" "fn main() -> Tensor[float32, 2]" BAD "${SOURCE}")
build_run(main-shape-fault "${BAD}" "" TRUE)
# A CPU interface also checks a dynamic returned tensor against a static parameter.
set(BAD "fn exact(values: Tensor[float32, 4]) -> Tensor[float32, 4]:\n  values\n\n${SOURCE}")
string(REPLACE "fn main() -> Tensor[float32, 3]" "fn main() -> Tensor[float32, ?]" BAD "${BAD}")
string(REPLACE "    prepare(host)" "    exact(prepare(host))" BAD "${BAD}")
build_run(cpu-shape-fault "${BAD}" "" TRUE)
# CPU computation can construct the result tensor, not only forward an existing value.
set(SUMMARY "fn summarize(values: Tensor[float32, ?]) -> Tensor[float32, 1]:\n  tensor([reduceSum(values)])\n\n${SOURCE}")
string(REPLACE "fn main() -> Tensor[float32, 3]" "fn main() -> Tensor[float32, 1]" SUMMARY "${SUMMARY}")
string(REPLACE "    prepare(host)" "    summarize(prepare(host))" SUMMARY "${SUMMARY}")
build_run(computed-result "${SUMMARY}" "[42180000]" FALSE)
message(STATUS "CPU tensor factories/returns, empty/tail shapes, immutable bits and runtime shape faults passed")

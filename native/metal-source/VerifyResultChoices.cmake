include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/result-choices.k" SOURCE)
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 60)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 60)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
compile(choice "${SOURCE}")
file(READ "${OUTPUT_DIR}/choice/manifest.txt" MANIFEST)
file(READ "${OUTPUT_DIR}/choice/kernel0-post.mlir" POST)
if(NOT MANIFEST MATCHES "epilogue_tensor_bindings=0,3" OR NOT MANIFEST MATCHES "epilogue_binding_layout=argument_buffer_tier2" OR MANIFEST MATCHES "matrix_graph_edges" OR NOT POST MATCHES "arith.select")
  message(FATAL_ERROR "Choice lost its projected resident result map: ${MANIFEST}")
endif()
string(REPLACE "project(x, y, z, 2)" "project(x, y, z, -1)" FALSE "${SOURCE}")
compile(false "${FALSE}")
string(REPLACE "if factor > 0:" "if true:" CONSTANT "${SOURCE}")
compile(constant "${CONSTANT}")
string(REPLACE "    bias\n" "    product * factor\n" IDENTICAL "${SOURCE}")
compile(identical "${IDENTICAL}")
string(REPLACE "    product * factor" "    if factor > 1:\n      product * factor\n    else:\n      -product" NESTED "${SOURCE}")
compile(nested "${NESTED}")
string(REPLACE "project(x, y, z, 2)" "project(x, y, z, 1)" NESTED_FALSE "${NESTED}")
compile(nested-false "${NESTED_FALSE}")
# A helper receives the already-computed product; it may use either arm normally.
set(HELPER "fn choose(product:Tensor[float32,2,2],bias:Tensor[float32,2,2],factor:float32)->Tensor[float32,2,2]:\n  if factor>0:\n    product*factor\n  else:\n    bias\n")
string(REPLACE "  if factor > 0:\n    product * factor\n  else:\n    bias" "  choose(product,bias,factor)" FORWARDED "${SOURCE}")
compile(helper "${HELPER}${FORWARDED}")
# The chosen tensor can feed the existing resident reduction and scalar epilogue.
string(REPLACE "-> Tensor[float32, 2, 2]:" "-> float32:" SUM "${SOURCE}")
string(REPLACE "  if factor > 0:" "  selected = if factor > 0:" SUM "${SUM}")
string(REPLACE "    bias\n\nfn main" "    bias\n  reduceSum(selected) * 2\n\nfn main" SUM "${SUM}")
string(REPLACE "fn main() -> Tensor[float32, ?, ?]" "fn main() -> float32" SUM "${SUM}")
string(REPLACE "    try await transfer(cached, devices.cpu())" "    cached" SUM "${SUM}")
compile(sum "${SUM}")
string(REPLACE "product = matmul(a, b)" "product = matmul(a + factor, b - 1)" MAPPED "${SOURCE}")
compile(mapped "${MAPPED}")
# Equality with the product is established before choosing, never in a speculative arm.
string(REPLACE "Tensor[float32, 2, 2]" "Tensor[float32, ?, ?]" DYNAMIC "${SOURCE}")
string(REPLACE "  if factor > 0:" "  aligned = product + bias\n  if factor > 0:" DYNAMIC "${DYNAMIC}")
compile(dynamic "${DYNAMIC}")
set(FORWARD "fn forward(a:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  a\n")
string(REPLACE "transfer(bias, gpu)" "transfer(forward(bias), gpu)" WRONG "${DYNAMIC}")
string(REPLACE "tensor([[1, 2], [3, 4]])" "tensor([[1, 2, 3, 4]])" WRONG "${WRONG}")
compile(mismatch "${FORWARD}${WRONG}")
if(DEFINED VARIANT)
  run(choice "[42300000,42600000,42c40000,43000000]\n" 0)
  run(false "[3f800000,40000000,40400000,40800000]\n" 0)
  run(constant "[42300000,42600000,42c40000,43000000]\n" 0)
  run(identical "[42300000,42600000,42c40000,43000000]\n" 0)
  run(nested "[42300000,42600000,42c40000,43000000]\n" 0)
  run(nested-false "[c1b00000,c1e00000,c2440000,c2800000]\n" 0)
  run(helper "[42300000,42600000,42c40000,43000000]\n" 0)
  run(mapped "[42600000,42a00000,42b80000,43060000]\n" 0)
  run(dynamic "[42300000,42600000,42c40000,43000000]\n" 0)
  run(mismatch "" 1)
  run(sum "44230000\n" 0)
  file(COPY "${OUTPUT_DIR}/choice/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "[42300000,42600000,42c40000,43000000]\n" 0)
endif()

if(NOT DEFINED VARIANT)
  function(reject NAME SOURCE)
    file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
    file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
    file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
    execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR TIMEOUT 60)
    file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
    if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
      message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS} ${ERROR}")
    endif()
  endfunction()
  string(REPLACE "    bias\n" "    matmul(a, b)\n" PRIMITIVE "${SOURCE}")
  string(REPLACE "  aligned = product + bias\n" "" UNPROVEN "${DYNAMIC}")
  admit_case(unproven "${UNPROVEN}")
  admit_case(branch-primitive "${PRIMITIVE}")
  string(REPLACE "    bias\n" "    tensor([[1,2],[3,4]])\n" ALLOCATION "${SOURCE}")
  reject(branch-allocation "${ALLOCATION}")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/pre-matmul.k" SOURCE)
string(FIND "${SOURCE}" "\nfn main()" SPLIT)
string(SUBSTRING "${SOURCE}" 0 ${SPLIT} OPS)
string(SUBSTRING "${SOURCE}" ${SPLIT} -1 MAIN)
string(REPLACE "\nfn project(" "\nexport fn project(" OPS "${OPS}")
file(WRITE "${ROOT}/operations.k" "${OPS}")
file(WRITE "${ROOT}/public.k" "export from \"./operations.k\" import project as calculate\n")
set(PREFIX "from \"./public.k\" import calculate as project\nfn forward(values:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  values\n")
set(MAIN "${PREFIX}${MAIN}")
foreach(NAME IN ITEMS input weights bias)
  string(REPLACE "transfer(${NAME}, gpu)" "transfer(forward(${NAME}), gpu)" MAIN "${MAIN}")
endforeach()
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
function(reject NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS}: ${ERROR}")
  endif()
endfunction()
compile(imported "${MAIN}")
file(READ "${OUTPUT_DIR}/imported/kernel0-left.mlir" LEFT)
file(READ "${OUTPUT_DIR}/imported/kernel0-right.mlir" RIGHT)
file(READ "${OUTPUT_DIR}/imported/manifest.txt" MANIFEST)
if(NOT LEFT MATCHES "arith.addf" OR NOT RIGHT MATCHES "arith.subf" OR
   NOT MANIFEST MATCHES "left_tensor_bindings=0" OR NOT MANIFEST MATCHES "right_tensor_bindings=2" OR
   NOT MANIFEST MATCHES "epilogue_tensor_bindings=0,2")
  message(FATAL_ERROR "Independent operand/post projections lost")
endif()
set(HIGH_FN "fn many(a:Tensor[float32,?,?],b:Tensor[float32,?,?]")
set(HIGH_EXPR "a")
set(HIGH_ARGS "a,b")
foreach(I RANGE 0 29)
  string(APPEND HIGH_FN ",extra${I}:Tensor[float32,?,?]")
  string(APPEND HIGH_EXPR " + extra${I}")
  string(APPEND HIGH_ARGS ",a")
endforeach()
string(APPEND HIGH_FN ")->Tensor[float32,?,?]:\n  prepared=${HIGH_EXPR}\n  multiply(prepared,b)\n")
string(REPLACE "spawn project(a, offset, 2, b)" "spawn many(${HIGH_ARGS})" HIGH_MAIN "${MAIN}")
set(MULTIPLY "fn multiply(a:Tensor[float32,?,?],b:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  matmul(a,b)\n")
compile(indirect "${MULTIPLY}${HIGH_FN}${HIGH_MAIN}")
file(READ "${OUTPUT_DIR}/indirect/manifest.txt" HIGH_MANIFEST)
if(NOT HIGH_MANIFEST MATCHES "left_binding_layout=argument_buffer_tier2")
  message(FATAL_ERROR "Operand map lost Tier 2 bindings")
endif()
foreach(SIDE IN ITEMS left right)
  if(SIDE STREQUAL "left")
    string(REPLACE "weights - 1" "weights" ONE "${OPS}")
  else()
    string(REPLACE "input + scale" "input" ONE "${OPS}")
  endif()
  file(WRITE "${ROOT}/operations.k" "${ONE}")
  compile(${SIDE} "${MAIN}")
endforeach()
string(REPLACE "  finish(product, bias, scale)" "  product" PURE "${OPS}")
file(WRITE "${ROOT}/operations.k" "${PURE}")
compile(no-post "${MAIN}")
# Repeated/reordered helper arguments and two different maps of the same matrix.
set(SQUARE_FN "fn prepare(b:Tensor[float32,?,?],a:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  matmul(a+1,b*2)\nfn square(v:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  prepare(v,v)\n")
string(REPLACE "spawn project(a, offset, 2, b)" "spawn square(offset)" SQUARE_MAIN "${MAIN}")
compile(reused "${SQUARE_FN}${SQUARE_MAIN}")
if(NOT DEFINED VARIANT)
  string(REPLACE "  product = matmul" "  ignored = matmul(input, weights)\n  product = matmul" BAD "${OPS}")
  file(WRITE "${ROOT}/operations.k" "${BAD}")
  admit_case(two-matrices "${MAIN}")
  # Pure same-source choices also compose through operand helpers.
  set(BRANCH "fn choose(v:Tensor[float32,?,?],s:float32)->Tensor[float32,?,?]:\n  if s > 0: v+1\n  else: v\n")
  string(REPLACE "input + scale" "choose(input,scale)" BAD "${OPS}")
  file(WRITE "${ROOT}/operations.k" "${BRANCH}${BAD}")
  compile(branch "${MAIN}")
  message(STATUS "Matrix operands: independent maps, imports, Tier 2 and transactional rejection passed")
  return()
endif()
run(imported "[42680000,42a80000,42c40000,430e0000]\n" 0)
run(left "[42a40000,42d80000,430c0000,43380000]\n" 0)
run(right "[42080000,42400000,42940000,42d40000]\n" 0)
run(no-post "[41e00000,42200000,42380000,42860000]\n" 0)
run(reused "[41b00000,42000000,42180000,42600000]\n" 0)
run(indirect "[442a8000,44590000,44bde000,44f80000]\n" 0)
file(COPY "${OUTPUT_DIR}/imported/" DESTINATION "${OUTPUT_DIR}/relocated")
run(relocated "[42680000,42a80000,42c40000,430e0000]\n" 0)
# Full input shape checks remain transitive, including equal-count unequal shapes.
set(SHAPE_FN "fn shaped(a:Tensor[float32,?,?],extra:Tensor[float32,?,?],b:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  matmul(a+extra,b)\n")
string(REPLACE "spawn project(a, offset, 2, b)" "spawn shaped(a,offset,b)" BAD_MAIN "${MAIN}")
string(REPLACE "Tensor[float32, 2, 2] = tensor([[1, 2], [3, 4]])" "Tensor[float32, 1, 6] = tensor([[1, 2, 3, 4, 5, 6]])" BAD_MAIN "${BAD_MAIN}")
compile(shape-fault "${SHAPE_FN}${BAD_MAIN}")
run(shape-fault "" 1)
# Compare a separately scheduled map/matmul/post sequence and unchanged primitive source.
set(SEPARATE "fn shift(a:Tensor[float32,?,?],s:float32)->Tensor[float32,?,?]:\n  a+s\nfn adjust(b:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  b-1\nfn plain(a:Tensor[float32,?,?],b:Tensor[float32,?,?])->Tensor[float32,?,?]:\n  matmul(a,b)\nfn finish(a:Tensor[float32,?,?],bias:Tensor[float32,?,?],s:float32)->Tensor[float32,?,?]:\n  (a+bias)*s\n${MAIN}")
string(REPLACE "    work = spawn project(a, offset, 2, b) on gpu" "    left = try await spawn shift(a,2) on gpu\n    right = try await spawn adjust(b) on gpu\n    product = try await spawn plain(left,right) on gpu\n    work = spawn finish(product,offset,2) on gpu" SEPARATE "${SEPARATE}")
compile(separate "${SEPARATE}")
run(separate "[42680000,42a80000,42c40000,430e0000]\n" 0)
foreach(SUFFIX IN ITEMS mlir lowered.mlir metal)
  file(SHA256 "${OUTPUT_DIR}/imported/kernel0.${SUFFIX}" A)
  file(SHA256 "${OUTPUT_DIR}/separate/kernel2.${SUFFIX}" B)
  if(NOT A STREQUAL B)
    message(FATAL_ERROR "Operand maps changed strict multiplication shader ${SUFFIX}")
  endif()
endforeach()
message(STATUS "Matrix operands ${VARIANT}: separate equivalence, both/single-side maps, no-post, reused input, shapes, Tier 2, relocation passed")

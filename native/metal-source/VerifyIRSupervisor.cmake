file(MAKE_DIRECTORY "${OUTPUT_DIR}")
foreach(VARIANT IN ITEMS debug optimized sanitized thread-sanitized)
  if(VARIANT STREQUAL "debug")
    set(FLAG)
  elseif(VARIANT STREQUAL "optimized")
    set(FLAG -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAG --sanitize)
  else()
    set(FLAG --thread-sanitize)
  endif()
  set(DEST "${OUTPUT_DIR}/${VARIANT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${SOURCE}" --target metal -o "${DEST}" ${FLAG}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${VARIANT}: typed supervisor compilation failed: ${STATUS}: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${DEST}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "[41700000,00000000,41c80000]\n")
      message(FATAL_ERROR "${VARIANT}/${WORKERS}: typed supervisor execution: ${STATUS}: ${OUT} ${ERROR}")
    endif()
  endforeach()
  file(READ "${DEST}/placement.ir" IR)
  if(NOT IR MATCHES "catch" OR NOT IR MATCHES "shape.check" OR NOT IR MATCHES "device.gpu")
    message(FATAL_ERROR "${VARIANT}: expected checked control flow and placement")
  endif()
endforeach()
# The sanitizer-instrumented compiler must make identical semantic/lowering decisions.
execute_process(COMMAND "${SANITIZED_COMPILER}" --arithmetic software "${SOURCE}" -o "${OUTPUT_DIR}/compiler-sanitized"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0)
  message(FATAL_ERROR "Sanitized compiler rejected typed supervisor: ${OUT} ${ERROR}")
endif()
foreach(FILE IN ITEMS host.cpp cpu.ll kernel0.mlir placement.ir continuation.plan manifest.txt)
  file(SHA256 "${OUTPUT_DIR}/debug/${FILE}" NORMAL)
  file(SHA256 "${OUTPUT_DIR}/compiler-sanitized/${FILE}" SANITIZED)
  if(NOT NORMAL STREQUAL SANITIZED)
    message(FATAL_ERROR "Compiler instrumentation changed ${FILE}")
  endif()
endforeach()
message(STATUS "IR-driven supervisor: pipelines, main-first function IDs, shadowed symbols, typed fields, settled recovery, shape guards and nested groups passed with 1/2/4 workers in four build variants")

file(READ "${SOURCE_DIR}/mixed.k" SOURCE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(build_run NAME CONTENT EXPECTED FAILURE)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal -o "${OUTPUT_DIR}/${NAME}" -O2
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: build failed: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(FAILURE)
      if(NOT STATUS EQUAL 1 OR NOT ERROR MATCHES "Metal task failed" OR NOT OUT STREQUAL "")
        message(FATAL_ERROR "${NAME}: expected CPU fault, got ${STATUS}: ${OUT} ${ERROR}")
      endif()
    elseif(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "${EXPECTED}\n")
      message(FATAL_ERROR "${NAME}: unexpected result ${STATUS}: ${OUT} ${ERROR}")
    endif()
  endforeach()
endfunction()
string(REPLACE "Tensor[float32, 3]" "Tensor[float32, 0]" EMPTY "${SOURCE}")
string(REPLACE "[1, 2, 3]" "[]" EMPTY "${EMPTY}")
string(REPLACE "[4, 5, 6]" "[]" EMPTY "${EMPTY}")
build_run(empty "${EMPTY}" "00000000" FALSE)
# A CPU helper's dynamic tensor is checked against a fixed-shape callee at runtime.
set(FAULT "fn exact(values: Tensor[float32, 4]) -> float32:\n  reduceSum(values)\n\n${SOURCE}")
string(REPLACE "  reduceSum(values)\n\nfn finish" "  exact(values)\n\nfn finish" FAULT "${FAULT}")
# Move the first CPU call after the GPU download so the fault crosses both boundaries.
string(REPLACE "    baseline = total(left)\n" "" FAULT "${FAULT}")
string(REPLACE "finish(total(host), baseline)" "total(host)" FAULT "${FAULT}")
set(FAULT "fn forward(values: Tensor[float32, ?]) -> Tensor[float32, ?]:\n  values\n\n${FAULT}")
string(REPLACE "total(host)" "total(forward(host))" FAULT "${FAULT}")
build_run(cpu-shape-fault "${FAULT}" "" TRUE)
# Same mixed source can still return a host tensor after ordinary CPU calls.
string(REPLACE "fn main() -> float32" "fn main() -> Tensor[float32, 3]" TENSOR "${SOURCE}")
string(REPLACE "    finish(total(host), baseline)" "    summary = finish(total(host), baseline)\n    host" TENSOR "${TENSOR}")
build_run(tensor-result "${TENSOR}" "[40a00000,41400000,41a80000]" FALSE)
set(PAIR "fn pair(first: Tensor[float32, ?], second: Tensor[float32, ?]) -> float32:\n  total(first) + total(second)\n\n${SOURCE}")
string(REPLACE "finish(total(host), baseline)" "finish(pair(host, left), 0)" PAIR "${PAIR}")
build_run(two-cpu-tensors "${PAIR}" "42300000" FALSE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}/relocated")
file(COPY "${OUTPUT_DIR}/tensor-result/program" "${OUTPUT_DIR}/tensor-result/kernel0.metallib" DESTINATION "${OUTPUT_DIR}/relocated")
execute_process(COMMAND "${OUTPUT_DIR}/relocated/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "[40a00000,41400000,41a80000]\n")
  message(FATAL_ERROR "Mixed program relocation failed: ${OUT} ${ERROR}")
endif()
file(READ "${OUTPUT_DIR}/tensor-result/cpu.mlir" IR)
if(NOT IR MATCHES "kalandra_cpu_0" OR NOT IR MATCHES "scf.for")
  message(FATAL_ERROR "CPU reduction did not lower through MLIR")
endif()
message(STATUS "Mixed source zero-length, CPU shape fault, tensor return and relocation passed")

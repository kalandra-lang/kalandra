include("${CMAKE_CURRENT_LIST_DIR}/VerifyAdmitted.cmake")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/nary-choices.k" SOURCE)
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 60)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR TIMEOUT 60)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
compile(nary "${SOURCE}")
file(READ "${OUTPUT_DIR}/nary/manifest.txt" MANIFEST)
if(NOT MANIFEST MATCHES "kernel1.map2_inputs=0,1,2" OR NOT MANIFEST MATCHES "kernel1.map2_tensors=4")
  message(FATAL_ERROR "N-ary operand/broadcast interface is missing: ${MANIFEST}")
endif()
string(REPLACE "Tensor[float32, ?]" "Tensor[float32, ?, ?]" MATRIX "${SOURCE}")
string(REPLACE "Tensor[float32, 3]" "Tensor[float32, 1, 3]" MATRIX "${MATRIX}")
foreach(VALUES IN ITEMS "1, 2, 3" "4, 5, 6" "7, 8, 9")
  string(REPLACE "tensor([${VALUES}])" "tensor([[${VALUES}]])" MATRIX "${MATRIX}")
endforeach()
compile(matrix "${MATRIX}")
string(REPLACE "normalize(first, y, z, 1)" "normalize(first, y, z, 100)" FALSE "${SOURCE}")
compile(false-arm "${FALSE}")
string(REPLACE "  if total > threshold:" "  if false:" CONSTANT "${SOURCE}")
compile(constant "${CONSTANT}")
string(REPLACE "Tensor[float32, 3]" "Tensor[float32, 0]" EMPTY "${SOURCE}")
foreach(VALUES IN ITEMS "1, 2, 3" "4, 5, 6" "7, 8, 9")
  string(REPLACE "tensor([${VALUES}])" "tensor([])" EMPTY "${EMPTY}")
endforeach()
compile(empty "${EMPTY}")
string(REPLACE "  total = reduceSum(a + b + c)" "  left=a+b\n  middle=b+c\n  right=c+a\n  total=reduceSum(left+middle+right)" INTERMEDIATE "${SOURCE}")
string(REPLACE "    a / total" "    left / total" INTERMEDIATE "${INTERMEDIATE}")
string(REPLACE "      b * threshold" "      middle * threshold" INTERMEDIATE "${INTERMEDIATE}")
string(REPLACE "      c + threshold" "      right + threshold" INTERMEDIATE "${INTERMEDIATE}")
compile(intermediates "${INTERMEDIATE}")
set(PROJECT "fn project(a:Tensor[float32,2,2],b:Tensor[float32,2,2],c:Tensor[float32,2,2],factor:float32)->Tensor[float32,2,2]:\n  selected=if factor>1:\n    a\n  else:\n    if factor>0:\n      b\n    else:\n      c\n  matmul(matmul(selected,a),b)\nfn main()->Tensor[float32,2,2] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,2,2]=tensor([[1,0],[0,1]])\n    b:Tensor[float32,2,2]=tensor([[2,0],[0,2]])\n    c:Tensor[float32,2,2]=tensor([[3,0],[0,3]])\n    x=try await transfer(a,gpu)\n    y=try await transfer(b,gpu)\n    z=try await transfer(c,gpu)\n    result=try await spawn project(x,y,z,2) on gpu\n    try await transfer(result,devices.cpu())\n")
compile(products "${PROJECT}")
set(FORWARD "fn forward(values:Tensor[float32,?])->Tensor[float32,?]:\n  values\n")
string(REPLACE "transfer(b, gpu)" "transfer(forward(b), gpu)" WRONG "${SOURCE}")
string(REPLACE "b: Tensor[float32, 3] = tensor([4, 5, 6])" "b: Tensor[float32, 2] = tensor([4, 5])" WRONG "${WRONG}")
compile(middle-mismatch "${FORWARD}${WRONG}")
# Forty independent source slots exercise the indirect resource table beyond direct limits.
set(PARAMETERS "")
set(ARGUMENTS "")
set(ALIGNED "")
set(LEFT "")
set(RIGHT "")
foreach(INDEX RANGE 0 39)
  if(INDEX GREATER 0)
    string(APPEND PARAMETERS ",")
    string(APPEND ARGUMENTS ",")
    string(APPEND ALIGNED "+")
  endif()
  string(APPEND PARAMETERS "a${INDEX}:Tensor[float32,3]")
  math(EXPR CHOICE "${INDEX}%3")
  if(CHOICE EQUAL 0)
    string(APPEND ARGUMENTS "x")
  elseif(CHOICE EQUAL 1)
    string(APPEND ARGUMENTS "y")
  else()
    string(APPEND ARGUMENTS "z")
  endif()
  string(APPEND ALIGNED "a${INDEX}")
  if(INDEX LESS 20)
    if(NOT LEFT STREQUAL "")
      string(APPEND LEFT "+")
    endif()
    string(APPEND LEFT "a${INDEX}")
  else()
    if(NOT RIGHT STREQUAL "")
      string(APPEND RIGHT "+")
    endif()
    string(APPEND RIGHT "a${INDEX}")
  endif()
endforeach()
set(BRANCHES "  total=reduceSum(a0)\n  if total>factor:\n    ${LEFT}\n  else:\n    ${RIGHT}\n")
set(WIDE "fn wide(${PARAMETERS},factor:float32)->Tensor[float32,3]:\n${BRANCHES}fn main()->Tensor[float32,?] ! TaskError:\n  try parallel:\n    gpu=devices.gpu()\n    a:Tensor[float32,3]=tensor([1,2,3])\n    b:Tensor[float32,3]=tensor([4,5,6])\n    c:Tensor[float32,3]=tensor([7,8,9])\n    x=try await transfer(a,gpu)\n    y=try await transfer(b,gpu)\n    z=try await transfer(c,gpu)\n    selected=try await spawn wide(${ARGUMENTS},17) on gpu\n    try await transfer(selected,devices.cpu())\n")
compile(wide "${WIDE}")
file(READ "${OUTPUT_DIR}/wide/manifest.txt" WIDE_MANIFEST)
if(NOT WIDE_MANIFEST MATCHES "kernel0.map0_tensors=41" OR NOT WIDE_MANIFEST MATCHES "kernel0.map0_inputs=0,1,2,3")
  message(FATAL_ERROR "Forty-source map lost its owned operand table: ${WIDE_MANIFEST}")
endif()
if(DEFINED VARIANT)
  run(nary "[3d20a0a1,3da0a0a1,3df0f0f1]\n" 0)
  run(matrix "[3d20a0a1,3da0a0a1,3df0f0f1]\n" 0)
  run(false-arm "[42d60000,42d80000,42da0000]\n" 0)
  run(constant "[41000000,41100000,41200000]\n" 0)
  run(empty "[]\n" 0)
  run(intermediates "[3d70f0f1,3db4b4b5,3df0f0f1]\n" 0)
  run(products "[40000000,00000000,00000000,40000000]\n" 0)
  run(middle-mismatch "" 1)
  run(wide "[42a00000,42c80000,42f00000]\n" 0)
  file(COPY "${OUTPUT_DIR}/nary/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "[3d20a0a1,3da0a0a1,3df0f0f1]\n" 0)
else()
  function(reject NAME SOURCE)
    file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
    file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
    file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" sentinel)
    execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" -o "${OUTPUT_DIR}/${NAME}" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
    file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" CONTENT)
    if(STATUS EQUAL 0 OR NOT ERROR MATCHES "G001" OR NOT CONTENT STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
      message(FATAL_ERROR "${NAME} lost transactional rejection: ${STATUS} ${ERROR}")
    endif()
  endfunction()
  # An independent middle source still needs a proven matching shape.
  string(REPLACE "  combined = a + b + c\n" "" BAD "${SOURCE}")
  string(REPLACE "  total = reduceSum(a + b + c)" "  total = reduceSum(a)" BAD "${BAD}")
  string(REPLACE "result = try await spawn normalize(first, y, z, 1) on gpu" "result = first" BAD "${BAD}")
  admit_case(unproven-middle "${BAD}")
endif()

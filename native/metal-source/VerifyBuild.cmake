file(READ "${SOURCE_DIR}/placed.k" PLACED)
file(READ "${SOURCE_DIR}/composed.k" COMPOSED)
file(MAKE_DIRECTORY "${OUTPUT_DIR}/cli")
set(ROOT "${OUTPUT_DIR}/cli")
string(REPLACE "try await transfer(result, devices.cpu())" "again = try await spawn combine(result, deviceLeft) on gpu\n    try await transfer(again, devices.cpu())" REPEATED "${COMPOSED}")
file(WRITE "${ROOT}/repeated.k" "${REPEATED}")
function(build_and_run NAME SOURCE FLAG EXPECTED)
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${SOURCE}" -o "${ROOT}/${NAME}" --build "${FLAG}" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: CLI build failed: ${OUT} ${ERROR}")
  endif()
  execute_process(COMMAND "${ROOT}/${NAME}/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "${EXPECTED}\n")
    message(FATAL_ERROR "${NAME}: compiled result mismatch: ${STATUS} ${OUT} ${ERROR}")
  endif()
endfunction()
build_and_run(optimized "${ROOT}/repeated.k" -O2 "[41980000,42000000,42440000]")
build_and_run(sanitized "${SOURCE_DIR}/placed.k" --sanitize "[40a00000,41400000,41a80000]")
build_and_run(thread-sanitized "${SOURCE_DIR}/placed.k" --thread-sanitize "[40a00000,41400000,41a80000]")
execute_process(COMMAND /usr/bin/otool -L "${ROOT}/optimized/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE LIBRARIES)
if(NOT STATUS EQUAL 0 OR LIBRARIES MATCHES "LLVM|MLIR")
  message(FATAL_ERROR "Produced program depends on compiler libraries: ${LIBRARIES}")
endif()
file(MAKE_DIRECTORY "${ROOT}/relocated")
file(COPY "${ROOT}/optimized/program" "${ROOT}/optimized/kernel0.metallib" DESTINATION "${ROOT}/relocated")
execute_process(COMMAND "${ROOT}/relocated/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT)
if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "[41980000,42000000,42440000]\n")
  message(FATAL_ERROR "Relocated shader/executable bundle failed")
endif()
# Source errors do not replace an existing executable or generated code.
file(SHA256 "${ROOT}/optimized/program" BEFORE)
string(REPLACE "product + left" "product % left" BAD "${PLACED}")
file(WRITE "${ROOT}/invalid.k" "${BAD}")
execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/invalid.k" -o "${ROOT}/optimized" --build -O2 RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
file(SHA256 "${ROOT}/optimized/program" AFTER)
if(STATUS EQUAL 0 OR NOT BEFORE STREQUAL AFTER OR NOT ERROR MATCHES "(G001|S019)")
  message(FATAL_ERROR "Invalid source was not rejected transactionally with the expected diagnostic")
endif()
string(REPLACE "devices.gpu()" "devices.gpu(4294967295)" MISSING "${PLACED}")
file(WRITE "${ROOT}/unavailable.k" "${MISSING}")
execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/unavailable.k" -o "${ROOT}/unavailable" --build RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0)
  message(FATAL_ERROR "Unavailable-device program did not build: ${ERROR}")
endif()
execute_process(COMMAND "${ROOT}/unavailable/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 1 OR NOT OUT STREQUAL "" OR NOT ERROR MATCHES "Metal task failed")
  message(FATAL_ERROR "Missing GPU silently succeeded/fell back: ${STATUS} ${OUT} ${ERROR}")
endif()
message(STATUS "Source CLI build, repeated GPU calls, relocated bundle, ASan/UBSan, TSan, output protection and missing-device failure passed")

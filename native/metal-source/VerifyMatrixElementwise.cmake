file(READ "${SOURCE_DIR}/matrix-elementwise.k" SOURCE)
file(READ "${SOURCE_DIR}/matrix-pipeline.k" PIPELINE)
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
function(run NAME CONTENT EXPECTED FLAG)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal -o "${OUTPUT_DIR}/${NAME}" "${FLAG}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME} build failed: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "${EXPECTED}\n")
      message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
  endforeach()
endfunction()
run(source "${SOURCE}" "[41a00000,41d80000,42080000,42240000,42400000,425c0000]" -O2)
# Rank changes do not introduce another arithmetic implementation.
string(REPLACE "Tensor[float32, ?, ?]" "Tensor[float32, ?]" VECTOR "${SOURCE}")
string(REPLACE "Tensor[float32, 2, 3]" "Tensor[float32, 6]" VECTOR "${VECTOR}")
string(REPLACE "tensor([[1, 2, 3], [4, 5, 6]])" "tensor([1, 2, 3, 4, 5, 6])" VECTOR "${VECTOR}")
string(REPLACE "tensor([[7, 8, 9], [10, 11, 12]])" "tensor([7, 8, 9, 10, 11, 12])" VECTOR "${VECTOR}")
run(vector "${VECTOR}" "[41a00000,41d80000,42080000,42240000,42400000,425c0000]" -O2)
foreach(KERNEL IN ITEMS 0 1 2 3)
  foreach(SUFFIX IN ITEMS mlir lowered.mlir spv)
    file(SHA256 "${OUTPUT_DIR}/source/kernel${KERNEL}.${SUFFIX}" MATRIX_HASH)
    file(SHA256 "${OUTPUT_DIR}/vector/kernel${KERNEL}.${SUFFIX}" VECTOR_HASH)
    if(NOT MATRIX_HASH STREQUAL VECTOR_HASH)
      message(FATAL_ERROR "Matrix/vector elementwise arithmetic differs for ${KERNEL}.${SUFFIX}")
    endif()
  endforeach()
endforeach()
run(pipeline "${PIPELINE}" "43a80000" -O2)
run(pipeline-sanitized "${PIPELINE}" "43a80000" --sanitize)
run(pipeline-thread-sanitized "${PIPELINE}" "43a80000" --thread-sanitize)
file(READ "${OUTPUT_DIR}/pipeline/host.cpp" HOST)
if(HOST MATCHES "r\\.download" OR NOT HOST MATCHES "r\\.elementwise" OR NOT HOST MATCHES "r\\.reduceSum")
  message(FATAL_ERROR "Resident matmul/elementwise/reduction pipeline changed data movement")
endif()
foreach(KERNEL IN ITEMS 0 1 2 3)
  file(READ "${OUTPUT_DIR}/source/kernel${KERNEL}.lowered.mlir" STRICT)
  file(READ "${OUTPUT_DIR}/source/kernel${KERNEL}.kernel.mlir" SPIRV)
  if(STRICT MATCHES "arith\\.(addf|mulf|divf)" OR SPIRV MATCHES "spirv\\.(FAdd|FMul|FDiv)|Fma|FPFastMathMode")
    message(FATAL_ERROR "Matrix elementwise kernel ${KERNEL} lost strict lowering")
  endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/relocated")
file(COPY "${OUTPUT_DIR}/pipeline/program" "${OUTPUT_DIR}/pipeline/kernel0.metallib"
  "${OUTPUT_DIR}/pipeline/kernel1.metallib" "${OUTPUT_DIR}/pipeline/kernel2.metallib" DESTINATION "${OUTPUT_DIR}/relocated")
execute_process(COMMAND "${OUTPUT_DIR}/relocated/program" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
if(NOT STATUS EQUAL 0 OR NOT OUT STREQUAL "43a80000\n")
  message(FATAL_ERROR "Relocated matrix pipeline failed: ${STATUS} ${OUT} ${ERROR}")
endif()
# Empty dimensions preserve their complete shapes through every placed stage.
string(REPLACE "Tensor[float32, 2, 3] = tensor([[1, 2, 3], [4, 5, 6]])" "Tensor[float32, 0, 3] = tensor([], [0, 3])" EMPTY "${PIPELINE}")
string(REPLACE "Tensor[float32, 2, 2] = tensor([[1, 2], [3, 4]])" "Tensor[float32, 0, 2] = tensor([], [0, 2])" EMPTY "${EMPTY}")
run(empty-rows "${EMPTY}" "00000000" --sanitize)
string(REPLACE "Tensor[float32, 3, 2] = tensor([[1, 2], [3, 4], [5, 6]])" "Tensor[float32, 3, 0] = tensor([[], [], []])" EMPTY "${PIPELINE}")
string(REPLACE "Tensor[float32, 2, 2] = tensor([[1, 2], [3, 4]])" "Tensor[float32, 2, 0] = tensor([[], []])" EMPTY "${EMPTY}")
run(empty-columns "${EMPTY}" "00000000" --thread-sanitize)
function(reject NAME CONTENT)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  file(MAKE_DIRECTORY "${OUTPUT_DIR}/${NAME}")
  file(WRITE "${OUTPUT_DIR}/${NAME}/host.cpp" "sentinel")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal -o "${OUTPUT_DIR}/${NAME}"
    RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
  if(STATUS EQUAL 0 OR NOT ERROR MATCHES "(G001|S0)")
    message(FATAL_ERROR "${NAME} missing diagnostic: ${STATUS} ${ERROR}")
  endif()
  file(READ "${OUTPUT_DIR}/${NAME}/host.cpp" SENTINEL)
  if(NOT SENTINEL STREQUAL "sentinel" OR EXISTS "${OUTPUT_DIR}/${NAME}/kernel0.mlir")
    message(FATAL_ERROR "${NAME} changed existing output")
  endif()
endfunction()
# Remove the ordinary CPU call so these mismatches test the GPU call itself.
string(REPLACE "    local = combine(left, 2, right, 0.5)" "    local = left" GPU_ONLY "${SOURCE}")
string(REPLACE "Tensor[float32, 2, 3] = tensor([[7, 8, 9], [10, 11, 12]])" "Tensor[float32, 3, 2] = tensor([[7, 8], [9, 10], [11, 12]])" BAD "${GPU_ONLY}")
reject(equal-bytes-different-axes "${BAD}")
string(REPLACE "Tensor[float32, 2, 3] = tensor([[7, 8, 9], [10, 11, 12]])" "Tensor[float32, 2, 2] = tensor([[7, 8], [9, 10]])" BAD "${GPU_ONLY}")
reject(known-width "${BAD}")
string(REPLACE "spawn combine(a, 2, b, 0.5)" "spawn combine(left, 2, b, 0.5)" BAD "${SOURCE}")
reject(hidden-upload "${BAD}")
string(REPLACE "    remote = try await transfer(summed, devices.cpu())" "    remote = summed" BAD "${SOURCE}")
reject(hidden-download "${BAD}")
function(fault NAME CONTENT)
  file(WRITE "${OUTPUT_DIR}/${NAME}.k" "${CONTENT}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/${NAME}.k" --target metal -o "${OUTPUT_DIR}/${NAME}" --sanitize
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME} must compile dynamic shapes: ${OUT} ${ERROR}")
  endif()
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL 1 OR NOT OUT STREQUAL "" OR NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} missing dynamic shape guard: ${STATUS} ${OUT} ${ERROR}")
    endif()
  endforeach()
endfunction()
set(FORWARD "fn forward(values: Tensor[float32, ?, ?]) -> Tensor[float32, ?, ?]:\n  values\n\n")
string(REPLACE "transfer(right, gpu)" "transfer(forward(right), gpu)" DYNAMIC "${GPU_ONLY}")
string(REPLACE "Tensor[float32, 2, 3] = tensor([[7, 8, 9], [10, 11, 12]])" "Tensor[float32, 3, 2] = tensor([[7, 8], [9, 10], [11, 12]])" BAD "${DYNAMIC}")
fault(dynamic-rows "${FORWARD}${BAD}")
string(REPLACE "Tensor[float32, 2, 3] = tensor([[7, 8, 9], [10, 11, 12]])" "Tensor[float32, 2, 2] = tensor([[7, 8], [9, 10]])" BAD "${DYNAMIC}")
fault(dynamic-columns "${FORWARD}${BAD}")
message(STATUS "Matrix elementwise helpers, complete shape guards, resident pipelines and relocation passed")

file(MAKE_DIRECTORY "${OUTPUT_DIR}/src")
set(ROOT "${OUTPUT_DIR}/src")
file(READ "${SOURCE_DIR}/reduction-feedback.k" SOURCE)
if(DEFINED VARIANT)
  set(TARGET_FLAGS --target metal)
  if(VARIANT STREQUAL "optimized")
    set(FLAGS -O2)
  elseif(VARIANT STREQUAL "sanitized")
    set(FLAGS --sanitize)
  elseif(VARIANT STREQUAL "thread-sanitized")
    set(FLAGS --thread-sanitize)
  else()
    set(FLAGS -O0)
  endif()
endif()
function(compile NAME SOURCE)
  file(WRITE "${ROOT}/${NAME}.k" "${SOURCE}")
  execute_process(COMMAND "${COMPILER}" --arithmetic software "${ROOT}/${NAME}.k" ${TARGET_FLAGS} -o "${OUTPUT_DIR}/${NAME}" ${FLAGS}
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0)
    message(FATAL_ERROR "${NAME}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endfunction()
function(run NAME EXPECTED CODE)
  foreach(WORKERS IN ITEMS 1 2 4)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "KALANDRA_WORKERS=${WORKERS}" "${OUTPUT_DIR}/${NAME}/program"
      RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
    if(NOT STATUS EQUAL CODE OR NOT OUT STREQUAL "${EXPECTED}" OR ERROR MATCHES "(AddressSanitizer|ThreadSanitizer|runtime error:)")
      message(FATAL_ERROR "${NAME}/${WORKERS}: ${STATUS}: ${OUT} ${ERROR}")
    endif()
    if(NOT CODE EQUAL 0 AND NOT ERROR MATCHES "Metal task failed: 1/1")
      message(FATAL_ERROR "${NAME} lost shape failure: ${ERROR}")
    endif()
  endforeach()
endfunction()
compile(variance "${SOURCE}")
file(READ "${OUTPUT_DIR}/variance/manifest.txt" MANIFEST)
file(READ "${OUTPUT_DIR}/variance/kernel0-map0.mlir" MAP)
if(NOT MANIFEST MATCHES "reduction_broadcasts=0:0" OR NOT MANIFEST MATCHES "reduction_inputs=0,2" OR NOT MAP MATCHES "memref.load %a3\\[%zero\\]")
  message(FATAL_ERROR "Lost device scalar broadcast: ${MANIFEST} ${MAP}")
endif()
string(REPLACE "Tensor[f32, ?]" "Tensor[f32, ?, ?]" MATRIX "${SOURCE}")
string(REPLACE "Tensor[f32, 3] = tensor([2, 4, 6])" "Tensor[f32, 1, 3] = tensor([[2, 4, 6]])" MATRIX "${MATRIX}")
compile(matrix "${MATRIX}")
# Reverse scalar/tensor order and use more than one reduction in a broadcast expression.
string(REPLACE "values - mean" "mean - values" REVERSE "${SOURCE}")
compile(reverse "${REVERSE}")
string(REPLACE "center(values, total / count)" "center(values, (total + reduceSum(values)) / (count * 2))" MANY "${SOURCE}")
compile(many "${MANY}")
# A map between products now consumes a reduction without a host scalar round trip.
set(PRODUCT "fn compute(a:Tensor[f32,?,?],b:Tensor[f32,?,?])->f32:\n  first=matmul(a,b)\n  total=reduceSum(first)\n  second=matmul(first/total,b)\n  return reduceSum(second)\nfn main()->f32 ! TaskError:\n  return try parallel:\n    gpu=devices.gpu()\n    a:Tensor[f32,2,2]=tensor([[1,0],[0,1]])\n    x=try await transfer(a,gpu)\n    try await spawn compute(x,x) on gpu\n")
compile(products "${PRODUCT}")
# Third reduction feeds a second map, exercising repeated interleaving.
string(REPLACE "reduceSum(squares) / count" "reduceSum(squares / reduceSum(squares))" CHAIN "${SOURCE}")
compile(chain "${CHAIN}")
# More live scalar broadcasts than Metal direct bindings can hold.
set(WIDE "fn subtotal(a:Tensor[f32,?])->f32:\n  return reduceSum(a)\nfn wide(a:Tensor[f32,?])->f32:\n")
set(EXPR "v0")
foreach(I RANGE 0 31)
  string(APPEND WIDE "  v${I}=subtotal(a)\n")
  if(I GREATER 0)
    string(APPEND EXPR " + v${I}")
  endif()
endforeach()
string(APPEND WIDE "  return reduceSum(a/(${EXPR}))\nfn main()->f32 ! TaskError:\n  return try parallel:\n    gpu=devices.gpu()\n    a:Tensor[f32,3]=tensor([2,4,6])\n    x=try await transfer(a,gpu)\n    try await spawn wide(x) on gpu\n")
compile(wide "${WIDE}")
file(READ "${OUTPUT_DIR}/wide/host.cpp" HOST)
if(NOT HOST MATCHES "ElementwiseSignature\\{33,0,m::ElementwiseBinding::ArgumentBuffer")
  message(FATAL_ERROR "Lost Tier 2 reduction broadcasts")
endif()
if(DEFINED VARIANT)
  run(variance "402aaaab\n" 0)
  run(matrix "402aaaab\n" 0)
  run(reverse "402aaaab\n" 0)
  run(many "402aaaab\n" 0)
  run(products "3f800000\n" 0)
  run(chain "3f800000\n" 0)
  run(wide "3d000000\n" 0)
  file(COPY "${OUTPUT_DIR}/variance/" DESTINATION "${OUTPUT_DIR}/relocated")
  run(relocated "402aaaab\n" 0)
endif()

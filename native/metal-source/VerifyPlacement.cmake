file(MAKE_DIRECTORY "${OUTPUT_DIR}/placement-cli")
foreach(NAME IN ITEMS placed composed mixed tensor-results shared-helpers scalar-entry matrix-elementwise differences arguments unused-inputs indirect-arguments tensor-negation division host-expressions cpu-spawn nested-parallel recovery reduction matmul)
  set(SOURCE "${SOURCE_DIR}/${NAME}.k")
  execute_process(COMMAND "${CHECKER}" --placement --dump-ir "${SOURCE}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE IR ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0 OR NOT IR MATCHES "device.gpu" OR NOT IR MATCHES "task.transfer" OR NOT IR MATCHES "task.spawn")
    message(FATAL_ERROR "${NAME} shared checker failed: ${STATUS}: ${ERROR}")
  endif()
  execute_process(COMMAND "${CHECKER}" --dump-ir --placement "${SOURCE}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE AGAIN ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0 OR NOT IR STREQUAL AGAIN)
    message(FATAL_ERROR "${NAME} check option order changed typed IR: ${ERROR}")
  endif()
  if(NAME STREQUAL "placed" OR NAME STREQUAL "composed")
    set(FOLDERS "${NAME}")
  else()
    set(FOLDERS "${NAME}-debug" "${NAME}-optimized" "${NAME}-sanitized" "${NAME}-thread-sanitized")
  endif()
  execute_process(COMMAND "${CHECKER}" --placement --dump-plan "${SOURCE}"
    RESULT_VARIABLE STATUS OUTPUT_VARIABLE PLAN ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 0 OR NOT PLAN MATCHES "spawn" OR NOT PLAN MATCHES "transfer")
    message(FATAL_ERROR "${NAME}: common continuation planning failed: ${ERROR}")
  endif()
  foreach(FOLDER IN LISTS FOLDERS)
    file(READ "${OUTPUT_DIR}/${FOLDER}/continuation.plan" ACTUAL_PLAN)
    if(NOT PLAN STREQUAL ACTUAL_PLAN)
      message(FATAL_ERROR "${FOLDER}: target continuation plan differs from the shared planner")
    endif()
    file(READ "${OUTPUT_DIR}/${FOLDER}/placement.ir" ACTUAL)
    if(NOT IR STREQUAL ACTUAL)
      message(FATAL_ERROR "${FOLDER}: target artifact differs from the shared typed frontend")
    endif()
  endforeach()
endforeach()
foreach(ARGS IN ITEMS "--placement" "--placement;--placement" "--dump-ir;--dump-ir" "--dump-plan;--dump-plan" "--dump-plan;--dump-ir" "--unknown")
  execute_process(COMMAND "${CHECKER}" ${ARGS} RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
  if(NOT STATUS EQUAL 2 OR NOT ERROR MATCHES "usage:")
    message(FATAL_ERROR "Invalid checker options accepted: ${ARGS}: ${STATUS}: ${OUT} ${ERROR}")
  endif()
endforeach()
# The new artifact participates in the same preflight output checks as host/CPU/GPU files.
set(SOURCE "${SOURCE_DIR}/placed.k")
file(MAKE_DIRECTORY "${OUTPUT_DIR}/placement-cli/symlink")
file(WRITE "${OUTPUT_DIR}/placement-cli/sentinel" "untouched")
file(CREATE_LINK "${OUTPUT_DIR}/placement-cli/sentinel" "${OUTPUT_DIR}/placement-cli/symlink/placement.ir" SYMBOLIC RESULT STATUS)
if(NOT STATUS STREQUAL "0")
  message(FATAL_ERROR "Cannot prepare placement artifact symlink test: ${STATUS}")
endif()
execute_process(COMMAND "${COMPILER}" --arithmetic software "${SOURCE}" -o "${OUTPUT_DIR}/placement-cli/symlink"
  RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
file(READ "${OUTPUT_DIR}/placement-cli/sentinel" SENTINEL)
if(STATUS EQUAL 0 OR NOT ERROR MATCHES "refusing symlink output" OR NOT SENTINEL STREQUAL "untouched"
   OR EXISTS "${OUTPUT_DIR}/placement-cli/symlink/host.cpp")
  message(FATAL_ERROR "Unsafe placement artifact output: ${STATUS}: ${OUT} ${ERROR}")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/placement-cli/collision")
file(READ "${SOURCE}" SOURCE_TEXT)
file(WRITE "${OUTPUT_DIR}/placement-cli/collision/input.k" "${SOURCE_TEXT}")
file(REMOVE "${OUTPUT_DIR}/placement-cli/collision/placement.ir")
file(CREATE_LINK "${OUTPUT_DIR}/placement-cli/collision/input.k" "${OUTPUT_DIR}/placement-cli/collision/placement.ir")
execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/placement-cli/collision/input.k"
  -o "${OUTPUT_DIR}/placement-cli/collision" RESULT_VARIABLE STATUS OUTPUT_VARIABLE OUT ERROR_VARIABLE ERROR)
file(READ "${OUTPUT_DIR}/placement-cli/collision/placement.ir" AFTER)
if(STATUS EQUAL 0 OR NOT ERROR MATCHES "source and output paths must be distinct" OR NOT SOURCE_TEXT STREQUAL AFTER
   OR EXISTS "${OUTPUT_DIR}/placement-cli/collision/host.cpp")
  message(FATAL_ERROR "Placement artifact overwrote input: ${STATUS}: ${OUT} ${ERROR}")
endif()
message(STATUS "Shared placement IR: 19 sources, 70 target artifacts, exact checker/emitter agreement and output preflight passed")

# The shared plan is subject to the same transactional preflight as other artifacts.
file(MAKE_DIRECTORY "${OUTPUT_DIR}/placement-cli/plan-symlink")
file(CREATE_LINK "${OUTPUT_DIR}/placement-cli/sentinel" "${OUTPUT_DIR}/placement-cli/plan-symlink/continuation.plan" SYMBOLIC RESULT STATUS)
if(NOT STATUS STREQUAL "0")
  message(FATAL_ERROR "Cannot prepare continuation artifact symlink: ${STATUS}")
endif()
execute_process(COMMAND "${COMPILER}" --arithmetic software "${SOURCE_DIR}/placed.k" -o "${OUTPUT_DIR}/placement-cli/plan-symlink"
  RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
file(READ "${OUTPUT_DIR}/placement-cli/sentinel" SENTINEL)
if(STATUS EQUAL 0 OR NOT ERROR MATCHES "refusing symlink output" OR NOT SENTINEL STREQUAL "untouched"
  OR EXISTS "${OUTPUT_DIR}/placement-cli/plan-symlink/host.cpp")
  message(FATAL_ERROR "Unsafe continuation artifact output: ${STATUS}: ${ERROR}")
endif()
file(MAKE_DIRECTORY "${OUTPUT_DIR}/placement-cli/plan-collision")
file(READ "${SOURCE_DIR}/placed.k" SOURCE_TEXT)
file(WRITE "${OUTPUT_DIR}/placement-cli/plan-collision/input.k" "${SOURCE_TEXT}")
file(REMOVE "${OUTPUT_DIR}/placement-cli/plan-collision/continuation.plan")
file(CREATE_LINK "${OUTPUT_DIR}/placement-cli/plan-collision/input.k" "${OUTPUT_DIR}/placement-cli/plan-collision/continuation.plan")
execute_process(COMMAND "${COMPILER}" --arithmetic software "${OUTPUT_DIR}/placement-cli/plan-collision/input.k"
  -o "${OUTPUT_DIR}/placement-cli/plan-collision" RESULT_VARIABLE STATUS ERROR_VARIABLE ERROR)
file(READ "${OUTPUT_DIR}/placement-cli/plan-collision/continuation.plan" AFTER)
if(STATUS EQUAL 0 OR NOT ERROR MATCHES "source and output paths must be distinct" OR NOT SOURCE_TEXT STREQUAL AFTER
  OR EXISTS "${OUTPUT_DIR}/placement-cli/plan-collision/host.cpp")
  message(FATAL_ERROR "Continuation artifact overwrote source: ${STATUS}: ${ERROR}")
endif()
message(STATUS "Common continuation plans: 19 sources, 70 target artifacts, exact standalone/emitter agreement and output preflight passed")
